const handleExport = async () => {
  if (!etlDate || !branch || !currency || !cgl) return;

  setExportLoading(true);

  try {
    const payload = {
      reconRunDate: etlDate.format("YYYY-MM-DD"),
      branchCode: branch?.split("-")[0] || null,
      currency,
      cgl: cgl?.split(" - ")[0] || null,
    };

    const downloadResponse = await callApi(
      "/ES/differences/export",
      payload,
      "POST",
      "arraybuffer"
    );

    if (downloadResponse?.byteLength > 0) {
      const blob = new Blob([downloadResponse], {
        type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      });

      const url = window.URL.createObjectURL(blob);
      const link = document.createElement("a");

      link.href = url;
      link.download = `Balance_Difference_${payload.branchCode}_${payload.currency}_${payload.cgl}.xlsx`;

      document.body.appendChild(link);
      link.click();
      link.remove();
      window.URL.revokeObjectURL(url);
    }
  } catch (error) {
    console.error("Export Error:", error);
    showSnackBar("Download Failed", "error");
  } finally {
    setExportLoading(false);
  }
};

    private void sendToMyDownloads(
            String userId,
            SearchCriteriaDTO dto,
            byte[] content) {

        try {

            String json =
                    new ObjectMapper()
                            .writeValueAsString(dto);

            String fileName =
                    "GL_Balance_Enquiry_"
                            + dto.getCgl()
                            + ".xlsx";

            MyDownloadsRequestDTO request =
                    new MyDownloadsRequestDTO(
                            userId,
                            fileName,
                            51,
                            json,
                            content
                    );

            myDownloadsService.insertRequest(request);

        } catch (Exception e) {

            log.error(
                    "Download save failed",
                    e
            );
        }
    }


          </Box>

          <Button
            variant="contained"
            size="small"
            startIcon={<FileDownloadIcon />}
            onClick={onDownload}
            disabled={!rowCount || loading}
            sx={{ 
              textTransform: 'none',
              bgcolor: '#58469f',
              fontWeight: 700,
              borderRadius: '8px',
              px: 3,
              boxShadow: '0 4px 12px rgba(88, 70, 159, 0.3)',
              '&:hover': { bgcolor: '#45357a' } 
            }}
          >
            Export 
          </Button>

        </Stack>

        {/* ROW 2: BALANCES */}
        {showBalances && balances && (
        <Stack direction="row" spacing={2}> 
          {[
            { 
              label: "Opening Balance", 
              date: balances.openingDate || balances.OpeningDate, 
              amt: balances.openingBalance, 
              icon: <AccountBalanceWalletIcon />,

          <Box sx={{ display: 'flex', alignItems: 'baseline', gap: 1.5 }}>
            <Typography variant="h6" fontWeight={800} sx={{ color: "#1a1a1a", letterSpacing: "-0.5px" }}>
              Transaction Ledger
            </Typography>
            
            <Typography 
              variant="caption" 
              fontWeight={700} 
              sx={{ 
                color: "#58469f", 
                textTransform: "uppercase", 
                bgcolor: "rgba(88, 70, 159, 0.1)", 
                px: 1.2, 
                py: 0.3, 
                borderRadius: 1.5,
                fontSize: '0.65rem'
              }}

renderInput={(params) => (
  <TextField
    {...params}
    label="CGL"
    InputProps={{
      ...params.InputProps,

      endAdornment: (
        <>
          <IconButton
            size="small"
            onClick={() =>
              setViewList((p) => ({
                ...p,
                cgl: !p.cgl,
              }))
            }
          >
            {viewList.cgl ? (
              <VisibilityOffIcon />
            ) : (
              <VisibilityIcon />
            )}
          </IconButton>

          {params.InputProps.endAdornment}
        </>
      ),
    }}
  />
)}





import React, { useState, useCallback, useEffect } from "react";
import {
  Box,
  Paper,
  Typography,
  IconButton,
  Grid,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  Breadcrumbs,
  Link,
  Button,
  Divider,
  Avatar,
  Stack,
  GlobalStyles,
} from "@mui/material";
import { DataGrid } from "@mui/x-data-grid";
import CloseIcon from "@mui/icons-material/Close";
import NavigateNextIcon from "@mui/icons-material/NavigateNext";
import AccountBalanceWalletIcon from "@mui/icons-material/AccountBalanceWallet";
import RefreshIcon from "@mui/icons-material/Refresh";

import useApi from "../../hooks/useApi";
import useValidation from "./Validation";
import BalanceParticularSearchFilters from "./BalanceParticularSearchFilters";
import { getBalanceParticularColumns } from "./BalanceParticularColumns";

const BalanceParticularSearchScreen = () => {
  const { callApi } = useApi();
  const { validateBranchCode, validateCurrency, validateCGL } = useValidation();

  const [filters, setFilters] = useState({
    date: "",
    branchCode: "",
    currency: "",
    cgl: "",
  });

  const [rows, setRows] = useState([]);
  const [loading, setLoading] = useState(false);
  const [totalElements, setTotalElements] = useState(0);
  const [etlDate, setEtlDate] = useState(null);

  const [paginationModel, setPaginationModel] = useState({
    page: 0,
    pageSize: 10,
  });

  const [openHistory, setOpenHistory] = useState(false);
  const [selectedRow, setSelectedRow] = useState(null);

  const updateFilter = (key, value) =>
    setFilters((prev) => ({ ...prev, [key]: value }));

  // ETL Date Fetching
  useEffect(() => {
    const fetchDefaultETLDate = async () => {
      try {
        const response = await callApi("/PS/file/fincore-date", {}, "GET");
        const dateVal = response?.data?.etlDate || response?.date || "";
        if (dateVal) {
          setEtlDate(dateVal);
          updateFilter("date", dateVal);
          fetchData(dateVal, 0, paginationModel.pageSize);
        }
      } catch (err) {
        console.error("ETL Date Error:", err);
      }
    };
    fetchDefaultETLDate();
  }, []);

  // Main Search API Call
  const fetchData = useCallback(
    async (date, pageIndex, pageSize) => {
      if (!date) return;
      setLoading(true);
      try {
        const payload = {
          fromDate: date,
          toDate: date,
          branchCode: filters.branchCode || null,
          currency: filters.currency || null,
          cgl: filters.cgl || null,
        };

        const response = await callApi(
          `/ES/differences/search?page=${pageIndex}&size=${pageSize}`,
          payload,
          "POST"
        );

        const content = response?.data?.content || response?.content || [];
        const mappedRows = content.map((item, index) => ({
          id: item.id || `row-${pageIndex}-${index}`,
          ...item,
          GLCC_VAL: `${item.branchCode || ""} / ${item.currency || ""} / ${item.cgl || ""}`,
        }));

        setRows(mappedRows);
        setTotalElements(
          response?.data?.totalElements || response?.totalElements || 0
        );
      } catch (err) {
        console.error("Search Fail:", err);
        setRows([]);
      } fontally {
        setLoading(false);
      }
    },
    [filters, callApi]
  );

  useEffect(() => {
    if (filters.date) {
      fetchData(filters.date, paginationModel.page, paginationModel.pageSize);
    }
  }, [paginationModel.page, paginationModel.pageSize]);

  const handleViewDetails = (row) => {
    setSelectedRow(row);
    setOpenHistory(true);
  };

  const columns = getBalanceParticularColumns(handleViewDetails);

  return (
    <Box
      sx={{
        width: "100%",
        minHeight: "100vh",
        background: "linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%)",
        p: { xs: 2, md: 3 },
      }}
    >
      <GlobalStyles styles={{ body: { backgroundColor: "#f8fafc" } }} />

      {/* TOP HEADER & BREADCRUMBS BAR */}
      <Paper
        elevation={0}
        sx={{
          p: 2,
          px: 3,
          mb: 3,
          borderRadius: "16px",
          background: "rgba(255, 255, 255, 0.8)",
          backdropFilter: "blur(12px)",
          border: "1px solid #e2e8f0",
        }}
      >
        <Stack direction="row" justifyContent="space-between" alignItems="center">
          <Box>
            <Breadcrumbs
              separator={<NavigateNextIcon fontSize="small" sx={{ color: "#94a3b8" }} />}
              sx={{ mb: 0.5, fontSize: "0.8rem" }}
            >
              <Link underline="hover" color="#64748b" href="#" sx={{ fontWeight: 500 }}>
                Compare Difference
              </Link>
              <Typography color="#1e293b" sx={{ fontWeight: 600, fontSize: "0.8rem" }}>
                Search
              </Typography>
            </Breadcrumbs>

            <Typography variant="h6" sx={{ fontWeight: 800, color: "#0f172a", letterSpacing: "-0.5px" }}>
              Balance Search & Comparison
            </Typography>
          </Box>

          <Button
            startIcon={<RefreshIcon />}
            size="small"
            variant="outlined"
            onClick={() => fetchData(filters.date, 0, paginationModel.pageSize)}
            sx={{
              borderRadius: "20px",
              textTransform: "none",
              borderColor: "#cbd5e1",
              color: "#475569",
              fontWeight: 600,
              "&:hover": { borderColor: "#94a3b8", backgroundColor: "#f8fafc" },
            }}
          >
            Refresh
          </Button>
        </Stack>
      </Paper>

      {/* FILTER CONTROLS */}
      <BalanceParticularSearchFilters
        filters={filters}
        etlDate={etlDate}
        setEtlDate={setEtlDate}
        updateFilter={updateFilter}
        onSearch={() => {
          setPaginationModel((prev) => ({ ...prev, page: 0 }));
          fetchData(filters.date, 0, paginationModel.pageSize);
        }}
        validateBranchCode={validateBranchCode}
        validateCurrency={validateCurrency}
        validateCGL={validateCGL}
      />

      {/* DATA GRID DISPLAY */}
      <Paper
        elevation={0}
        sx={{
          width: "100%",
          borderRadius: "16px",
          border: "1px solid #e2e8f0",
          overflow: "hidden",
          backgroundColor: "#ffffff",
          boxShadow: "0px 4px 20px rgba(0, 0, 0, 0.02)",
        }}
      >
        <Box
          sx={{
            p: 2,
            px: 3,
            backgroundColor: "#ffffff",
            borderBottom: "1px solid #f1f5f9",
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
          }}
        >
          <Typography variant="body2" sx={{ color: "#64748b", fontWeight: 600 }}>
            {loading
              ? "Loading data..."
              : `Showing ${rows.length} of ${totalElements.toLocaleString()} record(s)`}
          </Typography>
        </Box>

        <Box sx={{ height: 520, width: "100%" }}>
          <DataGrid
            rows={rows}
            columns={columns}
            rowCount={totalElements}
            loading={loading}
            paginationMode="server"
            paginationModel={paginationModel}
            onPaginationModelChange={setPaginationModel}
            pageSizeOptions={[10, 25, 50]}
            disableRowSelectionOnClick
            sx={{
              border: "none",
              "& .MuiDataGrid-columnHeaders": {
                backgroundColor: "#f8fafc",
                color: "#64748b",
                fontSize: "0.75rem",
                fontWeight: 800,
                letterSpacing: "0.5px",
                borderBottom: "1px solid #e2e8f0",
              },
              "& .MuiDataGrid-cell": {
                borderColor: "#f1f5f9",
              },
              "& .MuiDataGrid-row:hover": {
                backgroundColor: "#f8fafc",
              },
            }}
          />
        </Box>
      </Paper>

      {/* DETAILS DIALOG */}
      <Dialog
        open={openHistory}
        onClose={() => setOpenHistory(false)}
        fullWidth
        maxWidth="sm"
        PaperProps={{
          sx: { borderRadius: "20px", p: 1 },
        }}
      >
        <DialogTitle sx={{ pb: 1 }}>
          <Stack direction="row" alignItems="center" spacing={1.5}>
            <Avatar sx={{ bgcolor: "#eef2ff", color: "#6366f1" }}>
              <AccountBalanceWalletIcon fontSize="small" />
            </Avatar>
            <Typography variant="h6" sx={{ fontWeight: 700, flexGrow: 1, color: "#0f172a" }}>
              Difference Details
            </Typography>
            <IconButton onClick={() => setOpenHistory(false)} size="small">
              <CloseIcon />
            </IconButton>
          </Stack>
        </DialogTitle>

        <Divider />

        <DialogContent sx={{ py: 3 }}>
          {selectedRow && (
            <Grid container spacing={2}>
              <Grid item xs={6}>
                <Typography variant="caption" color="text.secondary" fontWeight={500}>
                  Reconciliation Date
                </Typography>
                <Typography variant="body2" sx={{ fontWeight: 700, color: "#1e293b" }}>
                  {selectedRow.reconRunDate || "N/A"}
                </Typography>
              </Grid>

              <Grid item xs={6}>
                <Typography variant="caption" color="text.secondary" fontWeight={500}>
                  Branch Code
                </Typography>
                <Typography variant="body2" sx={{ fontWeight: 700, color: "#1e293b" }}>
                  {selectedRow.branchCode || "N/A"}
                </Typography>
              </Grid>

              <Grid item xs={6}>
                <Typography variant="caption" color="text.secondary" fontWeight={500}>
                  Currency
                </Typography>
                <Typography variant="body2" sx={{ fontWeight: 700, color: "#1e293b" }}>
                  {selectedRow.currency || "N/A"}
                </Typography>
              </Grid>

              <Grid item xs={6}>
                <Typography variant="caption" color="text.secondary" fontWeight={500}>
                  CGL Number
                </Typography>
                <Typography variant="body2" sx={{ fontWeight: 700, color: "#1e293b" }}>
                  {selectedRow.cgl || "N/A"}
                </Typography>
              </Grid>

              <Grid item xs={12}>
                <Divider sx={{ my: 1 }} />
              </Grid>

              <Grid item xs={6}>
                <Paper variant="outlined" sx={{ p: 2, textAlign: "center", borderRadius: "12px", borderColor: "#e2e8f0" }}>
                  <Typography variant="caption" color="text.secondary" fontWeight={500}>
                    CBS Balance
                  </Typography>
                  <Typography variant="h6" sx={{ fontWeight: 800, color: "#0f172a", fontFamily: "monospace" }}>
                    {selectedRow.cbsBalance != null
                      ? Number(selectedRow.cbsBalance).toLocaleString()
                      : "0.00"}
                  </Typography>
                </Paper>
              </Grid>

              <Grid item xs={6}>
                <Paper variant="outlined" sx={{ p: 2, textAlign: "center", borderRadius: "12px", borderColor: "#e2e8f0" }}>
                  <Typography variant="caption" color="text.secondary" fontWeight={500}>
                    GL Balance
                  </Typography>
                  <Typography variant="h6" sx={{ fontWeight: 800, color: "#0f172a", fontFamily: "monospace" }}>
                    {selectedRow.glBalance != null
                      ? Number(selectedRow.glBalance).toLocaleString()
                      : "0.00"}
                  </Typography>
                </Paper>
              </Grid>

              <Grid item xs={12}>
                <Box
                  sx={{
                    p: 2,
                    borderRadius: "12px",
                    backgroundColor: selectedRow.differenceAmount < 0 ? "#fef2f2" : "#f0fdf4",
                    border: `1px solid ${
                      selectedRow.differenceAmount < 0 ? "#fecaca" : "#bbf7d0"
                    }`,
                    textAlign: "center",
                  }}
                >
                  <Typography variant="caption" color="text.secondary" fontWeight={600}>
                    Net Difference Amount
                  </Typography>
                  <Typography
                    variant="h5"
                    sx={{
                      fontWeight: 800,
                      fontFamily: "monospace",
                      color: selectedRow.differenceAmount < 0 ? "#dc2626" : "#16a34a",
                    }}
                  >
                    {selectedRow.differenceAmount != null
                      ? Number(selectedRow.differenceAmount).toLocaleString()
                      : "0.00"}
                  </Typography>
                </Box>
              </Grid>
            </Grid>
          )}
        </DialogContent>

        <DialogActions sx={{ px: 3, pb: 2 }}>
          <Button
            variant="outlined"
            onClick={() => setOpenHistory(false)}
            sx={{
              borderRadius: "20px",
              textTransform: "none",
              fontWeight: 600,
              borderColor: "#cbd5e1",
              color: "#475569",
            }}
          >
            Close
          </Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
};

export default BalanceParticularSearchScreen;

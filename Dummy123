import React from "react";
import { Box, Typography } from "@mui/material";
import CustomChip from "../../../utils/CustomChip";

const formatAmount = (value) => {
  const number = Number(value);

  if (Number.isNaN(number)) {
    return "-";
  }

  return new Intl.NumberFormat("en-IN", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  }).format(Math.abs(number));
};

const AmountCell = ({ value, difference = false }) => {
  const number = Number(value);

  if (Number.isNaN(number)) {
    return (
      <Typography
        variant="body2"
        sx={{
          fontWeight: 600,
          textAlign: "right",
          width: "100%",
        }}
      >
        -
      </Typography>
    );
  }

  const isNegative = number < 0;

  return (
    <Box
      sx={{
        display: "flex",
        alignItems: "center",
        justifyContent: "flex-end",
        height: "100%",
        width: "100%",
        pr: 1.5,
      }}
    >
      <Typography
        variant="body2"
        sx={{
          fontWeight: 600,
          color: isNegative ? "#d32f2f" : "#2e7d32",
          fontFeatureSettings: '"tnum"',
          mr: 1,
        }}
      >
        {formatAmount(number)}
      </Typography>

      <CustomChip
        label={isNegative ? "Dr" : "Cr"}
        size="small"
        sx={{
          height: 20,
          fontSize: "0.68rem",
          fontWeight: 700,
          bgcolor: isNegative
            ? "rgba(211, 47, 47, 0.08)"
            : "rgba(46, 125, 50, 0.08)",
          color: isNegative ? "#d32f2f" : "#2e7d32",
          border: `1px solid ${
            isNegative
              ? "rgba(211, 47, 47, 0.2)"
              : "rgba(46, 125, 50, 0.2)"
          }`,
        }}
      />
    </Box>
  );
};

const DifferenceAmountCell = ({ value }) => {
  const number = Number(value);

  if (Number.isNaN(number)) {
    return (
      <Typography
        variant="body2"
        sx={{
          fontWeight: 600,
          textAlign: "right",
          width: "100%",
        }}
      >
        -
      </Typography>
    );
  }

  return (
    <Typography
      variant="body2"
      sx={{
        fontWeight: 700,
        textAlign: "right",
        width: "100%",
        pr: 1.5,
        color:
          number < 0
            ? "#d32f2f"
            : number > 0
              ? "#2e7d32"
              : "text.secondary",
        fontFeatureSettings: '"tnum"',
      }}
    >
      {new Intl.NumberFormat("en-IN", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      }).format(number)}
    </Typography>
  );
};


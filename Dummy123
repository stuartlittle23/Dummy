          return;
        }
      }
      setGlifDataFilter((prev) => { return { ...prev, [filter.field]: { operator: "IN", value: [...prev[filter.field].value, filter.value] } } })
      return
    }
    setGlifDataFilter((prev) => { return { ...prev, [filter.field]: { operator: "IN", value: [filter.value] } } })
  }


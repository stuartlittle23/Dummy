        elevation={0}
        sx={{
          p: 2,
          px: 3,
          mb: 3,
          borderRadius: "16px",
          background: "rgba(255, 255, 255, 0.8)",
          backdropFilter: "blur(12px)",
          border: "1px solid #e2e8f0",
        }}
      >
        <Stack direction="row" justifyContent="space-between" alignItems="center">
          <Box>
            <Breadcrumbs
              separator={<NavigateNextIcon fontSize="small" sx={{ color: "#94a3b8" }} />}
              sx={{ mb: 0.5, fontSize: "0.8rem" }}
            >
              <Link underline="hover" color="#64748b" href="#" sx={{ fontWeight: 500 }}>
                Compare Difference
              </Link>
              <Typography color="#1e293b" sx={{ fontWeight: 600, fontSize: "0.8rem" }}>
                Search
              </Typography>
            </Breadcrumbs>

            <Typography variant="h6" sx={{ fontWeight: 800, color: "#0f172a", letterSpacing: "-0.5px" }}>
              Balance Search & Comparison
            </Typography>
          </Box>

          <Button
            startIcon={<RefreshIcon />}
            size="small"
            variant="outlined"
            onClick={() => fetchData(filters.date, 0, paginationModel.pageSize)}
            sx={{
              borderRadius: "20px",
              textTransform: "none",
              borderColor: "#cbd5e1",
              color: "#475569",
              fontWeight: 600,
              "&:hover": { borderColor: "#94a3b8", backgroundColor: "#f8fafc" },

import React, { useState, useCallback, useMemo, useEffect } from "react";
import {
  Card,
  CardContent,
  TextField,
  Button,
  Autocomplete,
  Checkbox,
  Typography,
  Stack,
  Box,
  IconButton,
  Grid,
  InputAdornment,
  Paper,
  Collapse,
  Chip,
  ToggleButton,
  ToggleButtonGroup,
} from "@mui/material";
import { DatePicker } from "@mui/x-date-pickers";

// Icons
import RestartAltIcon from "@mui/icons-material/RestartAlt";
import SearchIcon from "@mui/icons-material/Search";
import VisibilityIcon from "@mui/icons-material/Visibility";
import VisibilityOffIcon from "@mui/icons-material/VisibilityOff";
import DeleteSweepIcon from "@mui/icons-material/DeleteSweep";
import AccountBalanceIcon from "@mui/icons-material/AccountBalance";
import DateRangeIcon from "@mui/icons-material/DateRange";
import SummarizeIcon from "@mui/icons-material/Summarize";

// Utilities & Hooks
import { debounce } from "lodash";
import useApi from "../../../hooks/useApi";
import CustomChip from "../../../utils/CustomChip";

const BalanceLedgerForm = ({
  filters,
  onFilterChange,
  onReset,
  onFetch,
  permissions,
  user,
  circles,
  currencies,
  FOREIGN_CIRCLE_CODE,
  CIRCLE_GROUPS,
  minLimit,
  maxLimit,
  fetchLoading,
}) => {
  const { callApi } = useApi();
  const { hasWholeBank, hasCircle } = permissions;
  const [branchSearch, setBranchSearch] = useState(null);
  const [branches, setBranches] = useState([]);
  const [cgls, setCgls] = useState(["All CGLs"]);
  const [loading, setLoading] = useState({
    branch: false,
    cgl: false,
    currency: false,
  });
  const [viewList, setViewList] = useState(null);
  const [balanceDateError, setBalanceDateError] = useState(null);
  const [currencyOptions, setCurrencyOptions] = useState([
    "All Currencies",
    ...(currencies || []),
  ]);

  useEffect(() => {
  const allCurrencies = ["All Currencies", ...(currencies || [])];

  setCurrencyOptions(allCurrencies);

  if (filters.currencies?.includes("All Currencies")) {
    onFilterChange("currencies", allCurrencies);
  }
}, [currencies]);

  const isCircleVisible = !!hasWholeBank;
  const isBranchVisible =
    !permissions.hasWholeBank || filters.enquiryType === "COLLATION";

  const isBranchUser = !hasWholeBank && !user?.isCircle;
  const isCircleUser = user?.isCircle && !hasWholeBank;

  const branch = filters.branches || [];
  const hasSelectedBranches = !branch.includes("All Branches") && branch.length > 0;

  const cgl = filters.cgl || [];
  const hasSelectedCgls = !cgl.includes("All CGLs") && cgl.length > 0;

  const currency = filters.currencies || [];
  const hasSelectedCurrencies =
    !currency.includes("All Currencies") && currency.length > 0;

  const searchLogic = useCallback(
    async (type, term) => {
      if (!term || term.length < 3) return;
      try {
        setLoading((p) => ({ ...p, [type]: true }));
        let cp = "";

        if (hasWholeBank) {
          if (
            filters.circle !== CIRCLE_GROUPS.ALL &&
            filters.circle !== CIRCLE_GROUPS.DOMESTIC &&
            filters.circle !== CIRCLE_GROUPS.FOREIGN
          ) {
            cp = `&circleCode=${filters.circle}`;
          } else if (filters.circle === CIRCLE_GROUPS.FOREIGN) {
            cp = `&circleCode=${FOREIGN_CIRCLE_CODE}`;
          } else if (filters.circle === CIRCLE_GROUPS.DOMESTIC) {
            cp = `&circleCode=${CIRCLE_GROUPS.DOMESTIC}`;
          } else {
            cp = `&circleCode=${CIRCLE_GROUPS.ALL}`;
          }
        } else if (!hasWholeBank) {
          cp = `&circleCode=${user.circleCode}`;
        }

        const url =
          type === "branch"
            ? `/CM/common-master/branches-code-name-only?q=${encodeURIComponent(term)}${cp}`
            : type === "cgl"
              ? `/CM/common-master/cgl-code-description-only?q=${encodeURIComponent(term)}`
              : `/CM/common-master/currency-code-name-only?q=${encodeURIComponent(term)}`;

        const res = await callApi(url, null, "GET");

        if (res?.data) {
          let opts = [];
          if (type === "branch") {
            opts = res.data.map((i) => `${i.code}-${i.name}`);
            setBranches(opts);
          } else if (type === "cgl") {
            opts = res.data.map((i) => `${i.cglNumber} - ${i.description}`);
            setCgls(opts);
          } else if (type === "currency") {
            opts = res.data.map((i) => `${i.currencyCode} (${i.currencyName})`);
            setCurrencyOptions(["All Currencies", ...opts]);
          }
        }
      } catch (e) {
        console.error(e);
      } finally {
        setLoading((p) => ({ ...p, [type]: false }));
      }
    },
    [
      hasWholeBank,
      callApi,
      filters.circle,
      CIRCLE_GROUPS.ALL,
      CIRCLE_GROUPS.DOMESTIC,
      CIRCLE_GROUPS.FOREIGN,
      FOREIGN_CIRCLE_CODE,
      user.circleCode,
    ],
  );

  const fetchSearchData = useMemo(
    () => debounce((t, v) => searchLogic(t, v), 300),
    [searchLogic],
  );

  useEffect(() => () => fetchSearchData.cancel(), [fetchSearchData]);

  const handleBranchChange = (val) => {
    const clickedAll = val.includes("All Branches") && !filters.branches.includes("All Branches");
    const isEmpty = val.length === 0;

    if (clickedAll || isEmpty) {
      onFilterChange("branches", ["All Branches"]);
      setViewList(null);
      return;
    }

    const valWithoutAll = val.filter((v) => v !== "All Branches");
    onFilterChange("branches", valWithoutAll);
  };

  const removeBranch = (branchToRemove) => {
    const updated = filters.branches.filter((b) => b !== branchToRemove);

    if (updated.length === 0) {
      onFilterChange("branches", ["All Branches"]);
      setViewList(null);
    } else {
      onFilterChange("branches", updated);
    }
  };

  const handleCglChange = (val) => {
    const clickedAll =
      val.includes("All CGLs") && !filters.cgl.includes("All CGLs");
    const isEmpty = val.length === 0;

    if (clickedAll || isEmpty) {
      onFilterChange("cgl", ["All CGLs"]);
      setViewList(null);
      return;
    }

    onFilterChange(
      "cgl",
      val.filter((v) => v !== "All CGLs"),
    );
  };

  const removeCgl = (item) => {
    const updated = filters.cgl.filter((c) => c !== item);

    if (updated.length === 0) {
      onFilterChange("cgl", ["All CGLs"]);
      setViewList(null);
    } else {
      onFilterChange("cgl", updated);
    }
  };

const handleCurrencyChange = (val) => {
  const hadAll = filters.currencies.includes("All Currencies");
  const hasAll = val.includes("All Currencies");

  // User clicked "All Currencies" -> select everything
  if (hadAll && !hasAll && val.length === 0) {
    onFilterChange(
      "currencies",
      ["All Currencies", ...currencies.filter(c => c !== "All Currencies")]
    );
    setViewList(null);
    return;
  }

  // User unchecked "All Currencies" -> clear everything
  if (hadAll && !hasAll) {
    onFilterChange("currencies", []);
    setViewList(null);
    return;
  }

  // Normal selection
  const updated = val.filter(v => v !== "All Currencies");

  const actualCurrencies = currencyOptions.filter(
    c => c !== "All Currencies"
  );

  if (
    updated.length === actualCurrencies.length &&
    actualCurrencies.every(c => updated.includes(c))
  ) {
    onFilterChange(
      "currencies",
      ["All Currencies", ...actualCurrencies]
    );
    return;
  }

  onFilterChange("currencies", updated);
  };



  const removeCurrency = (item) => {
    const updated = filters.currencies.filter((c) => c !== item);

    if (updated.length === 0) {
      onFilterChange("currencies", ["All Currencies"]);
      setViewList(null);
    } else {
      onFilterChange("currencies", updated);
    }
  };

  const handleCircleChange = (value) => {
    onFilterChange("branches", ["All Branches"]);
    setBranches([]);
    setViewList(null);
    onFilterChange("circle", value?.value || null);
  };

  const SectionHeader = ({ icon, title }) => (
    <Stack direction="row" spacing={1} alignItems="center" sx={{ mb: 2 }}>
      <Box
        sx={{
          p: 0.5,
          bgcolor: "primary.main",
          borderRadius: 1,
          color: "white",
          display: "flex",
        }}
      >
        {icon}
      </Box>
      <Typography
        variant="subtitle2"
        sx={{ fontWeight: 800, color: "text.primary", letterSpacing: 1 }}
      >
        {title}
      </Typography>
    </Stack>
  );

  const getDateErrorMessage = (field, error) => {
    switch (error) {
      case "maxDate":
        return `${field} cannot be in future`;
      case "minDate":
        return `${field} cannot be before ${minLimit.format("DD/MM/YYYY")}`;
      case "invalidDate":
        return `Please enter a valid ${field}`;
      default:
        return "";
    }
  };

  const validationMessages = [
    balanceDateError && getDateErrorMessage("Balance Date", balanceDateError),
  ].filter(Boolean);

  return (
    <Box sx={{ position: "relative", mb: 2 }}>
      <Card
        sx={{
          borderRadius: "24px",
          boxShadow: "0 20px 50px rgba(0,0,0,0.1)",
          border: "1px solid rgba(255,255,255,0.3)",
        }}
      >
        <CardContent sx={{ p: { xs: 2, sm: 3, md: 4 } }}>
          {/* UPDATED HEADER: Responsive stacking to prevent overlap on mobile */}
          <Stack
            direction={{ xs: "column", lg: "row" }}
            justifyContent="space-between"
            alignItems={{ xs: "flex-start", lg: "center" }}
            spacing={{ xs: 3, lg: 0 }}
            sx={{ mb: 2 }}
          >
            <Box>
              <Typography
                variant="h4"
                sx={{
                  fontWeight: 900,
                  // fontSize: { xs: "1.75rem", md: "2.125rem" },
                }}
              >
                Ledger Balance Insights
              </Typography>
              <Typography variant="body2" color="text.secondary">
                Ledger Balance search and analysis
              </Typography>
            </Box>
              {!isBranchUser &&(
              <Paper
                elevation={3}
                sx={{
                  px: { xs: 2, sm: 4 },
                  py: 1,
                  borderRadius: "50px",
                  display: "flex",
                  flexDirection: { xs: "column", sm: "row" },
                  alignItems: "center",
                  gap: { xs: 1.5, sm: 3 },
                  border: "1px solid #ffffff77",
                  bgcolor: "#bba7da4f",
                  boxShadow: "0 6px 18px rgba(0, 0, 0, 0.23)",
                  width: { xs: "100%", sm: "auto" },
                  boxSizing: "border-box",
                }}
              >
                <Stack direction="row" spacing={1} alignItems="center">
                  <SummarizeIcon sx={{ color: "#58469f" }} />
                  <Typography
                    variant="subtitle1"
                    sx={{ fontWeight: 900, color: "#333" }}
                  >
                    Switch Enquiry Type
                  </Typography>
                </Stack>

                <ToggleButtonGroup
                  exclusive
                  size="small"
                  value={filters.enquiryType}
                  onChange={(_, value) => {
                    if (value) {
                      onFilterChange("enquiryType", value);
                    }
                  }}
                  sx={{
                    width: { xs: "100%", sm: "auto" },
                    display: "flex",
                    "& .MuiToggleButton-root": {
                      flex: { xs: 1, sm: "none" },
                      px: { xs: 1, sm: 3 },
                      py: 0.8,
                      borderRadius: "10px !important",
                      textTransform: "none",
                      fontWeight: 700,
                      border: "1px solid #d0d7de",
                      color: "#555",
                      transition: "all 0.25s",
                      mx: 0.5,
                    },
                    "& .Mui-selected": {
                      bgcolor: "#58469f !important",
                      color: "#fff !important",
                      borderColor: "#58469f !important",
                      boxShadow: "0 4px 12px rgba(88,70,159,0.35)",
                    },
                    "& .MuiToggleButton-root:hover": {
                      bgcolor: "rgba(88,70,159,0.08)",
                    },
                  }}
                >
                  <ToggleButton value="COLLATION">Collation</ToggleButton>
                  <ToggleButton value="CONSOLIDATED">Consolidation</ToggleButton>
                </ToggleButtonGroup>
              </Paper>
              )}
          </Stack>


          {/* 1. HIERARCHY ZONE */}
          <Grid container spacing={4} sx={{ mt: { xs: 2, md: 4 } }}>
            {!isBranchUser && !(isCircleUser && filters.enquiryType ==="CONSOLIDATED") && (isCircleVisible || isBranchVisible) && (
              <Grid size={{ xs: 12, md: 6}}>
                <Paper
                  variant="outlined"
                  sx={{
                    p: 3,
                    borderRadius: "20px",
                    bgcolor: "rgba(0,0,0,0.01)",
                    borderStyle: "dashed",
                    position: "relative",
                  }}
                >
                  <SectionHeader
                    icon={<AccountBalanceIcon fontSize="small" />}
                    title="Hierarchy"
                  />

                  <Grid container spacing={2}>
                    {isCircleVisible && (
                      <Grid size={{ xs: 12, sm: isBranchVisible ? 6 : 12 }}>
                        <Autocomplete
                          size="small"
                          options={[
                            { value: CIRCLE_GROUPS.ALL, label: "All Circles" },
                            {
                              value: CIRCLE_GROUPS.DOMESTIC,
                              label: "Domestic Circles",
                            },
                            {
                              value: CIRCLE_GROUPS.FOREIGN,
                              label: "Foreign Circles",
                            },
                            ...circles.map((c) => ({
                              value: c.circleCode,
                              label:
                                c.circleCode === FOREIGN_CIRCLE_CODE
                                  ? `${c.circleCode} - Foreign`
                                  : `${c.circleCode} - ${c.circleName}`,
                            })),
                          ]}
                          value={(() => {
                            if (filters.circle === CIRCLE_GROUPS.ALL)
                              return {
                                value: CIRCLE_GROUPS.ALL,
                                label: "All Circles",
                              };
                            if (filters.circle === CIRCLE_GROUPS.DOMESTIC)
                              return {
                                value: CIRCLE_GROUPS.DOMESTIC,
                                label: "Domestic Circles",
                              };
                            if (filters.circle === CIRCLE_GROUPS.FOREIGN)
                              return {
                                value: CIRCLE_GROUPS.FOREIGN,
                                label: "Foreign Circles",
                              };
                            const matched = circles.find(
                              (c) => c.circleCode === filters.circle,
                            );
                            return matched
                              ? {
                                  value: matched.circleCode,
                                  label:
                                    matched.circleCode === FOREIGN_CIRCLE_CODE
                                      ? `${matched.circleCode} - Foreign`
                                      : `${matched.circleCode} - ${matched.circleName}`,
                                }
                              : null;
                          })()}
                          isOptionEqualToValue={(option, value) =>
                            option?.value === value?.value
                          }
                          onChange={(_, value) => handleCircleChange(value)}
                          getOptionLabel={(option) => option?.label || ""}
                          renderInput={(params) => (
                            <TextField
                              {...params}
                              label="Select Circle"
                              required
                              variant="standard"
                              inputProps={{
                                ...params.inputProps,
                                maxLength: 30,
                                
                              }}
                            />
                          )}
                        />
                      </Grid>
                    )}
                    {isBranchVisible && (
                      <Grid size={{ xs: 12, sm: isCircleVisible ? 6 : 12 }}>
                        <Autocomplete
                          multiple
                          size="small"
                          disableCloseOnSelect
                          options={["All Branches", ...branches]}
                          loading={loading.branch}
                          value={filters.branches}
                          inputValue={branchSearch}
                          onInputChange={(event, newInputValue, reason) => {
  if (newInputValue.length > 30) return;

  setBranchSearch(newInputValue);

  if (reason === "input" && newInputValue.length >= 3) {
    fetchSearchData("branch", newInputValue);
  }

  if (reason === "clear" || reason === "blur") {
    setBranches([]);
  }
}}
                          onChange={(_, val) => {
                            handleBranchChange(val);
                            setBranchSearch("");
                          }}
                          renderTags={() => null}
                          renderOption={(props, option, { selected }) => (
                            <li {...props} key={option}>
                              <Checkbox
                                size="small"
                                style={{ marginRight: 8 }}
                                checked={selected}
                              />
                              <Typography variant="body2">{option}</Typography>
                            </li>
                          )}
                          renderInput={(p) => (
                            <TextField
                              {...p}
                              label="Select Branches"
                              variant="standard"
                              required
                              placeholder={"Enter atleast 3 digits..."}
                              InputProps={{
                                ...p.InputProps,
                                maxLength: 30,
                                endAdornment: (
                                  <InputAdornment
                                    position="end"
                                    sx={{ mb: 0.5 }}
                                  >
                                    <Stack
                                      direction="row"
                                      alignItems="center"
                                      spacing={1}
                                    >
                                      <CustomChip
                                        label={
                                          filters.branches.includes("All Branches")
                                            ? "All Branches"
                                            : `${filters.branches.length} Selected`
                                        }
                                        color={
                                          filters.branches.includes("All Branches")
                                            ? "default"
                                            : "primary"
                                        }
                                        sx={{
                                          fontWeight: 700,
                                          fontSize: "0.7rem",
                                        }}
                                      />
                                      {!filters.branches.includes("All Branches") &&
                                        filters.branches.length > 0 && (
                                          <IconButton
                                            size="small"
                                            onClick={() =>
                                              setViewList(
                                                viewList === "branches"
                                                  ? null
                                                  : "branches",
                                              )
                                            }
                                            color={
                                              viewList === "branches"
                                                ? "primary"
                                                : "default"
                                            }
                                            sx={{
                                              transition: "0.2s",
                                              bgcolor: viewList
                                                ? "rgba(25, 118, 210, 0.08)"
                                                : "transparent",
                                            }}
                                          >
                                            {viewList === "branches" ? (
                                              <VisibilityOffIcon fontSize="small" />
                                            ) : (
                                              <VisibilityIcon fontSize="small" />
                                            )}
                                          </IconButton>
                                        )}
                                    </Stack>
                                    {p.InputProps.endAdornment}
                                  </InputAdornment>
                                ),
                              }}
                            />
                          )}
                        />
                      </Grid>
                    )}
                  </Grid>
                </Paper>
              </Grid>
            )}

            {/* 2. ACCOUNT ZONE */}
            <Grid
              size={{ xs: 12, md: !isBranchUser && !(isCircleUser && filters.enquiryType ==="CONSOLIDATED")?6:12,}}
            >
              <Paper
                variant="outlined"
                sx={{
                  p: 3,
                  borderRadius: "20px",
                  bgcolor: "rgba(0,0,0,0.01)",
                  borderStyle: "dashed",
                }}
              >
                <SectionHeader
                  icon={<SearchIcon fontSize="small" />}
                  title="Account Details"
                />
                <Grid container spacing={2}>
                  <Grid size={{ xs: 12, sm: 7 }}>
                    <Autocomplete
                      multiple
                      autoHighlight
                      disableCloseOnSelect
                      renderTags={() => null}
                      limitTags={0}
                      value={filters.cgl}
                      options={[
                        "All CGLs",
                        ...cgls.filter((c) => c !== "All CGLs"),
                      ]}
                      clearIcon={filters.cgl ? undefined : null}
                      noOptionsText={
                        filters.enquiryType !== "CONSOLIDATED" &&
                        (!filters.cgl || filters.cgl.length < 3)
                          ? "Please enter at least 3 characters"
                          : "No Options"
                      }
                     onInputChange={(event, newInputValue, reason) => {
                    if (newInputValue.length > 30) return;

                    setBranchSearch(newInputValue);

                    if (reason === "input") {
                      if (newInputValue.length >= 3) {
                        fetchSearchData("branch", newInputValue);
                      } else {
                        setBranches([]);
                      }
                    }

                    if (reason === "clear" || reason === "blur") {
                      setBranches([]);
                    }
                  }}

                      onChange={(_, v) => handleCglChange(v)}
                      renderOption={(props, option, { selected }) => (
                        <li {...props}>
                          <Checkbox checked={selected} />
                          {option}
                        </li>
                      )}
                      renderInput={(params) => (
                        <TextField
                          {...params}
                          variant="standard"
                          label="CGL *"
                          placeholder={"Enter atleast 3 characters..."}
                          InputProps={{
                            ...params.InputProps,
                            startAdornment: null,
                            endAdornment: (
                              <>
                                {filters.cgl.length > 0 && (
                                  <>
                                    <CustomChip
                                      label={
                                        filters.cgl.includes("All CGLs")
                                          ? "All CGLs"
                                          : `${filters.cgl.length} Selected`
                                      }
                                      color={
                                        filters.cgl.includes("All CGLs")
                                          ? "default"
                                          : "primary"
                                      }
                                    />
                                    {!filters.cgl.includes("All CGLs") &&
                                      filters.cgl.length > 0 && (
                                        <IconButton
                                          size="small"
                                          onClick={() =>
                                            setViewList(
                                              viewList === "cgl" ? null : "cgl",
                                            )
                                          }
                                        >
                                          {viewList === "cgl" ? (
                                            <VisibilityOffIcon fontSize="small" />
                                          ) : (
                                            <VisibilityIcon fontSize="small" />
                                          )}
                                        </IconButton>
                                      )}
                                  </>
                                )}
                                {params.InputProps.endAdornment}
                              </>
                            ),
                          }}
                        />
                      )}
                      loadingText="Searching Cgls..."
                    />
                  </Grid>
                  <Grid size={{ xs: 12, sm: 5 }}>
                    <Autocomplete
                      multiple
                      size="small"
                      options={[...currencyOptions]}
                      autoHighlight
                      value={filters.currencies}
                      disableCloseOnSelect
                      renderTags={() => null}
                      limitTags={0}
                      onChange={(_, v) => handleCurrencyChange(v)}
                      renderOption={(props, option, { selected }) => (
                        <li {...props} key={option}>
                          <Checkbox
                            size="small"
                            style={{ marginRight: 8 }}
                            checked={selected}
                          />
                          <Typography variant="body2">{option}</Typography>
                        </li>
                      )}
                      renderInput={(p) => (
                        <TextField
                          {...p}
                          label="Currency"
                          required
                          variant="standard"
                          disableCloseOnSelect
                          InputProps={{
                            ...p.InputProps,
                            startAdornment: null,
                            endAdornment: (
                              <>
                                <CustomChip
                                  label={
                                    filters.currencies.includes(
                                      "All Currencies",
                                    )
                                      ? "All currencies"
                                      : `${filters.currencies.length} Selected`
                                  }
                                  color={
                                    filters.currencies.includes(
                                      "All Currencies",
                                    )
                                      ? "default"
                                      : "primary"
                                  }
                                />
                                {!filters.currencies.includes(
                                  "All Currencies",
                                ) &&
                                  filters.currencies.length > 0 && (
                                    <IconButton
                                      size="small"
                                      onClick={() =>
                                        setViewList(
                                          viewList === "currency"
                                            ? null
                                            : "currency",
                                        )
                                      }
                                    >
                                      {viewList === "currency" ? (
                                        <VisibilityOffIcon fontSize="small" />
                                      ) : (
                                        <VisibilityIcon fontSize="small" />
                                      )}
                                    </IconButton>
                                  )}
                                {p.InputProps.endAdornment}
                              </>
                            ),
                          }}
                        />
                      )}
                    />
                  </Grid>
                </Grid>
              </Paper>
            </Grid>

            {/* ROW 2: INDIVIDUAL BRANCH TRAY */}
            {viewList === "branches" && hasSelectedBranches && (
              <Grid size={{ xs: 12 }}>
                <Collapse in={viewList && hasSelectedBranches}>
                  <Paper
                    variant="outlined"
                    sx={{
                      borderRadius: "20px",
                      bgcolor: "#fff",
                      border: "1px solid #e0e6ed",
                      overflow: "hidden",
                      mb: 1.5,
                      boxShadow: "0 4px 20px rgba(0,0,0,0.05)",
                    }}
                  >
                    <Stack
                      direction="row"
                      justifyContent="space-between"
                      alignItems="center"
                      sx={{
                        p: 2,
                        borderBottom: "1px solid #f0f0f0",
                        bgcolor: "rgba(25, 118, 210, 0.02)",
                      }}
                    >
                      <Stack direction="row" spacing={1} alignItems="center">
                        <Typography
                          variant="caption"
                          sx={{
                            fontWeight: 800,
                            color: "primary.main",
                            letterSpacing: 1,
                          }}
                        >
                          SELECTED BRANCHES
                        </Typography>
                        <CustomChip
                          label={filters.branches.length}
                          color="primary"
                          sx={{ height: 20 }}
                        />
                      </Stack>
                      <Button
                        size="small"
                        color="error"
                        variant="text"
                        startIcon={<DeleteSweepIcon />}
                        onClick={() => {
                          onFilterChange("branches", ["All Branches"]);
                          setViewList(null);
                        }}
                        sx={{
                          p: 1,
                          fontWeight: 700,
                          "&:hover": { color: "white", background: "#9f0400" },
                        }}
                      >
                        Clear All
                      </Button>
                    </Stack>
                    <Box
                      sx={{
                        p: 2,
                        maxHeight: "250px",
                        overflowY: "auto",
                        display: "flex",
                        flexWrap: "wrap",
                        gap: 1,
                        "&::-webkit-scrollbar": { width: "6px" },
                        "&::-webkit-scrollbar-track": { background: "#f1f1f1" },
                        "&::-webkit-scrollbar-thumb": {
                          background: "#ccc",
                          borderRadius: "10px",
                        },
                      }}
                    >
                      {filters.branches.map((b) => (
                        <Chip
                          key={b}
                          label={b}
                          color="primary"
                          variant="outlined"
                          onDelete={() => removeBranch(b)}
                          sx={{
                            borderRadius: "8px",
                            bgcolor: "white",
                            fontWeight: 500,
                            "& .MuiChip-deleteIcon": {
                              color: "inherit",
                              transition: "0.2s",
                              "&:hover": {
                                color: "inherit",
                                transform: "scale(1.2)",
                              },
                            },
                            "&:hover": {
                              bgcolor: "#f5f9ff",
                              borderColor: "primary.main",
                            },
                          }}
                        />
                      ))}
                    </Box>
                  </Paper>
                </Collapse>
              </Grid>
            )}

            {/* ROW 2: INDIVIDUAL CGL TRAY */}
            {viewList === "cgl" && hasSelectedCgls && (
              <Grid size={{ xs: 12 }}>
                <Collapse in={viewList && hasSelectedCgls}>
                  <Paper
                    variant="outlined"
                    sx={{
                      borderRadius: "20px",
                      bgcolor: "#fff",
                      border: "1px solid #e0e6ed",
                      overflow: "hidden",
                      mb: 1.5,
                      boxShadow: "0 4px 20px rgba(0,0,0,0.05)",
                    }}
                  >
                    <Stack
                      direction="row"
                      justifyContent="space-between"
                      alignItems="center"
                      sx={{
                        p: 2,
                        borderBottom: "1px solid #f0f0f0",
                        bgcolor: "rgba(25, 118, 210, 0.02)",
                      }}
                    >
                      <Stack direction="row" spacing={1} alignItems="center">
                        <Typography
                          variant="caption"
                          sx={{
                            fontWeight: 800,
                            color: "primary.main",
                            letterSpacing: 1,
                          }}
                        >
                          SELECTED CGLs
                        </Typography>
                        <CustomChip
                          label={filters.cgl.length}
                          color="primary"
                          sx={{ height: 20 }}
                        />
                      </Stack>
                      <Button
                        size="small"
                        color="error"
                        variant="text"
                        startIcon={<DeleteSweepIcon />}
                        onClick={() => {
                          onFilterChange("cgl", ["All CGLs"]);
                          setViewList(null);
                        }}
                        sx={{
                          p: 1,
                          fontWeight: 700,
                          "&:hover": { color: "white", background: "#9f0400" },
                        }}
                      >
                        Clear All
                      </Button>
                    </Stack>
                    <Box
                      sx={{
                        p: 2,
                        maxHeight: "250px",
                        overflowY: "auto",
                        display: "flex",
                        flexWrap: "wrap",
                        gap: 1,
                        "&::-webkit-scrollbar": { width: "6px" },
                        "&::-webkit-scrollbar-track": { background: "#f1f1f1" },
                        "&::-webkit-scrollbar-thumb": {
                          background: "#ccc",
                          borderRadius: "10px",
                        },
                      }}
                    >
                      {(filters.cgl || []).map((b) => (
                        <Chip
                          key={b}
                          label={b}
                          color="primary"
                          variant="outlined"
                          onDelete={() => removeCgl(b)}
                          sx={{
                            borderRadius: "8px",
                            bgcolor: "white",
                            fontWeight: 500,
                            "& .MuiChip-deleteIcon": {
                              color: "error.main",
                              transition: "0.2s",
                              "&:hover": {
                                color: "#d32f2f",
                                transform: "scale(1.2)",
                              },
                            },
                            "&:hover": {
                              bgcolor: "#f5f9ff",
                              borderColor: "primary.main",
                            },
                          }}
                        />
                      ))}
                    </Box>
                  </Paper>
                </Collapse>
              </Grid>
            )}

            {/* ROW 2: INDIVIDUAL CURRENCY TRAY */}
            {viewList === "currency" && hasSelectedCurrencies && (
              <Grid size={{ xs: 12 }}>
                <Collapse in={viewList && hasSelectedCurrencies}>
                  <Paper
                    variant="outlined"
                    sx={{
                      borderRadius: "20px",
                      bgcolor: "#fff",
                      border: "1px solid #e0e6ed",
                      overflow: "hidden",
                      mb: 1.5,
                      boxShadow: "0 4px 20px rgba(0,0,0,0.05)",
                    }}
                  >
                    <Stack
                      direction="row"
                      justifyContent="space-between"
                      alignItems="center"
                      sx={{
                        p: 2,
                        borderBottom: "1px solid #f0f0f0",
                        bgcolor: "rgba(25, 118, 210, 0.02)",
                      }}
                    >
                      <Stack direction="row" spacing={1} alignItems="center">
                        <Typography
                          variant="caption"
                          sx={{
                            fontWeight: 800,
                            color: "primary.main",
                            letterSpacing: 1,
                          }}
                        >
                          SELECTED CURRENCIES
                        </Typography>
                        <CustomChip
                          label={filters.currencies.length}
                          color="primary"
                          sx={{ height: 20 }}
                        />
                      </Stack>
                      <Button
                        size="small"
                        color="error"
                        variant="text"
                        startIcon={<DeleteSweepIcon />}
                        onClick={() => {
                          onFilterChange("currencies", ["All Currencies"]);
                          setViewList(null);
                        }}
                        sx={{
                          p: 1,
                          fontWeight: 700,
                          "&:hover": { color: "white", background: "#9f0400" },
                        }}
                      >
                        Clear All
                      </Button>
                    </Stack>
                    <Box
                      sx={{
                        p: 2,
                        maxHeight: "250px",
                        overflowY: "auto",
                        display: "flex",
                        flexWrap: "wrap",
                        gap: 1,
                        "&::-webkit-scrollbar": { width: "6px" },
                        "&::-webkit-scrollbar-track": { background: "#f1f1f1" },
                        "&::-webkit-scrollbar-thumb": {
                          background: "#ccc",
                          borderRadius: "10px",
                        },
                      }}
                    >
                      {filters.currencies.map((b) => (
                        <Chip
                          key={b}
                          label={b}
                          color="primary"
                          variant="outlined"
                          onDelete={() => removeCurrency(b)}
                          sx={{
                            borderRadius: "8px",
                            bgcolor: "white",
                            fontWeight: 500,
                            "& .MuiChip-deleteIcon": {
                              color: "error.main",
                              transition: "0.2s",
                              "&:hover": {
                                color: "#d32f2f",
                                transform: "scale(1.2)",
                              },
                            },
                            "&:hover": {
                              bgcolor: "#f5f9ff",
                              borderColor: "primary.main",
                            },
                          }}
                        />
                      ))}
                    </Box>
                  </Paper>
                </Collapse>
              </Grid>
            )}

            {/* 3. TIMELINE & FLAGS ZONE */}
            <Grid
              size={{ xs: 12 }}
              sx={{ display: "flex", justifyContent: "center" }}
            >
              {/* UPDATED TIMELINE CONTAINER: Removed fixed 50% width so it adapts to mobile */}
              <Paper
                sx={{
                  p: 2.5,
                  width: { xs: "100%", md: "fit-content" },
                  borderRadius: "20px",
                  background: "#58469ff3",
                  color: "white",
                  display: "inline-block",
                  boxSizing: "border-box",
                }}
              >
                <Stack
                  direction={{ xs: "column", sm: "row" }}
                  spacing={{ xs: 2, sm: 4 }}
                  alignItems={{ xs: "flex-start", sm: "center" }}
                  sx={{ width: "100%" }}
                >
                  <Stack
                    direction="row"
                    spacing={2}
                    alignItems="center"
                    sx={{ minWidth: 100 }}
                  >
                    <DateRangeIcon />
                    <Typography sx={{ fontWeight: 700 }}>
                      Balance Date *
                    </Typography>
                  </Stack>
                  {/* UPDATED DATE PICKER CONTAINER: Swapped static width for responsive breakpoints */}
                  <Box sx={{ width: { xs: "100%", sm: 300, md: 400 } }}>
                    <DatePicker
                      value={filters.balanceDate}
                      format="DD/MM/YYYY"
                      minDate={minLimit}
                      maxDate={maxLimit}
                      views={["year", "month", "day"]}
                      onChange={(value) => {
                        onFilterChange("balanceDate", value);
                      }}
                      onError={(error) => {
                        setBalanceDateError(error || null);
                      }}
                      slotProps={{
                        textField: {
                          size: "small",
                          fullWidth: true,
                          placeholder: "DD/MM/YYYY",
                          error: !!balanceDateError,
                          sx: {
                            bgcolor: "white",
                            borderRadius: 1,
                            flex: 1,
                            required: true,
                          },
                        },
                        day: {
                          sx: {
                            fontWeight: 600,
                            "&.MuiPickersDay-root": { color: "#111" },
                            "&.MuiPickersDay-today": {
                              border: "2px solid #58469f",
                              fontWeight: 800,
                            },
                            "&.Mui-selected": {
                              backgroundColor: "#58469f !important",
                              color: "#fff !important",
                              fontWeight: 800,
                            },
                            "&:hover": {
                              backgroundColor: "rgba(88,70,159,0.08)",
                            },
                            "&.Mui-disabled": {
                              color: "rgba(0,0,0,0.25) !important",
                              backgroundColor: "rgba(0,0,0,0.04)",
                              opacity: 0.45,
                              textDecoration: "line-through",
                            },
                          },
                        },
                        monthButton: {
                          sx: {
                            fontWeight: 700,
                            "&.Mui-selected": {
                              backgroundColor: "#58469f !important",
                              color: "#fff !important",
                            },
                            "&.Mui-disabled": {
                              color: "rgba(0,0,0,0.25) !important",
                              opacity: 0.45,
                              textDecoration: "line-through",
                              backgroundColor: "rgba(0,0,0,0.04)",
                            },
                          },
                        },
                        yearButton: {
                          sx: {
                            fontWeight: 700,
                            "&.Mui-selected": {
                              backgroundColor: "#58469f !important",
                              color: "#fff !important",
                            },
                            "&.Mui-disabled": {
                              color: "rgba(0,0,0,0.25) !important",
                              opacity: 0.45,
                              textDecoration: "line-through",
                              backgroundColor: "rgba(0,0,0,0.04)",
                            },
                          },
                        },
                      }}
                    />
                  </Box>
                </Stack>
              </Paper>
            </Grid>
          </Grid>

          <Grid size={{ xs: 12 }}>
            {validationMessages.length > 0 && (
              <Paper
                sx={{
                  mt: 1,
                  p: 1.5,
                  borderRadius: 2,
                  border: "1px solid",
                  borderColor: "#ff4d4f",
                  bgcolor: "#fff1f0",
                }}
              >
                <Stack spacing={0.5}>
                  {validationMessages.map((msg, index) => (
                    <Typography
                      key={index}
                      variant="body2"
                      sx={{ color: "#d32f2f", fontWeight: 600 }}
                    >
                      • {msg}
                    </Typography>
                  ))}
                </Stack>
              </Paper>
            )}
          </Grid>

          {/* UPDATED ACTION BUTTONS: Flex adjustments so buttons span full width on tiny screens */}
          <Box
            sx={{
              mt: 3,
              position: "sticky",
              bottom: 12,
              zIndex: 20,
              display: "flex",
              flexDirection: { xs: "column-reverse", sm: "row" },
              justifyContent: "flex-end",
              gap: 2,
            }}
          >
            <Button
              variant="outlined"
              startIcon={<RestartAltIcon />}
              onClick={onReset}
              sx={{
                borderRadius: 2,
                textTransform: "none",
                fontWeight: 700,
                width: { xs: "100%", sm: "auto" },
              }}
            >
              Reset
            </Button>
            <Button
              variant="contained"
              startIcon={<SearchIcon />}
              onClick={onFetch}
              disabled={
                filters.cgl.length === 0 ||
                !filters.balanceDate ||
                balanceDateError
              }
              loading={fetchLoading}
              sx={{
                borderRadius: 2,
                px: { xs: 2, sm: 4 },
                textTransform: "none",
                fontWeight: 800,
                width: { xs: "100%", sm: "auto" },
              }}
            >
              Search
            </Button>
          </Box>
        </CardContent>
      </Card>
    </Box>
  );
};

export default BalanceLedgerForm;

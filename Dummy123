            ) : (
              <CheckCircleRoundedIcon sx={{ fontSize: 15, color: SLATE }} />
            )}
            <Typography
              sx={{
                fontFamily: mono,
                fontSize: 13.5,
                fontWeight: 700,
                fontVariantNumeric: "tabular-nums",
                color: !isMismatch ? SLATE : diff < 0 ? NEGATIVE : POSITIVE,
              }}
            >
              {diff === 0 ? "0.00" : `${diff > 0 ? "+" : ""}${fmt(diff)}`}
            </Typography>
          </Stack>
        );
      },
    },
    {

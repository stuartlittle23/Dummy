
import React from "react";
import { Box, Paper, Typography, IconButton, Tooltip, Divider } from "@mui/material";
import AnalyticsIcon from "@mui/icons-material/Analytics";
import TuneIcon from "@mui/icons-material/Tune";
import FilterAltOffIcon from "@mui/icons-material/FilterAltOff"; 
import AssignmentIcon from "@mui/icons-material/Assignment";
import AccountBalanceIcon from "@mui/icons-material/AccountBalance";
import LayersIcon from "@mui/icons-material/Layers";
import CalendarMonthIcon from "@mui/icons-material/CalendarMonth";
import dayjs from "dayjs";

export default function ReportAnalysisHeader({
  activeReport,
  onOpenFilter,
  onClearFilters, 
  filtersApplied,
  appliedFilters, 
}) {
  
  // Extract and sanitize filter display values
  const reportDisplay = 
    activeReport?.displayName || 
    appliedFilters?.reportName || 
    appliedFilters?.reportCode || 
    "YSA Report";

  const headDisplay = 
    appliedFilters?.headCode || 
    appliedFilters?.head || 
    appliedFilters?.searchHeadCode || 
    "None Selected";

  const scopeDisplay = 
    appliedFilters?.scope || 
    appliedFilters?.selectedViewCode || 
    appliedFilters?.viewCode || 
    "None Selected";

  const dateValue = 
    appliedFilters?.reportDate || 
    appliedFilters?.date;

  // Render values smoothly whether objects or raw strings
  const cleanReport = typeof reportDisplay === "object" ? reportDisplay?.displayName : reportDisplay;
  const cleanHead = typeof headDisplay === "object" ? `${headDisplay.headCode || ""} - ${headDisplay.headName || ""}` : headDisplay;
  const cleanScope = typeof scopeDisplay === "object" ? scopeDisplay?.displayName || scopeDisplay?.viewCode : scopeDisplay;
  const cleanDate = dateValue ? (dayjs(dateValue).isValid() ? dayjs(dateValue).format("DD MMM YYYY") : dateValue) : "Not Set";

  // Configuration array for flexible, equal-width filtering items
  const filterItems = [
    {
      label: "Report Type",
      value: cleanReport,
      icon: <AssignmentIcon sx={{ color: "#475569", fontSize: 17 }} />
    },
    {
      label: "Account Head",
      value: cleanHead,
      icon: <AccountBalanceIcon sx={{ color: "#475569", fontSize: 17 }} />
    },
    {
      label: "Scope View",
      value: cleanScope,
      icon: <LayersIcon sx={{ color: "#475569", fontSize: 17 }} />
    },
    {
      label: "Reporting Date",
      value: cleanDate,
      icon: <CalendarMonthIcon sx={{ color: "#475569", fontSize: 17 }} />
    }
  ];

  // UI Card Styles - Flexible Equal Distributions
  const premiumCardStyle = {
    display: "flex", 
    alignItems: "center", 
    gap: 1.5, 
    p: "12px 18px", 
    borderRadius: "14px",
    background: "rgba(255, 255, 255, 0.45)", 
    backdropFilter: "blur(8px)", 
    border: "1px solid rgba(255, 255, 255, 0.6)", 
    boxShadow: "0 4px 14px rgba(0,0,0,0.03)",
    flex: "1 1 0px", 
    minWidth: "150px", 
    maxWidth: "300px", 
    overflow: "hidden"
  };

  const miniIconWrapper = {
    display: "flex", 
    alignItems: "center", 
    justifyContent: "center", 
    bgcolor: "rgba(255, 255, 255, 0.5)", 
    p: 1.1, 
    borderRadius: "10px",
    flexShrink: 0
  };

  const topLabelStyle = { 
    display: "block", 
    textTransform: "uppercase", 
    fontSize: "10px", 
    fontWeight: 700, 
    color: "#475569", 
    letterSpacing: "0.5px", 
    lineHeight: 1 
  };

  const bottomValueStyle = { 
    fontWeight: 600, 
    color: "#0f172a", 
    fontSize: "13.5px", 
    mt: 0.4 
  };

  return (
    <Paper
      elevation={0}
      sx={{
        p: "16px 24px", 
        borderRadius: 0,
        bgcolor: "transparent", 
        display: "flex",
        justifyContent: "space-between",
        flexDirection: "row",
        flexShrink: 0,
        alignItems: "center",
        gap: 3,
      }}
    >
      {/* Left Module: Identity */}
      <Box display="flex" alignItems="center" gap={1.5} sx={{ pl: 0.5 }}>
        <Box
          sx={{
            background: "linear-gradient(135deg, #4f46e5 0%, #3730a3 100%)",
            borderRadius: "12px", 
            width: 44,
            height: 44,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            boxShadow: "0 4px 12px rgba(79, 70, 229, 0.2)",
          }}
        >
          <AnalyticsIcon sx={{ color: "#fff", fontSize: 22 }} />
        </Box>
        <Box sx={{ overflow: "hidden" }}>
          <Typography variant="subtitle1" sx={{ fontWeight: 700, color: "text.primary", letterSpacing: "-0.3px", lineHeight: 1.1 }}>
            {cleanReport}
          </Typography>
          <Typography variant="caption" sx={{ color: "text.secondary", fontWeight: 500, display: "block", mt: 0.1, fontSize: "11px" }}>
            Matrix Live Analytics
          </Typography>
        </Box>
      </Box>

      {/* Center Module & Dividers: Rendered together ONLY when filters exist */}
      {filtersApplied && (
        <>
          {/* Solid Black Divider after Identity Module */}
          <Divider orientation="vertical" flexItem sx={{ mx: 0.5, my: 0.5, borderColor: "#000000", opacity: 1 }} />

          <Box
            display="flex"
            alignItems="center"
            justifyContent="center" 
            gap={2.5} 
            sx={{
              flexGrow: 1,
              px: 1,
              overflowX: "auto",
              scrollbarWidth: "none",
              "&::-webkit-scrollbar": { display: "none" },
            }}
          >
            {filterItems.map((item, index) => (
              <Box key={index} sx={premiumCardStyle}>
                <Box sx={miniIconWrapper}>
                  {item.icon}
                </Box>
                <Box sx={{ overflow: "hidden", flexGrow: 1, minWidth: 0 }}>
                  <Typography variant="caption" sx={topLabelStyle}>{item.label}</Typography>
                  <Typography variant="body2" noWrap sx={bottomValueStyle}>
                    {item.value}
                  </Typography>
                </Box>
              </Box>
            ))}
          </Box>

          {/* Solid Black Divider before action area */}
          <Divider orientation="vertical" flexItem sx={{ mx: 0.5, my: 0.5, borderColor: "#000000", opacity: 1 }} />
        </>
      )}

      {/* Right Module: Actions Area */}
      <Box display="flex" alignItems="center" gap={1.5} sx={{ pr: 0.5 }}>
        
        {/* Clear Active Filters Button */}
        {filtersApplied && (
          <Tooltip title="Clear Active Filters" arrow placement="bottom">
            <IconButton
              onClick={onClearFilters}
              size="small"
              sx={{
                p: 1.3,
                borderRadius: "12px",
                border: "1px solid #fee2e2",
                bgcolor: "#fff5f5",
                color: "#ef4444",
                boxShadow: "0 1px 2px rgba(239, 68, 68, 0.05)",
                transition: "all 0.2s ease",
                "&:hover": {
                  bgcolor: "#ef4444",
                  color: "#ffffff",
                  borderColor: "#ef4444",
                },
              }}
            >
              <FilterAltOffIcon sx={{ fontSize: 19 }} />
            </IconButton>
          </Tooltip>
        )}

        {/* Modify Report Criteria Button */}
        <Tooltip title="Modify Report Criteria" arrow placement="bottom">
          <IconButton
            onClick={onOpenFilter}
            size="small"
            sx={{
              p: 1.3,
              borderRadius: "12px",
              border: "1px solid rgba(255, 255, 255, 0.6)",
              bgcolor: "rgba(255, 255, 255, 0.45)",
              backdropFilter: "blur(8px)",
              color: "#475569",
              boxShadow: "0 2px 6px rgba(0,0,0,0.03)",
              transition: "all 0.2s ease",
              "&:hover": {
                bgcolor: "rgba(255, 255, 255, 0.75)",
                borderColor: "#4f46e5",
                color: "#4f46e5",
              },
            }}
          >
            <TuneIcon sx={{ fontSize: 19 }} />
          </IconButton>
        </Tooltip>
      </Box>
    </Paper>
  );
}

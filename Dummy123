import React from "react";
import { Box, Paper, Typography, IconButton, Tooltip } from "@mui/material";
import AnalyticsIcon from "@mui/icons-material/Analytics";
import TuneIcon from "@mui/icons-material/Tune";
import FilterAltOffIcon from "@mui/icons-material/FilterAltOff"; 
import AssignmentIcon from "@mui/icons-material/Assignment";
import AccountBalanceIcon from "@mui/icons-material/AccountBalance";
import LayersIcon from "@mui/icons-material/Layers";
import CalendarMonthIcon from "@mui/icons-material/CalendarMonth";
import dayjs from "dayjs";

export default function ReportAnalysisHeader({
  activeReport,
  onOpenFilter,
  onClearFilters, 
  filtersApplied,
  appliedFilters, 
}) {
  
  // Extract and sanitize filter display values
  const reportDisplay = 
    activeReport?.displayName || 
    appliedFilters?.reportName || 
    appliedFilters?.reportCode || 
    "YSA Report";

  const headDisplay = 
    appliedFilters?.headCode || 
    appliedFilters?.head || 
    appliedFilters?.searchHeadCode || 
    "None Selected";

  const scopeDisplay = 
    appliedFilters?.scope || 
    appliedFilters?.selectedViewCode || 
    appliedFilters?.viewCode || 
    "None Selected";

  const dateValue = 
    appliedFilters?.reportDate || 
    appliedFilters?.date;

  // Render values smoothly whether objects or raw strings
  const cleanReport = typeof reportDisplay === "object" ? reportDisplay?.displayName : reportDisplay;
  const cleanHead = typeof headDisplay === "object" ? `${headDisplay.headCode || ""} - ${headDisplay.headName || ""}` : headDisplay;
  const cleanScope = typeof scopeDisplay === "object" ? scopeDisplay?.displayName || scopeDisplay?.viewCode : scopeDisplay;
  const cleanDate = dateValue ? (dayjs(dateValue).isValid() ? dayjs(dateValue).format("DD MMM YYYY") : dateValue) : "Not Set";

  return (
    <Paper
      elevation={0}
      sx={{
        p: "14px 16px", // Increased side padding to keep elements away from the absolute edges
        borderRadius: 0,
        bgcolor: "transparent", 
        display: "flex",
        justifyContent: "space-between",
        flexDirection: "row",
        flexShrink: 0,
        alignItems: "center",
        gap: 2,
      }}
    >
      {/* Left Module: Identity (Moved slightly right via padding) */}
      <Box display="flex" alignItems="center" gap={1.5} sx={{ pl: 0.5 }}>
        <Box
          sx={{
            background: "linear-gradient(135deg, #4f46e5 0%, #3730a3 100%)",
            borderRadius: "10px", // Smoother corporate radius
            width: 40,
            height: 40,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            boxShadow: "0 2px 8px rgba(79, 70, 229, 0.15)",
          }}
        >
          <AnalyticsIcon sx={{ color: "#fff", fontSize: 20 }} />
        </Box>
        <Box sx={{ overflow: "hidden" }}>
          <Typography variant="subtitle1" sx={{ fontWeight: 700, color: "text.primary", letterSpacing: "-0.3px", lineHeight: 1.1 }}>
            {cleanReport}
          </Typography>
          <Typography variant="caption" sx={{ color: "text.secondary", fontWeight: 500, display: "block", mt: 0.1, fontSize: "11px" }}>
            Matrix Live Analytics
          </Typography>
        </Box>
      </Box>

      {/* ================= CENTERED PREMIUM MINI CHIPS ================= */}
      {filtersApplied && (
        <Box
          display="flex"
          alignItems="center"
          justifyContent="center" // Perfectly centers the filter pills
          gap={1.5}
          sx={{
            flexGrow: 1,
            mx: 4,
            px: 2,
            overflowX: "auto",
            scrollbarWidth: "none",
            "&::-webkit-scrollbar": { display: "none" },
          }}
        >
          {/* Chip 1: Target Report */}
          <Box sx={{
            display: "flex", alignItems: "center", gap: 1, p: "5px 12px", borderRadius: "20px", // Pill design eliminates sharp corners
            background: "rgba(241, 245, 249, 0.8)", border: "1px solid #e2e8f0", maxWidth: 180,
          }}>
            <AssignmentIcon sx={{ color: "#64748b", fontSize: 15 }} />
            <Box sx={{ overflow: "hidden" }}>
              <Typography variant="caption" noWrap sx={{ fontWeight: 600, color: "#334155", fontSize: "11px" }}>
                {cleanReport}
              </Typography>
            </Box>
          </Box>

          {/* Chip 2: Account Head */}
          <Box sx={{
            display: "flex", alignItems: "center", gap: 1, p: "5px 12px", borderRadius: "20px",
            background: "rgba(241, 245, 249, 0.8)", border: "1px solid #e2e8f0", maxWidth: 220,
          }}>
            <AccountBalanceIcon sx={{ color: "#64748b", fontSize: 15 }} />
            <Box sx={{ overflow: "hidden" }}>
              <Typography variant="caption" noWrap sx={{ fontWeight: 600, color: "#334155", fontSize: "11px" }}>
                {cleanHead}
              </Typography>
            </Box>
          </Box>

          {/* Chip 3: Scope */}
          <Box sx={{
            display: "flex", alignItems: "center", gap: 1, p: "5px 12px", borderRadius: "20px",
            background: "rgba(241, 245, 249, 0.8)", border: "1px solid #e2e8f0", maxWidth: 160,
          }}>
            <LayersIcon sx={{ color: "#64748b", fontSize: 15 }} />
            <Box sx={{ overflow: "hidden" }}>
              <Typography variant="caption" noWrap sx={{ fontWeight: 600, color: "#334155", fontSize: "11px" }}>
                {cleanScope}
              </Typography>
            </Box>
          </Box>

          {/* Chip 4: Date */}
          <Box sx={{
            display: "flex", alignItems: "center", gap: 1, p: "5px 12px", borderRadius: "20px",
            background: "rgba(241, 245, 249, 0.8)", border: "1px solid #e2e8f0",
          }}>
            <CalendarMonthIcon sx={{ color: "#64748b", fontSize: 15 }} />
            <Typography variant="caption" sx={{ fontWeight: 600, color: "#334155", fontSize: "11px" }}>
              {cleanDate}
            </Typography>
          </Box>
        </Box>
      )}

      {/* Right Module: Actions Area (Moved slightly left from the absolute edge) */}
      <Box display="flex" alignItems="center" gap={1.2} sx={{ pr: 0.5 }}>
        
        {/* Clear Filters Button */}
        {filtersApplied && (
          <Tooltip title="Clear Active Filters" arrow placement="bottom">
            <IconButton
              onClick={onClearFilters}
              size="small"
              sx={{
                p: 1,
                borderRadius: "10px",
                border: "1px solid #fca5a5",
                bgcolor: "#fef2f2",
                color: "#dc2626",
                transition: "all 0.2s",
                "&:hover": {
                  bgcolor: "#dc2626",
                  color: "#ffffff",
                  boxShadow: "0 4px 12px rgba(220, 38, 38, 0.2)",
                  borderColor: "#dc2626"
                },
              }}
            >
              <FilterAltOffIcon sx={{ fontSize: 18 }} />
            </IconButton>
          </Tooltip>
        )}

        {/* Filter Trigger Button */}
        <Tooltip title="Modify Report Criteria" arrow placement="bottom">
          <IconButton
            onClick={onOpenFilter}
            size="small"
            sx={{
              p: 1,
              borderRadius: "10px",
              border: "1px solid",
              borderColor: "divider",
              bgcolor: "background.paper",
              color: "text.primary",
              boxShadow: "0 1px 3px rgba(0,0,0,0.05)",
              transition: "all 0.2s",
              "&:hover": {
                bgcolor: "action.hover",
                color: "primary.main",
                transform: "translateY(-1px)"
              },
            }}
          >
            <TuneIcon sx={{ fontSize: 18 }} />
          </IconButton>
        </Tooltip>
      </Box>
    </Paper>
  );
}



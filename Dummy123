import React from "react";
import { Box, Paper, Typography, IconButton, Tooltip } from "@mui/material";
import AnalyticsIcon from "@mui/icons-material/Analytics";
import TuneIcon from "@mui/icons-material/Tune";
import FullscreenIcon from "@mui/icons-material/Fullscreen";
import FullscreenExitIcon from "@mui/icons-material/FullscreenExit";
import dayjs from "dayjs";

export default function ReportAnalysisHeader({
  activeReport,
  isFullscreen,
  toggleFullscreen,
  onOpenFilter,
  filtersApplied,
  appliedFilters, // 🟢 Receives the data object from the screen state
}) {
  
  // Safely extract values from the appliedFilters state object
  const reportDisplay = 
    activeReport?.displayName || 
    appliedFilters?.reportName || 
    appliedFilters?.reportCode || 
    "YSA Report";

  const headDisplay = 
    appliedFilters?.headCode || 
    appliedFilters?.head || 
    appliedFilters?.searchHeadCode || 
    "None Selected";

  const scopeDisplay = 
    appliedFilters?.scope || 
    appliedFilters?.selectedViewCode || 
    appliedFilters?.viewCode || 
    "None Selected";

  const dateValue = 
    appliedFilters?.reportDate || 
    appliedFilters?.date;

  return (
    <Paper
      elevation={0}
      sx={{
        p: 3,
        borderRadius: 2,
        boxShadow: "0 5px 10px rgba(0,0,0,0.2)",
        border: 1,
        borderColor: "divider",
        display: "flex",
        justifyContent: "space-between",
        flexDirection: "row",
        flexShrink: 0,
        alignItems: "center",
      }}
    >
      {/* Branding Left Block */}
      <Box display="flex" alignItems="center" gap={2}>
        <Box
          sx={{
            backgroundColor: "primary.main",
            borderRadius: "10px",
            width: 44,
            height: 44,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
          }}
        >
          <AnalyticsIcon sx={{ color: "primary.contrastText", fontSize: 24 }} />
        </Box>
        <Box sx={{ overflow: "hidden" }}>
          <Typography variant="h6" sx={{ fontWeight: 700, color: "text.primary" }}>
            {reportDisplay}
          </Typography>
          <Typography variant="caption" sx={{ color: "text.primary" }}>
            Dynamic Drill-Down Matrix
          </Typography>
        </Box>
      </Box>

      {/* ================= 🟢 THE 4 SUMMARY BLOCKS ================= */}
      {filtersApplied && (
        <Box
          display="flex"
          alignItems="center"
          justifyContent="center"
          gap={1.5}
          sx={{
            flexGrow: 1,
            mx: 3,
            px: 2,
            py: 0.5,
            borderLeft: "2px dashed",
            borderRight: "2px dashed",
            borderColor: "divider",
            overflowX: "auto",
            scrollbarWidth: "none",
            "&::-webkit-scrollbar": { display: "none" },
          }}
        >
          {/* Block 1: Report Selection */}
          <Box sx={{ minWidth: 120, bgcolor: "action.hover", p: "6px 12px", borderRadius: "6px", border: "1px solid", borderColor: "divider" }}>
            <Typography variant="caption" display="block" color="text.secondary" sx={{ fontWeight: 600, fontSize: "10px", textTransform: "uppercase" }}>
              Report
            </Typography>
            <Typography variant="body2" noWrap sx={{ fontWeight: 700, color: "primary.main" }}>
              {typeof reportDisplay === "object" ? reportDisplay?.displayName : reportDisplay}
            </Typography>
          </Box>

          {/* Block 2: Account Head Selection */}
          <Box sx={{ minWidth: 150, maxWidth: 220, bgcolor: "action.hover", p: "6px 12px", borderRadius: "6px", border: "1px solid", borderColor: "divider" }}>
            <Typography variant="caption" display="block" color="text.secondary" sx={{ fontWeight: 600, fontSize: "10px", textTransform: "uppercase" }}>
              Account Head
            </Typography>
            <Typography variant="body2" noWrap sx={{ fontWeight: 700, color: "text.primary" }}>
              {typeof headDisplay === "object" ? `${headDisplay.headCode || ""} - ${headDisplay.headName || ""}` : headDisplay}
            </Typography>
          </Box>

          {/* Block 3: Scope Selection */}
          <Box sx={{ minWidth: 110, bgcolor: "action.hover", p: "6px 12px", borderRadius: "6px", border: "1px solid", borderColor: "divider" }}>
            <Typography variant="caption" display="block" color="text.secondary" sx={{ fontWeight: 600, fontSize: "10px", textTransform: "uppercase" }}>
              Scope Level
            </Typography>
            <Typography variant="body2" noWrap sx={{ fontWeight: 700, color: "text.primary" }}>
              {typeof scopeDisplay === "object" ? scopeDisplay?.displayName || scopeDisplay?.viewCode : scopeDisplay}
            </Typography>
          </Box>

          {/* Block 4: Report Date Selection */}
          <Box sx={{ minWidth: 105, bgcolor: "primary.light", color: "primary.contrastText", p: "6px 12px", borderRadius: "6px", opacity: 0.95 }}>
            <Typography variant="caption" display="block" sx={{ fontWeight: 600, fontSize: "10px", textTransform: "uppercase", opacity: 0.8 }}>
              Report Date
            </Typography>
            <Typography variant="body2" sx={{ fontWeight: 800 }}>
              {dateValue 
                ? (dayjs(dateValue).isValid() ? dayjs(dateValue).format("DD/MM/YYYY") : dateValue) 
                : "Not Set"}
            </Typography>
          </Box>
        </Box>
      )}

      {/* Right Controls Area */}
      <Box display="flex" alignItems="center" gap={1.5}>
        <Tooltip title="Select criteria to generate the report" arrow placement="bottom">
          <IconButton
            onClick={onOpenFilter}
            color="primary"
            size="medium"
            sx={{
              border: "1px solid",
              borderColor: "divider",
              bgcolor: "background.paper",
              boxShadow: 1,
              "&:hover": { bgcolor: "primary.main", color: "primary.contrastText" },
            }}
          >
            <TuneIcon />
          </IconButton>
        </Tooltip>

        {toggleFullscreen && (
          <IconButton onClick={toggleFullscreen} color="inherit" size="medium" sx={{ border: "1px solid", borderColor: "divider" }}>
            {isFullscreen ? <FullscreenExitIcon /> : <FullscreenIcon />}
          </IconButton>
        )}
      </Box>
    </Paper>
  );
}

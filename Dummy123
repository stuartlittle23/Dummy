<Stack
                  direction={{ xs: "column", md: "row" }}
                  spacing={3}
                  alignItems="center"
                >
                  <Stack
                    direction="row"
                    spacing={1}
                    alignItems="center"
                    sx={{ minWidth: 100 }}
                  >
                    <DateRangeIcon />
                    <Typography sx={{ fontWeight: 700 }}>
                      From Date *
                    </Typography>
                  </Stack>

                  <DatePicker
                    value={filters.fromDate}
                    format="DD/MM/YYYY"
                    minDate={minLimit}
                    maxDate={filters.toDate || maxLimit}
                    views={["year", "month", "day"]}
                    onChange={(value) => {
                      onFilterChange("fromDate", value);

                      if (
                        value &&
                        filters.toDate &&
                        value.isValid() &&
                        filters.toDate.isValid()
                      ) {
                        if (value.isAfter(filters.toDate, "day")) {
                          setFromDateError("fromGreaterThanTo");
                          setToDateError("toLessThanFrom");
                        } else {
                          setFromDateError(null);
                          setToDateError(null);
                        }
                      } else {
                        setFromDateError(null);
                      }
                    }}
                    onError={(error) => {
                      if (error) {
                        setFromDateError(error);
                      } else if (
                        filters.fromDate &&
                        filters.toDate &&
                        filters.fromDate.isAfter(filters.toDate, "day")
                      ) {
                        setFromDateError("fromGreaterThanTo");
                      } else {
                        setFromDateError(null);
                      }
                    }}
                    slotProps={{
                      textField: {
                        size: "small",
                        fullWidth: true,
                        placeholder: "DD/MM/YYYY",
                        error: !!fromDateError,
                        sx: {
                          bgcolor: "white",
                          borderRadius: 1,
                          flex: 1,
                        },
                      },

                      day: {
                        sx: {
                          fontWeight: 600,
                          "&.MuiPickersDay-root": {
                            color: "#111",
                          },
                          "&.MuiPickersDay-today": {
                            border: "2px solid #58469f",
                            fontWeight: 800,
                          },
                          "&.Mui-selected": {
                            backgroundColor: "#58469f !important",
                            color: "#fff !important",
                            fontWeight: 800,
                          },
                          "&:hover": {
                            backgroundColor: "rgba(88,70,159,0.08)",
                          },
                          "&.Mui-disabled": {
                            color: "rgba(0,0,0,0.25) !important",
                            backgroundColor: "rgba(0,0,0,0.04)",
                            opacity: 0.45,
                            textDecoration: "line-through",
                          },
                        },
                      },

                      monthButton: {
                        sx: {
                          fontWeight: 700,
                          "&.Mui-selected": {
                            backgroundColor: "#58469f !important",
                            color: "#fff !important",
                          },
                          "&.Mui-disabled": {
                            color: "rgba(0,0,0,0.25) !important",
                            opacity: 0.45,
                            textDecoration: "line-through",
                            backgroundColor: "rgba(0,0,0,0.04)",
                          },
                        },
                      },

                      yearButton: {
                        sx: {
                          fontWeight: 700,
                          "&.Mui-selected": {
                            backgroundColor: "#58469f !important",
                            color: "#fff !important",
                          },
                          "&.Mui-disabled": {
                            color: "rgba(0,0,0,0.25) !important",
                            opacity: 0.45,
                            textDecoration: "line-through",
                            backgroundColor: "rgba(0,0,0,0.04)",
                          },
                        },
                      },
                    }}
                  />

                  <Stack
                    direction="row"
                    spacing={1}
                    alignItems="center"
                    sx={{ minWidth: 100 }}
                  >
                    <DateRangeIcon />
                    <Typography sx={{ fontWeight: 700 }}>To Date *</Typography>
                  </Stack>

                  <DatePicker
                    value={filters.toDate}
                    format="DD/MM/YYYY"
                    minDate={filters?.fromDate || minLimit}
                    maxDate={maxLimit}
                    views={["year", "month", "day"]}
                    onChange={(value) => {
                      onFilterChange("toDate", value);

                      if (
                        filters.fromDate &&
                        value &&
                        filters.fromDate.isValid() &&
                        value.isValid()
                      ) {
                        if (value.isBefore(filters.fromDate, "day")) {
                          setToDateError("toLessThanFrom");
                          setFromDateError("fromGreaterThanTo");
                        } else {
                          setToDateError(null);
                          setFromDateError(null);
                        }
                      } else {
                        setToDateError(null);
                      }
                    }}
                    onError={(error) => {
                      if (error) {
                        setToDateError(error);
                      } else if (
                        filters.fromDate &&
                        filters.toDate &&
                        filters.toDate.isBefore(filters.fromDate, "day")
                      ) {
                        setToDateError("toLessThanFrom");
                      } else {
                        setToDateError(null);
                      }
                    }}
                    slotProps={{
                      textField: {
                        size: "small",
                        fullWidth: true,
                        placeholder: "DD/MM/YYYY",
                        error: !!toDateError,

                        sx: {
                          bgcolor: "white",
                          borderRadius: 1,
                          flex: 1,
                          required: true,
                        },
                      },

                      day: {
                        sx: {
                          fontWeight: 600,
                          "&.MuiPickersDay-root": {
                            color: "#111",
                          },
                          "&.MuiPickersDay-today": {
                            border: "2px solid #58469f",
                            fontWeight: 800,
                          },
                          "&.Mui-selected": {
                            backgroundColor: "#58469f !important",
                            color: "#fff !important",
                            fontWeight: 800,
                          },
                          "&:hover": {
                            backgroundColor: "rgba(88,70,159,0.08)",
                          },
                          "&.Mui-disabled": {
                            color: "rgba(0,0,0,0.25) !important",
                            backgroundColor: "rgba(0,0,0,0.04)",
                            opacity: 0.45,
                            textDecoration: "line-through",
                          },
                        },
                      },

                      monthButton: {
                        sx: {
                          fontWeight: 700,
                          "&.Mui-selected": {
                            backgroundColor: "#58469f !important",
                            color: "#fff !important",
                          },
                          "&.Mui-disabled": {
                            color: "rgba(0,0,0,0.25) !important",
                            opacity: 0.45,
                            textDecoration: "line-through",
                            backgroundColor: "rgba(0,0,0,0.04)",
                          },
                        },
                      },

                      yearButton: {
                        sx: {
                          fontWeight: 700,
                          "&.Mui-selected": {
                            backgroundColor: "#58469f !important",
                            color: "#fff !important",
                          },
                          "&.Mui-disabled": {
                            color: "rgba(0,0,0,0.25) !important",
                            opacity: 0.45,
                            textDecoration: "line-through",
                            backgroundColor: "rgba(0,0,0,0.04)",
                          },
                        },
                      },
                    }}
                  />                 
                </Stack>
              </Paper>
            </Grid>
          </Grid>

          <Grid size={{ xs: 12 }}>
            {validationMessages.length > 0 && (
              <Paper
                // elevation={0}
                sx={{
                  mt: 1,
                  p: 1.5,
                  borderRadius: 2,
                  border: "1px solid",
                  borderColor: "#ff4d4f",
                  bgcolor: "#fff1f0",
                }}
              >
                <Stack spacing={0.5}>
                  {validationMessages.map((msg, index) => (
                    <Typography
                      key={index}
                      variant="body2"
                      sx={{
                        color: "#d32f2f",
                        fontWeight: 600,
                      }}
                    >
                      • {msg}
                    </Typography>
                  ))}
                </Stack>
              </Paper>
            )}
          </Grid>

          <Box
            sx={{
              mt: 2,
              position: "sticky",
              bottom: 12,
              zIndex: 20,
              display: "flex",
              justifyContent: "flex-end",
              gap: 2,
            }}
          >
            <Button
              variant="outlined"
              startIcon={<RestartAltIcon />}
              onClick={onReset}
              sx={{
                borderRadius: 2,
                textTransform: "none",
                fontWeight: 700,
              }}
            >
              Reset
            </Button>
            <Button
              variant="contained"
              startIcon={<SearchIcon />}
              onClick={onFetch}
              disabled={
                !filters.cgl ||
                !filters.fromDate ||
                !filters.toDate ||
                fromDateError ||
                toDateError
              }
              loading={fetchLoading}
              sx={{
                borderRadius: 2,
                px: 4,
                textTransform: "none",
                fontWeight: 800,
              }}
            >
              Search
            </Button>
          </Box>
        </CardContent>
      </Card>
    </Box>
  );
};

export default BalanceLedgerForm;

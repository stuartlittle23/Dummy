
const transactionColumns = useMemo(() => {
  const cols = [
    {
      field: "balanceDate",
      headerName: "Balance Date",
      flex: 0.8,
      minWidth: 150,
      valueFormatter: (v) =>
        v ? dayjs(v).format("DD/MM/YYYY") : "-",
    },

    {
      field: "branchCode",
      headerName: "Branch",
      flex: 1,
      minWidth: 180,

      ...(branchOptions?.length
        ? {
            type: "singleSelect",
            valueOptions: branchOptions,
          }
        : {}),

      renderCell: (params) => (
        <Box sx={{ lineHeight: "1.2", py: 0.5 }}>
          <Typography
            variant="body2"
            sx={{
              fontWeight: 700,
              fontSize: "0.8rem",
            }}
          >
            {params.row.branchCode}
          </Typography>

          <Typography
            variant="caption"
            sx={{
              color: "text.secondary",
              fontSize: "0.7rem",
            }}
          >
            {params.row.branchName}
          </Typography>
        </Box>
      ),
    },

    {
      field: "cgl",
      headerName: "CGL",
      flex: 1,
      minWidth: 160,
    },

    {
      field: "balance",
      headerName: "Balance",
      flex: 1,
      minWidth: 180,
      align: "right",
      headerAlign: "right",

      renderCell: (params) => (
        <Typography
          fontWeight={700}
          color={
            Number(params.value) < 0
              ? "error.main"
              : "success.main"
          }
        >
          {new Intl.NumberFormat("en-IN", {
            minimumFractionDigits: 2,
          }).format(params.value || 0)}
        </Typography>
      ),
    },

    {
      field: "inrBalance",
      headerName: "INR Balance",
      flex: 1,
      minWidth: 180,
      align: "right",
      headerAlign: "right",

      renderCell: (params) => (
        <Typography
          fontWeight={700}
          color={
            Number(params.value) < 0
              ? "error.main"
              : "success.main"
          }
        >
          {new Intl.NumberFormat("en-IN", {
            minimumFractionDigits: 2,
          }).format(params.value || 0)}
        </Typography>
      ),
    },
  ];

  if (selectedCircle === "ALL") {
    cols.splice(1, 0, {
      field: "circleCode",
      headerName: "Circle",
      flex: 1,
      minWidth: 160,
      type: "singleSelect",
      valueOptions: circleOptions,

      renderCell: (params) => (
        <Box sx={{ lineHeight: "1.2", py: 0.5 }}>
          <Typography
            variant="body2"
            sx={{
              fontWeight: 700,
              fontSize: "0.8rem",
            }}
          >
            {params.row.circleCode}
          </Typography>

          <Typography
            variant="caption"
            sx={{
              color: "text.secondary",
              fontSize: "0.7rem",
            }}
          >
            {params.row.circleName}
          </Typography>
        </Box>
      ),
    });
  }

  if (selectedCurrency === "All Currencies") {
    cols.splice(3, 0, {
      field: "currency",
      headerName: "Currency",
      flex: 1,
      minWidth: 150,
      type: "singleSelect",
      valueOptions: currencyOptions,

      renderCell: (params) => (
        <Box sx={{ lineHeight: "1.2", py: 0.5 }}>
          <Typography
            variant="body2"
            sx={{
              fontWeight: 700,
              fontSize: "0.8rem",
            }}
          >
            {params.row.currency}
          </Typography>

          <Typography
            variant="caption"
            sx={{
              color: "text.secondary",
              fontSize: "0.7rem",
            }}
          >
            {params.row.currencyName}
          </Typography>
        </Box>
      ),
    });
  }

  return cols;
}, [
  branchOptions,
  selectedCircle,
  selectedCurrency,
  circleOptions,
  currencyOptions,
]);

import React, { useState, useCallback, useEffect } from "react";
import { TextField, Button, Box, Paper, Typography, IconButton, Grid, Card, CardContent, Dialog, DialogTitle, DialogContent, DialogActions, InputAdornment, Stack, Chip } from "@mui/material";
import { DataGrid } from "@mui/x-data-grid";
import CalendarMonthIcon from "@mui/icons-material/CalendarMonth";
import CloseIcon from "@mui/icons-material/Close";
import SearchIcon from "@mui/icons-material/Search";
import HistoryIcon from "@mui/icons-material/History";
import ManageSearchIcon from "@mui/icons-material/ManageSearch";
import useApi from "../../hooks/useApi";
import useValidation from "./Validation";
import dayjs from "dayjs";
import { LocalizationProvider, DatePicker } from "@mui/x-date-pickers";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";

const BalanceParticularSearchScreen = () => {
  const { callApi } = useApi();
  const { validateBranchCode, validateCurrency, validateCGL } = useValidation();

  const [filters, setFilters] = useState({ date: "", branchCode: "", currency: "", cgl: "" });
  const [rows, setRows] = useState([]);
  const [loading, setLoading] = useState(false);
  const [totalElements, setTotalElements] = useState(0);
  const [etlDate, setEtlDate] = useState("");
  const [paginationModel, setPaginationModel] = useState({ page: 0, pageSize: 10 });
  const [openHistory, setOpenHistory] = useState(false);
  const [selectedRow, setSelectedRow] = useState(null);
  const [searched, setSearched] = useState(false);

  const updateFilter = (key, value) => setFilters((prev) => ({ ...prev, [key]: value }));

  const fetchData = useCallback(async (date, pageIndex, pageSize) => {
    if (!date) return;
    setLoading(true);
    try {
      const payload = {
        fromDate: date,
        toDate: date,
        branchCode: filters.branchCode || null,
        currency: filters.currency || null,
        cgl: filters.cgl || null,
      };

      const response = await callApi(`/ES/differences/search?page=${pageIndex}&size=${pageSize}`, payload, "POST");
      const content = response?.data?.content || response?.content || [];

      const mappedRows = content.map((item, index) => ({
        id: item.id || `row-${pageIndex}-${index}`,
        ...item,
        GLCC_VAL: `${item.branchCode || "-"} ${item.currency || "-"} ${item.cgl || "-"}`,
      }));

      setRows(mappedRows);
      setTotalElements(response?.data?.totalElements || response?.totalElements || 0);
    } catch (err) {
      console.error("Search Fail:", err);
      setRows([]);
      setTotalElements(0);
    } finally {
      setLoading(false);
    }
  }, [callApi, filters]);

  useEffect(() => {
    const fetchDefaultETLDate = async () => {
      try {
        const response = await callApi("/PS/file/fincore-date", {}, "GET");
        const date = response?.data?.etlDate || response?.data?.userDate?.split("T")[0] || response?.date || "";
        if (date) {
          setEtlDate(date);
          updateFilter("date", date);
        }
      } catch (err) {
        console.error("ETL Date Error:", err);
      }
    };
    fetchDefaultETLDate();
  }, [callApi]);

  useEffect(() => {
    if (searched && filters.date) {
      fetchData(filters.date, paginationModel.page, paginationModel.pageSize);
    }
  }, [paginationModel.page, paginationModel.pageSize]);

  const handleSearch = () => {
    setSearched(true);
    if (paginationModel.page !== 0) {
      setPaginationModel((prev) => ({ ...prev, page: 0 }));
    } else {
      fetchData(filters.date, 0, paginationModel.pageSize);
    }
  };

  const columns = [
    { field: "reconRunDate", headerName: "Error Date", flex: 0.9, minWidth: 130 },
    {
      field: "GLCC_VAL",
      headerName: "GLCC",
      flex: 1.3,
      minWidth: 180,
      renderCell: (params) => (
        <Box sx={{ lineHeight: 1.2 }}>
          <Typography variant="body2" sx={{ fontWeight: 700, fontSize: "0.8rem" }}>
            {params.row.branchCode || "-"} {params.row.currency || "-"}
          </Typography>
          <Typography variant="caption" sx={{ color: "text.secondary", fontSize: "0.7rem" }}>
            {params.row.cgl || "-"}
          </Typography>
        </Box>
      ),
    },
    {
      field: "cbsBalance",
      headerName: "CBS Balance",
      flex: 1,
      minWidth: 150,
      headerAlign: "right",
      align: "right",
      renderCell: ({ value }) => (
        <Typography sx={{ width: "100%", textAlign: "right", fontWeight: 600, fontFeatureSettings: '"tnum"' }}>
          {Number(value || 0).toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
        </Typography>
      ),
    },
    {
      field: "glBalance",
      headerName: "GL Balance",
      flex: 1,
      minWidth: 150,
      headerAlign: "right",
      align: "right",
      renderCell: ({ value }) => (
        <Typography sx={{ width: "100%", textAlign: "right", fontWeight: 600, fontFeatureSettings: '"tnum"' }}>
          {Number(value || 0).toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
        </Typography>
      ),
    },
    {
      field: "differenceAmount",
      headerName: "Difference",
      flex: 1,
      minWidth: 150,
      headerAlign: "right",
      align: "right",
      renderCell: ({ value }) => {
        const number = Number(value || 0);
        return (
          <Typography sx={{ width: "100%", textAlign: "right", fontWeight: 700, color: number < 0 ? "#d32f2f" : number > 0 ? "#2e7d32" : "text.secondary", fontFeatureSettings: '"tnum"' }}>
            {number.toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
          </Typography>
        );
      },
    },
    {
      field: "action",
      headerName: "History",
      flex: 0.6,
      minWidth: 100,
      sortable: false,
      filterable: false,
      renderCell: (params) => (
        <IconButton color="primary" onClick={() => { setSelectedRow(params.row); setOpenHistory(true); }}>
          <HistoryIcon fontSize="small" />
        </IconButton>
      ),
    },
  ];

  return (
    <Box sx={{ width: "100%", p: { xs: 1, sm: 2 } }}>
      <Paper elevation={0} sx={{ p: { xs: 1.5, sm: 2, md: 2.5 }, mb: 3, bgcolor: "rgba(255,255,255,0.4)", backdropFilter: "blur(6px)", border: "1px solid", borderColor: "divider", borderRadius: 3 }}>
        <Box sx={{ p: { xs: 1.5, sm: 2 }, borderRadius: 2, bgcolor: "background.paper", boxShadow: 2, borderTop: "4px solid", borderColor: "secondary.main", mb: 2 }}>
          <Stack direction={{ xs: "column", sm: "row" }} alignItems={{ xs: "flex-start", sm: "center" }} justifyContent="space-between" spacing={2}>
            <Stack direction="row" spacing={1.5} alignItems="center">
              <Box sx={{ width: 44, height: 44, borderRadius: "12px", display: "flex", alignItems: "center", justifyContent: "center", bgcolor: "rgba(88,70,159,0.1)", color: "primary.main" }}>
                <CalendarMonthIcon sx={{ fontSize: 27 }} />
              </Box>
              <Box>
                <Typography variant="h6" fontWeight={800} sx={{ fontSize: { xs: "1rem", sm: "1.1rem" }, letterSpacing: "-0.3px" }}>
                  Date Wise Balance Search
                </Typography>
                <Typography variant="body2" color="text.secondary" sx={{ mt: 0.3, fontSize: { xs: "0.75rem", sm: "0.82rem" } }}>
                  View balance differences for a specific date and track reconciliation history.
                </Typography>
              </Box>
            </Stack>
            <Chip icon={<ManageSearchIcon />} label="Date Wise Search" size="small" sx={{ fontWeight: 700, color: "#58469f", bgcolor: "rgba(88,70,159,0.08)" }} />
          </Stack>
        </Box>

        <Card sx={{ borderRadius: 2, boxShadow: "0 3px 14px rgba(0,0,0,0.06)", border: "1px solid", borderColor: "divider" }}>
          <CardContent sx={{ p: { xs: 2, sm: 2.5 } }}>
            <Grid container spacing={2} alignItems="flex-start">
              <Grid item xs={12} sm={6} md={3}>
                <LocalizationProvider dateAdapter={AdapterDayjs}>
                  <DatePicker
                    label="ETL Date*"
                    value={etlDate ? dayjs(etlDate) : null}
                    maxDate={dayjs()}
                    onChange={(newValue) => {
                      const value = newValue ? newValue.format("YYYY-MM-DD") : "";
                      setEtlDate(value);
                      updateFilter("date", value);
                    }}
                    slotProps={{ textField: { fullWidth: true, size: "small", placeholder: "DD-MM-YYYY", InputLabelProps: { shrink: true } } }}
                  />
                </LocalizationProvider>
              </Grid>

              <Grid item xs={12} sm={6} md={3}>
                <TextField fullWidth label="Branch Code" size="small" value={filters.branchCode} placeholder="eg. 12345" InputLabelProps={{ shrink: true }} onChange={(e) => updateFilter("branchCode", validateBranchCode(e.target.value))} />
              </Grid>

              <Grid item xs={12} sm={6} md={3}>
                <TextField fullWidth label="Currency" size="small" value={filters.currency} placeholder="eg. INR" InputLabelProps={{ shrink: true }} onChange={(e) => updateFilter("currency", validateCurrency(e.target.value))} />
              </Grid>

              <Grid item xs={12} sm={6} md={3}>
                <TextField fullWidth label="CGL" size="small" value={filters.cgl} placeholder="eg. 9999999999" InputLabelProps={{ shrink: true }} onChange={(e) => updateFilter("cgl", validateCGL(e.target.value))} InputProps={{ startAdornment: <InputAdornment position="start"><SearchIcon fontSize="small" color="action" /></InputAdornment> }} />
              </Grid>

              <Grid item xs={12}>
                <Box sx={{ display: "flex", justifyContent: "flex-end", mt: 0.5 }}>
                  <Button variant="contained" startIcon={<SearchIcon />} disabled={!filters.date || loading} onClick={handleSearch} sx={{ height: 40, minWidth: 140, px: 3.5, borderRadius: "8px", textTransform: "none", fontWeight: 700 }}>
                    {loading ? "Searching..." : "Search"}
                  </Button>
                </Box>
              </Grid>
            </Grid>
          </CardContent>
        </Card>
      </Paper>

      {searched && (
        <Paper elevation={0} sx={{ width: "100%", p: { xs: 1.5, sm: 2 }, borderRadius: 3, bgcolor: "rgba(255,255,255,0.4)", backdropFilter: "blur(10px)", border: "1px solid rgba(255,255,255,0.3)", boxShadow: "0 8px 32px rgba(0,0,0,0.05)" }}>
          <Stack direction={{ xs: "column", sm: "row" }} alignItems={{ xs: "flex-start", sm: "center" }} justifyContent="space-between" spacing={1.5} sx={{ mb: 1.5 }}>
            <Box>
              <Typography variant="h6" fontWeight={800} sx={{ letterSpacing: "-0.4px" }}>
                Date Wise Results
              </Typography>
              <Typography variant="body2" color="text.secondary">
                Balance differences and reconciliation history for the selected date.
              </Typography>
            </Box>
            <Chip label={totalElements > 0 ? `${totalElements.toLocaleString("en-IN")} Records Found` : "No Records"} size="small" sx={{ fontWeight: 700, color: "#58469f", bgcolor: "rgba(88,70,159,0.1)", borderRadius: "8px" }} />
          </Stack>

          <Box sx={{ width: "100%", overflowX: "auto", height: { xs: "55vh", sm: "60vh", md: 470 } }}>
            <DataGrid
              rows={rows}
              columns={columns}
              rowCount={totalElements}
              loading={loading}
              paginationMode="server"
              paginationModel={paginationModel}
              onPaginationModelChange={setPaginationModel}
              pageSizeOptions={[10, 25, 50]}
              disableRowSelectionOnClick
              rowHeight={45}
              sx={{
                borderRadius: "16px",
                backgroundColor: "rgba(255,255,255,0.4)",
                border: "1px solid rgba(255,255,255,0.3)",
                "& .MuiDataGrid-columnHeaders": { bgcolor: "#f8f9fa", fontWeight: 700 },
                "& .MuiDataGrid-row:hover": { backgroundColor: "#f0f4ff" },
                "& .MuiDataGrid-cell": { fontSize: "0.82rem" },
              }}
            />
          </Box>
        </Paper>
      )}

      <Dialog open={openHistory} onClose={() => setOpenHistory(false)} fullWidth maxWidth="md">
        <DialogTitle sx={{ fontWeight: 800 }}>
          Difference Details
          <IconButton onClick={() => setOpenHistory(false)} sx={{ position: "absolute", right: 8, top: 8 }}>
            <CloseIcon />
          </IconButton>
        </DialogTitle>

        <DialogContent dividers>
          {selectedRow && (
            <Grid container spacing={2}>
              <Grid item xs={12} sm={6}><Typography><b>Date:</b> {selectedRow.reconRunDate || "-"}</Typography></Grid>
              <Grid item xs={12} sm={6}><Typography><b>Branch:</b> {selectedRow.branchCode || "-"}</Typography></Grid>
              <Grid item xs={12} sm={6}><Typography><b>Currency:</b> {selectedRow.currency || "-"}</Typography></Grid>
              <Grid item xs={12} sm={6}><Typography><b>CGL:</b> {selectedRow.cgl || "-"}</Typography></Grid>
              <Grid item xs={12} sm={6}><Typography><b>CBS Balance:</b> {selectedRow.cbsBalance ?? "-"}</Typography></Grid>
              <Grid item xs={12} sm={6}><Typography><b>GL Balance:</b> {selectedRow.glBalance ?? "-"}</Typography></Grid>
              <Grid item xs={12}><Typography sx={{ color: selectedRow.differenceAmount < 0 ? "#d32f2f" : "#2e7d32", fontWeight: 800 }}><b>Difference:</b> {selectedRow.differenceAmount ?? "-"}</Typography></Grid>
            </Grid>
          )}
        </DialogContent>

        <DialogActions sx={{ p: 2 }}>
          <Button onClick={() => setOpenHistory(false)} variant="contained" sx={{ textTransform: "none", borderRadius: "8px" }}>
            Close
          </Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
};

export default BalanceParticularSearchScreen;

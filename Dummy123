import React, { useCallback, useEffect, useState } from 'react'
import useApi from '../../hooks/useApi'
import Validation from './Validation';
import useCustomSnackbar from '../../utils/useCustomSnackbar';
import { Autocomplete, Box, Button, FormControl, Grid, InputLabel, MenuItem, Select, TextField } from '@mui/material';
import AddIcon from '@mui/icons-material/Add';
import debounce from 'lodash/debounce';

const filterMap = {
    CURRENCY: { type: "autocomplete", multiValue: true, validate: "validateCurrency" },
    CGL: { type: "autocomplete", multiValue: true, validate: "validateCgl" },
    JOURNAL_NUMBER: { type: "input", multiValue: false, validate: "validateJrnNo" },
    TRANSACTION_CODE: { type: "input", multiValue: true, validate: "validateTxnCode" },
    BATCH_ID: { type: "input", multiValue: false, validate: "validateBatchId" },
    ACCOUNT: { type: "input", multiValue: false, validate: "validateAccNo" }
}

const filterLabels = {
    CURRENCY: "Currency",
    CGL: "CGL",
    JOURNAL_NUMBER: "Journal Number",
    TRANSACTION_CODE: "Transaction Code",
    BATCH_ID: "Batch Id",
    ACCOUNT: "Account",
}

export default function Filter({ handleFilter, getValues }) {
    const [values, setValues] = useState([]);
    const [filterField, setFilterField] = useState('CGL');
    const [isMinInput, setIsMinInput] = useState();
    const [inputInstance, setInputInstance] = useState("");
    const [fieldError, setFieldError] = useState(null);
    const snackbar = useCustomSnackbar();
    const { callApi } = useApi();

    const setFilter = () => {
        if ((filterField === "CURRENCY" || filterField === "CGL") && inputInstance === "") {
            setFieldError("Kindly select a value!");
            snackbar("Kindly select the value!", "error");
            return
        }
        let isValid = Validation[filterMap[filterField].validate](inputInstance);
        if (isValid != null) {
            setFieldError(isValid);
            snackbar(isValid, "error")
            return;
        }
        setFieldError(null);
        handleFilter({ field: filterField, value: inputInstance, multiValue: filterMap[filterField].multiValue })
        setInputInstance("");
    }

    const debouncedFetchCgls = useCallback(debounce(async (value, type, isMinInput) => {
        await fetchCgls(value, type, isMinInput);
    }, 100), []);

    async function fetchCurrencies() {
        const response = await callApi(
            "/CM/common-master/currency",
            null,
            "GET",
        );
        if (response) {
            setValues(response.data || [])
        } else {
            snackbar("Failed to fetch currency list!")
        }
    }

    async function fetchCgls(term, reason, isMinInput) {
        if (reason === "input") {
            if (term?.length < 3) {
                if (isMinInput) {
                    setIsMinInput(false);
                }
                setValues([])
                return;
            }
            if (!isMinInput) {
                setIsMinInput(true);
            }

            try {
                const res = await callApi(`/CM/common-master/cgl-code-description-only?q=${encodeURIComponent(term)}`);
                if (res && res.success) {
                    setValues(res?.data);
                } else {
                    setValues([]);
                    snackbar(res?.message, "error")
                }
            } catch (e) {
                snackbar(e.message, "error")
            }
        }
    }

    const handleSelectChange = (e) => {
        setFilterField(e.target.value);
        setInputInstance("");
        setFieldError(null);
        setValues([]);
    }

    useEffect(() => {
        const fetchData = async () => {
            await fetchCurrencies();
        }
        if (filterField === "CURRENCY") {
            fetchData();
        }
    }, [filterField])

    return (
        <Grid container spacing={1} alignItems="flex-start">
            <Grid item size={{ md: 4 }}>
                <FormControl variant="outlined" fullWidth size="small">
                    <InputLabel>Select Filter</InputLabel>
                    <Select
                        value={filterField || ''}
                        label="Select Filter"
                        onChange={handleSelectChange}
                    >
                        {Object.keys(filterMap).map((key) => (
                            <MenuItem key={key} value={key}>{filterLabels[key]}</MenuItem>
                        ))}
                    </Select>
                </FormControl>
            </Grid>

            <Grid item size={{ md: 5 }}>
                {filterField === "CURRENCY" &&
                    <Autocomplete
                        options={values || []}
                        value={inputInstance}
                        size="small"
                        onInputChange={(event, value, reason) => {
                            setInputInstance('')
                        }}
                        renderInput={(params) => <TextField {...params} label="Currency" error={!!fieldError} helperText={fieldError} />}
                        filterOptions={(options, { inputValue }) => { return options.filter((val) => val.startsWith(inputValue.toUpperCase()) && !getValues("CURRENCY")?.includes(val)) }}
                        onChange={(e, v, r) => {
                            setFieldError(null);
                            if (r === "selectOption") {
                                setInputInstance(v);
                            } else if (r === "clear") {
                                setInputInstance('')
                            }
                        }}
                        noOptionsText={
                            ("No Options")
                        }
                    />
                }
                {filterField === "CGL" &&
                    <Autocomplete
                        options={values.map((each) => each.cglNumber)}
                        value={inputInstance}
                        size="small"
                        onInputChange={(event, value, reason) => {
                            debouncedFetchCgls(value, reason, isMinInput)
                        }}
                        renderInput={(params) => <TextField {...params} label="CGL" error={!!fieldError} helperText={fieldError} />}
                        filterOptions={(options) => { return options.filter((val) => !getValues("CGL")?.includes(val)) }}
                        onChange={(e, v, r) => {
                            setFieldError(null);
                            if (r === "selectOption") {
                                setInputInstance(v);
                                setValues([]);
                            } else if (r === "clear") {
                                setInputInstance('');
                                setValues([]);
                            }
                        }}
                        noOptionsText={
                            (!isMinInput) ? "Please enter at least 3 characters" : "No Options"
                        }
                    />
                }
                {filterField === "JOURNAL_NUMBER" &&
                    <TextField
                        id="outlined-controlled"
                        label="Journal Number"
                        size="small"
                        fullWidth
                        error={!!fieldError}
                        helperText={fieldError}
                        slotProps={{ htmlInput: { maxLength: 10 } }}
                        value={inputInstance}
                        onChange={(e) => {
                            setFieldError(null);
                            setInputInstance(e.target.value)
                        }}
                    />
                }
                {filterField === "TRANSACTION_CODE" &&
                    <TextField
                        id="outlined-controlled"
                        label="Transaction Code"
                        size="small"
                        fullWidth
                        error={!!fieldError}
                        helperText={fieldError}
                        slotProps={{ htmlInput: { maxLength: 5 } }}
                        value={inputInstance}
                        onChange={(e) => {
                            setFieldError(null);
                            setInputInstance(e.target.value)
                        }}
                    />
                }
                {filterField === "BATCH_ID" &&
                    <TextField
                        id="outlined-controlled"
                        label="Batch Id"
                        size="small"
                        fullWidth
                        error={!!fieldError}
                        helperText={fieldError}
                        slotProps={{ htmlInput: { maxLength: 10 } }}
                        value={inputInstance}
                        onChange={(e) => {
                            setFieldError(null);
                            setInputInstance(e.target.value)
                        }}
                    />
                }
                {filterField === "ACCOUNT" &&
                    <TextField
                        id="outlined-controlled"
                        label="Account"
                        size="small"
                        fullWidth
                        error={!!fieldError}
                        helperText={fieldError}
                        slotProps={{ htmlInput: { maxLength: 10 } }}
                        value={inputInstance}
                        onChange={(e) => {
                            setFieldError(null);
                            setInputInstance(e.target.value)
                        }}
                    />
                }
            </Grid>

            <Grid item size={{ md: 3 }}>
                <Button
                    fullWidth
                    variant="contained"
                    startIcon={<AddIcon />}
                    onClick={setFilter}
                    sx={{
                        textTransform: 'none', borderRadius: '8px', fontWeight: 600, height: '40px',
                        boxShadow: '0 2px 8px rgba(108, 92, 231, 0.25)'
                    }}
                >
                    Add Filter
                </Button>
            </Grid>
        </Grid>
    )
}

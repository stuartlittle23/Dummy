import React, { useCallback, useEffect, useState } from "react";
import { Autocomplete, Box, Card, CardContent, Chip, IconButton, Stack, TextField, Typography, Dialog, DialogTitle, DialogContent, DialogActions, Button } from "@mui/material";
import { DataGrid } from "@mui/x-data-grid";
import CalendarMonthOutlinedIcon from "@mui/icons-material/CalendarMonthOutlined";
import SearchIcon from "@mui/icons-material/Search";
import RestartAltIcon from "@mui/icons-material/RestartAlt";
import ManageSearchOutlinedIcon from "@mui/icons-material/ManageSearchOutlined";
import HistoryIcon from "@mui/icons-material/History";
import CloseIcon from "@mui/icons-material/Close";
import { DatePicker, LocalizationProvider } from "@mui/x-date-pickers";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";
import dayjs from "dayjs";
import { useSelector } from "react-redux";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import { getPermissions } from "../../utils/CommonUtilities";
import { StyledButton } from "./Components/BalanceDifferenceStyles";

export default function BalanceParticularSearchScreen() {
  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();
  const user = useSelector((state) => state.auth.user);
  const selectedMenu = useSelector((state) => state.menus.selectedMenuItem);
  const permissions = getPermissions(selectedMenu);

  const [filters, setFilters] = useState({ date: "", branchCode: "", currency: "", cgl: "" });
  const [branches, setBranches] = useState([]);
  const [currencies, setCurrencies] = useState([]);
  const [cgls, setCgls] = useState([]);
  const [branchInput, setBranchInput] = useState("");
  const [currencyInput, setCurrencyInput] = useState("");
  const [cglInput, setCglInput] = useState("");
  const [etlDate, setEtlDate] = useState(null);
  const [rows, setRows] = useState([]);
  const [totalElements, setTotalElements] = useState(0);
  const [filtersExpanded, setFiltersExpanded] = useState(true);
  const [loading, setLoading] = useState({ branch: false, currency: false, cgl: false, search: false });
  const [paginationModel, setPaginationModel] = useState({ page: 0, pageSize: 25 });
  const [openHistory, setOpenHistory] = useState(false);
  const [selectedRow, setSelectedRow] = useState(null);

  const updateFilter = (key, value) => setFilters((prev) => ({ ...prev, [key]: value }));

  const fetchCurrencies = useCallback(async () => {
    setLoading((prev) => ({ ...prev, currency: true }));
    try {
      const result = await callApi("/CM/common-master/currency-code-name-only", null, "GET");
      const sorted = (result?.data || []).sort((a, b) => {
        if (a.currencyCode === "INR") return -1;
        if (b.currencyCode === "INR") return 1;
        return a.currencyName.localeCompare(b.currencyName);
      });
      setCurrencies(sorted);
    } catch {
      showSnackBar("Currency data not available", "error");
    } finally {
      setLoading((prev) => ({ ...prev, currency: false }));
    }
  }, [callApi, showSnackBar]);

  const fetchSearchData = useCallback(async (type, term) => {
    if (!term || term.length < 3) return;
    setLoading((prev) => ({ ...prev, [type]: true }));
    try {
      let circleValue = "";
      if (permissions?.wholebank === true) circleValue = "null";
      else if (user?.isCircle === true || permissions?.circle) circleValue = user?.circleCode;

      const url = type === "branch"
        ? `/CM/common-master/branches-code-name-only?q=${encodeURIComponent(term)}&circleCode=${circleValue || ""}`
        : `/CM/common-master/cgl-code-description-only?q=${encodeURIComponent(term)}`;

      const result = await callApi(url, null, "GET");

      if (type === "branch") setBranches((result?.data || []).map((i) => `${i.code}-${i.name}`));
      else setCgls((result?.data || []).map((i) => `${i.cglNumber} - ${i.description}`));
    } catch {
      if (type === "branch") setBranches([]);
      if (type === "cgl") setCgls([]);
    } finally {
      setLoading((prev) => ({ ...prev, [type]: false }));
    }
  }, [callApi, permissions, user]);

  const fetchData = useCallback(async (date, page, size) => {
    if (!date) return;
    setLoading((prev) => ({ ...prev, search: true }));
    try {
      const payload = {
        fromDate: date,
        toDate: date,
        branchCode: filters.branchCode?.split("-")[0] || null,
        currency: filters.currency || null,
        cgl: filters.cgl?.split(" - ")[0] || null,
      };

      const response = await callApi(`/ES/differences/search?page=${page}&size=${size}`, payload, "POST");
      const content = response?.data?.content || response?.content || [];

      setRows(content.map((item, index) => ({
        id: item.id || `row-${page}-${index}`,
        ...item,
        GLCC_VAL: `${item.branchCode || ""} ${item.currency || ""} ${item.cgl || ""}`,
      })));

      setTotalElements(response?.data?.totalElements || response?.totalElements || 0);
      setFiltersExpanded(false);
    } catch {
      setRows([]);
      setTotalElements(0);
      showSnackBar("No records found", "error");
    } finally {
      setLoading((prev) => ({ ...prev, search: false }));
    }
  }, [callApi, filters, showSnackBar]);

  useEffect(() => {
    const fetchETLDate = async () => {
      try {
        const response = await callApi("/PS/file/fincore-date", {}, "GET");
        const value = response?.data?.userDate || response?.data?.etlDate || response?.date || "";
        if (value) {
          const date = dayjs(value.split("T")[0]);
          setEtlDate(date);
          updateFilter("date", date.format("YYYY-MM-DD"));
        }
      } catch {
        setEtlDate(dayjs());
      }
    };

    fetchETLDate();
    fetchCurrencies();
  }, [callApi, fetchCurrencies]);

  useEffect(() => {
    if (rows.length > 0 && filters.date) fetchData(filters.date, paginationModel.page, paginationModel.pageSize);
  }, [paginationModel.page, paginationModel.pageSize]);

  const handleSearch = () => {
    setPaginationModel((prev) => ({ ...prev, page: 0 }));
    fetchData(filters.date, 0, paginationModel.pageSize);
  };

  const handleReset = () => {
    const date = etlDate ? etlDate.format("YYYY-MM-DD") : "";
    setFilters({ date, branchCode: "", currency: "", cgl: "" });
    setBranchInput("");
    setCurrencyInput("");
    setCglInput("");
    setBranches([]);
    setCgls([]);
    setRows([]);
    setTotalElements(0);
    setFiltersExpanded(true);
    setPaginationModel({ page: 0, pageSize: 25 });
  };

  const columns = [
    { field: "reconRunDate", headerName: "Error Date", flex: 1, minWidth: 130 },
    { field: "GLCC_VAL", headerName: "GLCC", flex: 1.3, minWidth: 180 },
    { field: "cbsBalance", headerName: "CBS Balance", flex: 1, minWidth: 140 },
    { field: "glBalance", headerName: "GL Balance", flex: 1, minWidth: 140 },
    {
      field: "differenceAmount",
      headerName: "Difference",
      flex: 1,
      minWidth: 140,
      renderCell: (params) => (
        <Typography sx={{ fontWeight: 700, color: Number(params.value) < 0 ? "#d32f2f" : "#2e7d32" }}>
          {Number(params.value || 0).toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
        </Typography>
      ),
    },
    {
      field: "action",
      headerName: "Action",
      minWidth: 90,
      sortable: false,
      renderCell: (params) => (
        <IconButton color="primary" onClick={() => { setSelectedRow(params.row); setOpenHistory(true); }}>
          <HistoryIcon />
        </IconButton>
      ),
    },
  ];

  return (
    <Box sx={{ width: "100%", p: { xs: 1, sm: 2 } }}>
      <Card elevation={0} sx={{ borderRadius: 3, bgcolor: "rgba(255,255,255,0.4)", backdropFilter: "blur(5px)", border: "1px solid", borderColor: "divider", overflow: "hidden" }}>
        <Box sx={{ p: { xs: 1.5, sm: 2 }, mb: filtersExpanded ? 1 : 0.5, bgcolor: "background.paper", borderLeft: "6px solid", borderColor: "primary.main", boxShadow: 2, borderRadius: 2 }}>
          <Stack direction={{ xs: "column", sm: "row" }} alignItems={{ xs: "flex-start", sm: "center" }} justifyContent="space-between" spacing={2}>
            <Stack direction="row" spacing={1.5} alignItems="center">
              <Box sx={{ width: 40, height: 40, borderRadius: "50%", display: "flex", alignItems: "center", justifyContent: "center", bgcolor: "rgba(88,70,159,0.1)", color: "primary.main", flexShrink: 0 }}>
                <CalendarMonthOutlinedIcon />
              </Box>
              <Box>
                <Stack direction="row" spacing={1} alignItems="center" flexWrap="wrap">
                  <Typography sx={{ fontWeight: 800, fontSize: { xs: "0.95rem", sm: "1.05rem" } }}>Date Wise Balance Search</Typography>
                  <Chip label="Date Wise" size="small" sx={{ height: 21, fontSize: "0.68rem", fontWeight: 700, color: "#58469f", bgcolor: "rgba(88,70,159,0.08)" }} />
                </Stack>
                <Typography color="text.secondary" sx={{ mt: 0.2, fontSize: { xs: "0.72rem", sm: "0.8rem" } }}>
                  View balance differences for a selected date and track reconciliation history.
                </Typography>
              </Box>
            </Stack>

            {rows.length > 0 && (
              <StyledButton variant="contained" startIcon={<ManageSearchOutlinedIcon />} onClick={() => setFiltersExpanded((prev) => !prev)} sx={{ textTransform: "none", borderRadius: "8px", fontWeight: 600, minWidth: { xs: "100%", sm: 140 }, height: 34 }}>
                {filtersExpanded ? "Hide Filters" : "Edit Filters"}
              </StyledButton>
            )}
          </Stack>
        </Box>

        {rows.length > 0 && !filtersExpanded && (
          <Stack direction="row" spacing={1} sx={{ px: 2, pt: 1.5, flexWrap: "wrap", rowGap: 1 }}>
            {[`ETL Date: ${dayjs(filters.date).format("DD MMM YYYY")}`, `Branch: ${filters.branchCode}`, `Currency: ${filters.currency}`, `CGL: ${filters.cgl}`]
              .filter(Boolean)
              .map((value, index) => (
                <Box key={index} sx={{ px: 1.5, py: 0.45, borderRadius: "20px", bgcolor: "rgba(88,70,159,0.08)", border: "1px solid rgba(88,70,159,0.36)" }}>
                  <Typography sx={{ fontSize: "0.72rem", fontWeight: 500, color: "#58469f" }}>{value}</Typography>
                </Box>
              ))}
          </Stack>
        )}

        {filtersExpanded && (
          <CardContent sx={{ p: { xs: 1.5, sm: 2 }, "&:last-child": { pb: 2 } }}>
            <LocalizationProvider dateAdapter={AdapterDayjs}>
              <Box sx={{ display: "grid", gridTemplateColumns: { xs: "1fr", sm: "repeat(2, 1fr)", md: "repeat(4, 1fr)" }, gap: 2 }}>
                <DatePicker
                  label="ETL Date*"
                  value={etlDate}
                  format="DD-MM-YYYY"
                  onChange={(value) => {
                    setEtlDate(value);
                    updateFilter("date", value ? value.format("YYYY-MM-DD") : "");
                  }}
                  slotProps={{ textField: { fullWidth: true, size: "small", InputLabelProps: { shrink: true }, placeholder: "DD-MM-YYYY" } }}
                />

                <Autocomplete
                  autoHighlight
                  forcePopupIcon={false}
                  options={branches}
                  value={filters.branchCode || null}
                  inputValue={branchInput}
                  loading={loading.branch}
                  disabled={!permissions?.wholebank && (user?.isCircle === false || permissions?.branch)}
                  noOptionsText={branchInput.length < 3 ? "Please enter at least 3 characters" : "No Options"}
                  onInputChange={(event, value, reason) => {
                    setBranchInput(value);
                    if (reason === "input" && value.length >= 3) fetchSearchData("branch", value);
                    if (reason === "clear") setBranches([]);
                  }}
                  onChange={(event, value) => updateFilter("branchCode", value || "")}
                  renderInput={(params) => (
                    <TextField {...params} label="Branch Code or Name*" placeholder="eg. 12345 or ABC" fullWidth size="small" InputLabelProps={{ shrink: true }} />
                  )}
                />

                <Autocomplete
                  autoHighlight
                  options={currencies}
                  loading={loading.currency}
                  value={currencies.find((item) => item.currencyCode === filters.currency) || null}
                  inputValue={currencyInput}
                  getOptionLabel={(option) => option ? `${option.currencyCode} (${option.currencyName})` : ""}
                  onInputChange={(event, value) => setCurrencyInput(value)}
                  onChange={(event, value) => {
                    updateFilter("currency", value?.currencyCode || "");
                    setCurrencyInput(value ? `${value.currencyCode} (${value.currencyName})` : "");
                  }}
                  onOpen={fetchCurrencies}
                  renderInput={(params) => (
                    <TextField {...params} label="Currency*" placeholder="Please select Currency" fullWidth size="small" InputLabelProps={{ shrink: true }} />
                  )}
                />

                <Autocomplete
                  autoHighlight
                  forcePopupIcon={false}
                  options={cgls}
                  value={filters.cgl || null}
                  inputValue={cglInput}
                  loading={loading.cgl}
                  noOptionsText={cglInput.length < 3 ? "Please enter at least 3 characters" : "No Options"}
                  onInputChange={(event, value, reason) => {
                    setCglInput(value);
                    if (reason === "input" && value.length >= 3) fetchSearchData("cgl", value);
                    if (reason === "clear") setCgls([]);
                  }}
                  onChange={(event, value) => {
                    updateFilter("cgl", value || "");
                    setCglInput(value || "");
                  }}
                  renderInput={(params) => (
                    <TextField {...params} label="CGL*" placeholder="eg. 9999999999" fullWidth size="small" InputLabelProps={{ shrink: true }} />
                  )}
                />
              </Box>

              <Box sx={{ display: "flex", justifyContent: "flex-end", gap: 1.5, mt: 2 }}>
                <StyledButton variant="contained" startIcon={<RestartAltIcon />} onClick={handleReset} sx={{ textTransform: "none", minWidth: 90 }}>
                  Reset
                </StyledButton>
                <StyledButton variant="contained" startIcon={<SearchIcon />} disabled={!filters.date || !filters.branchCode || !filters.currency || !filters.cgl || loading.search} onClick={handleSearch} sx={{ textTransform: "none", minWidth: 100 }}>
                  {loading.search ? "Searching..." : "Search"}
                </StyledButton>
              </Box>
            </LocalizationProvider>
          </CardContent>
        )}
      </Card>

      {rows.length > 0 && (
        <Box sx={{ mt: 2 }}>
          <Card elevation={0} sx={{ p: 2, borderRadius: 3, border: "1px solid", borderColor: "divider" }}>
            <Stack direction="row" justifyContent="space-between" alignItems="center" mb={2}>
              <Typography fontWeight={800}>Balance Difference Records</Typography>
              <Chip label={`${totalElements.toLocaleString("en-IN")} Records Found`} size="small" sx={{ fontWeight: 700 }} />
            </Stack>
            <Box sx={{ width: "100%", height: 470 }}>
              <DataGrid rows={rows} columns={columns} rowCount={totalElements} loading={loading.search} paginationMode="server" paginationModel={paginationModel} onPaginationModelChange={setPaginationModel} pageSizeOptions={[25, 50, 75, 100]} disableRowSelectionOnClick />
            </Box>
          </Card>
        </Box>
      )}

      <Dialog open={openHistory} onClose={() => setOpenHistory(false)} fullWidth maxWidth="md">
        <DialogTitle>
          Difference Details
          <IconButton onClick={() => setOpenHistory(false)} sx={{ position: "absolute", right: 8, top: 8 }}>
            <CloseIcon />
          </IconButton>
        </DialogTitle>
        <DialogContent>
          {selectedRow && (
            <Box sx={{ display: "grid", gridTemplateColumns: { xs: "1fr", sm: "repeat(2, 1fr)" }, gap: 2, pt: 1 }}>
              <Typography>Date: {selectedRow.reconRunDate}</Typography>
              <Typography>Branch: {selectedRow.branchCode}</Typography>
              <Typography>Currency: {selectedRow.currency}</Typography>
              <Typography>CGL: {selectedRow.cgl}</Typography>
              <Typography>CBS: {selectedRow.cbsBalance}</Typography>
              <Typography>GL: {selectedRow.glBalance}</Typography>
              <Typography sx={{ color: "error.main", fontWeight: 700 }}>Difference: {selectedRow.differenceAmount}</Typography>
            </Box>
          )}
        </DialogContent>
        <DialogActions>
          <Button onClick={() => setOpenHistory(false)}>Close</Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
}

 <Grid container spacing={2}>
                  <Grid size={{ xs: 12, sm: 7 }}>
                    <Autocomplete
                    multiple
                    // multiple={filters.enquiryType==="CONSOLIDATED"}
                      // forcePopupIcon={false}
                      autoHighlight
                      // disableCloseOnSelect={filters.enquiryType==="CONSOLIDATED"}
                      disableCloseOnSelect
                      renderTags={filters.enquiryType==="CONSOLIDATED"?()=>null:undefined}
                      limitTags={0}
                      value={filters.enquiryType === "CONSOLIDATED"? filters.cgl : filters.cgl?.includes("All CGLs")?null:filters.cgl?.[0]||null}
                      options={filters.enquiryType==="CONSOLIDATED"?["All CGLs", ...cgls.filter(c => c!== "All CGLs")]:cgls.filter(c=>c!=="All CGLs")}
                      clearIcon={filters.cgl ? undefined : null}
                      noOptionsText={
                        filters.enquiryType !== "CONSOLIDATED" &&
                        (!filters.cgl || filters.cgl.length < 3)
                          ? "Please enter at least 3 characters"
                          : "No Options"
                      }
                      onInputChange={(e, v) => {
                        if (v.length >= 3) fetchSearchData("cgl", v);

                      }}
                      onChange={(_, v) => handleCglChange(v)}
                      renderOption={(props, option, { selected }) =>
                        filters.enquiryType === "CONSOLIDATED" ? (

                          <li {...props}>
                            <Checkbox checked={selected} />
                            {option}
                          </li>

                        ) : (

                          <li {...props}>
                            {option}
                          </li>

                        )
                      }
                      renderInput={(params) => (
                      <TextField
                        {...params}
                        variant="standard"
                        label="CGL *"
                        InputProps={{
                          ...params.InputProps,
                          startAdornment:null,

                          endAdornment: (
                            <>
                            {filters.enquiryType === "CONSOLIDATED" && filters.cgl.length>0 &&(
                                <>
                             <CustomChip
                              label={
                                filters.cgl.includes("All CGLs")
                                  ? "All CGLs"
                                  : `${filters.cgl.length} Selected`
                              }
                              color={
                                filters.cgl.includes("All CGLs")
                                  ? "default"
                                  : "primary"
                              }
                            />

                            {!filters.cgl.includes("All CGLs") &&
                            filters.cgl.length > 0 && (
                              <IconButton
                                size="small"
                                onClick={() =>
                                  setViewList(
                                    viewList === "cgl" ? null : "cgl"
                                  )
                                }
                              >
                                {viewList === "cgl"
                                  ? <VisibilityOffIcon fontSize="small"/>
                                  : <VisibilityIcon fontSize="small"/>}
                              </IconButton>
                            )}
                            </>
                              )}
                              {params.InputProps.endAdornment}
                            </>
                          ),
                        }}
                      />
                    )}
                      loadingText="Searching Cgls..."
                    />

import React, {
  useState,
  useMemo,
  useEffect,
} from "react";

import {
  Autocomplete,
  Box,
  MenuItem,
  TextField,
  Typography,
  Stack,
} from "@mui/material";

import {
  DatePicker,
  LocalizationProvider,
} from "@mui/x-date-pickers";

import {
  AdapterDayjs,
} from "@mui/x-date-pickers/AdapterDayjs";

import dayjs from "dayjs";

import SearchIcon from "@mui/icons-material/Search";
import RestartAltIcon from "@mui/icons-material/RestartAlt";

import useCustomSnackbar from "../../../utils/useCustomSnackbar";

import {
  calculateQuickFilterDates,
  getAvailableFilters,
} from "../../../utils/CommonUtilities";

import {
  StyledButton,
} from "./BalanceDifferenceStyles";


export default function BalanceDifferenceFilters({
  branch,
  setBranch,

  currency,
  setCurrency,

  cgl,
  setCgl,

  start,
  setStart,

  end,
  setEnd,

  currencies,
  branches,
  cgls,

  loading,

  handleSearchChange,
  fetchCurrencies,

  handleSubmit,
  resetState,

  isNumeric,

  req,

  user,
  permissions,

  etlDate,

  glcc,
  setGlcc,

  glccValidated,
  setGlccValidated,

  validateGlcc,
}) {
  const [
    fromDateError,
    setFromDateError,
  ] = useState(null);

  const [
    toDateError,
    setToDateError,
  ] = useState(null);

  const [
    quickFilter,
    setQuickFilter,
  ] = useState("custom");

  const showSnackBar =
    useCustomSnackbar();

  const {
    hasWholeBank,
  } = permissions;

  const isBranchUser =
    !hasWholeBank &&
    !user?.isCircle;

  const MIN_ALLOWED_DATE =
    useMemo(
      () => dayjs("2026-03-31"),
      [],
    );

  const baseDate =
    etlDate?.isValid?.()
      ? etlDate
      : dayjs();


  /* =====================================================
     REGEX
  ===================================================== */

  const GLCC_ALLOWED_REGEX =
    /^[A-Z0-9]*$/;

  const BRANCH_REGEX =
    /^[A-Za-z0-9/&(), -]*$/;

  const CGL_ALLOWED_REGEX =
    /^[A-Za-z0-9._<>/&()= -]*$/;

  const CURRENCY_ALLOWED_REGEX =
    /^[A-Za-z ()]*$/;


  /* =====================================================
     INPUT STATES
  ===================================================== */

  const [
    branchInput,
    setBranchInput,
  ] = useState("");

  const [
    cglInput,
    setCglInput,
  ] = useState("");

  const [
    currencyInput,
    setCurrencyInput,
  ] = useState("");


  /* =====================================================
     VALIDATION MESSAGES
  ===================================================== */

  const INVALID_GLCC_MSG =
    "Invalid GLCC format. Only letters and numbers are allowed.";

  const INVALID_GLCC_PATTERN_MSG =
    "Invalid GLCC format. Enter 5 digits, followed by 3 letters, and then 10 digits.";

  const INVALID_BRANCH_MSG =
    "Invalid Branch Code/Branch Name format. Only letters, numbers, spaces, '/', '&', '(', ')', '-', and ',' are allowed.";

  const INVALID_CURRENCY_MSG =
    "Invalid Currency format. Only letters, spaces, '(' and ')' are allowed.";

  const INVALID_CGL_MSG =
    "Invalid CGL format. Only letters, numbers, spaces, '_', '-', '<', '>', '/', '&', '(', ')' and '=' are allowed.";


  /* =====================================================
     QUICK FILTERS
  ===================================================== */

  const availableFilters =
    useMemo(() => {
      return getAvailableFilters(
        baseDate,
        MIN_ALLOWED_DATE,
      );
    }, [
      MIN_ALLOWED_DATE,
      baseDate,
    ]);


  const handleQuickFilter = (e) => {
    const option =
      e.target.value;

    setQuickFilter(option);

    if (option === "custom") {
      return;
    }

    const {
      newStart,
      newEnd,
    } =
      calculateQuickFilterDates(
        option,
        baseDate,
        MIN_ALLOWED_DATE,
      );

    setStart(newStart);
    setEnd(newEnd);
  };


  /* =====================================================
     DATE ERROR MESSAGE
  ===================================================== */

  const getDateErrorMessage = (
    field,
    error,
  ) => {
    switch (error) {
      case "invalidDate":
        return `Please enter a valid ${field}`;

      case "minDate":
        return `${field} cannot be earlier than ${MIN_ALLOWED_DATE.format(
          "DD-MM-YYYY",
        )}`;

      case "maxDate":
        return `${field} cannot exceed ${etlDate?.format(
          "DD-MM-YYYY",
        )}`;

      case "fromGreaterThanTo":
        return "From Date cannot be greater than To Date";

      case "toLessThanFrom":
        return "To Date cannot be less than From Date";

      case "rangeExceeds12Months":
        return "Date range cannot exceed 12 months";

      case "afterEtlDate":
        return `To Date cannot exceed Fincore ETL Date ${etlDate?.format(
          "DD-MM-YYYY",
        )}`;

      default:
        return "";
    }
  };


  /* =====================================================
     DATE VALIDATION
  ===================================================== */

  useEffect(() => {
    let fromErr = null;
    let toErr = null;

    if (start) {
      if (!start.isValid?.()) {
        fromErr = "invalidDate";
      } else if (
        start.isBefore(
          MIN_ALLOWED_DATE,
          "day",
        )
      ) {
        fromErr = "minDate";
      } else if (
        etlDate?.isValid?.() &&
        start.isAfter(
          etlDate,
          "day",
        )
      ) {
        fromErr = "maxDate";
      }
    }

    if (end) {
      if (!end.isValid?.()) {
        toErr = "invalidDate";
      } else if (
        end.isBefore(
          MIN_ALLOWED_DATE,
          "day",
        )
      ) {
        toErr = "minDate";
      } else if (
        etlDate?.isValid?.() &&
        end.isAfter(
          etlDate,
          "day",
        )
      ) {
        toErr = "afterEtlDate";
      }
    }

    if (
      start?.isValid?.() &&
      end?.isValid?.() &&
      !fromErr &&
      !toErr
    ) {
      if (
        start.isAfter(
          end,
          "day",
        )
      ) {
        fromErr =
          "fromGreaterThanTo";
      } else if (
        end.isAfter(
          start
            .clone()
            .add(1, "year"),
          "day",
        )
      ) {
        toErr =
          "rangeExceeds12Months";
      }
    }

    setFromDateError(fromErr);
    setToDateError(toErr);
  }, [
    start,
    end,
    etlDate,
    MIN_ALLOWED_DATE,
  ]);


  /* =====================================================
     RESET
  ===================================================== */

  const handleReset = () => {
    setFromDateError(null);
    setToDateError(null);

    setQuickFilter("custom");

    setBranchInput("");
    setCglInput("");
    setCurrencyInput("");

    resetState();
  };


  const validationMessages = [
    fromDateError &&
      getDateErrorMessage(
        "From Date",
        fromDateError,
      ),

    toDateError &&
      getDateErrorMessage(
        "To Date",
        toDateError,
      ),
  ].filter(Boolean);


  /* =====================================================
     UI
  ===================================================== */

  return (
    <Box
      sx={{
        width: "100%",
        mt: 3,
      }}
    >

      {/* =================================================
          FIRST ROW
      ================================================= */}

      <Box
        sx={{
          display: "grid",

          gridTemplateColumns: {
            xs: "1fr",
            sm: "repeat(2, 1fr)",
            md:
              permissions?.wholebank ||
              !isBranchUser
                ? "repeat(4, 1fr)"
                : "repeat(3, 1fr)",
          },

          gap: 2,
          mb: 2,
        }}
      >

        {/* GLCC */}

        {(hasWholeBank ||
          user?.isCircle === true) && (
          <Box>
            <TextField
              label="GLCC (Optional)"
              fullWidth
              value={glcc}
              placeholder="Enter 18 Characters GLCC"
              InputLabelProps={{
                shrink: true,
              }}
              inputProps={{
                maxLength: 18,
              }}

              onChange={(e) => {
                const value =
                  e.target.value.toUpperCase();

                if (
                  !GLCC_ALLOWED_REGEX.test(
                    value,
                  )
                ) {
                  showSnackBar(
                    INVALID_GLCC_MSG,
                    "warning",
                  );
                  return;
                }

                if (
                  value.length <= 5 &&
                  !/^\d*$/.test(value)
                ) {
                  showSnackBar(
                    INVALID_GLCC_PATTERN_MSG,
                    "warning",
                  );
                  return;
                }

                if (
                  value.length > 5 &&
                  value.length <= 8 &&
                  !/^\d{5}[A-Z]*$/.test(
                    value,
                  )
                ) {
                  showSnackBar(
                    INVALID_GLCC_PATTERN_MSG,
                    "warning",
                  );
                  return;
                }

                if (
                  value.length > 8 &&
                  !/^\d{5}[A-Z]{3}\d*$/.test(
                    value,
                  )
                ) {
                  showSnackBar(
                    INVALID_GLCC_PATTERN_MSG,
                    "warning",
                  );
                  return;
                }

                setGlcc(value);

                setGlccValidated(
                  false,
                );

                setBranch("");
                setCurrency("");
                setCgl("");

                if (
                  value.length === 18
                ) {
                  validateGlcc(value);
                }
              }}
            />
          </Box>
        )}


        {/* BRANCH */}

        <Autocomplete
          autoHighlight

          disabled={
            glccValidated ||
            (!permissions?.wholebank &&
              (user?.isCircle === false ||
                permissions?.branch))
          }

          value={branch}

          forcePopupIcon={false}

          clearIcon={
            branchInput
              ? undefined
              : null
          }

          options={branches || []}

          noOptionsText={
            req.branch
              ? "Please enter at least 3 characters"
              : "No Options"
          }

          inputValue={branchInput}

          loading={
            !req.branch &&
            loading.branch
          }

          onClose={(e, reason) => {
            if (reason === "blur") {
              handleSearchChange(
                branchInput,
                "blur",
                "branch",
              );
            }
          }}

          onInputChange={(
            e,
            value,
            reason,
          ) => {
            if (
              reason === "input" &&
              !BRANCH_REGEX.test(
                value,
              )
            ) {
              showSnackBar(
                INVALID_BRANCH_MSG,
                "warning",
              );
              return;
            }

            setBranchInput(value);

            handleSearchChange(
              value,
              reason,
              "branch",
            );
          }}

          onChange={(e, value) =>
            setBranch(value)
          }

          renderInput={(params) => (
            <TextField
              {...params}
              label="Branch Code or Name*"
              fullWidth
              InputLabelProps={{
                shrink: true,
              }}
              placeholder="eg. 12345 or ABC"

              slotProps={{
                htmlInput: {
                  ...params.inputProps,
                  maxLength:
                    isNumeric(
                      params.inputProps
                        .value,
                    )
                      ? 5
                      : 15,
                },
              }}
            />
          )}
        />


        {/* CURRENCY */}

        <Autocomplete
          autoHighlight

          disabled={glccValidated}

          options={currencies || []}

          value={
            currencies?.find(
              (c) =>
                c.currencyCode ===
                currency,
            ) || null
          }

          inputValue={currencyInput}

          getOptionLabel={(option) =>
            option
              ? `${option.currencyCode} (${option.currencyName})`
              : ""
          }

          onInputChange={(
            e,
            value,
            reason,
          ) => {
            if (
              reason === "input" &&
              !CURRENCY_ALLOWED_REGEX.test(
                value,
              )
            ) {
              showSnackBar(
                INVALID_CURRENCY_MSG,
                "warning",
              );
              return;
            }

            setCurrencyInput(value);
          }}

          onChange={(
            event,
            newValue,
          ) => {
            setCurrency(
              newValue
                ? newValue.currencyCode
                : "",
            );

            setCurrencyInput(
              newValue
                ? `${newValue.currencyCode} - ${newValue.currencyName}`
                : "",
            );
          }}

          onOpen={fetchCurrencies}

          renderInput={(params) => (
            <TextField
              {...params}
              label="Currency*"
              fullWidth
              InputLabelProps={{
                shrink: true,
              }}
              placeholder={
                !currency
                  ? "Please select Currency"
                  : ""
              }
            />
          )}
        />


        {/* CGL */}

        <Autocomplete
          disabled={glccValidated}

          forcePopupIcon={false}

          autoHighlight

          value={cgl}

          options={cgls}

          inputValue={cglInput}

          clearIcon={
            cglInput || cgl
              ? undefined
              : null
          }

          noOptionsText={
            cglInput.length < 3
              ? "Please enter at least 3 characters"
              : "No Options"
          }

          loading={
            !req.cgl &&
            loading.cgl
          }

          onClose={(e, reason) => {
            if (reason === "blur") {
              handleSearchChange(
                cglInput,
                "blur",
                "cgl",
              );
            }
          }}

          onInputChange={(
            e,
            value,
            reason,
          ) => {
            if (
              reason === "input" &&
              !CGL_ALLOWED_REGEX.test(
                value,
              )
            ) {
              showSnackBar(
                INVALID_CGL_MSG,
                "warning",
              );
              return;
            }

            setCglInput(value);

            handleSearchChange(
              value,
              reason,
              "cgl",
            );
          }}

          onChange={(e, value) => {
            setCgl(value);
            setCglInput(value || "");
          }}

          renderInput={(params) => (
            <TextField
              {...params}
              label="CGL*"
              fullWidth
              InputLabelProps={{
                shrink: true,
              }}
              placeholder="eg. 9999999999"

              slotProps={{
                htmlInput: {
                  ...params.inputProps,
                  maxLength:
                    isNumeric(
                      params.inputProps
                        .value,
                    )
                      ? 10
                      : 30,
                },
              }}
            />
          )}
        />

      </Box>


      {/* =================================================
          DATE ROW
      ================================================= */}

      <LocalizationProvider
        dateAdapter={AdapterDayjs}
      >

        <Box
          sx={{
            display: "grid",

            mt: 3,
            mb: 0.5,

            gridTemplateColumns: {
              xs: "1fr",
              sm: "repeat(2, 1fr)",
              md: "repeat(4, 1fr)",
            },

            gap: 2,

            alignItems: "start",
          }}
        >

          {/* DATE RANGE */}

          <TextField
            select
            label="Date Range"
            value={quickFilter}
            onChange={
              handleQuickFilter
            }
            InputLabelProps={{
              shrink: true,
            }}
            fullWidth
          >
            {availableFilters.map(
              (opt) => (
                <MenuItem
                  key={opt.value}
                  value={opt.value}
                >
                  {opt.label}
                </MenuItem>
              ),
            )}
          </TextField>


          {/* FROM DATE */}

          <DatePicker
            value={start}
            format="DD-MM-YYYY"
            minDate={
              MIN_ALLOWED_DATE
            }
            maxDate={etlDate}
            views={[
              "year",
              "month",
              "day",
            ]}
            disableHighlightToday

            onChange={(value) => {
              setStart(value);
              setQuickFilter(
                "custom",
              );
            }}

            slotProps={{
              textField: {
                label: "From Date*",
                InputLabelProps: {
                  shrink: true,
                },
                placeholder:
                  "DD-MM-YYYY",
                error:
                  !!fromDateError,
                fullWidth: true,
              },
            }}
          />


          {/* TO DATE */}

          <DatePicker
            value={end}
            format="DD-MM-YYYY"

            minDate={
              start ||
              MIN_ALLOWED_DATE
            }

            maxDate={etlDate}

            views={[
              "year",
              "month",
              "day",
            ]}

            disableHighlightToday

            disabled={!start}

            onChange={(value) => {
              setEnd(value);
              setQuickFilter(
                "custom",
              );
            }}

            slotProps={{
              textField: {
                label: "To Date*",
                InputLabelProps: {
                  shrink: true,
                },
                placeholder:
                  "DD-MM-YYYY",
                error:
                  !!toDateError,
                fullWidth: true,
              },
            }}
          />


          {/* BUTTONS */}

          <Box
            sx={{
              display: "flex",
              justifyContent: {
                xs: "stretch",
                sm: "flex-end",
              },
              gap: 1.5,

              height: "100%",

              alignItems: "center",
            }}
          >

            <StyledButton
              variant="contained"
              startIcon={
                <RestartAltIcon />
              }
              onClick={handleReset}
              sx={{
                flex: {
                  xs: 1,
                  sm: "unset",
                },
              }}
            >
              Reset
            </StyledButton>


            <StyledButton
              variant="contained"
              startIcon={
                <SearchIcon />
              }

              disabled={
                !(
                  cgl &&
                  currency &&
                  branch &&
                  start &&
        

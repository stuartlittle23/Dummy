            { 
              label: "Closing Balance", 
              date: balances.closingDate || balances.ClosingDate,
              amt: balances.closingBalance, 
              icon: <AccountBalanceWalletIcon />,
            }
          ].map((item, index) => {
            const isNeg = item.amt < 0;
            const indicator = isNeg ? "DR" : "CR";
            const absVal = Math.abs(item.amt || 0).toFixed(2);

            const activeColor = isNeg ? "#b84646f3" : "#427a44"; 
            const activeBg = isNeg 
              ? "linear-gradient(135deg, #fff5f5 0%, #fed7d759 100%)" 
              : "linear-gradient(135deg, #f6fdf9 0%, #c6f6d556 100%)";

            return (
              <Box 
                key={index}
                sx={{ 
                  flex: 1, 
                  p: 1.5, 
                  borderRadius: '12px', 
                  background: activeBg,
                  border: '1px solid rgba(255, 255, 255, 0.3)',
                  borderBottom: `4px solid ${activeColor}`,
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "space-between",
                  position: "relative",
                  overflow: "hidden"
                }}
              >
                <Stack direction="row" alignItems="center" sx={{ zIndex: 1 }}>
                  <Box sx={{ p: 1, borderRadius: '10px', bgcolor: '#fff', display: 'flex', mr: 1.5, boxShadow: '0 2px 6px rgba(0,0,0,0.05)', color: activeColor }}>
                    {item.icon}
                  </Box>
                  <Box>
                    <Typography variant="caption" color="text.secondary" fontWeight={700} sx={{ textTransform: 'uppercase', fontSize: '0.65rem' }}>
                      {item.label}
                    </Typography>
                    <Typography variant="subtitle1" fontWeight={800} sx={{ color: '#2c3e50', lineHeight: 1 }}>
                      {absVal}
                      <Box component="span" sx={{ fontSize: '0.7rem', ml: 0.5, color: activeColor, fontWeight: 900 }}>
                        {indicator}
                      </Box>
                    </Typography>
                  </Box>
                </Stack>

                {isNeg ? (
                  <TrendingDownIcon sx={{ 
                    position: 'absolute', left: '50%', top: '50%', transform: 'translate(-50%, -50%)',
                    fontSize: '3rem', opacity: 0.25, color: activeColor, zIndex: 0 
                  }} />
                ) : (
                  <TrendingUpIcon sx={{ 
                    position: 'absolute', left: '50%', top: '50%', transform: 'translate(-50%, -50%)',
                    fontSize: '3rem', opacity: 0.25, color: activeColor, zIndex: 0 
                  }} />
                )}

                <Box sx={{ textAlign: 'right', zIndex: 1 }}>
                  <Stack direction="row" alignItems="center" spacing={0.5} justifyContent="flex-end">

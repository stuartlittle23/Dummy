        </RailField>

        <RailField icon={<AccountBalanceRoundedIcon sx={{ fontSize: 17 }} />} label="Branch code">
          <TextField fullWidth size="small" placeholder="All branches" value={filters.branch} onChange={(e) => setFilters((f) => ({ ...f, branch: e.target.value }))} sx={railFieldSx} />
        </RailField>

        <RailField icon={<PublicRoundedIcon sx={{ fontSize: 17 }} />} label="Currency">

/* ==========================================================================
   BranchPosition — Enterprise glass theme
   ========================================================================== */

.appShell {
  display:flex; align-items:stretch; overflow:hidden; min-height:640px;
  border-radius:16px; border:1px solid rgba(49,88,200,.12);
  box-shadow:0 4px 24px rgba(20,42,90,.08);
  background:rgba(255,255,255,.58); backdrop-filter:blur(18px);
  -webkit-backdrop-filter:blur(18px);
}

/* ---- Sidebar ---------------------------------------------------------- */

.sidebar {
  width:260px; min-width:260px; flex-shrink:0; padding:20px 16px;
  display:flex; flex-direction:column; background:rgba(247,249,253,.72);
  border-right:1px solid rgba(49,88,200,.12);
  backdrop-filter:blur(18px); -webkit-backdrop-filter:blur(18px);
}

.sidebarBrand { display:flex; align-items:center; gap:10px; margin-bottom:20px; padding:0 4px; }
.sidebarBrandIconWrap { position:relative; }
.sidebarBrandIcon {
  width:36px; height:36px; border-radius:10px; display:flex;
  align-items:center; justify-content:center; color:#24489f;
  background:rgba(220,229,255,.72);
}
.brandSparkle { position:absolute; top:-6px; right:-6px; font-size:13px!important; color:#8ca4df; }
.sidebarBrandText { font-size:15px; font-weight:700; color:#17284f; }

.infoCard {
  display:flex; align-items:center; gap:10px; padding:10px;
  border:1px solid rgba(49,88,200,.10); border-radius:10px;
  background:rgba(255,255,255,.58); margin-bottom:8px;
}
.infoCardIcon {
  width:30px; height:30px; flex-shrink:0; border-radius:8px;
  display:flex; align-items:center; justify-content:center;
  background:rgba(232,238,255,.8); color:#3158c8;
}
.infoCardLabel {
  font-size:10px; font-weight:700; letter-spacing:.05em;
  text-transform:uppercase; color:rgba(23,40,79,.52); margin:0 0 2px;
}
.infoCardValue { font-size:13px; font-weight:700; color:#17284f; line-height:1.3; }
.infoCardSubvalue { font-size:11px; color:rgba(23,40,79,.55); }

.reportDateCard { margin-bottom:16px; }
.reportDateCard :global(.MuiOutlinedInput-root) {
  height:38px; background:rgba(255,255,255,.68); border-radius:8px;
}
.reportDateCard :global(.MuiOutlinedInput-notchedOutline) { border-color:rgba(49,88,200,.16); }
.reportDateCard :global(.MuiInputBase-input) { padding:8px 10px; font-size:13px; font-weight:600; color:#17284f; }

.sidebarSectionLabel {
  padding:0 8px 7px; font-size:10px; font-weight:700;
  letter-spacing:.07em; color:rgba(23,40,79,.5);
}

.navTabs { margin-top:0; }
.navTab {
  min-height:46px!important; padding:8px 12px!important; margin-bottom:8px;
  border-radius:9px!important; border:1px solid rgba(49,88,200,.10);
  background:rgba(255,255,255,.62); color:#30446d!important;
  font-weight:600!important; text-transform:none!important;
  align-items:center; flex-direction:row; justify-content:flex-start;
  transition:all .15s ease;
}
.navTab:hover { background:rgba(231,237,255,.8); }
.navTab:global(.Mui-selected) {
  background:linear-gradient(135deg,#3158c8,#24479f)!important;
  color:#fff!important; border-color:#3158c8;
  box-shadow:0 4px 12px rgba(49,88,200,.20);
}
.navTab:global(.Mui-disabled) { opacity:.45; }

.sidebarFooter { margin-top:auto; padding-top:12px; }
.sidebarIllustration {
  position:relative; width:100%; display:flex; justify-content:center;
  align-items:center; padding:12px 0 4px; opacity:.9;
}
.sparkleTopRight { position:absolute; top:2px; right:28%; font-size:15px!important; color:#a9b9e8; }
.sparkleBottomLeft { position:absolute; bottom:6px; left:22%; font-size:10px!important; color:#a9b9e8; opacity:.8; }
.sparkleMidRight { position:absolute; top:38%; right:14%; font-size:9px!important; color:#c7d1ee; }

/* ---- Main content ------------------------------------------------------- */

.mainContent {
  flex:1; min-width:0; padding:24px;
  background:rgba(250,252,255,.52);
  backdrop-filter:blur(18px); -webkit-backdrop-filter:blur(18px);
}

.pageHeaderArea {
  display:flex; align-items:flex-start; justify-content:space-between;
  gap:20px; margin-bottom:20px;
}
.pageHeaderRow { display:flex; align-items:center; gap:6px; }
.headerSparkle { font-size:17px!important; color:#91a7df; }
.pageHeaderTitle { font-size:20px; font-weight:750; color:#17284f; margin:0 0 2px; }
.pageHeaderSubtitle { font-size:13px; color:rgba(23,40,79,.58); margin:0; }
.reportSummaryRow { display:flex; align-items:center; gap:18px; margin-top:8px; }
.reportDateBadge {
  display:flex; align-items:center; gap:7px; padding:7px 11px;
  border-radius:7px; background:rgba(231,237,255,.72);
  color:#3158c8; font-size:12px; font-weight:700;
}
.reportDateBadge :global(.MuiSvgIcon-root) { font-size:17px; }
.downloadAllButton {
  min-width:150px!important; height:40px!important;
  border-radius:8px!important; text-transform:none!important;
  border-color:#3158c8!important; color:#24479f!important;
  font-weight:700!important; background:rgba(255,255,255,.52)!important;
}

/* ---- Summary cards ---------------------------------------------------- */

.summaryRow {
  display:grid; grid-template-columns:repeat(3,minmax(0,1fr));
  gap:18px; margin-bottom:22px;
}

.summaryCard {
  position:relative; min-width:0; padding:18px 20px 20px;
  border:1px solid rgba(49,88,200,.13)!important;
  border-radius:13px!important; background:rgba(255,255,255,.66)!important;
  box-shadow:0 3px 15px rgba(30,55,100,.06)!important;
  backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
  transition:all .15s ease;
}
.summaryCard:hover { box-shadow:0 6px 20px rgba(30,55,100,.10)!important; transform:translateY(-1px); }
.summaryCardSelected { border-color:rgba(49,88,200,.35)!important; box-shadow:0 5px 20px rgba(49,88,200,.12)!important; }

.cardSparkleBadge { position:absolute; top:10px; right:12px; font-size:16px!important; color:#159b88; }

.summaryCardHeader { display:flex; align-items:center; gap:12px; }
.summaryCardIcon {
  width:42px; height:42px; flex-shrink:0; border-radius:11px;
  display:flex; align-items:center; justify-content:center;
}
.summaryCardLabel { font-size:14px; font-weight:700; color:#17284f; text-transform:none; }

.summaryCountArea { text-align:center; padding:10px 0 4px; }
.summaryCardCount { font-size:32px!important; font-weight:750!important; line-height:1.15; }
.summaryCardCaption { font-size:12px; color:rgba(23,40,79,.52); }

.summaryCardDivider { height:1px; margin:12px 0; background:rgba(49,88,200,.10); }

.summaryCardActions { display:flex; flex-direction:column; gap:8px; }
.viewDetailsButton {
  width:100%!important; height:38px!important; text-transform:none!important;
  border-radius:7px!important; border-color:#8194c7!important;
  color:#24479f!important; font-weight:700!important;
}
.cardDownloadButton {
  width:100%!important; height:38px!important; text-transform:none!important;
  border-radius:7px!important; background:#3158c8!important;
  font-weight:700!important; box-shadow:none!important;
}
.cardDownloadButton:hover { background:#24479f!important; }

.rolePurple { border-left:3px solid #3158c8!important; }
.rolePurple .summaryCardIcon { background:#e8eeff; color:#3158c8; }
.rolePurple .summaryCardCount { color:#3158c8; }

.roleTeal { border-left:3px solid #159b88!important; }
.roleTeal .summaryCardIcon { background:#e2f5f0; color:#159b88; }
.roleTeal .summaryCardCount { color:#159b88; }

.roleAmber { border-left:3px solid #d88916!important; }
.roleAmber .summaryCardIcon { background:#fff0dd; color:#d17b0d; }
.roleAmber .summaryCardCount { color:#d17b0d; }

/* ---- Details panel ---------------------------------------------------- */

.detailsPanel {
  overflow:hidden; margin-bottom:18px; border:1px solid rgba(49,88,200,.13);
  border-radius:13px; background:rgba(255,255,255,.64);
  box-shadow:0 4px 20px rgba(30,55,100,.07);
  backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px);
}

.detailsHeader {
  min-height:72px; display:flex; align-items:center; justify-content:space-between;
  gap:16px; padding:14px 18px; border-bottom:1px solid rgba(49,88,200,.10);
}
.detailsHeaderLeft { display:flex; flex-direction:column; gap:5px; min-width:0; }
.detailsTitle { font-size:17px!important; font-weight:750!important; color:#17284f; }
.detailsCountChip {
  width:max-content!important; background:#e8eeff!important;
  color:#3158c8!important; font-weight:700!important;
}
.detailsHeaderActions { display:flex; align-items:center; gap:8px; }
.detailsHeaderActions :global(.MuiButton-root) {
  text-transform:none; border-radius:7px; border-color:#8194c7; color:#24479f; font-weight:700;
}
.closeDetailsButton { color:#17284f!important; }

.detailsToolbar {
  display:flex; align-items:center; justify-content:space-between;
  min-height:52px; padding:7px 14px; border-bottom:1px solid rgba(49,88,200,.08);
}
.detailsSearchBox {
  width:210px; height:36px; display:flex; align-items:center; gap:7px;
  padding:0 10px; border:1px solid rgba(49,88,200,.16); border-radius:7px;
  background:rgba(255,255,255,.62); color:rgba(23,40,79,.48); font-size:12px;
}
.detailsToolbarIcons { display:flex; align-items:center; gap:3px; }
.detailsToolbarIcons :global(.MuiIconButton-root) { color:#30446d; }

.detailsGridWrapper { width:100%; overflow:hidden; }
.detailsGridWrapper :global(.MuiDataGrid-root) { width:100%; }

.detailsBottomBar {
  display:flex; align-items:center; justify-content:space-between; gap:15px;
  padding:10px 16px; border-top:1px solid rgba(49,88,200,.09);
  background:rgba(247,249,253,.58);
}
.detailsBottomBar :global(.MuiTypography-root) {
  font-size:11.5px; color:rgba(23,40,79,.55);
}
.detailsBottomBar :global(.MuiButton-root) {
  text-transform:none; border-radius:7px; color:#24479f; border-color:#9aa9cc;
}

.differenceInfoBanner {
  display:flex; align-items:center; gap:9px; padding:11px 14px;
  border:1px solid rgba(49,88,200,.11); border-radius:9px;
  background:rgba(232,238,255,.48); color:#3158c8;
}
.differenceInfoBanner :global(.MuiTypography-root) { font-size:12px; color:rgba(23,40,79,.62); }

/* ---- GLIF — intentionally retained as existing screen structure -------- */

.glifSection {
  width:100%; margin-bottom:16px; padding:20px 24px;
  border:1px solid rgba(49,88,200,.10); border-radius:14px;
  background:rgba(255,255,255,.62);
  box-shadow:0 2px 10px rgba(30,55,100,.05);
  backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
}
.glifSectionHeader { display:flex; align-items:center; gap:10px; margin-bottom:16px; }
.glifSectionIcon {
  width:34px; height:34px; flex-shrink:0; border-radius:9px;
  display:flex; align-items:center; justify-content:center;
  background:#e8eeff; color:#3158c8;
}
.glifSectionTitle { flex-grow:1; font-size:15px; font-weight:700; color:#17284f; }
.typographyLabel { font-size:13px; color:rgba(23,40,79,.60); }
.chipValues { display:flex; flex-wrap:wrap; align-items:center; gap:8px; }
.filterFieldChip { font-weight:600!important; }
.activeFiltersRow { display:flex; align-items:center; justify-content:space-between; margin-bottom:12px; }
.clearAllLink {
  padding:0; border:0; background:none; cursor:pointer;
  color:#3158c8; font-size:12px; font-weight:700;
}
.clearAllLink:hover { text-decoration:underline; }

/* ---- Information banner ---------------------------------------------- */

.infoBanner {
  display:flex; align-items:flex-start; gap:10px; padding:12px 16px;
  border-radius:10px; background:rgba(232,238,255,.52);
  border:1px solid rgba(49,88,200,.13); margin-top:16px;
}
.infoBannerText { font-size:12.5px; color:rgba(23,40,79,.60); line-height:1.5; }

/* ---- Dialog ----------------------------------------------------------- */

.dialog { height:100%; width:100%; }
.dialogPaper {
  max-width:none!important; border-radius:16px!important;
  background:rgba(250,252,255,.94)!important;
  box-shadow:0 14px 50px rgba(20,42,90,.20)!important;
  backdrop-filter:blur(18px); -webkit-backdrop-filter:blur(18px);
}
.dialogButton { flex-grow:0; margin:4px!important; }
.dialogTitle {
  display:flex; align-items:center; font-weight:600;
  border-bottom:1px solid rgba(49,88,200,.10);
}

/* ---- Responsive ------------------------------------------------------- */

@media (max-width:1100px) {
  .sidebar { width:230px; min-width:230px; }
  .summaryRow { gap:12px; }
  .summaryCard { padding:15px; }
}

@media (max-width:850px) {
  .appShell { flex-direction:column; }
  .sidebar { width:100%; min-width:0; border-right:0; border-bottom:1px solid rgba(49,88,200,.12); }
  .sidebarFooter { display:none; }
  .navTabs { flex-direction:row; }
  .navTab { flex:1; margin-bottom:0; margin-right:8px; }
  .summaryRow { grid-template-columns:1fr; }
  .pageHeaderArea { flex-direction:column; }
  .downloadAllButton { width:100%; }
}

@media (max-width:600px) {
  .mainContent { padding:16px; }
  .reportSummaryRow { flex-direction:column; align-items:flex-start; gap:8px; }
  .detailsHeader { align-items:flex-start; }
  .detailsHeaderActions { flex-shrink:0; }
  .detailsToolbar { padding:7px 8px; }
  .detailsSearchBox { width:170px; }
  .detailsBottomBar { flex-direction:column; align-items:flex-start; }
}

let circleValue = hasWholeBank
  ? (selectedCircle?.code || "")
  : (user?.circleCode || "");

switch (user?.roleAccess) {
  case "W":
    circleValue = selectedCircle?.code || "";
    break;
  case "C":
  case "B":
    circleValue = user?.circleCode || "";
    break;
  default:
    circleValue = "";
}

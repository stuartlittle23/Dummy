    public Map<String, Page<?>> getDifference(BranchPosDifferenceReqDTO dto) {
        Map<String, Page<?>> result = new HashMap<>();
        String userDate = dto.getDate();
        String branchCode = dto.getBranch();
        DifferenceType requestedType = dto.getDifferenceType();
        Map<String, Integer> pageModel = Optional.ofNullable(dto.getPaginationModel()).orElse(Map.of("page", 0, "pageSize", 100));
        PageRequest pageRequest = PageRequest.of(pageModel.get("page"), pageModel.get("pageSize"));
        if (requestedType == null) {
            result.put("BCD", diffRepo.fetchDifferenceDatewise(branchCode, userDate, pageRequest));
            result.put("CSD", suspenseDiffRepo.fetchDifferenceDatewise(userDate, branchCode, "1111111111", pageRequest));
            result.put("TSD", suspenseDiffRepo.fetchDifferenceDatewise(userDate, branchCode, "1260505001", pageRequest));
        } else {
            result.put(requestedType.toString(), switch (requestedType) {
                case BCD -> {
                    yield diffRepo.fetchDifferenceDatewise(branchCode, userDate, pageRequest);
                }
                case CSD -> {
                    yield suspenseDiffRepo.fetchDifferenceDatewise(userDate, branchCode, "1111111111", pageRequest);
                }
                case TSD -> {
                    yield suspenseDiffRepo.fetchDifferenceDatewise(userDate, branchCode, "1260505001", pageRequest);
                }
            });
        }
        return result;
    }

    public List<?> getDetailedDifference(DetailedDifferenceReqDTO dto) {
        LocalDate startDate = dto.getStartDate();
        LocalDate endDate = dto.getEndDate();
        DifferenceType type = dto.getDifferenceType();
        String branch = dto.getBranch();
        String currency = dto.getCurrency();
        String cgl = dto.getCgl();
        return switch (type) {
            case BCD -> {
                yield diffRepo.fetchDetailedDifference(branch, endDate, startDate, cgl, currency);
            }
            case CSD -> {
                yield suspenseDiffRepo.fetchDetailedDifference(endDate, startDate, branch, "1111111111", currency);
            }
            case TSD -> {
                yield suspenseDiffRepo.fetchDetailedDifference(endDate, startDate, branch, "1260505001", currency);
            }
        };
    }

    @Transactional(readOnly = true)
    public StreamingResponseBody exportDifferenceData(BranchPosDifferenceReqDTO req) {
        String branchCode = req.getBranch();
        String userDate = req.getDate();
        DifferenceType differenceType = req.getDifferenceType();
        final SXSSFWorkbook workbook = new SXSSFWorkbook(100);

        SXSSFSheet sheet = workbook.createSheet(req.getDifferenceType().toString());
        sheet.trackAllColumnsForAutoSizing();
        Map<String, CellStyle> styles = getCellStyles(workbook);
        CellStyle numberStyle = styles.get("numeric");

        final AtomicInteger rowNum = new AtomicInteger(0);

        String queryBalCom = """
                SELECT TO_CHAR(recon_run_date, 'DD-MM-YYYY') as report_date,TO_CHAR(first_error_date, 'DD-MM-YYYY') as first_error_date,branch_code,currency,cgl,cbs_balance,gl_balance,difference_amount,diff_bw_yesterday,type,head
                FROM difference WHERE branch_code =?
                AND recon_run_date = to_date(?, 'YYYY-MM-DD')
                and difference_amount <> 0
                """;

        String querySuspense = """
                SELECT TO_CHAR(balance_date, 'DD-MM-YYYY') as report_date,TO_CHAR(first_error_date, 'DD-MM-YYYY') as first_error_date,branch_code,currency,cgl,balance,inr_balance,type
                FROM SUSPENSE_TRACKER
                WHERE branch_code = ?
                AND balance_date = to_date( ?, 'YYYY-MM-DD')
                AND cgl = ?
                AND balance <> 0
                """;

        int columnCount = 0;
        Map<String, Object> queryMeta = new HashMap<>();
        List<Object> parameters = new ArrayList<>();
        parameters.add(branchCode);
        parameters.add(userDate);
        switch ((DifferenceType) differenceType) {
            case BCD -> {
                columnCount = 11;
                queryMeta.put("query", queryBalCom);
            }
            case CSD -> {
                columnCount = 8;
                queryMeta.put("query", querySuspense);
                parameters.add(suspenseCgl);
            }
            case TSD -> {
                columnCount = 8;
                queryMeta.put("query", queryBalCom);
                parameters.add(suspenseTechnical);
            }
        }
        queryMeta.put("parameters", parameters);

        RowCallbackHandler handler = getHandler(sheet, rowNum, columnCount, numberStyle);
        executeQuery(queryMeta, handler);

        return outputStream -> {
            autoSizeSheetAndUntrack(sheet);
            workbook.write(outputStream);
            workbook.close(); // Deletes temp files
        };
    }


                    // 2. Level 2 7-day restriction from ETL/Report date
                    let isWithin7Days = true;
                    if (level === 2) {
                        const recordDateStr = params.row?.reconRunDate || params.row?.date;
                        const baseDate = reportDate ? new Date(reportDate) : new Date();
                        const recDate = recordDateStr ? new Date(recordDateStr) : null;
                        
                        if (recDate) {
                            const diffTime = baseDate - recDate;
                            const diffDays = diffTime / (1000 * 60 * 60 * 24);
                            isWithin7Days = diffDays >= 0 && diffDays <= 7;
                        }
                    }

                    // Render the download button (disabled if outside the 7-day window)
                    return (
                        <IconButton
                            onClick={() => isWithin7Days && onDownloadRow(params.row)}
                            disabled={!isWithin7Days}
                            size="small"
                            title={isWithin7Days ? "Download GLIF Details" : "Download restricted to records within the last 7 days"}
                        >
                            <Download fontSize="small" color={isWithin7Days ? "inherit" : "disabled"} />
                        </IconButton>
                    );

import React,{useMemo,useState} from "react";
import {Box,Paper,Typography,Button} from "@mui/material";
import {DataGrid,GridOverlay} from "@mui/x-data-grid";
import {Download,Visibility,ExpandMore} from "@mui/icons-material";
import styles from "./BranchPosition.module.css";

const titles={
    reconRunDate:"Report Date",date:"Report Date",firstErrorDate:"First Error Date",
    branchCode:"Branch Code",currency:"Currency",cgl:"CGL",balance:"Amount",
    inrBalance:"INR Balance",cbsBalance:"CBS Balance",glBalance:"GL Balance",
    differenceAmount:"Difference Amount",diffBwYesterday:"Diff Bw Yesterday",
    type:"Type",head:"Head"
};

const formatTitle=k=>titles[k]||k.replace(/([a-z])([A-Z])/g,"$1 $2").replace(/^./,x=>x.toUpperCase());

export default function DisplayTab({level,type,data={},category,clickHandler=()=>{},downloadHandler=()=>{},requestData=()=>{},loading=false}){
    const [paginationModel,setPaginationModel]=useState({page:0,pageSize:100});
    const rows=data?.content||[];

    const columns=useMemo(()=>{
        if(!rows.length)return[];
        const fields=Object.keys(rows[0]);
        const cols=fields.filter(f=>f!=="id").map(f=>({
            field:f,headerName:formatTitle(f),flex:["balance","inrBalance","cbsBalance","glBalance","differenceAmount","diffBwYesterday"].includes(f)?1.3:1,
            minWidth:100,align:typeof rows[0][f]==="number"?"right":"left",headerAlign:typeof rows[0][f]==="number"?"right":"left",
            sortable:true,filterable:true
        }));
        if(level===1)cols.push({
            field:"action",headerName:"Action",width:80,sortable:false,filterable:false,align:"center",headerAlign:"center",
            renderCell:p=><Button size="small" className={styles.viewButton} onClick={()=>clickHandler(type,p.row)}><Visibility/></Button>
        });
        return cols;
    },[rows,level,type]);

    const download=()=>downloadHandler(type,type);

    return(
        <Paper className={styles.tableCard}>
            {level===1&&<Box className={styles.tableHeader}>
                <Box><Typography className={styles.tableTitle}>{category}</Typography></Box>
                <Box className={styles.tableHeaderRight}>
                    <Typography className={styles.rowBadge}>{rows.length} rows</Typography>
                    <Button size="small" variant="outlined" startIcon={<Download/>} onClick={download} disabled={!rows.length}>Download</Button>
                    <ExpandMore/>
                </Box>
            </Box>}
            <DataGrid
                rows={rows}
                columns={columns}
                getRowId={r=>r.id||`${r.head||""}-${r.cgl||""}-${r.currency||""}-${r.date||r.reconRunDate||""}`}
                pagination={level===1}
                paginationMode="server"
                paginationModel={paginationModel}
                onPaginationModelChange={m=>{setPaginationModel(m);requestData(type,m)}}
                rowCount={data?.page?.totalElements||rows.length}
                pageSizeOptions={[100]}
                loading={loading}
                hideFooter={!rows.length}
                hideFooterPagination={level===2}
                disableRowSelectionOnClick
                sx={{
                    border:0,
                    "& .MuiDataGrid-columnHeaders":{background:"rgba(246,245,252,.75)",borderBottom:"1px solid #e5e3ed"},
                    "& .MuiDataGrid-cell":{borderBottom:"1px solid #eeeef4"},
                    "& .MuiDataGrid-columnHeader:focus,& .MuiDataGrid-cell:focus":{outline:"none"}
                }}
                slots={{
                    noRowsOverlay:()=> <GridOverlay><Typography color="text.secondary">No records found</Typography></GridOverlay>
                }}
            />
        </Paper>
    );
}

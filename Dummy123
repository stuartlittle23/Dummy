<Box className={styles.bankIllustration}>
  <Box className={styles.bankGlow}>
    <AccountBalance className={styles.bankIcon} />
  </Box>
  <AutoAwesome className={styles.bankSparkle1} />
  <AutoAwesome className={styles.bankSparkle2} />
  <AutoAwesome className={styles.bankSparkle3} />
</Box>




.bankIllustration {
  position: relative;
  width: 100%;
  height: 190px;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  overflow: hidden;
}

.bankGlow {
  width: 150px;
  height: 150px;
  border-radius: 50% 50% 0 0;
  background: radial-gradient(circle, rgba(108,92,231,0.22) 0%, rgba(108,92,231,0.08) 50%, transparent 72%);
  display: flex;
  justify-content: center;
  align-items: center;
}

.bankIcon {
  font-size: 105px !important;
  color: #6C5CE7;
  opacity: 0.8;
}

.bankSparkle1 {
  position: absolute;
  top: 20px;
  left: 22%;
  color: #B8AEFB;
  font-size: 16px !important;
}

.bankSparkle2 {
  position: absolute;
  top: 42px;
  right: 20%;
  color: #C9BFFC;
  font-size: 12px !important;
}

.bankSparkle3 {
  position: absolute;
  top: 75px;
  left: 30%;
  color: #DCD5FE;
  font-size: 9px !important;
}

@Query("""
       SELECT r FROM RequestVoucher r
       WHERE (:vid IS NULL
              OR LOWER(r.vid) LIKE LOWER(CONCAT('%', :vid, '%')))
       AND (:fromDate IS NULL
              OR :toDate IS NULL
              OR r.createdAt BETWEEN :fromDate AND :toDate)
       """)
List<RequestVoucher> searchVoucher(
        @Param("vid") String vid,
        @Param("fromDate") Timestamp fromDate,
        @Param("toDate") Timestamp toDate);


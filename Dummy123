// WITH THIS:
onPaginationModelChange={(model) => {
  setFetchConf((prev) => {
    if (prev.page === model.page && prev.pageSize === model.pageSize) {
      return prev; // Prevents redundant resets
    }
    return { ...prev, page: model.page, pageSize: model.pageSize };
  });
}}





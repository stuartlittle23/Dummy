onInputChange={(event, newInputValue, reason) => {
  if (reason === "reset") return; // Prevents internal MUI resets from wiping data
  if (newInputValue.length > 30) return;

  setBranchSearch(newInputValue);

  if (newInputValue.length >= 3) {
    fetchSearchData("branch", newInputValue);
  } else if (newInputValue.length === 0) {
    setBranches([]); // Only clear options if the user manually deletes everything
  }
}}
onChange={(_, val) => {
  handleBranchChange(val);
  // REMOVED setBranchSearch("") from here so it doesn't clear your results on select!
}}

import com.fincore.JournalService.Dto.RequestVoucherDto;
import com.fincore.JournalService.Models.RequestVoucher;
import com.fincore.JournalService.Models.VoucherCategory;
import com.fincore.JournalService.Repository.RequestVoucherRepository;
import com.fincore.JournalService.Repository.VoucherCategoryRepository;

import java.sql.Timestamp;
import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.util.List;




@Autowired
private RequestVoucherRepository requestVoucherRepository;

@Autowired
private VoucherCategoryRepository voucherCategoryRepository;


@Override
public RequestVoucher createRequest(RequestVoucherDto dto) {

    String category = dto.getCategory();

    if ("Other".equalsIgnoreCase(category)) {

        category = dto.getCustomCategory();

        if (!voucherCategoryRepository
                .existsByCategoryName(category)) {

            VoucherCategory voucherCategory =
                    new VoucherCategory();

            voucherCategory.setCategoryName(category);
            voucherCategory.setCreatedDate(
                    new Timestamp(System.currentTimeMillis()));

            voucherCategoryRepository.save(voucherCategory);
        }
    }

    RequestVoucher requestVoucher =
            new RequestVoucher();

    requestVoucher.setVid(generateVid());
    requestVoucher.setCategory(category);
    requestVoucher.setDescription(dto.getDescription());
    requestVoucher.setAllowedRole(dto.getAllowedRole());
    requestVoucher.setSdReqNo(dto.getSdReqNo());
    requestVoucher.setCreatedBy(dto.getCreatedBy());
    requestVoucher.setRemarks(dto.getRemarks());

    requestVoucher.setStatus("AVAILABLE");

    requestVoucher.setCreatedAt(
            new Timestamp(System.currentTimeMillis()));

    return requestVoucherRepository.save(requestVoucher);
}

@Override
public List<RequestVoucher> getAllRequests() {

    return requestVoucherRepository.findAll();
}






private String generateVid() {

    String yearMonth = LocalDate.now()
            .format(DateTimeFormatter.ofPattern("yyMM"));

    long count = requestVoucherRepository.count() + 1;

    return "VID-" + yearMonth + "-"
            + String.format("%05d", count);
}








          </Grid>

          {/* 2. CURRENCY */}
          <Grid size={{ xs: 12, sm: 6, md: fieldGridSize }}>
            <Box sx={{ height: "100%" }}>
              <Autocomplete
                autoHighlight
                disabled={glccValidated}
                options={currencies || []}
                value={userInputs?.currency || null}
                inputValue={currencyInput}
                onOpen={fetchCurrencies}
                // onChange={(event, newValue) => update("currency", newValue)}
                onInputChange={(e, value, reason) => {
                  if (reason === "input" && !CURRENCY_ALLOWED_REGEX.test(value)) {
                    return;
                  }

                  setCurrencyInput(value);
                }}

                onChange={(event, newValue) => {
                  update("currency", newValue);
                  setCurrencyInput(newValue || "");
                }}
                renderInput={(params) => (
                  <TextField
                    {...params}
                    fullWidth
                    label="Currency*"
                    InputLabelProps={{ shrink: true }}
                    placeholder="Select Currency"
                    sx={{
                      "& .MuiInputLabel-root": {
                        fontWeight: 500,
                        color: "text.primary",
                      },
                      "& .MuiOutlinedInput-root": {
                        backgroundColor: "transparent",
                      },
                    }}
                  />
                )}
              />
            </Box>
          </Grid>

          {/* 3. CGL */}
          <Grid size={{ xs: 12, sm: 6, md: fieldGridSize }}>
            <Box sx={{ height: "100%" }}>
              <Autocomplete
                disabled={glccValidated}
                forcePopupIcon={false}
                autoHighlight
                value={userInputs?.cgl || ""}
                inputValue={cglInput}
                loading={!req.cgl && loading.cgl}
                options={cgls}
                noOptionsText={
                  req.cgl ? "Please enter at least 3 characters" : "No Options"
                }
                onInputChange={(e, value, reason) => {
                  if (reason === "input" && !CGL_ALLOWED_REGEX.test(value)) {
                    return;
                  }
                  setCglInput(value);
                  handleSearchChange(value, reason, "cgl");
                }}
                onChange={(e, value) => {
                  update("cgl", value);
                  setCglInput(value || "");
                }}


                // onInputChange={(e, value, reason) =>
                //   handleSearchChange(value, reason, "cgl")
                // }
                // onChange={(e, value) => update("cgl", value)}
                renderInput={(params) => (
                  <TextField
                    {...params}
                    fullWidth
                    label="CGL*"
                    InputLabelProps={{ shrink: true }}
                    placeholder="eg. 9999999999"
                    sx={{
                      "& .MuiInputLabel-root": {
                        fontWeight: 500,
                        color: "text.primary",
                      },
                      "& .MuiOutlinedInput-root": {
                        backgroundColor: "transparent",
                      },
                    }}
                    slotProps={{
                      htmlInput: {
                        ...params.inputProps,
                        maxLength: isNumeric(params.inputProps.value) ? 10 : 30,
                      },
                    }}
                  />
                )}
              />
            </Box>
          </Grid>

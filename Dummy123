        if ((level === 1 || level === 2) && type === "TSD") {
            cols.push({
                field: "rowDownload",
                headerName: "Download",
                headerAlign: "center",
                align: "center",
                width: 90,
                sortable: false,
                filterable: false,
                disableColumnMenu: true,
                renderCell: (params) => {
                    // 1. Check if head or type is 'ZERO_DIFFERENCE'
                    const headVal = (params.row?.head || "").toUpperCase();
                    const typeVal = (params.row?.type || "").toUpperCase();
                    if (headVal === "ZERO_DIFFERENCE" || typeVal === "ZERO_DIFFERENCE") {
                        return null;
                    }

                    // 2. Level 2 7-day restriction from ETL/Report date
                    if (level === 2) {
                        const recordDateStr = params.row?.reconRunDate || params.row?.date;
                        const baseDate = reportDate ? new Date(reportDate) : new Date();
                        const recDate = recordDateStr ? new Date(recordDateStr) : null;
                        
                        if (recDate) {
                            const diffTime = baseDate - recDate;
                            const diffDays = diffTime / (1000 * 60 * 60 * 24);
                            const isWithin7Days = diffDays >= 0 && diffDays <= 7;
                            
                            if (!isWithin7Days) {
                                return null;
                            }
                        }
                    }

                    // 3. Render the download button if it passes all checks
                    return (
                        <IconButton
                            onClick={() => onDownloadRow(params.row)}
                            size="small"
                            title="Download GLIF Details"
                        >
                            <Download fontSize="small" />
                        </IconButton>
                    );
                },
            });
        }

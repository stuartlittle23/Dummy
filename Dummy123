import React from "react";
import {
  Box,
  Button,
  Paper,
  Typography,
  IconButton,
} from "@mui/material";
import { DataGrid } from "@mui/x-data-grid";
import HistoryIcon from "@mui/icons-material/History";

const BalanceRangeSearchTable = ({
  rows = [],
  loading = false,
  totalElements = 0,
  paginationModel,
  setPaginationModel,
  onEditFilters,
  onHistoryClick,
}) => {
  const columns = [
    {
      field: "branchCode",
      headerName: "Branch",
      flex: 1,
      minWidth: 120,
    },
    {
      field: "currency",
      headerName: "Currency",
      flex: 1,
      minWidth: 120,
    },
    {
      field: "cgl",
      headerName: "CGL",
      flex: 1,
      minWidth: 150,
    },
    {
      field: "cbsBalance",
      headerName: "CBS Balance",
      flex: 1,
      minWidth: 150,
    },
    {
      field: "glBalance",
      headerName: "GL Balance",
      flex: 1,
      minWidth: 150,
    },
    {
      field: "differenceAmount",
      headerName: "Difference Amount",
      flex: 1,
      minWidth: 170,
      renderCell: (params) => (
        <Typography
          sx={{
            fontWeight: 700,
            color:
              Number(params.value) < 0
                ? "#d32f2f"
                : "#2e7d32",
          }}
        >
          {params.value !== null &&
          params.value !== undefined
            ? Number(params.value).toLocaleString()
            : "-"}
        </Typography>
      ),
    },
    {
      field: "differenceYesterday",
      headerName: "Diff. Yesterday",
      flex: 1,
      minWidth: 160,
      renderCell: (params) => (
        <Typography>
          {params.value !== null &&
          params.value !== undefined
            ? Number(params.value).toLocaleString()
            : "-"}
        </Typography>
      ),
    },
    {
      field: "action",
      headerName: "Action",
      minWidth: 90,
      sortable: false,
      filterable: false,
      renderCell: (params) => (
        <IconButton
          color="primary"
          onClick={() => {
            if (onHistoryClick) {
              onHistoryClick(params.row);
            }
          }}
        >
          <HistoryIcon />
        </IconButton>
      ),
    },
  ];

  return (
    <Box sx={{ width: "100%", mt: 3 }}>
      {/* RESULT HEADER */}
      <Box
        sx={{
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
          mb: 1.5,
        }}
      >
        <Box>
          <Typography
            sx={{
              fontSize: "18px",
              fontWeight: 700,
              color: "#202060",
            }}
          >
            Difference Records
          </Typography>

          <Typography
            sx={{
              fontSize: "13px",
              color: "#777",
              mt: 0.3,
            }}
          >
            {loading
              ? "Loading records..."
              : `${Number(totalElements || 0).toLocaleString()} record(s) found`}
          </Typography>
        </Box>

        <Button
          variant="outlined"
          onClick={onEditFilters}
          sx={{
            textTransform: "none",
            borderRadius: "8px",
            minWidth: "120px",
          }}
        >
          Edit Filters
        </Button>
      </Box>

      {/* TABLE */}
      <Paper
        elevation={0}
        sx={{
          width: "100%",
          borderRadius: "12px",
          overflow: "hidden",
          border: "1px solid #e0e0e0",
          backgroundColor: "#fff",
        }}
      >
        <DataGrid
          rows={rows || []}
          columns={columns}
          loading={loading}
          rowCount={totalElements || 0}
          paginationMode="server"
          paginationModel={paginationModel}
          onPaginationModelChange={setPaginationModel}
          pageSizeOptions={[10, 25, 50]}
          autoHeight
          disableRowSelectionOnClick
          disableColumnResize={false}
          sx={{
            border: "none",

            "& .MuiDataGrid-columnHeaders": {
              backgroundColor: "#f7f7fb",
              fontWeight: 700,
            },

            "& .MuiDataGrid-columnHeaderTitle": {
              fontWeight: 700,
              color: "#202060",
            },

            "& .MuiDataGrid-cell": {
              fontSize: "14px",
            },

            "& .MuiDataGrid-footerContainer": {
              borderTop: "1px solid #eeeeee",
            },
          }}
          localeText={{
            noRowsLabel:
              "No difference records available for the selected criteria",
          }}
        />
      </Paper>
    </Box>
  );
};

export default BalanceRangeSearchTable;

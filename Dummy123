.page{display:flex;gap:14px;width:100%;height:calc(100vh - 32px);min-height:620px;padding:10px;box-sizing:border-box;overflow:hidden;background:linear-gradient(135deg,#faf9ff,#f3f0fb,#faf9ff)}
.sidebar{position:relative;display:flex;flex-direction:column;width:280px;min-width:280px;height:100%;min-height:620px;box-sizing:border-box;overflow:hidden;padding:18px;background:rgba(245,243,255,.62);border:1px solid rgba(255,255,255,.72);border-radius:20px;box-shadow:0 8px 28px rgba(76,55,170,.1);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}
.brand{position:relative;display:flex;align-items:center;gap:12px;padding:4px 2px 18px}.brandIcon{width:58px;height:58px;display:flex;align-items:center;justify-content:center;border-radius:15px;background:linear-gradient(145deg,rgba(112,83,220,.12),rgba(255,255,255,.8));color:#5135c9}.brandIcon svg{font-size:32px}.brandTitle{font-size:18px!important;font-weight:700!important;color:#17203a}.brandLine{width:48px;height:3px;margin-top:8px;border-radius:4px;background:#6744d8}.sidebarSparkle{position:absolute;right:2px;top:0;color:#9a83ed;font-size:25px!important}
.infoCard{padding:14px 14px 8px;border:1px solid rgba(255,255,255,.75);border-radius:16px;background:rgba(250,249,255,.48);box-shadow:0 4px 18px rgba(76,55,170,.06);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}.infoCard hr{margin:8px 0;border-color:rgba(70,60,130,.1)}.infoItem{display:flex;align-items:center;gap:12px;padding:12px 2px;min-width:0}.infoItem>div:last-child{min-width:0;flex:1}.infoIcon{width:42px;height:42px;min-width:42px;display:flex;align-items:center;justify-content:center;border-radius:12px;background:rgba(105,76,215,.08);color:#5135c9}.infoIcon svg{font-size:22px}.infoLabel{font-size:11px!important;font-weight:700!important;letter-spacing:.5px;color:#59617a}.infoValue{font-size:20px!important;font-weight:700!important;line-height:1.2;color:#17203a}.infoSub{font-size:14px!important;font-weight:500!important;margin-top:3px;color:#59617a}
.dateInfo{min-width:0!important;width:100%}.dateInfo :global(.MuiFormControl-root){width:100%!important;min-width:0!important}.dateInfo :global(.MuiInputBase-root){width:100%!important;min-width:0!important;padding-right:4px!important;font-size:14px!important;background:rgba(255,255,255,.55);border-radius:10px}.dateInfo :global(.MuiInputBase-input){font-size:14px!important;padding:9px 4px!important;min-width:0!important}.dateInfo :global(.MuiIconButton-root){padding:5px!important}.dateInfo :global(.MuiSvgIcon-root){font-size:19px!important}
.navigation{display:flex;flex-direction:column;gap:9px;margin-top:18px}.navButton{width:100%!important;justify-content:flex-start!important;text-transform:none!important;font-size:14px!important;font-weight:600!important;color:#27304a!important;padding:12px 16px!important;border-radius:11px!important;min-height:46px!important;background:rgba(255,255,255,.42)!important;border:1px solid rgba(255,255,255,.72)!important;box-shadow:0 3px 10px rgba(76,55,170,.07)!important;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}.navButton :global(.MuiButton-startIcon){color:#4e3aaf!important}.activeNav{color:#fff!important;background:linear-gradient(135deg,#5637c9,#6849d8)!important;border:1px solid rgba(255,255,255,.25)!important;box-shadow:0 6px 16px rgba(86,55,201,.28)!important}.activeNav :global(.MuiButton-startIcon){color:#fff!important}
.sidebarArtwork{position:relative;flex:0 0 205px;height:205px;min-height:205px;margin:8px -4px 0;display:flex;align-items:flex-end;justify-content:center;overflow:hidden}.artGlow{width:180px;height:135px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:radial-gradient(circle,rgba(126,99,226,.22),rgba(126,99,226,.05) 65%,transparent 70%);filter:drop-shadow(0 10px 18px rgba(92,68,190,.15))}.artBank{font-size:82px!important;color:#7860d9;filter:drop-shadow(0 8px 8px rgba(85,61,180,.18))}.artBase{position:absolute;bottom:4px;width:190px;height:14px;border-radius:50%;background:rgba(102,77,201,.11);box-shadow:0 -8px 22px rgba(102,77,201,.12)}.artSparkleOne{position:absolute;left:30px;bottom:105px;font-size:18px!important;color:#a797ed}.artSparkleTwo{position:absolute;right:28px;bottom:145px;font-size:13px!important;color:#c0b5f5}
.main{flex:1;min-width:0;height:100%;overflow:hidden}.mainPanel{height:100%;overflow:auto;padding:20px;background:rgba(248,247,255,.58);border:1px solid rgba(255,255,255,.75);border-radius:18px;box-shadow:0 8px 28px rgba(76,55,170,.07);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);box-sizing:border-box}
.pageHeader{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px}.pageTitle{font-size:25px!important;font-weight:700!important;color:#121a32!important;line-height:1.2!important}.pageSubtitle{font-size:13px!important;color:#59647d!important;margin-top:5px!important}
.summaryGrid{width:100%!important;margin:0 0 14px!important}.summaryGrid>.MuiGrid-item{min-width:0!important}.summaryCard{width:100%;height:145px;padding:18px!important;position:relative;display:flex;align-items:flex-start;gap:13px;border-radius:14px!important;background:rgba(255,255,255,.62)!important;border:1px solid rgba(255,255,255,.78)!important;box-shadow:0 5px 18px rgba(60,45,130,.07)!important;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);box-sizing:border-box}.summaryIcon{width:48px;height:48px;flex-shrink:0;border-radius:14px;display:flex;align-items:center;justify-content:center;background:#f3efff}.summaryIcon svg{font-size:27px}.summaryContent{min-width:0}.summaryTitle{font-size:14px!important;font-weight:700!important;color:#172039!important;margin-top:2px!important}.summaryCount{font-size:30px!important;font-weight:700!important;line-height:1.1!important;margin-top:9px!important}.summaryLabel{font-size:12px!important;color:#5d6780!important;margin-top:4px!important}.summaryCard.violet .summaryIcon{color:#5b3dcc;background:#f0ebff}.summaryCard.violet .summaryCount{color:#5537c8}.summaryCard.green .summaryIcon{color:#15966d;background:#e8f8f1}.summaryCard.green .summaryCount{color:#15966d}.summaryCard.orange .summaryIcon{color:#e88b10;background:#fff3df}.summaryCard.orange .summaryCount{color:#e88b10}.cardDownload{position:absolute!important;right:16px;bottom:16px;text-transform:none!important;font-size:12px!important;border-radius:7px!important}
.sections{display:flex;flex-direction:column;gap:10px;width:100%}.sections>*{width:100%!important;min-width:0!important;box-sizing:border-box!important}.infoBanner{width:100%;margin-top:12px;padding:12px 16px!important;border-radius:12px!important;background:rgba(255,255,255,.48)!important;border:1px solid rgba(255,255,255,.72)!important;color:#59647d!important;font-size:12px!important;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.glifPanel{width:100%;box-sizing:border-box;padding:0!important;background:transparent!important;box-shadow:none!important}.glifHeader{width:100%;margin-bottom:18px}.glifTitle{font-size:24px!important;font-weight:700!important;color:#172039!important;line-height:1.2!important}.glifSubtitle{font-size:13px!important;color:#59647d!important;margin-top:5px!important}
.glifFilterCard,.appliedFilterCard{width:100%;box-sizing:border-box;padding:18px!important;margin-bottom:14px;border-radius:14px!important;background:rgba(255,255,255,.58)!important;border:1px solid rgba(255,255,255,.78)!important;box-shadow:0 5px 18px rgba(60,45,130,.07)!important;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}.glifSectionHeader,.appliedHeader{display:flex;align-items:center;justify-content:space-between;width:100%;margin-bottom:12px}.filterTitle{font-size:14px!important;font-weight:700!important;color:#26304a!important;margin:0!important}.filterHint{font-size:11px!important;color:#7b8499!important;margin-top:3px!important}.filterRow{width:100%;min-width:0}.filterRow>div{width:100%!important;min-width:0!important}
.appliedFilterCard{min-height:110px}.emptyFilter{width:100%;padding:18px 4px;color:#8a92a5}.emptyFilter p{font-size:12px!important}.appliedList{display:flex;flex-direction:column;gap:8px;width:100%}.appliedFilter{display:flex;align-items:center;gap:12px;width:100%;box-sizing:border-box;padding:9px 11px;border-radius:9px;background:rgba(245,243,252,.78);border:1px solid rgba(90,70,170,.08)}.appliedLabel{font-size:11px!important;font-weight:700!important;color:#4e3ab0!important;min-width:145px}.appliedValues{display:flex;flex-wrap:wrap;gap:5px;flex:1;min-width:0}.appliedValues .MuiChip-root{font-size:11px;height:26px}.clearFilterButton,.clearAllButton{font-size:11px!important;text-transform:none!important;color:#5739c8!important;min-width:auto!important}.glifDownload{display:flex;justify-content:flex-end;width:100%;margin-top:16px}.glifDownload button{font-size:12px!important;text-transform:none!important;background:#5739c8!important;box-shadow:0 5px 14px rgba(87,57,200,.22)!important}
.dialogTitle{display:flex!important;align-items:center;justify-content:space-between;font-size:15px!important}
@media(max-width:1100px){.summaryCard{padding:14px!important}.summaryTitle{font-size:13px!important}.summaryCount{font-size:26px!important}.cardDownload{right:12px;bottom:12px}.filterRow{overflow-x:auto;padding-bottom:2px}}
@media(max-width:1000px){.page{height:auto;min-height:0;overflow:visible;flex-direction:column}.sidebar{width:100%;min-width:0;height:auto}.main{height:auto}.mainPanel{height:auto;overflow:visible}.summaryCard{height:135px}.glifFilterCard,.appliedFilterCard{padding:14px!important}}


[
  `Branch: ${userInputs?.branch}`,
  `Currency: ${userInputs?.currency}`,
  `CGL: ${userInputs?.cgl}`,
  `Date: ${dayjs(userInputs?.fromDate).format(
    "DD MMM"
  )} - ${dayjs(userInputs?.toDate).format(
    "DD MMM YYYY"
  )}`,
  ...(
    userInputs?.minAmount || userInputs?.maxAmount
      ? [
          `Amount: ${
            userInputs?.minAmount || 0
          } - ${
            userInputs?.maxAmount || "∞"
          }`,
        ]
      : []
  ),
]

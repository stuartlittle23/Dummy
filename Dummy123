import React, { useState, useCallback, useEffect } from "react";
import { Autocomplete, Box, Button, Card, CardContent, Dialog, DialogActions, DialogContent, DialogTitle, Grid, IconButton, InputAdornment, Paper, TextField, Typography } from "@mui/material";
import { DatePicker, LocalizationProvider } from "@mui/x-date-pickers";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";
import SearchIcon from "@mui/icons-material/Search";
import RestartAltIcon from "@mui/icons-material/RestartAlt";
import CloseIcon from "@mui/icons-material/Close";
import CalendarMonthIcon from "@mui/icons-material/CalendarMonth";
import useApi from "../../hooks/useApi";
import useValidation from "./Validation";
import dayjs from "dayjs";
import BalanceDateWiseTable from "./Components/BalanceDateWiseTable";

const BalanceParticularSearchScreen = () => {
  const { callApi } = useApi();
  const { validateBranchCode, validateCurrency, validateCGL } = useValidation();

  const [filters, setFilters] = useState({ date: "", branchCode: "", currency: "", cgl: "" });
  const [rows, setRows] = useState([]);
  const [loading, setLoading] = useState(false);
  const [totalElements, setTotalElements] = useState(0);
  const [etlDate, setEtlDate] = useState(null);
  const [filtersExpanded, setFiltersExpanded] = useState(true);
  const [openHistory, setOpenHistory] = useState(false);
  const [selectedRow, setSelectedRow] = useState(null);
  const [paginationModel, setPaginationModel] = useState({ page: 0, pageSize: 25 });

  const updateFilter = (key, value) => setFilters((prev) => ({ ...prev, [key]: value }));

  const fetchData = useCallback(async (date, pageIndex = 0, pageSize = 25) => {
    if (!date) return;
    setLoading(true);
    try {
      const payload = { fromDate: date, toDate: date, branchCode: filters.branchCode || null, currency: filters.currency || null, cgl: filters.cgl || null };
      const response = await callApi(`/ES/differences/search?page=${pageIndex}&size=${pageSize}`, payload, "POST");
      const content = response?.data?.content || response?.content || [];
      const mappedRows = content.map((item, index) => ({ id: item.id || `row-${pageIndex}-${index}`, ...item, GLCC_VAL: `${item.branchCode || ""} ${item.currency || ""} ${item.cgl || ""}` }));
      setRows(mappedRows);
      setTotalElements(response?.data?.totalElements || response?.totalElements || 0);
      setFiltersExpanded(false);
    } catch (err) {
      console.error("Search Fail:", err);
      setRows([]);
      setTotalElements(0);
    } finally {
      setLoading(false);
    }
  }, [callApi, filters]);

  useEffect(() => {
    const fetchDefaultETLDate = async () => {
      try {
        const response = await callApi("/PS/file/fincore-date", {}, "GET");
        const rawDate = response?.data?.userDate || response?.data?.etlDate || response?.date || "";
        const date = rawDate ? dayjs(rawDate.split("T")[0]).format("YYYY-MM-DD") : "";
        if (date) {
          setEtlDate(date);
          updateFilter("date", date);
        }
      } catch (err) {
        console.error("ETL Date Error:", err);
      }
    };
    fetchDefaultETLDate();
  }, [callApi]);

  useEffect(() => {
    if (filters.date && !filtersExpanded) fetchData(filters.date, paginationModel.page, paginationModel.pageSize);
  }, [paginationModel.page, paginationModel.pageSize]);

  const handleSearch = () => {
    setPaginationModel((prev) => ({ ...prev, page: 0 }));
    fetchData(filters.date, 0, paginationModel.pageSize);
  };

  const handleReset = () => {
    setFilters({ date: etlDate || "", branchCode: "", currency: "", cgl: "" });
    setRows([]);
    setTotalElements(0);
    setPaginationModel({ page: 0, pageSize: 25 });
    setFiltersExpanded(true);
  };

  return (
    <Box sx={{ p: { xs: 1, sm: 2 } }}>
      <Card elevation={0} sx={{ border: "1px solid", borderColor: "divider", borderRadius: 3, overflow: "hidden" }}>
        <Box sx={{ p: { xs: 1.5, sm: 2 }, bgcolor: "background.paper", borderLeft: "6px solid", borderColor: "primary.main" }}>
          <Box sx={{ display: "flex", alignItems: "center", justifyContent: "space-between", gap: 2 }}>
            <Box sx={{ display: "flex", alignItems: "center", gap: 1.5 }}>
              <CalendarMonthIcon color="primary" sx={{ fontSize: { xs: 28, sm: 34 } }} />
              <Box>
                <Box sx={{ display: "flex", alignItems: "center", gap: 1 }}>
                  <Typography variant="subtitle1" fontWeight={700}>Date Wise Balance Search</Typography>
                  <Typography variant="caption" sx={{ px: 1, py: 0.3, borderRadius: 1.5, bgcolor: "rgba(88,70,159,0.1)", color: "primary.main", fontWeight: 700 }}>Date Wise</Typography>
                </Box>
                <Typography variant="body2" color="text.secondary">View balance differences for a selected date and track reconciliation history.</Typography>
              </Box>
            </Box>
            {rows.length > 0 && <Button variant="contained" onClick={() => setFiltersExpanded((prev) => !prev)} sx={{ textTransform: "none", borderRadius: 2, minWidth: 130 }}>{filtersExpanded ? "Hide Filters" : "Edit Filters"}</Button>}
          </Box>
        </Box>

        {filtersExpanded && (
          <CardContent sx={{ p: { xs: 1.5, sm: 2.5 } }}>
            <Grid container spacing={2}>
              <Grid item xs={12} sm={6} md={3}>
                <LocalizationProvider dateAdapter={AdapterDayjs}>
                  <DatePicker value={etlDate ? dayjs(etlDate) : null} format="DD-MM-YYYY" onChange={(value) => { const date = value ? value.format("YYYY-MM-DD") : ""; setEtlDate(date); updateFilter("date", date); }} slotProps={{ textField: { fullWidth: true, label: "ETL Date*", InputLabelProps: { shrink: true } } }} />
                </LocalizationProvider>
              </Grid>

              <Grid item xs={12} sm={6} md={3}>
                <TextField fullWidth label="Branch Code or Name*" placeholder="eg. 12345 or ABC" value={filters.branchCode} onChange={(e) => updateFilter("branchCode", validateBranchCode(e.target.value))} InputLabelProps={{ shrink: true }} />
              </Grid>

              <Grid item xs={12} sm={6} md={3}>
                <TextField fullWidth label="Currency*" placeholder="Please select Currency" value={filters.currency} onChange={(e) => updateFilter("currency", validateCurrency(e.target.value))} InputLabelProps={{ shrink: true }} />
              </Grid>

              <Grid item xs={12} sm={6} md={3}>
                <TextField fullWidth label="CGL*" placeholder="eg. 9999999999" value={filters.cgl} onChange={(e) => updateFilter("cgl", validateCGL(e.target.value))} InputLabelProps={{ shrink: true }} InputProps={{ startAdornment: <InputAdornment position="start"><SearchIcon fontSize="small" /></InputAdornment> }} />
              </Grid>

              <Grid item xs={12}>
                <Box sx={{ display: "flex", justifyContent: { xs: "stretch", sm: "flex-end" }, gap: 1.5 }}>
                  <Button variant="contained" startIcon={<RestartAltIcon />} onClick={handleReset} sx={{ textTransform: "none", borderRadius: 2, flex: { xs: 1, sm: "unset" } }}>Reset</Button>
                  <Button variant="contained" startIcon={<SearchIcon />} disabled={!filters.date || !filters.branchCode || !filters.currency || !filters.cgl} onClick={handleSearch} sx={{ textTransform: "none", borderRadius: 2, flex: { xs: 1, sm: "unset" } }}>Search</Button>
                </Box>
              </Grid>
            </Grid>
          </CardContent>
        )}
      </Card>

      {rows.length > 0 && (
        <BalanceDateWiseTable
          rows={rows}
          loading={loading}
          totalElements={totalElements}
          paginationModel={paginationModel}
          setPaginationModel={setPaginationModel}
          onHistory={(row) => { setSelectedRow(row); setOpenHistory(true); }}
        />
      )}

      <Dialog open={openHistory} onClose={() => setOpenHistory(false)} fullWidth maxWidth="md">
        <DialogTitle>
          Difference Details
          <IconButton onClick={() => setOpenHistory(false)} sx={{ position: "absolute", right: 8, top: 8 }}><CloseIcon /></IconButton>
        </DialogTitle>
        <DialogContent>
          {selectedRow && (
            <Grid container spacing={2} sx={{ mt: 0.5 }}>
              <Grid item xs={6}><Typography>Date: {selectedRow.reconRunDate}</Typography></Grid>
              <Grid item xs={6}><Typography>Branch: {selectedRow.branchCode}</Typography></Grid>
              <Grid item xs={6}><Typography>Currency: {selectedRow.currency}</Typography></Grid>
              <Grid item xs={6}><Typography>CGL: {selectedRow.cgl}</Typography></Grid>
              <Grid item xs={6}><Typography>CBS: {selectedRow.cbsBalance}</Typography></Grid>
              <Grid item xs={6}><Typography>GL: {selectedRow.glBalance}</Typography></Grid>
              <Grid item xs={12}><Typography sx={{ color: "error.main", fontWeight: 700 }}>Difference: {selectedRow.differenceAmount}</Typography></Grid>
            </Grid>
          )}
        </DialogContent>
        <DialogActions><Button onClick={() => setOpenHistory(false)}>Close</Button></DialogActions>
      </Dialog>
    </Box>
  );
};

export default BalanceParticularSearchScreen;

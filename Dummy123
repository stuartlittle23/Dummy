const SPECIAL_CHAR_MSG = "Special characters are not allowed.";




if (!GLCC_ALLOWED_REGEX.test(value)) {
  showSnackBar(SPECIAL_CHAR_MSG);
  return;
}




onInputChange={(e, value, reason) => {
  if (reason === "input" && !BRANCH_ALLOWED_REGEX.test(value)) {
    showSnackBar(SPECIAL_CHAR_MSG);
    return;
  }

  setBranchInput(value);
  handleSearchChange(value, reason, "branch");
}}






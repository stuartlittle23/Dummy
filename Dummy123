.infoBanner {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 12px 16px;
  border-radius: 10px;
  background-color: #F5F3FF;
  border: 1px solid rgba(108, 92, 231, 0.15);
  margin-top: 20px;
  background-color: rgba(255, 255, 255, 0.158);
  backdrop-filter: blur(12px);
}

.infoBannerText {
  font-size: 12.5px;
  color: rgba(30, 20, 60, 0.6);
  line-height: 1.5;
}

/* ---- Full-width GLIF sections --------------------------------------------- */

.glifSection {
  width: 100%;
  background-color: rgba(255, 255, 255, 0.493);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(108, 92, 231, 0.1);
  border-radius: 14px;
  padding: 18px 22px;
  margin-bottom: 14px;
  box-shadow: 0 1px 6px rgba(76, 60, 150, 0.05);
}

.glifSectionHeader {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
}

.glifSectionIcon {
  width: 32px;
  height: 32px;
  border-radius: 9px;
  background-color: #F5F3FF;
  color: #6C5CE7;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.glifSectionTitle {
  font-size: 14px;
  font-weight: 700;
  color: rgba(30, 20, 60, 0.87);
  flex-grow: 1;
}

.chipValues {
  display: flex;
  row-gap: 8px;
  column-gap: 8px;
  flex-wrap: wrap;
  align-items: center;
}

.filterFieldChip {
  font-weight: 600 !important;
}

.typographyLabel {
  font-size: 12.5px;
  color: rgba(30, 20, 60, 0.55);
}

.clearAllLink {
  font-size: 12px;
  font-weight: 600;
  color: #6C5CE7;
  cursor: pointer;
  background: none;
  border: none;
  padding: 0;
}

.clearAllLink:hover {
  text-decoration: underline;
}

.downloadRow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 6px 4px;
}

.downloadRowText {
  font-size: 12px;
  color: rgba(30, 20, 60, 0.5);
  line-height: 1.5;
}

.downloadRowButton {
  text-transform: none !important;
  border-radius: 8px !important;
  font-weight: 600 !important;
  flex-shrink: 0;
  box-shadow: 0 2px 8px rgba(108, 92, 231, 0.25) !important;
}

/* ---- Details dialog — CHANGE 5: much wider ------------------------------------- */

.dialogPaper {
  border-radius: 16px;
  max-height: 85vh;
  width: 65vw;
  max-width: 1400px !important;
  box-shadow: 0 12px 48px rgba(76, 60, 150, 0.2);
}

.dialogTitle {
  display: flex;
  align-items: center;
  gap: 4px;
  font-weight: 600;
  border-bottom: 1px solid rgba(108, 92, 231, 0.1);
}

.dialogTitleText {
  font-size: 15px;
  font-weight: 700;
  color: rgba(30, 20, 60, 0.87);
  flex-grow: 1;
}

.dialogButton {
  flex-grow: 0;
  margin: 4px;
}

/* ---- Empty-state box inside the grid — CHANGE 3 & 4 ------------------------------ */

.emptyStateBox {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 32px 16px;
  width: calc(100% - 32px);
  margin: 8px 16px;
  border: 1px dashed rgba(108, 92, 231, 0.25);
  border-radius: 12px;
  background-color: #FBFAFF;
}

.bankIllustration {
  position: relative;
  width: 100%;
  height: 190px;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  overflow: hidden;
}

.bankGlow {
  width: 150px;
  height: 150px;
  border-radius: 50% 50% 0 0;
  background: radial-gradient(circle, rgba(108,92,231,0.22) 0%, rgba(108,92,231,0.08) 50%, transparent 72%);
  display: flex;
  justify-content: center;
  align-items: center;
}

.bankIcon {
  font-size: 62px !important;
  color: #6C5CE7;
  opacity: 0.8;
}

.bankSparkle1 {
  position: absolute;
  top: 20px;
  left: 22%;
  color: #B8AEFB;
  font-size: 16px !important;
}

.bankSparkle2 {
  position: absolute;
  top: 42px;
  right: 20%;
  color: #C9BFFC;
  font-size: 12px !important;
}

.bankSparkle3 {
  position: absolute;
  top: 75px;
  left: 30%;
  color: #DCD5FE;
  font-size: 9px !important;
}

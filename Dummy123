isOptionEqualToValue={(option, value) =>
                            option?.value === value?.value
                          }
                          onChange={(_, value) => handleCircleChange(value)}
                          getOptionLabel={(option) => option?.label || ""}
                          renderInput={(params) => (
                            <TextField
                              {...params}
                              label="Select Circle"
                              required
                              variant="standard"
                              inputProps={{
                                ...params.inputProps,
                                maxLength: 30,
                              }}
                            />
                          )}
                        />
                      </Grid>
                    )}
                    {isBranchVisible && (
                      <Grid size={{ xs: 12, sm: isCircleVisible ? 6 : 12 }}>
                        <Autocomplete
                          multiple
                          size="small"
                          disableCloseOnSelect
                          options={["ALL", ...branches]}
                          loading={loading.branch}
                          value={filters.branches}
                          inputValue={branchSearch}
                          onInputChange={(event, newInputValue, reason) => {
                            // Prevent long typing
                            if (newInputValue.length > 30) {
                              return;
                            }

                            setBranchSearch(newInputValue);

                            if (
                              reason === "input" &&
                              newInputValue.length >= 3
                            ) {
                              fetchSearchData("branch", newInputValue);
                            }
                          }}
                          onChange={(_, val) => {
                            handleBranchChange(val);

                            // Clear search after selection
                            setBranchSearch("");
                          }}
                          renderTags={() => null}
                          // Add Checkboxes to the dropdown
                          renderOption={(props, option, { selected }) => (
                            <li {...props} key={option}>
                              <Checkbox
                                size="small"
                                style={{ marginRight: 8 }}
                                checked={selected}
                              />
                              <Typography variant="body2">{option}</Typography>
                            </li>
                          )}
                          renderInput={(p) => (
                            <TextField
                              {...p}
                              label="Select Branches"
                              variant="standard"
                              required
                              placeholder={
                                filters.branches.includes("ALL")
                                  ? "Search branches..."
                                  : ""
                              }
                              InputProps={{
                                ...p.InputProps,
                                maxLength: 30,
                                endAdornment: (
                                  <InputAdornment
                                    position="end"
                                    sx={{ mb: 0.5 }}
                                  >
                                    <Stack
                                      direction="row"
                                      alignItems="center"
                                      spacing={1}
                                    >
                                      <CustomChip
                                        label={
                                          filters.branches.includes("ALL")
                                            ? "All Branches"
                                            : `${filters.branches.length} Selected`
                                        }
                                        color={
                                          filters.branches.includes("ALL")
                                            ? "default"
                                            : "primary"
                                        }
                                        sx={{
                                          fontWeight: 700,
                                          fontSize: "0.7rem",
                                        }}
                                      />
                                      {!filters.branches.includes("ALL") &&
                                        filters.branches.length > 0 && (
                                          <IconButton
                                            size="small"
                                            onClick={() =>
                                              setViewBranchList(!viewBranchList)
                                            }
                                            color={
                                              viewBranchList
                                                ? "primary"
                                                : "default"
                                            }
                                            sx={{
                                              transition: "0.2s",
                                              bgcolor: viewBranchList
                                                ? "rgba(25, 118, 210, 0.08)"
                                                : "transparent",
                                            }}
                                          >
                                            {viewBranchList ? (
                                              <VisibilityOffIcon fontSize="small" />
                                            ) : (
                                              <VisibilityIcon fontSize="small" />
                                            )}
                                          </IconButton>
                                        )}
                                    </Stack>
                                    {p.InputProps.endAdornment}
                                  </InputAdornment>
                                ),
                              }}
                            />
                          )}
                        />
                      </Grid>
                    )}
                  </Grid>
                </Paper>
              </Grid>
            )}

            {/* 2. ACCOUNT ZONE */}
            <Grid
              size={{ xs: 12, md: isCircleVisible || isBranchVisible ? 6 : 12 }}
            >
              <Paper
                variant="outlined"
                sx={{
                  p: 3,
                  borderRadius: "20px",
                  bgcolor: "rgba(0,0,0,0.01)",
                  borderStyle: "dashed",
                }}
              >
                <SectionHeader
                  icon={<SearchIcon fontSize="small" />}
                  title="Account Details"
                />
                <Grid container spacing={2}>
                  <Grid size={{ xs: 12, sm: 7 }}>
                    <Autocomplete
                      forcePopupIcon={false}
                      autoHighlight
                      value={filters.cgl}
                      options={cgls}
                      clearIcon={filters.cgl ? undefined : null}
                      noOptionsText={
                        filters.cgl && filters.cgl < 3
                          ? "Please enter at least 3 characters"
                          : "No Options"
                      }
                      onInputChange={(e, v) => {
                        if (v.length >= 3) fetchSearchData("cgl", v);
                      }}
                      onChange={(_, v) => onFilterChange("cgl", v)}
                      renderInput={(params) => (
                        <TextField
                          {...params}
                          label="CGL"
                          required
                          InputLabelProps={{ shrink: true }}
                          placeholder="eg. 9999999999"
                          variant="standard"
                          inputProps={{
                            ...params.inputProps,
                            maxLength: 30,
                          }}
                        />
                      )}
                      loadingText="Searching Cgls..."
                    />
                  </Grid>
                  <Grid size={{ xs: 12, sm: 5 }}>
                    <Autocomplete
                      size="small"
                      options={["All Currencies", ...currencies]}
                      value={filters.currencies}
                      onChange={(_, v) =>
                        onFilterChange("currencies", v || "ALL")
                      }
                      renderInput={(p) => (
                        <TextField
                          {...p}
                          label="Currency"
                          required
                          variant="standard"
                          inputProps={{
                            ...p.inputProps,
                            maxLength: 30,
                          }}
                        />
                      )}
                    />
                  </Grid>
                </Grid>
              </Paper>
            </Grid>

            {/* ROW 2: INDIVIDUAL BRANCH TRAY */}
            {viewBranchList && hasSelectedBranches && (
              <Grid size={{ xs: 12 }}>
                <Collapse in={viewBranchList && hasSelectedBranches}>
                  <Paper
                    variant="outlined"
                    sx={{
                      borderRadius: "20px",
                      bgcolor: "#fff",
                      border: "1px solid #e0e6ed",
                      overflow: "hidden",
                      mb: 1.5,
                      boxShadow: "0 4px 20px rgba(0,0,0,0.05)",
                    }}
                  >
                    {/* Sticky Header */}
                    <Stack
                      direction="row"
                      justifyContent="space-between"
                      alignItems="center"
                      sx={{
                        p: 2,
                        borderBottom: "1px solid #f0f0f0",
                        bgcolor: "rgba(25, 118, 210, 0.02)",
                      }}
                    >
                      <Stack direction="row" spacing={1} alignItems="center">
                        <Typography
                          variant="caption"
                          sx={{
                            fontWeight: 800,
                            color: "primary.main",
                            letterSpacing: 1,
                          }}
                        >
                          SELECTED BRANCHES
                        </Typography>
                        <CustomChip
                          label={filters.branches.length}
                          color="primary"
                          sx={{ height: 20 }}
                        />
                      </Stack>

                      <Button
                        size="small"
                        color="error"
                        variant="text"
                        startIcon={<DeleteSweepIcon />}
                        onClick={() => {
                          onFilterChange("branches", ["ALL"]);
                          setViewBranchList(false);
                        }}
                        sx={{
                          p: 1,
                          fontWeight: 700,
                          "&:hover": {
                            color: "white",
                            background: "#9f0400",
                          },
                        }}
                      >
                        Clear All
                      </Button>
                    </Stack>

                    {/* Scrollable Area with Individual Remove */}
                    {/* Scrollable Area with Individual Remove using standard MUI Chip */}
                    <Box
                      sx={{
                        p: 2,
                        maxHeight: "250px",
                        overflowY: "auto",
                        display: "flex",
                        flexWrap: "wrap",
                        gap: 1,
                        "&::-webkit-scrollbar": { width: "6px" },
                        "&::-webkit-scrollbar-track": { background: "#f1f1f1" },
                        "&::-webkit-scrollbar-thumb": {
                          background: "#ccc",
                          borderRadius: "10px",
                        },
                      }}
                    >
                      {filters.branches.map((b) => (
                        <Chip
                          key={b}
                          label={b}
                          color="primary"
                          variant="outlined"
                          // Standard MUI Chip handles onDelete by showing the 'X' icon automatically
                          onDelete={() => removeBranch(b)}
                          sx={{
                            borderRadius: "8px",
                            bgcolor: "white",
                            fontWeight: 500,
                            "& .MuiChip-deleteIcon": {
                              color: "error.main",
                              transition: "0.2s",
                              "&:hover": {
                                color: "#d32f2f",
                                transform: "scale(1.2)",
                              },
                            },
                            "&:hover": {
                              bgcolor: "#f5f9ff",
                              borderColor: "primary.main",
                            },
                          }}
                        />
                      ))}
                    </Box>
                  </Paper>
                </Collapse>
              </Grid>
            )}

            {/* 3. TIMELINE & FLAGS ZONE */}
            <Grid size={{ xs: 12 }}>
              <Paper
                sx={{
                  p: 2.5,
                  borderRadius: "20px",
                  // background:
                  //   "linear-gradient(90deg, #1976d2 0%, #1565c0 100%)",
                  background: "#58469f",
                  color: "white",
                }}
              >
                <Stack
                  direction={{ xs: "column", md: "row" }}
                  spacing={3}
                  alignItems="center"
                >
                  <Stack
                    direction="row"
                    spacing={1}
                    alignItems="center"
                    sx={{ minWidth: 100 }}
                  >
                    <DateRangeIcon />
                    <Typography sx={{ fontWeight: 700 }}>
                      From Date *
                    </Typography>
                  </Stack>

                  <DatePicker
                    value={filters.fromDate}
                    format="DD/MM/YYYY"
                    minDate={minLimit}
                    maxDate={filters.toDate || maxLimit}
                    views={["year", "month", "day"]}
                    onChange={(value) => {
                      onFilterChange("fromDate", value);

                      if (
                        value &&
                        filters.toDate &&
                        value.isValid() &&
                        filters.toDate.isValid()
                      ) {
                        if (value.isAfter(filters.toDate, "day")) {
                          setFromDateError("fromGreaterThanTo");
                          setToDateError("toLessThanFrom");
                        } else {
                          setFromDateError(null);
                          setToDateError(null);
                        }
                      } else {
                        setFromDateError(null);
                      }
                    }}
                    onError={(error) => {
                      if (error) {
                        setFromDateError(error);
                      } else if (
                        filters.fromDate &&
                        filters.toDate &&
                        filters.fromDate.isAfter(filters.toDate, "day")
                      ) {
                        setFromDateError("fromGreaterThanTo");
                      } else {
                        setFromDateError(null);
                      }
                    }}
                    slotProps={{
                      textField: {
                        size: "small",
                        fullWidth: true,
                        placeholder: "DD/MM/YYYY",
                        error: !!fromDateError,
                        sx: {
                          bgcolor: "white",
                          borderRadius: 1,
                          flex: 1,
                        },
                      },

                      day: {
                        sx: {
                          fontWeight: 600,
                          "&.MuiPickersDay-root": {
                            color: "#111",
                          },
                          "&.MuiPickersDay-today": {
                            border: "2px solid #58469f",
                            fontWeight: 800,
                          },
                          "&.Mui-selected": {
                            backgroundColor: "#58469f !important",
                            color: "#fff !important",
                            fontWeight: 800,
                          },
                          "&:hover": {
                            backgroundColor: "rgba(88,70,159,0.08)",
                          },
                          "&.Mui-disabled": {
                            color: "rgba(0,0,0,0.25) !important",
                            backgroundColor: "rgba(0,0,0,0.04)",
                            opacity: 0.45,
                            textDecoration: "line-through",
                          },
                        },
                      },

                      monthButton: {
                        sx: {
                          fontWeight: 700,
                          "&.Mui-selected": {
                            backgroundColor: "#58469f !important",
                            color: "#fff !important",
                          },
                          "&.Mui-disabled": {
                            color: "rgba(0,0,0,0.25) !important",
                            opacity: 0.45,
                            textDecoration: "line-through",
                            backgroundColor: "rgba(0,0,0,0.04)",
                          },
                        },
                      },

                      yearButton: {
                        sx: {
                          fontWeight: 700,
                          "&.Mui-selected": {
                            backgroundColor: "#58469f !important",
                            color: "#fff !important",
                          },
                          "&.Mui-disabled": {
                            color: "rgba(0,0,0,0.25) !important",
                            opacity: 0.45,
                            textDecoration: "line-through",
                            backgroundColor: "rgba(0,0,0,0.04)",
                          },
                        },
                      },
                    }}
                  />

                  <Stack
                    direction="row"
                    spacing={1}
                    alignItems="center"
                    sx={{ minWidth: 100 }}
                  >
                    <DateRangeIcon />
                    <Typography sx={{ fontWeight: 700 }}>To Date *</Typography>
                  </Stack>

                  <DatePicker
                    value={filters.toDate}
                    format="DD/MM/YYYY"
                    minDate={filters?.fromDate || minLimit}
                    maxDate={maxLimit}
                    views={["year", "month", "day"]}
                    onChange={(value) => {
                      onFilterChange("toDate", value);

                      if (
                        filters.fromDate &&
                        value &&
                        filters.fromDate.isValid() &&
                        value.isValid()
                      ) {
                        if (value.isBefore(filters.fromDate, "day")) {
                          setToDateError("toLessThanFrom");
                          setFromDateError("fromGreaterThanTo");
                        } else {
                          setToDateError(null);
                          setFromDateError(null);
                        }
                      } else {
                        setToDateError(null);
                      }
                    }}
                    onError={(error) => {
                      if (error) {
                        setToDateError(error);
                      } else if (
                        filters.fromDate &&
                        filters.toDate &&
                        filters.toDate.isBefore(filters.fromDate, "day")
                      ) {
                        setToDateError("toLessThanFrom");
                      } else {
                        setToDateError(null);
                      }
                    }}
                    slotProps={{
                      textField: {
                        size: "small",
                        fullWidth: true,
                        placeholder: "DD/MM/YYYY",
                        error: !!toDateError,

                        sx: {
                          bgcolor: "white",
                          borderRadius: 1,
                          flex: 1,
                          required: true,
                        },
                      },

                      day: {
                        sx: {
                          fontWeight: 600,
                          "&.MuiPickersDay-root": {
                            color: "#111",
                          },
                          "&.MuiPickersDay-today": {
                            border: "2px solid #58469f",
                            fontWeight: 800,
                          },
                          "&.Mui-selected": {
                            backgroundColor: "#58469f !important",
                            color: "#fff !important",
                            fontWeight: 800,
                          },
                          "&:hover": {
                            backgroundColor: "rgba(88,70,159,0.08)",
                          },
                          "&.Mui-disabled": {
                            color: "rgba(0,0,0,0.25) !important",
                            backgroundColor: "rgba(0,0,0,0.04)",
                            opacity: 0.45,
                            textDecoration: "line-through",
                          },
                        },
                      },

                      monthButton: {
                        sx: {
                          fontWeight: 700,
                          "&.Mui-selected": {
                            backgroundColor: "#58469f !important",
                            color: "#fff !important",
                          },
                          "&.Mui-disabled": {
                            color: "rgba(0,0,0,0.25) !important",
                            opacity: 0.45,
                            textDecoration: "line-through",
                            backgroundColor: "rgba(0,0,0,0.04)",
                          },
                        },
                      },

                      yearButton: {
                        sx: {
                          fontWeight: 700,
                          "&.Mui-selected": {
                            backgroundColor: "#58469f !important",
                            color: "#fff !important",
                          },
                          "&.Mui-disabled": {
                            color: "rgba(0,0,0,0.25) !important",
                            opacity: 0.45,
                            textDecoration: "line-through",
                            backgroundColor: "rgba(0,0,0,0.04)",
                          },
                        },
                      },
                    }}
                  />

                  <Stack
                    direction="row"
                    spacing={1}
                    alignItems="center"
                    // sx={{ minWidth: 100 }}
                  >
                    <DateRangeIcon />
                    <Typography sx={{ fontWeight: 700 }}>
                      Transaction Type *
                    </Typography>
                  </Stack>

                  <Autocomplete
                    multiple
                    size="small"
                    disableCloseOnSelect
                    sx={{ flex: 1.5 /* , minWidth: 250 */ }}
                    options={sourceOptions}
                    value={filters.sourceFlags}
                    getOptionLabel={(o) => o.flagName || ""}
                    isOptionEqualToValue={(option, value) =>
                      option.flagId === value.flagId
                    }
                    // LOGIC: Handle Select All toggle
                    onChange={(_, selectedOptions) => {
                      const isSelectAllClicked = selectedOptions.some(
                        (option) => option.flagId === "select-all",
                      );
                      if (isSelectAllClicked) {
                        // If already all selected, clear them. Otherwise, select all.
                        if (
                          filters.sourceFlags.length === sourceOptions.length
                        ) {
                          onFilterChange("sourceFlags", []);
                        } else {
                          onFilterChange("sourceFlags", sourceOptions);
                        }
                      } else {
                        onFilterChange("sourceFlags", selectedOptions);
                      }
                    }}
                    // INJECT: "Select All" option at the top of the list
                    filterOptions={(options) => {
                      const filtered = options;
                      return [
                        { flagId: "select-all", flagName: "Select All" },
                        ...filtered,
                      ];
                    }}
                    renderTags={(v) => (
                      <CustomChip
                        label={
                          v.length === sourceOptions.length
                            ? "All Types"
                            : `${v.length} Types`
                        }
                        color="default"
                        sx={{ bgcolor: "white" }}
                      />
                    )}
                    renderOption={(props, option, { selected }) => {
                      // Check if everything is selected to show the "Select All" box as checked
                      const isAllSelected =
                        filters.sourceFlags.length === sourceOptions.length;
                      const isChecked =
                        option.flagId === "select-all"
                          ? isAllSelected
                          : selected;

                      return (
                        <li {...props} key={option.flagId}>
                          <Checkbox
                            size="small"
                            style={{ marginRight: 8 }}
                            checked={isChecked}
                          />
                          <Typography
                            variant="body2"
                            sx={{
                              fontWeight:
                                option.flagId === "select-all" ? 700 : 400,
                            }}
                          >
                            {option.flagName}
                          </Typography>
                        </li>
                      );
                    }}
                    renderInput={(p) => (
                      <TextField
                        {...p}
                        placeholder="Transaction Types"
                        sx={{
                          bgcolor: "white",
                          borderRadius: 2,
                          "& .MuiOutlinedInput-root": { borderRadius: 2 },
                        }}
                        inputProps={{
                          ...p.inputProps,
                          maxLength: 30,
                        }}
                      />
                    )}
                  />
                </Stack>
              </Paper>
            </Grid>
          </Grid>

          <Grid size={{ xs: 12 }}>
            {validationMessages.length > 0 && (
              <Paper
                // elevation={0}
                sx={{
                  mt: 1,
                  p: 1.5,
                  borderRadius: 2,
                  border: "1px solid",
                  borderColor: "#ff4d4f",
                  bgcolor: "#fff1f0",
                }}
              >
                <Stack spacing={0.5}>
                  {validationMessages.map((msg, index) => (
                    <Typography
                      key={index}
                      variant="body2"
                      sx={{
                        color: "#d32f2f",
                        fontWeight: 600,
                      }}
                    >
                      • {msg}
                    </Typography>
                  ))}
                </Stack>
              </Paper>
            )}
          </Grid>

          <Box
            sx={{
              mt: 2,
              position: "sticky",
              bottom: 12,
              zIndex: 20,
              display: "flex",
              justifyContent: "flex-end",
              gap: 2,
            }}
          >
            <Button
              variant="outlined"
              startIcon={<RestartAltIcon />}
              onClick={onReset}
              sx={{
                borderRadius: 2,
                textTransform: "none",
                fontWeight: 700,
              }}
            >
              Reset
            </Button>
            <Button
              variant="contained"
              startIcon={<SearchIcon />}
              onClick={onFetch}
              disabled={
                !filters.cgl ||
                !filters.fromDate ||
                !filters.toDate ||
                fromDateError ||
                toDateError
              }
              loading={fetchLoading}
              sx={{
                borderRadius: 2,
                px: 4,
                textTransform: "none",
                fontWeight: 800,
              }}
            >
              Search
            </Button>
          </Box>
        </CardContent>
      </Card>
    </Box>
  );
};

export default LedgerForm;

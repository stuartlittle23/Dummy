.page{display:flex;gap:14px;width:100%;height:calc(100vh - 105px);min-height:620px;overflow:hidden;padding:10px;box-sizing:border-box}
.sidebar{width:280px;min-width:280px;height:100%;padding:18px;background:rgba(255,255,255,.72);border:1px solid rgba(110,80,210,.12);border-radius:18px;box-shadow:0 8px 28px rgba(70,50,150,.08);box-sizing:border-box;overflow:hidden}
.brand{display:flex;align-items:center;gap:12px;margin-bottom:20px}
.brandIcon{width:48px;height:48px;border-radius:14px;display:flex;align-items:center;justify-content:center;color:#5638c9;background:linear-gradient(145deg,#f4f0ff,#fff);box-shadow:0 3px 12px rgba(86,56,201,.1)}
.brandIcon svg{font-size:28px}
.brandTitle{font-size:17px;font-weight:700;color:#17203a}
.brandLine{width:52px;height:3px;border-radius:5px;background:#7654d9;margin-top:7px}
.infoCard{padding:14px;border-radius:14px;background:rgba(255,255,255,.52);border:1px solid rgba(90,70,170,.1)}
.infoCard hr{margin:10px 0;border-color:rgba(90,70,170,.12)}
.infoItem{display:flex;align-items:center;gap:12px;min-width:0}
.infoIcon{width:38px;height:38px;flex-shrink:0;border-radius:11px;display:flex;align-items:center;justify-content:center;color:#5941c9;background:#f2efff}
.infoIcon svg{font-size:20px}
.infoLabel{font-size:10px!important;font-weight:700!important;color:#65708b!important;letter-spacing:.5px}
.infoValue{font-size:20px!important;font-weight:700!important;color:#182039!important;line-height:1.25!important}
.infoSub{font-size:13px!important;font-weight:500!important;color:#536078!important;margin-top:2px!important}
.dateInfo{min-width:0;flex:1}
.dateInfo :global(.MuiFormControl-root){width:100%}
.dateInfo input{font-size:13px!important;padding:8px!important}
.navigation{margin-top:20px;display:flex;flex-direction:column;gap:4px}
.navButton{justify-content:flex-start!important;text-transform:none!important;color:#28334d!important;font-size:13px!important;font-weight:600!important;padding:11px 12px!important;border-radius:10px!important}
.navButton:hover{background:rgba(105,76,205,.06)!important}
.activeNav{color:#5335c5!important;background:#fff!important;box-shadow:0 4px 14px rgba(70,50,150,.08)!important;border-left:3px solid #593bd0!important}
.main{flex:1;min-width:0;height:100%;overflow:hidden}
.mainPanel{height:100%;overflow:auto;padding:20px;background:rgba(255,255,255,.68);border:1px solid rgba(100,80,180,.1);border-radius:18px;box-shadow:0 8px 28px rgba(70,50,150,.06);box-sizing:border-box}
.pageHeader{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px}
.pageTitle{font-size:25px!important;font-weight:700!important;color:#121a32!important;line-height:1.2!important}
.pageSubtitle{font-size:13px!important;color:#59647d!important;margin-top:5px!important}
.summaryGrid{margin-bottom:14px!important}
.summaryCard{height:145px;padding:18px!important;position:relative;display:flex;align-items:flex-start;gap:13px;border-radius:14px!important;background:rgba(255,255,255,.74)!important;border:1px solid rgba(80,70,150,.1)!important;box-shadow:0 5px 18px rgba(60,45,130,.07)!important;box-sizing:border-box}
.summaryIcon{width:48px;height:48px;flex-shrink:0;border-radius:14px;display:flex;align-items:center;justify-content:center;background:#f3efff}
.summaryIcon svg{font-size:27px}
.summaryContent{min-width:0}
.summaryTitle{font-size:14px!important;font-weight:700!important;color:#172039!important;margin-top:2px!important}
.summaryCount{font-size:30px!important;font-weight:700!important;line-height:1.1!important;margin-top:9px!important}
.summaryLabel{font-size:12px!important;color:#5d6780!important;margin-top:4px!important}
.summaryCard.violet .summaryIcon{color:#5b3dcc;background:#f0ebff}
.summaryCard.violet .summaryCount{color:#5537c8}
.summaryCard.green .summaryIcon{color:#15966d;background:#e8f8f1}
.summaryCard.green .summaryCount{color:#15966d}
.summaryCard.orange .summaryIcon{color:#e88b10;background:#fff3df}
.summaryCard.orange .summaryCount{color:#e88b10}
.cardDownload{position:absolute!important;right:16px;bottom:16px;text-transform:none!important;font-size:12px!important;border-radius:7px!important}
.violet .cardDownload{color:#5739c8!important;border-color:#8068d8!important}
.green .cardDownload{color:#15966d!important;border-color:#62bd9d!important}
.orange .cardDownload{color:#df8610!important;border-color:#e6aa61!important}
.sections{display:flex;flex-direction:column;gap:10px}
.infoBanner{margin-top:12px;padding:12px 16px!important;border-radius:12px!important;background:rgba(255,255,255,.52)!important;border:1px solid rgba(90,70,170,.1)!important;color:#59647d!important;font-size:12px!important}
.glifPanel{padding:4px!important;background:transparent!important;box-shadow:none!important}
.glifTitle{font-size:22px!important;font-weight:700!important;color:#172039!important}
.glifSubtitle{font-size:13px!important;color:#59647d!important;margin:4px 0 14px!important}
.filterSection{padding:16px!important;min-height:155px;background:rgba(255,255,255,.66)!important;border:1px solid rgba(90,70,170,.1)!important;border-radius:12px!important;box-shadow:none!important}
.filterTitle{font-size:14px!important;font-weight:700!important;color:#26304a!important;margin-bottom:12px!important}
.emptyFilter{font-size:12px!important;color:#8790a4!important;margin-top:28px!important}
.appliedFilter{display:flex;align-items:center;gap:8px;padding:7px 9px;border-radius:8px;background:rgba(245,243,252,.75);border:1px solid rgba(90,70,170,.08)}
.appliedLabel{font-size:11px!important;font-weight:700!important;color:#4e3ab0!important;min-width:105px}
.appliedValues{display:flex;flex-wrap:wrap;gap:4px;flex:1}
.appliedValues .MuiChip-root{font-size:11px;height:25px}
.appliedFilter .MuiButton-root{font-size:10px!important;min-width:auto!important}
.glifDownload{display:flex;justify-content:flex-end;margin-top:14px}
.glifDownload button{font-size:12px!important;text-transform:none!important;background:#5739c8!important}
.dialogTitle{display:flex!important;align-items:center;justify-content:space-between;font-size:15px!important}
@media(max-width:1000px){.page{height:auto;min-height:0;overflow:visible;flex-direction:column}.sidebar{width:100%;min-width:0;height:auto}.main{height:auto}.mainPanel{height:auto;overflow:visible}.summaryCard{height:135px}}

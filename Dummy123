long countByVidStartingWith(String prefix);


private String generateVid() {

    String yearMonth = LocalDate.now()
            .format(DateTimeFormatter.ofPattern("yyMM"));

    String prefix = "VID-" + yearMonth + "-";

    long count =
            requestVoucherRepository
                    .countByVidStartingWith(prefix) + 1;

    String sequence =
            String.format("%05d", count);

    return prefix + sequence;
}

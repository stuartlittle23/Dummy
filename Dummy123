import React,{useCallback,useEffect,useState} from 'react';
import {Box,Typography,Chip,Paper,Button,IconButton,Dialog,DialogContent,DialogTitle} from '@mui/material';
import {LocalizationProvider} from '@mui/x-date-pickers/LocalizationProvider';
import {DesktopDatePicker} from '@mui/x-date-pickers/DesktopDatePicker';
import {AdapterDayjs} from '@mui/x-date-pickers/AdapterDayjs';
import dayjs from 'dayjs';
import DisplayTab from './DisplayTab';
import useApi from '../../hooks/useApi';
import {AccountBalance,Public,Download,Delete,Close,CalendarMonthOutlined,ReceiptLongOutlined,VerifiedUserOutlined,CompareArrowsOutlined,AdjustOutlined,StorageOutlined,AccountBalanceOutlined,InfoOutlined,AutoAwesome,FilterAltOutlined,PlaylistAddCheckOutlined,CloudDownloadOutlined,VisibilityOutlined} from '@mui/icons-material';
import debounce from 'lodash/debounce';
import downloadFile from '../../utils/DownloadUtils';
import useCustomSnackbar from '../../utils/useCustomSnackbar';
import styles from './BranchPosition.module.css';
import Filter from './Filter';

const alterDateFormat=date=>date?.replace(/^(0[1-9]|[12][0-9]|3[01])([-/.])(0[1-9]|1[0-2])\2(\d{4})$/,'$4$2$3$2$1');

const categoryMeta={
  TSD:{label:'Technical suspense',category:'Technical Suspense Difference',icon:<ReceiptLongOutlined fontSize="small"/>,role:'rolePurple'},
  CSD:{label:'CGL suspense',category:'CGL Suspense Difference',icon:<VerifiedUserOutlined fontSize="small"/>,role:'roleTeal'},
  BCD:{label:'Balance compare',category:'Balance Compare Difference',icon:<CompareArrowsOutlined fontSize="small"/>,role:'roleAmber'}
};

const filterFieldColors={
  CURRENCY:{bg:'#E1F5EE',text:'#0F8A6C'},
  CGL:{bg:'#EEEDFE',text:'#6C5CE7'},
  JOURNAL_NUMBER:{bg:'#E6F1FB',text:'#1D6FB8'},
  TRANSACTION_CODE:{bg:'#FBEAF0',text:'#C23E70'},
  BATCH_ID:{bg:'#F1EFE8',text:'#6B6A63'},
  ACCOUNT:{bg:'#FFF1E0',text:'#C9761A'}
};

function BankIllustration(){
  return <svg width="120" height="92" viewBox="0 0 120 92" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="10" y="76" width="100" height="8" rx="2" fill="#DCD5FE"/><polygon points="60,10 108,34 12,34" fill="#C9BFFC"/><rect x="16" y="34" width="88" height="38" fill="#EEEDFE"/><rect x="26" y="42" width="10" height="30" rx="2" fill="#8F7FF0"/><rect x="44" y="42" width="10" height="30" rx="2" fill="#8F7FF0"/><rect x="62" y="42" width="10" height="30" rx="2" fill="#8F7FF0"/><rect x="80" y="42" width="10" height="30" rx="2" fill="#8F7FF0"/><rect x="12" y="72" width="96" height="4" fill="#6C5CE7"/><circle cx="60" cy="22" r="4" fill="#6C5CE7"/></svg>;
}

function SummaryCard({meta,count,isLoading,onViewDetails,onDownload}){
  const hasCount=typeof count==='number';
  return <Paper elevation={0} className={`${styles.summaryCard} ${styles[meta.role]}`}>
    <Box className={styles.summaryCardHeader}><Box className={styles.summaryCardIcon}>{meta.icon}</Box><Typography className={styles.summaryCardLabel}>{meta.label}</Typography></Box>
    <Typography className={styles.summaryCardCount}>{isLoading?'—':hasCount?count:'—'}</Typography>
    <Typography className={styles.summaryCardCaption}>{isLoading?'Checking…':'Records found'}</Typography>
    <Box className={styles.summaryCardDivider}/>
    <Button fullWidth variant="outlined" size="small" startIcon={<VisibilityOutlined fontSize="small"/>} disabled={!hasCount} onClick={onViewDetails} className={styles.summaryViewButton}>View details</Button>
    <Button fullWidth variant="contained" size="small" startIcon={<Download fontSize="small"/>} disabled={!hasCount||count===0} onClick={onDownload} className={styles.summaryDownloadButton}>Download</Button>
  </Paper>;
}

export default function BranchPosition(){
  const [userDate,setUserDate]=useState(null);
  const [dataRows,setDataRows]=useState({});
  const [breakupDataRows,setBreakupDataRows]=useState({});
  const {callApi}=useApi();
  const [glifDataFilter,setGlifDataFilter]=useState({});
  const [loading,setLoading]=useState('N');
  const showSnackBar=useCustomSnackbar();
  const [mode,setMode]=useState('DD');
  const [expandedCategory,setExpandedCategory]=useState(null);
  const [isDialogOpen,setIsDialogOpen]=useState(false);
  const user=JSON.parse(localStorage.getItem('user'));

  const debouncedFetchDifference=useCallback(debounce(async()=>{if(mode==='DD')await fetchDifference();},100),[userDate,mode]);

  async function fetchDifference(){
    const payload={date:userDate,branch:user.branch.toString().padStart(5,0),paginationModel:{page:0,pageSize:100}};
    try{
      setLoading('Y');
      const res=await callApi('/ES/branch-position/get-difference',payload,'POST');
      if(res?.success)setDataRows(res.data);
      else{showSnackBar(res?.message,'error');setDataRows({});}
      setLoading('N');
    }catch(e){setLoading('N');showSnackBar(e.message,'error');}
  }

  async function fetchIndividualDifference(type,paginationModel){
    const payload={date:userDate,branch:user.branch.toString().padStart(5,0),differenceType:type,paginationModel};
    try{
      setLoading(type);
      const res=await callApi('/ES/branch-position/get-difference',payload,'POST');
      if(res?.success)setDataRows(prev=>({...prev,[type]:res.data?.[type]||[]}));
      else showSnackBar(res?.message,'error');
      setLoading('N');
    }catch(e){setLoading('N');showSnackBar(e.message,'error');}
  }

  const openDetails=type=>{
    setExpandedCategory(type);
    if(!dataRows?.[type]?.content)fetchIndividualDifference(type,{page:0,pageSize:100});
  };

  const closeDetails=()=>setExpandedCategory(null);

  const fetchDetailedData=async(type,{cgl,currency,firstErrorDate})=>{
    const payload={branch:user.branch.toString().padStart(5,0),cgl,currency,startDate:alterDateFormat(firstErrorDate),endDate:userDate,differenceType:type};
    try{
      const res=await callApi('/ES/branch-position/get-detailed-difference',payload,'POST');
      if(res?.success)setBreakupDataRows({type,content:res.data||[]});
      else showSnackBar(res?.message,'error');
    }catch(e){showSnackBar(e.message,'error');}
  };

  const blobErrorHandler=error=>{
    if(error instanceof Blob){
      error.text().then(errorMessage=>{
        try{const errorJson=JSON.parse(errorMessage);showSnackBar(errorJson?.message,'error');}
        catch(e){showSnackBar(`Error: ${errorMessage}`);}
      });
    }else showSnackBar(error.message,'error');
  };

  const exportData=async(filePref,differenceType)=>{
    const payload={branch:user.branch.toString().padStart(5,0),date:userDate,differenceType};
    try{
      const res=await callApi('/ES/branch-position/export-difference',payload,'POST','blob','application/octet-stream');
      if(res){const filename=`${filePref}_${payload.branch}_${alterDateFormat(userDate)}`;downloadFile(new Blob([res]),'xlsx',filename,false);}
      else throw new Error('Failed to download file!');
    }catch(e){blobErrorHandler(e);}
  };

  const exportDetailedData=async()=>{
    if(!breakupDataRows?.content?.length){showSnackBar('No Rows to download!','error');return;}
    const first=breakupDataRows.content[0];
    const branch=user.branch.toString().padStart(5,0);
    const payload={branch,cgl:first.cgl,currency:first.currency,startDate:alterDateFormat(first.firstErrorDate),endDate:userDate,differenceType:breakupDataRows.type};
    try{
      const res=await callApi('/ES/branch-position/export-detailed-difference',payload,'POST','blob','application/octet-stream');
      if(res){const filename=`${breakupDataRows.type}_${branch}_${first.currency}_${first.cgl}_${alterDateFormat(userDate)}`;downloadFile(new Blob([res]),'xlsx',filename,false);}
      else throw new Error('Failed to download file!');
    }catch(e){blobErrorHandler(e);}
  };

  const exportGlifData=async()=>{
    const payload={
      branch:user.branch.toString().padStart(5,0),
      date:userDate,
      filters:[
        {field:'BRANCH_CODE',operator:'EQUALS',value:user.branch.toString().padStart(5,0)},
        {field:'TRANS_DATE',operator:'EQUALS',value:userDate},
        ...Object.entries(glifDataFilter).map(([key,entry])=>({field:key,operator:entry.operator,value:entry.value}))
      ]
    };
    try{
      const res=await callApi('/ES/branch-position/export-glif-data',payload,'POST','blob','application/octet-stream');
      if(res){
        const branch=user.branch.toString().padStart(5,0);
        const filename=`glif_${branch}_${alterDateFormat(userDate)}${Object.keys(glifDataFilter).length?'_filtered':''}`;
        downloadFile(new Blob([res]),'xlsx',filename,false);
      }else throw new Error('Failed to download file!');
    }catch(e){blobErrorHandler(e);}
  };

  useEffect(()=>{
    const fetchData=async()=>{
      try{
        const res=await callApi('/ES/branch-position/user-date');
        if(res?.success)setUserDate(res.data.substring(0,10));
        else showSnackBar(res?.message,'error');
      }catch(e){showSnackBar(e.message,'error');}
    };
    fetchData();
    return()=>{
      setUserDate(null);
      setBreakupDataRows({});
      setDataRows({});
      setIsDialogOpen(false);
      setGlifDataFilter({});
      setLoading('N');
      setMode('DD');
      setExpandedCategory(null);
    };
  },[]);

  useEffect(()=>{
    if(userDate==null)return;
    setBreakupDataRows({});
    debouncedFetchDifference();
  },[userDate,debouncedFetchDifference]);

  useEffect(()=>{
    if(breakupDataRows?.content)setIsDialogOpen(true);
  },[breakupDataRows]);

  const closeDialog=()=>{setBreakupDataRows({});setIsDialogOpen(false);};

  const handleFilter=filter=>{
    if(!filter.multiValue){
      setGlifDataFilter(prev=>({...prev,[filter.field]:{operator:'EQUALS',value:filter.value}}));
      return;
    }
    if(glifDataFilter[filter.field]){
      if(glifDataFilter[filter.field].value.length>=10){showSnackBar('only 10 filter values allowed!','error');return;}
      if(new Set(glifDataFilter[filter.field].value).has(filter.value)){showSnackBar('value already present in the filter!','error');return;}
      setGlifDataFilter(prev=>({...prev,[filter.field]:{operator:'IN',value:[...prev[filter.field].value,filter.value]}}));
      return;
    }
    setGlifDataFilter(prev=>({...prev,[filter.field]:{operator:'IN',value:[filter.value]}}));
  };

  const deleteFilter=key=>{const {[key]:_,...rem}=glifDataFilter;setGlifDataFilter(rem);};

  const deleteFilterValue=(key,deleteVal)=>{
    const newArray=glifDataFilter[key].value.filter(val=>val!=deleteVal);
    if(newArray.length>0)setGlifDataFilter(prev=>({...prev,[key]:{...prev[key],value:newArray}}));
    else deleteFilter(key);
  };

  const getFiterData=field=>glifDataFilter[field]?.value||[];

  const getCategoryCount=type=>{
    const bucket=dataRows?.[type];
    if(!bucket)return null;
    if(typeof bucket?.page?.totalElements==='number')return bucket.page.totalElements;
    if(Array.isArray(bucket?.content))return bucket.content.length;
    if(Array.isArray(bucket))return bucket.length;
    return null;
  };

  const activeFilterCount=Object.keys(glifDataFilter).length;

  return <>
    <Box className={styles.appShell}>
      <Box className={styles.sidebar}>
        <Box className={styles.sidebarBrand}>
          <Box className={styles.sidebarBrandIconWrap}><Box className={styles.sidebarBrandIcon}><AccountBalanceOutlined fontSize="small"/></Box><AutoAwesome className={styles.brandSparkle}/></Box>
          <Typography className={styles.sidebarBrandText}>Branch position</Typography>
          <AutoAwesome className={styles.sidebarStar}/>
        </Box>

        <Box className={styles.infoCard}>
          <Box className={styles.infoCardIcon}><AccountBalance fontSize="small"/></Box>
          <Box><Typography className={styles.infoCardLabel}>Branch</Typography><Typography className={styles.infoCardValue}>{user?.branch?.toString().padStart(5,0)}</Typography><Typography className={styles.infoCardSubvalue}>{user?.branchName}</Typography></Box>
        </Box>

        <Box className={styles.infoCard}>
          <Box className={styles.infoCardIcon}><Public fontSize="small"/></Box>
          <Box><Typography className={styles.infoCardLabel}>Circle</Typography><Typography className={styles.infoCardValue}>{user?.circleCode}</Typography><Typography className={styles.infoCardSubvalue}>{user?.circleName}</Typography></Box>
        </Box>

        <Box className={styles.infoCard} sx={{marginBottom:'16px'}}>
          <Box className={styles.infoCardIcon}><CalendarMonthOutlined fontSize="small"/></Box>
          <Box sx={{flexGrow:1}}>
            <Typography className={styles.infoCardLabel}>Report Date</Typography>
            <LocalizationProvider dateAdapter={AdapterDayjs}>
              <DesktopDatePicker
                value={userDate?dayjs(userDate,'YYYY-MM-DD'):dayjs()}
                onChange={newVal=>setUserDate(newVal?newVal.format('YYYY-MM-DD'):dayjs().format('YYYY-MM-DD'))}
                maxDate={dayjs()}
                format="DD-MM-YYYY"
                closeOnSelect
                slotProps={{textField:{size:'small',fullWidth:true,variant:'standard',InputProps:{disableUnderline:true,sx:{fontSize:'13px',fontWeight:600,color:'rgba(30,20,60,0.85)'}}}}}
                slots={{actionBar:()=>null}}
              />
            </LocalizationProvider>
          </Box>
        </Box>

        <Typography className={styles.sidebarSectionLabel}>DATA</Typography>

        <Box className={styles.navTabs}>
          <Button fullWidth className={`${styles.navTabButton} ${mode==='DD'?styles.navTabActive:''}`} onClick={()=>{setMode('DD');setGlifDataFilter({});setExpandedCategory(null);}}>
            <AdjustOutlined fontSize="small"/><span>Difference data</span>
          </Button>
          <Button fullWidth className={`${styles.navTabButton} ${mode==='GE'?styles.navTabActive:''}`} onClick={()=>{setMode('GE');setGlifDataFilter({});setExpandedCategory(null);}}>
            <StorageOutlined fontSize="small"/><span>GLIF data</span>
          </Button>
        </Box>

        <Box className={styles.sidebarFooter}>
          <Box className={styles.sidebarIllustration}>
            <AutoAwesome className={styles.sparkleTopRight}/><AutoAwesome className={styles.sparkleBottomLeft}/><AutoAwesome className={styles.sparkleMidRight}/><BankIllustration/>
          </Box>
        </Box>
      </Box>

      <Box className={styles.mainContent}>
        {mode==='DD'&&<>
          <Box className={styles.pageHeaderRow}>
            <Box>
              <Typography className={styles.pageHeaderTitle}>Difference data</Typography>
              <Box className={styles.dateBadge}><CalendarMonthOutlined fontSize="small"/><Typography>Report date: {userDate?dayjs(userDate).format('DD-MM-YYYY'):'—'}</Typography></Box>
            </Box>
            <Button variant="outlined" startIcon={<Download/>} className={styles.downloadAllButton} onClick={()=>Object.keys(categoryMeta).forEach(type=>{if(getCategoryCount(type)>0)exportData(type,type);})}>Download all</Button>
          </Box>

          <Typography className={styles.pageHeaderSubtitle}>Reconciliation status for the selected date.</Typography>

          <Box className={styles.summaryRow}>
            {Object.entries(categoryMeta).map(([type,meta])=><SummaryCard key={type} meta={meta} count={getCategoryCount(type)} isLoading={loading==='Y'||loading===type} onViewDetails={()=>openDetails(type)} onDownload={()=>exportData(type,type)}/>)}
          </Box>

          {expandedCategory&&<Box className={styles.detailsPanel}>
            <Box className={styles.detailsHeader}>
              <Box>
                <Typography className={styles.detailsTitle}>{categoryMeta[expandedCategory]?.label} — Details</Typography>
                <Chip size="small" className={styles.detailsCountChip} label={`${getCategoryCount(expandedCategory)??0} records found`}/>
              </Box>

              <Box className={styles.detailsHeaderActions}>
                <Button variant="outlined" size="small" startIcon={<Download fontSize="small"/>} disabled={!getCategoryCount(expandedCategory)} onClick={()=>exportData(expandedCategory,expandedCategory)}>Download</Button>
                <IconButton className={styles.closeDetailsButton} onClick={closeDetails} size="small" title="Close"><Close fontSize="small"/></IconButton>
              </Box>
            </Box>

            <Box className={styles.detailsGridWrapper}>
              <DisplayTab category={categoryMeta[expandedCategory]?.category} type={expandedCategory} level={1} hideHeader flat data={dataRows[expandedCategory]||[]} clickHandler={fetchDetailedData} downloadHandler={exportData} loading={loading===expandedCategory||loading==='Y'} requestData={fetchIndividualDifference}/>
            </Box>

            <Box className={styles.detailsFooter}>
              <Typography>Showing {getCategoryCount(expandedCategory)??0} records for branch {user?.branch?.toString().padStart(5,0)}.</Typography>
              <Button variant="outlined" size="small" onClick={closeDetails}>Close</Button>
            </Box>
          </Box>}

          {!expandedCategory&&<Box className={styles.infoBanner}><InfoOutlined fontSize="small"/><Typography className={styles.infoBannerText}>Select <b>View details</b> on any category to inspect its records, or use <b>Download</b> to export the complete category data.</Typography></Box>}
        </>}

        {mode==='GE'&&<>
          <Box className={styles.pageHeaderRow}><Typography className={styles.pageHeaderTitle}>GLIF data</Typography><AutoAwesome className={styles.headerSparkle}/></Box>
          <Typography className={styles.pageHeaderSubtitle}>Download GLIF data for your branch and selected date.</Typography>

          <Box className={styles.glifSection}>
            <Box className={styles.glifSectionHeader}><Box className={styles.glifSectionIcon}><FilterAltOutlined fontSize="small"/></Box><Typography className={styles.glifSectionTitle}>Add Filter</Typography></Box>
            <Typography className={styles.typographyLabel} sx={{mb:1}}>Add up to 10 values per filter field.</Typography>
            <Filter handleFilter={handleFilter} getValues={getFiterData}/>
          </Box>

          <Box className={styles.glifSection}>
            <Box className={styles.glifSectionHeader} sx={{marginBottom:0}}>
              <Box className={styles.glifSectionIcon}><PlaylistAddCheckOutlined fontSize="small"/></Box>
              <Typography className={styles.glifSectionTitle}>Applied Filters ({activeFilterCount})</Typography>
              {activeFilterCount>0&&<button className={styles.clearAllLink} onClick={()=>setGlifDataFilter({})}>Clear All</button>}
            </Box>

            <Box sx={{marginTop:'14px'}}>
              {activeFilterCount===0?<Typography variant="caption" sx={{color:'rgba(30,20,60,0.45)'}}>No filters applied yet — results will include the full branch and date.</Typography>:<Box className={styles.chipValues}>
                {Object.entries(glifDataFilter).map(([key,val])=>{
                  const color=filterFieldColors[key]||{bg:'#F1EFE8',text:'#6B6A63'};
                  const items=Array.isArray(val.value)?val.value:[val.value];
                  return items.map((ent,index)=><Chip key={`${key}-${index}`} size="small" className={styles.filterFieldChip} label={`${key.replaceAll('_',' ')}: ${ent}`} onDelete={()=>Array.isArray(val.value)?deleteFilterValue(key,ent):deleteFilter(key)} deleteIcon={<Delete fontSize="small"/>} sx={{backgroundColor:color.bg,color:color.text}}/>);
                })}
              </Box>}
            </Box>
          </Box>

          <Box className={styles.glifSection}>
            <Box className={styles.glifSectionHeader}><Box className={styles.glifSectionIcon}><CloudDownloadOutlined fontSize="small"/></Box><Typography className={styles.glifSectionTitle}>Download GLIF Data</Typography></Box>
            <Box className={styles.infoBanner} sx={{marginTop:0,marginBottom:'16px'}}><InfoOutlined fontSize="small" sx={{color:'#6C5CE7',mt:'1px'}}/><Typography cla

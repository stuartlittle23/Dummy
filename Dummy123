{filterField === "CGL" &&
    <Autocomplete
        options={values || []}
        value={values.find((v) => v.cglNumber === inputInstance) || null}
        size="small"
        getOptionLabel={(option) => option ? `${option.cglNumber} (${option.description})` : ''}
        isOptionEqualToValue={(option, value) => option.cglNumber === value?.cglNumber}
        onInputChange={(event, value, reason) => {
            debouncedFetchCgls(value, reason, isMinInput)
        }}
        renderInput={(params) => <TextField {...params} label="CGL" error={!!fieldError} helperText={fieldError} />}
        filterOptions={(options) => {
            return options.filter((val) => !getValues("CGL")?.includes(val.cglNumber))
        }}
        onChange={(e, v, r) => {
            setFieldError(null);
            if (r === "selectOption") {
                setInputInstance(v.cglNumber);
                setValues([]);
            } else if (r === "clear") {
                setInputInstance('');
                setValues([]);
            }
        }}
        noOptionsText={
            (!isMinInput) ? "Please enter at least 3 characters" : "No Options"
        }
    />
}

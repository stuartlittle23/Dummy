<Stack
    direction="row"
    justifyContent="space-between"
    alignItems="flex-start"
    sx={{ mb: 3 }}
>
    <Box>
        <Typography variant="h5" fontWeight={700}>
            Ledger Balance Insights Explorer
        </Typography>

        <Typography variant="body2" color="text.secondary">
            Ledger Balance search and analysis
        </Typography>
    </Box>

    <Paper
        variant="outlined"
        sx={{
            px: 2,
            py: 1.5,
            borderRadius: 3,
            display: "flex",
            alignItems: "center",
            gap: 2,
            bgcolor: "#fafafa",
            borderColor: "divider",
        }}
    >
        <Typography
            variant="subtitle2"
            sx={{
                fontWeight: 700,
                whiteSpace: "nowrap",
            }}
        >
            Enquiry Type
        </Typography>

        <ToggleButtonGroup
            exclusive
            size="small"
            value={filters.enquiryType}
            onChange={(_, value) => {
                if (value) {
                    onFilterChange("enquiryType", value);
                }
            }}
            sx={{
                "& .MuiToggleButton-root": {
                    textTransform: "none",
                    px: 2.5,
                    fontWeight: 600,
                },
                "& .Mui-selected": {
                    bgcolor: "#58469f !important",
                    color: "#fff !important",
                },
            }}
        >
            <ToggleButton value="COLLATION">
                Collation
            </ToggleButton>

            <ToggleButton value="CONSOLIDATED">
                Consolidated
            </ToggleButton>
        </ToggleButtonGroup>
    </Paper>
</Stack>

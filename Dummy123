<DataGrid
  rows={data || []}
  columns={balanceColumns}
  loading={loading}
  rowCount={rowCount}
  pagination
  paginationMode="server"
  pageSizeOptions={[25, 50, 75, 100]}
  paginationModel={{
    page: fetchConf.page,
    pageSize: fetchConf.pageSize,
  }}
  slots={{
    noRowsOverlay: CustomNoRowsOverlay,
  }}
  onPaginationModelChange={(model) => {
    // PREVENT DUPLICATE CALLS: Ignore if pagination values didn't actually change
    if (
      model.page === fetchConf.page &&
      model.pageSize === fetchConf.pageSize
    ) {
      return;
    }

    setFetchConf((prev) => ({
      ...prev,
      page: model.page,
      pageSize: model.pageSize,
    }));
  }}
  sortingMode="server"
  sortingOrder={["asc", "desc"]}
  sortModel={[
    {
      field: "date",
      sort: fetchConf.sortIn?.toLowerCase() || "desc",
    },
  ]}
  onSortModelChange={(model) => {
    if (!model || model.length === 0) return;

    setFetchConf((prev) => ({
      ...prev,
      sortIn: model[0].sort.toUpperCase(),
      page: 0,
    }));
  }}
  rowHeight={45}
  disableRowSelectionOnClick
  sx={{
    borderRadius: "20px",
    backgroundColor: "rgba(255,255,255,0.4)",
    border: "1px solid rgba(255,255,255,0.3)",
    "& .MuiDataGrid-columnHeaders": {
      bgcolor: "#f8f9fa",
      fontWeight: 700,
    },
  }}
/>







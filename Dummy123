@PostMapping("/get-technical-suspense-glif-details")
public ResponseEntity<ApiResponse<List<Map<String, Object>>>> getTechnicalSuspenseGlifDetails(
        @Valid @RequestBody TechnicalSuspenseGlifRequest request) {

    return ResponseEntity.ok(
            ApiResponse.success(
                    branchPositionService.getTechnicalSuspenseGlifDetails(request),
                    "Technical Suspense GLIF details fetched successfully!"
            )
    );
}





@PostMapping("/export-technical-suspense-glif-details")
public ResponseEntity<StreamingResponseBody> exportTechnicalSuspenseGlifDetails(
        @Valid @RequestBody TechnicalSuspenseGlifRequest request) {

    return ResponseEntity.ok()
            .header(
                    HttpHeaders.CONTENT_DISPOSITION,
                    "attachment; filename=TechnicalSuspenseGlifDetails.xlsx"
            )
            .contentType(MediaType.parseMediaType(
                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
            ))
            .body(
                    branchPositionService.exportTechnicalSuspenseGlifDetails(request)
            );
}

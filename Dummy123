onClick={(e) => {
  e.stopPropagation();

  const rows = [];
  const totalHierarchyCols = maxVisibleLevel + 1;

  // 1. Fetch all headers from the DOM
  const allHeaders = Array.from(document.querySelectorAll("th")).map(th => th.innerText.trim()).filter(Boolean);
  
  // 2. Build the header row: Slice out the ones we want, but pad the beginning with empty tabs if we are deeper in the tree
  const activeHeaders = allHeaders.slice(node.level, totalHierarchyCols);
  const paddingHeaders = Array(node.level).fill(""); // Maintains the correct spreadsheet column structure
  const metricHeaders = activeMetrics.map((m) => m.displayName || m.logicalName);
  
  rows.push([...paddingHeaders, ...activeHeaders, ...metricHeaders].join("\t"));

  // 3. Keep your original data traversal completely untouched!
  const traverse = (currentNode) => {
    const columns = Array(totalHierarchyCols).fill("");
    columns[currentNode.level] = currentNode.name;

    const metrics = activeMetrics.map((m) => {
      const value = currentNode[m.logicalName];
      if (value === null || value === undefined) return "";
      return !isNaN(value) ? Number(value).toFixed(2) : value;
    });

    const rowString = [...columns, ...metrics].join("\t");
    rows.push(rowString);

    if (currentNode.children && currentNode.children.length > 0) {
      currentNode.children.forEach((child) => traverse(child));
    }
  };

  traverse(node);

  const combinedData = rows.join("\n");

  navigator.clipboard
    .writeText(combinedData)
    .then(() => {
      showSnackBar("Data copied with aligned headers", "success");
    })
    .catch((err) => {
      console.error("Failed to copy text: ", err);
      showSnackBar("Failed to copy text", "error");
    });
}}

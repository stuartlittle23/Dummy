 {isBranchVisible && (
                      <Grid size={{ xs: 12, sm: isCircleVisible ? 6 : 12 }}>
                        <Autocomplete
                          multiple
                          size="small"
                          disableCloseOnSelect
                          options={["All Branches", ...branches]}
                          loading={loading.branch}
                          value={filters.branches}
                          inputValue={branchSearch}
                          onInputChange={(event, newInputValue, reason) => {
  if (newInputValue.length > 30) return;

  // 1. If it's an internal MUI reset from selecting an option, DO NOT clear the data
  if (reason === "reset") return;

  setBranchSearch(newInputValue);

  if (newInputValue.length >= 3) {
    fetchSearchData("branch", newInputValue);
  } else if (newInputValue === "") {
    // 2. Clear data ONLY when the input field is physically 100% empty
    setBranches([]);
  }
}}
onChange={(_, val) => {
  handleBranchChange(val);
  // 3. REMOVED setBranchSearch("") from here so it doesn't force a wipeout on click!
}}
                          renderTags={() => null}
                          renderOption={(props, option, { selected }) => (
                            <li {...props} key={option}>
                              <Checkbox
                                size="small"
                                style={{ marginRight: 8 }}
                                checked={selected}
                              />
                              <Typography variant="body2">{option}</Typography>
                            </li>
                          )}
                          renderInput={(p) => (
                            <TextField
                              {...p}
                              label="Select Branches"
                              variant="standard"
                              required
                              placeholder={"Enter atleast 3 digits..."}
                              InputProps={{
                                ...p.InputProps,
                                maxLength: 30,
                                endAdornment: (
                                  <InputAdornment
                                    position="end"
                                    sx={{ mb: 0.5 }}
                                  >
                                    <Stack
                                      direction="row"
                                      alignItems="center"
                                      spacing={1}
                                    >
                                      <CustomChip
                                        label={
                                          filters.branches.includes("All Branches")
                                            ? "All Branches"
                                            : `${filters.branches.length} Selected`
                                        }
                                        color={
                                          filters.branches.includes("All Branches")
                                            ? "default"
                                            : "primary"
                                        }
                                        sx={{
                                          fontWeight: 700,
                                          fontSize: "0.7rem",
                                        }}
                                      />
                                      {!filters.branches.includes("All Branches") &&
                                        filters.branches.length > 0 && (
                                          <IconButton
                                            size="small"
                                            onClick={() =>
                                              setViewList(
                                                viewList === "branches"
                                                  ? null
                                                  : "branches",
                                              )
                                            }
                                            color={
                                              viewList === "branches"
                                                ? "primary"
                                                : "default"
                                            }
                                            sx={{
                                              transition: "0.2s",
                                              bgcolor: viewList
                                                ? "rgba(25, 118, 210, 0.08)"
                                                : "transparent",
                                            }}
                                          >
                                            {viewList === "branches" ? (
                                              <VisibilityOffIcon fontSize="small" />
                                            ) : (
                                              <VisibilityIcon fontSize="small" />
                                            )}
                                          </IconButton>
                                        )}
                                    </Stack>
                                    {p.InputProps.endAdornment}
                                  </InputAdornment>
                                ),
                              }}
                            />
                          )}
                        />
                      </Grid>
                    )}
                  </Grid>
                </Paper>
              </Grid>
            )}


package com.fincore.JournalService.Models;

import jakarta.persistence.*;
import lombok.Data;

import java.sql.Timestamp;

@Entity
@Table(name = "request_voucher")
@Data
public class RequestVoucher {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;

    @Column(name = "vid", unique = true)
    private String vid;

    @Column(name = "voucher_category")
    private String voucherCategory;

    private String description;

    @Column(name = "allowed_role")
    private String allowedRole;

    @Column(name = "sd_request_numbers")
    private String sdRequestNumbers;

    private String status;

    @Column(name = "created_date")
    private Timestamp createdDate;
}



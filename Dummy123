function camelToTitleCase(str) {

    let spaced = str.replace(/([a-z0-9])([A-Z])/g, '$1 $2');
    spaced = spaced.replace(/([A-Z]+)([A-Z][a-z])/g, '$1 $2');
    return spaced
        .split(' ')
        .map(word => word.charAt(0).toUpperCase() + word.slice(1))
        .join(' ');
}


onst deleteFilter = (key) => {
    const { [key]: _, ...rem } = glifDataFilter;
    setGlifDataFilter(rem);
  };

  const deleteFilterValue = (key, deleteVal) => {
    const newArray = glifDataFilter[key].value.filter(
      (val) => val != deleteVal
    );
    if (newArray.length > 0) {
      setGlifDataFilter((prev) => {
        return { ...prev, [key]: { ...prev[key], value: newArray } };
      });
    } else {
      deleteFilter(key);
    }
  };

  const getFiterData = (field) => {
    return glifDataFilter[field]?.value || [];
  };

  const getCategoryCount = (type) => {
    const bucket = dataRows?.[type];
    if (!bucket) return null;
    if (typeof bucket?.page?.totalElements === "number")
      return bucket.page.totalElements;
    if (Array.isArray(bucket?.content)) return bucket.content.length;
    return null;
  };

  const activeFilterCount = Object.keys(glifDataFilter).length;
  const formattedDate = userDate ? dayjs(userDate).format("DD-MM-YYYY") : "—";
  const activeMeta = dialogType ? categoryMeta[dialogType] : null;
  const dialogCategoryCount = dialogType ? getCategoryCount(dialogType) : null;

  const handleReset = () => {
    // // Clear Circle only when editable
    // if (hasWholeBank) {
    //   setSelectedCircle(null);
    //   setCircleInput('');
    // }

    // Clear Branch only when editable
    if (!isBranchUser) {
      setSelectedBranch(null);
      setBranchInput("");
      setBranchOptions([]);
    }

    // Clear Report Date
    setUserDate(null);

    // Clear results and filters
    setGlifDataFilter({});
    setReportDateError(null);
    setDataRows({});
    setBreakupDataRows({});
    setSelectedGlcc("");
  };
  return (
    <>
      <Box className={styles.appShell}>
        {/* ---- Sidebar ---- */}
        <Box className={styles.sidebar}>
          <Box className={styles.sidebarBrand}>
            <Box className={styles.sidebarBrandIconWrap}>
              <Box className={styles.sidebarBrandIcon}>
                <AccountBalanceOutlined fontSize="small" />
              </Box>
            </Box>
            <Typography className={styles.sidebarBrandText}>
              Branch Position
            </Typography>
          </Box>

          {/* <Box className={styles.dateCard}>
          <Box sx={{ display: 'flex', alignItems: 'center', gap: '8px', marginBottom: '2px' }}>
            <Public sx={{ fontSize: 15, color: '#6C5CE7' }} />
            <Typography className={styles.infoCardLabel} sx={{ margin: 0 }}>Circle</Typography>
          </Box>

          {!hasWholeBank ? (
            <TextField
              size="small"
              fullWidth
              disabled
              value={`${user?.circleCode} - ${user?.circleName}`}
            />
          ) : (
            <Autocomplete
            autoHighlight
              size="small"
              fullWidth
              value={selectedCircle}
              options={circleOptions}
              loading={circleLoading}
              getOptionLabel={(o) => o ? `${o.circleCode} - ${o.circleName}` : ''}
              onChange={(e, val) => {setSelectedCircle(val);
                setSelectedBranch(null);
                setBranchInput('');
                setBranchOptions([]);
              }
              }
              renderInput={(params) => (
              <TextField
                {...params}
                label="Select Circle"
                sx={{mt:1}}
                inputProps={{
                  ...params.inputProps,
                }}
              />
            )}
            />
          )}
        </Box> */}
          <Box className={styles.dateCard}>
            <Box
              sx={{
                display: "flex",
                alignItems: "center",
                gap: "8px",
                marginBottom: "2px",
              }}
            >
              <AccountBalance sx={{ fontSize: 15, color: "#6C5CE7" }} />
              <Typography className={styles.infoCardLabel} sx={{ margin: 0 }}>
                Branch
              </Typography>
            </Box>

            {isBranchUser ? (
              <TextField
                size="small"
                fullWidth
                disabled
                value={`${effectiveBranchCode} - ${effectiveBranchName}`}
              />
            ) : (
              <Autocomplete
                autoHighlight
                size="small"
                fullWidth
                value={selectedBranch}
                options={branchOptions}
                loading={branchLoading}
                getOptionLabel={(o) => (o ? `${o.code} - ${o.name}` : "")}
                isOptionEqualToValue={(o, v) => o.code === v?.code}
                inputValue={branchInput}
                onInputChange={(e, val, reason) => {
                  setBranchInput(val);
                  if (reason === "input") fetchBranchOptions(val);
                }}
                onChange={(e, val) => setSelectedBranch(val)}
                noOptionsText={
                  branchInput.length < 3
                    ? "Enter at least 3 characters"
                    : "No Options"
                }
                renderInput={(params) => (
                  <TextField
                    {...params}
                    label="Select Branch"
                    sx={{ mt: 1 }}
                    inputProps={{
                      ...params.inputProps,
                      title: selectedBranch?.name || "",
                    }}
                  />
                )}
              />
            )}
          </Box>

          <Box className={styles.dateCard}>
            <Box
              sx={{
                display: "flex",
                alignItems: "center",
                gap: "8px",
                marginBottom: "2px",
              }}
            >
              <CalendarMonthOutlined sx={{ fontSize: 15, color: "#6C5CE7" }} />
              <Typography className={styles.infoCardLabel} sx={{ margin: 0 }}>
                Report Date
              </Typography>
            </Box>
            <LocalizationProvider dateAdapter={AdapterDayjs}>
              <DatePicker
                value={userDate}
                format="DD-MM-YYYY"
                minDate={MIN_ALLOWED_DATE}
                maxDate={etlDate}
                views={["year", "month", "day"]}
                onChange={(value) => {
                  setUserDate(value);
                }}
                onError={(error) => {
                  setReportDateError(error || null);
                }}
                slotProps={{
                  textField: {
                    size: "small",
                    fullWidth: true,
                    placeholder: "DD-MM-YYYY",
                    error: !!reportDateError,
                    helperText:
                      reportDateError === "maxDate"
                        ? "Report Date cannot be in future"
                        : reportDateError === "minDate"
                        ? `Report Date cannot be before ${MIN_ALLOWED_DATE.format(
                            "DD-MM-YYYY"
                          )}`
                        : reportDateError === "invalidDate"
                        ? "Please enter a valid Report Date"
                        : "",
                  },
                }}
              />
            </LocalizationProvider>
          </Box>

          <Box className={styles.searchResetRow}>
            <Button
              variant="contained"
              size="small"
              startIcon={<SearchOutlined />}
              disabled={isSearchDisabled}
              onClick={() => {
                setBreakupDataRows({});
                fetchDifference();
              }}
            >
              Search
            </Button>

            <Button
              variant="outlined"
              size="small"
              onClick={handleReset}
              startIcon={<RestartAltOutlined />}
            >
              Reset
            </Button>
          </Box>

          <Box className={styles.sidebarFooter}>
            <Box className={styles.sidebarIllustration}>
              <AutoAwesome className={styles.sparkleTopRight} />
              <AutoAwesome className={styles.sparkleBottomLeft} />
              <AutoAwesome className={styles.sparkleMidRight} />
              <Box className={styles.bankIllustration}>
                <Box className={styles.bankGlow}>
                  <AccountBalance className={styles.bankIcon} />
                </Box>
                <AutoAwesome className={styles.bankSparkle1} />
                <AutoAwesome className={styles.bankSparkle2} />
                <AutoAwesome className={styles.bankSparkle3} />
              </Box>
            </Box>
          </Box>
        </Box>

        {/* ---- Main content ---- */}
        <Box className={styles.mainContent}>
          <Tabs
            orientation="horizontal"
            className={styles.navTabs}
            value={mode}
            sx={{ "& .MuiTabs-flexContainer": { gap: "8px" } }}
            onChange={() => {
              setMode(mode === "DD" ? "GE" : "DD");
              setGlifDataFilter({});
            }}
            TabIndicatorProps={{ style: { display: "none" } }}
            aria-label="branch position mode navigation"
          >
            <Tab
              value="DD"
              className={styles.navTab}
              icon={<AdjustOutlined fontSize="small" />}
              iconPosition="start"
              label="Reconciliation Status"
              disabled={loading != "N" && mode != "DD"}
            />
            <Tab
              value="GE"
              className={styles.navTab}
              icon={<StorageOutlined fontSize="small" />}
              iconPosition="start"
              label="GLIF Data"
              disabled={loading != "N" && mode != "GE"}
            />
          </Tabs>
          {mode === "DD" && (
            <>
              <Box className={styles.pageHeaderRow}>
                <Typography className={styles.pageHeaderTitle}>
                  Reconciliation Status
                </Typography>
                <AutoAwesome className={styles.headerSparkle} />
              </Box>
              <Typography className={styles.pageHeaderSubtitle}>
                Reconciliation status for{" "}
                <Box component="span" className={styles.highlightDate}>
                  {formattedDate}
                </Box>
              </Typography>

              <Box className={styles.summaryRow}>
                {Object.entries(categoryMeta).map(([type, meta]) => (
                  <SummaryCard
                    key={type}
                    meta={meta}
                    count={getCategoryCount(type)}
                    isLoading={loading === "Y" || loading === type}
                    onViewDetails={() => openCategoryDialog(type)}
                    onDownload={() => exportData(type, type)}
                  />
                ))}
              </Box>

              {/* <Box className={styles.infoBanner}>
                <InfoOutlined fontSize="small" sx={{ color: '#6C5CE7', mt: '1px' }} />
                <Typography className={styles.infoBannerText}>
                  Download will include Reconciliation Status for branch {user?.branch?.toString().padStart(5, 0)} on {formattedDate}.
                </Typography>
              </Box> */}
            </>
          )}

          {mode === "GE" && (
            <>
              <Box className={styles.pageHeaderRow}>
                <Typography className={styles.pageHeaderTitle}>
                  GLIF data
                </Typography>
                <AutoAwesome className={styles.headerSparkle} />
              </Box>
              <Typography className={styles.pageHeaderSubtitle}>
                Download GLIF data for your branch and selected date.
              </Typography>

              <Box className={styles.glifSection}>
                <Box className={styles.glifSectionHeader}>
                  <Box className={styles.glifSectionIcon}>
                    <FilterAltOutlined fontSize="small" />
                  </Box>
                  <Typography className={styles.glifSectionTitle}>
                    Add Filter
                  </Typography>
                  <Typography className={styles.typographyLabel}>
                    ( Add up to 10 values per filter field. )
                  </Typography>
                </Box>
                <Filter handleFilter={handleFilter} getValues={getFiterData} />
              </Box>

              <Box className={styles.glifSection}>
                <Box
                  className={styles.glifSectionHeader}
                  sx={{ marginBottom: 0 }}
                >
                  <Box className={styles.glifSectionIcon}>
                    <PlaylistAddCheckOutlined fontSize="small" />
                  </Box>
                  <Typography className={styles.glifSectionTitle}>
                    Applied Filters ({activeFilterCount})
                  </Typography>
                  {activeFilterCount > 0 && (
                    <button
                      className={styles.clearAllLink}
                      onClick={() => setGlifDataFilter({})}
                    >
                      Clear All
                    </button>
                  )}
                </Box>
                <Box sx={{ marginTop: "14px" }}>
                  {activeFilterCount === 0 ? (
                    <Typography
                      variant="caption"
                      sx={{ color: "rgba(30,20,60,0.45)" }}
                    >
                      No filters applied yet — results will include the full
                      branch and date.
                    </Typography>
                  ) : (
                    <Box className={styles.chipValues}>
                      {Object.entries(glifDataFilter).map(([key, val]) => {
                        const color = filterFieldColors[key] || {
                          bg: "#F1EFE8",
                          text: "#6B6A63",
                        };
                        const items = Array.isArray(val.value)
                          ? val.value
                          : [val.value];
                        return items.map((ent, index) => (
                          <Chip
                            key={`${key}-${index}`}
                            size="small"
                            className={styles.filterFieldChip}
                            label={`${key.replaceAll("_", " ")}: ${ent}`}
                            onDelete={() =>
                              Array.isArray(val.value)
                                ? deleteFilterValue(key, ent)
                                : deleteFilter(key)
                            }
                            deleteIcon={<Delete fontSize="small" />}
                            sx={{
                              backgroundColor: color.bg,
                              color: color.text,
                            }}
                          />
                        ));
                      })}
                    </Box>
                  )}
                </Box>
              </Box>

              <Box className={styles.downloadRow}>
                {/* <Typography className={styles.downloadRowText}>
                  Includes all GLIF data for branch {user?.branch?.toString().padStart(5, 0)} on {formattedDate} with the applied filters.
                </Typography> */}
                <Button
                  variant="contained"
                  size="small"
                  className={styles.downloadRowButton}
                  startIcon={<Download fontSize="small" />}
                  onClick={() => exportGlifData()}
                  sx={{ marginLeft: "auto" }}
                >
                  Download GLIF Data
                </Button>
              </Box>
            </>
          )}
        </Box>
      </Box>

      <Dialog
        open={isDialogOpen}
        onClose={closeDialog}
        maxWidth="xl"
        fullWidth
        PaperProps={{ className: styles.dialogPaper }}
      >
        <DialogTitle className={styles.dialogTitle}>
          <Box sx={{ display: "flex", alignItems: "center", gap: 1 }}>
            <Typography className={styles.dialogTitleText}>
              {dialogView === "category"
                ? activeMeta?.category || "Details"
                : "Difference Break-up"}
            </Typography>

            <Chip
              label={
                dialogView === "category"
                  ? dialogCategoryCount > 0
                    ? `${dialogCategoryCount.toLocaleString(
                        "en-IN"
                      )} Records Found`
                    : "No Records"
                  : breakupDataRows?.content?.length > 0
                  ? `${breakupDataRows.content.length.toLocaleString(
                      "en-IN"
                    )} Records Found`
                  : "No Records"
              }
              size="small"
              sx={{
                fontWeight: 700,
                color: "#58469f",
                bgcolor: "rgba(88, 70, 159, 0.1)",
                borderRadius: "8px",
              }}
            />

            {dialogView === "category" && (
              <Chip
                label={`Report Date: ${dayjs(userDate).format("DD-MM-YYYY")}`}
                size="small"
                sx={{
                  fontWeight: 700,
                  color: "#58469f",
                  bgcolor: "rgba(88, 70, 159, 0.1)",
                  borderRadius: "8px",
                }}
              />
            )}

            {dialogView === "breakup" && (
              <>
                <Chip
                  label={`GLCC: ${selectedGlcc}`}
                  size="small"
                  sx={{
                    fontWeight: 700,
                    color: "#58469f",
                    bgcolor: "rgba(88, 70, 159, 0.1)",
                    borderRadius: "8px",
                  }}
                />
              </>
            )}
          </Box>

          {/* This empty Box is the spacer that pushes everything after it to the right */}
          <Box sx={{ flexGrow: 1 }} />

          {dialogView === "category" && (
            <IconButton
              className={styles.dialogButton}
              disabled={!dialogCategoryCount}
              onClick={() => exportData(dialogType, dialogType)}
              size="small"
              title="Download"
            >
              <Download fontSize="small" />
            </IconButton>
          )}
          {dialogView === "breakup" && (
            <IconButton
              className={styles.dialogButton}
              disabled={breakupDataRows?.data?.length == 0}
              onClick={exportDetailedData}
              size="small"
              title="Download breakup"
            >
              <Download fontSize="small" />
            </IconButton>
          )}

          <IconButton
            className={styles.dialogButton}
            onClick={closeDialog}
            size="small"
            title="Close"
          >
            <Close fontSize="small" />
          </IconButton>
        </DialogTitle>

        <DialogContent>
          {dialogView === "category" && dialogType && (
            <DisplayTab
              category={activeMeta.category}
              type={dialogType}
              level={1}
              hideHeader
              flat
              data={dataRows[dialogType] || []}
              clickHandler={fetchDetailedData}
              downloadHandler={exportData}
              loading={loading === "Y" || loading === dialogType}
              requestData={fetchIndividualDifference}
            />
          )}

          {dialogView === "breakup" && (
            <DisplayTab
              data={breakupDataRows || []}
              category="Difference Breakup"
              type={breakupDataRows?.type}
              level={2}
              hideHeader
              flat
              downloadHandler={exportDetailedData}
            />
          )}
        </DialogContent>
      </Dialog>
    </>
  );
}

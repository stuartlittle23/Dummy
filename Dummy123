package com.fincore.enquiry_service.service;

import com.fincore.enquiry_service.dto.LedgerWiseBalanceRequest;
import com.fincore.enquiry_service.dto.LedgerWiseBalanceResponse;
import com.fincore.enquiry_service.model.GlBalance;
import com.fincore.enquiry_service.repository.LedgerWiseBalanceRepository;
import com.fincore.enquiry_service.specification.LedgerWiseBalanceSpecification;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.data.domain.*;
import org.springframework.stereotype.Service;

@Slf4j
@RequiredArgsConstructor
@Service("LedgerWiseBalanceService")
public class LedgerWiseBalanceServiceImpl
        implements LedgerWiseBalanceService {

    private final LedgerWiseBalanceRepository ledgerWiseBalanceRepository;
    private final LedgerWiseBalanceExportService ledgerWiseBalanceExportService;

    @Override
    public Page<LedgerWiseBalanceResponse> search(
            LedgerWiseBalanceRequest dto) {

        Sort.Direction direction =
                "asc".equalsIgnoreCase(dto.getSortOrder())
                        ? Sort.Direction.ASC
                        : Sort.Direction.DESC;

        Pageable pageable = PageRequest.of(
                dto.getPage(),
                dto.getSize(),
                Sort.by(direction, getSortField(dto.getSortField()))
        );

        Page<GlBalance> page =
                ledgerWiseBalanceRepository.findAll(
                        LedgerWiseBalanceSpecification.build(dto),
                        pageable
                );

        return page.map(this::mapToDto);
    }

    @Override
    public byte[] excelExport(
            LedgerWiseBalanceRequest dto,
            String userId) {

        return ledgerWiseBalanceExportService.export(dto, userId);
    }

    private LedgerWiseBalanceResponse mapToDto(
            GlBalance entity) {

        String branchCode = null;
        String branchName = null;
        String circleCode = null;
        String circleName = null;

        try {

            if (entity.getBranch() != null) {

                branchCode = entity.getBranch().getCode();
                branchName = entity.getBranch().getName();

                if (entity.getBranch().getCircle() != null) {

                    circleCode =
                            entity.getBranch()
                                    .getCircle()
                                    .getCircleCode();

                    circleName =
                            entity.getBranch()
                                    .getCircle()
                                    .getCircleName();
                }
            }

        } catch (Exception e) {

            log.warn(
                    "Branch/Circle mapping failed for balance id : {}",
                    entity.getId()
            );
        }

        return new LedgerWiseBalanceResponse(

                entity.getId(),
                entity.getBalanceDate(),

                branchCode,
                branchName,

                circleCode,
                circleName,

                entity.getCurrencyMaster() != null
                        ? entity.getCurrencyMaster().getCurrencyCode()
                        : null,

                entity.getCurrencyMaster() != null
                        ? entity.getCurrencyMaster().getCurrencyName()
                        : null,

                entity.getCglMaster() != null
                        ? entity.getCglMaster().getCglNumber()
                        : null,

                entity.getCglMaster() != null
                        ? entity.getCglMaster().getDescription()
                        : null,

                entity.getBalance(),
                entity.getInrBalance()
        );
    }

    private String getSortField(String field) {

        return switch (field) {

            case "id" -> "id";

            case "balanceDate" -> "balanceDate";

            case "branchCode" -> "branch.code";
            case "branchName" -> "branch.name";

            case "circleCode" -> "branch.circle.circleCode";
            case "circleName" -> "branch.circle.circleName";

            case "currency" -> "currencyMaster.currencyCode";
            case "currencyName" -> "currencyMaster.currencyName";

            case "cgl" -> "cglMaster.cglNumber";
            case "description" -> "cglMaster.description";

            case "balance" -> "balance";
            case "inrBalance" -> "inrBalance";

            default -> "balanceDate";
        };
    }


}





package com.fincore.enquiry_service.service;

import com.fincore.enquiry_service.dto.LedgerWiseBalanceRequest;
import com.fincore.enquiry_service.dto.LedgerWiseBalanceResponse;
import org.springframework.data.domain.Page;

public interface LedgerWiseBalanceService {

    Page<LedgerWiseBalanceResponse> search(
            LedgerWiseBalanceRequest dto);

    byte[] excelExport(
            LedgerWiseBalanceRequest dto,
            String userId);
}

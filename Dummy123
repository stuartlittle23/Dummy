import React from "react";
import { Box, Typography, Chip, IconButton, Button } from "@mui/material";
import { DataGrid } from "@mui/x-data-grid";
import MoreVertIcon from "@mui/icons-material/MoreVert";
import FileDownloadOutlinedIcon from "@mui/icons-material/FileDownloadOutlined";
import ErrorOutlineOutlinedIcon from "@mui/icons-material/ErrorOutlineOutlined";

const columns = [
  { field: "errorDate", headerName: "Error Date", flex: 1, minWidth: 120 },
  { field: "branchCode", headerName: "Branch", flex: 1, minWidth: 120 },
  { field: "currency", headerName: "Currency", flex: 0.9, minWidth: 110 },
  { field: "cgl", headerName: "CGL", flex: 1, minWidth: 130 },
  { field: "cbsBalance", headerName: "CBS Balance", flex: 1.1, minWidth: 140 },
  { field: "glBalance", headerName: "GL Balance", flex: 1.1, minWidth: 140 },
  { field: "differenceAmount", headerName: "Difference Amount", flex: 1.2, minWidth: 160 },
  { field: "diffYesterday", headerName: "Diff. Yesterday", flex: 1.1, minWidth: 140 },
  { field: "type", headerName: "Type", flex: 0.8, minWidth: 90 },
  { field: "head", headerName: "Head", flex: 0.8, minWidth: 90 },
];

export default function BalanceDateWiseTable({
  rows = [],
  loading = false,
  totalElements = 0,
  paginationModel,
  setPaginationModel,
}) {
  const formattedRows = rows.map((row, index) => ({
    ...row,
    id: row.id || `balance-${index}`,
    errorDate: row.errorDate || row.etlDate || row.date || "-",
    branchCode: row.branchCode || row.branch || "-",
    currency: row.currency || "-",
    cgl: row.cgl || row.cglNumber || "-",
    cbsBalance: row.cbsBalance ?? row.cbs_bal ?? "-",
    glBalance: row.glBalance ?? row.gl_bal ?? "-",
    differenceAmount:
      row.differenceAmount ?? row.difference ?? row.diffAmount ?? "-",
    diffYesterday:
      row.diffYesterday ?? row.differenceYesterday ?? "-",
    type: row.type || "-",
    head: row.head || "-",
  }));

  return (
    <Box
      sx={{
        width: "100%",
        mt: 2,
        borderRadius: 3,
        overflow: "hidden",
        bgcolor: "background.paper",
        border: "1px solid",
        borderColor: "divider",
        boxShadow: "0 2px 8px rgba(0,0,0,0.06)",
      }}
    >
      <Box
        sx={{
          px: { xs: 2, sm: 2.5 },
          py: 1.8,
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
          borderBottom: "1px solid",
          borderColor: "divider",
        }}
      >
        <Box sx={{ display: "flex", alignItems: "center", gap: 1.5 }}>
          <Typography
            sx={{
              fontSize: { xs: "1rem", sm: "1.1rem" },
              fontWeight: 700,
              color: "text.primary",
            }}
          >
            Balance Difference Records
          </Typography>

          <Chip
            label={totalElements > 0 ? `${totalElements} Records` : "No Records"}
            size="small"
            sx={{
              height: 25,
              fontSize: "0.7rem",
              fontWeight: 700,
              bgcolor: "rgba(88,70,159,0.08)",
              color: "primary.main",
            }}
          />
        </Box>

        <Button
          variant="contained"
          size="small"
          startIcon={<FileDownloadOutlinedIcon />}
          disabled={!formattedRows.length}
          sx={{
            textTransform: "none",
            borderRadius: "8px",
            fontWeight: 600,
            minWidth: 90,
            boxShadow: "none",
          }}
        >
          Export
        </Button>
      </Box>

      <Box sx={{ width: "100%" }}>
        <DataGrid
          rows={formattedRows}
          columns={columns.map((column) => ({
            ...column,
            sortable: true,
            disableColumnMenu: false,
            renderHeader: (params) => (
              <Box
                sx={{
                  width: "100%",
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "space-between",
                  fontWeight: 700,
                  fontSize: "0.82rem",
                }}
              >
                <span>{params.colDef.headerName}</span>
                <MoreVertIcon
                  sx={{
                    fontSize: 18,
                    color: "text.secondary",
                  }}
                />
              </Box>
            ),
          }))}
          loading={loading}
          rowCount={totalElements}
          paginationMode="server"
          paginationModel={paginationModel}
          onPaginationModelChange={setPaginationModel}
          pageSizeOptions={[25, 50, 100]}
          disableRowSelectionOnClick
          hideFooterSelectedRowCount
          slots={{
            noRowsOverlay: () => (
              <Box
                sx={{
                  height: "100%",
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "center",
                  flexDirection: "column",
                  gap: 1,
                }}
              >
                <ErrorOutlineOutlinedIcon
                  sx={{
                    fontSize: 28,
                    color: "text.secondary",
                  }}
                />
                <Typography
                  sx={{
                    fontSize: "0.95rem",
                    fontWeight: 600,
                    color: "text.secondary",
                  }}
                >
                  No difference records available for the selected criteria
                </Typography>
              </Box>
            ),
          }}
          sx={{
            border: 0,
            minHeight: 330,

            "& .MuiDataGrid-columnHeaders": {
              backgroundColor: "rgba(88,70,159,0.05)",
              borderBottom: "1px solid",
              borderColor: "divider",
              minHeight: 52,
            },

            "& .MuiDataGrid-columnHeader": {
              px: 1.5,
              outline: "none !important",
            },

            "& .MuiDataGrid-columnHeaderTitle": {
              fontWeight: 700,
              fontSize: "0.82rem",
            },

            "& .MuiDataGrid-cell": {
              px: 1.5,
              fontSize: "0.82rem",
              borderBottom: "1px solid",
              borderColor: "rgba(0,0,0,0.06)",
              outline: "none !important",
            },

            "& .MuiDataGrid-row:hover": {
              backgroundColor: "rgba(88,70,159,0.03)",
            },

            "& .MuiDataGrid-footerContainer": {
              minHeight: 52,
              borderTop: "1px solid",
              borderColor: "divider",
            },

            "& .MuiTablePagination-root": {
              fontSize: "0.8rem",
            },

            "& .MuiDataGrid-overlay": {
              backgroundColor: "transparent",
            },
          }}
        />
      </Box>
    </Box>
  );
}

import React from "react";
import { Box, Paper, Typography, IconButton, Tooltip } from "@mui/material";
import AnalyticsIcon from "@mui/icons-material/Analytics";
import TuneIcon from "@mui/icons-material/Tune";
import FilterAltOffIcon from "@mui/icons-material/FilterAltOff"; // Premium clear filters icon
import AssignmentIcon from "@mui/icons-material/Assignment";
import AccountBalanceIcon from "@mui/icons-material/AccountBalance";
import LayersIcon from "@mui/icons-material/Layers";
import CalendarMonthIcon from "@mui/icons-material/CalendarMonth";
import dayjs from "dayjs";

export default function ReportAnalysisHeader({
  activeReport,
  onOpenFilter,
  onClearFilters, // 🟢 New callback prop to reset/clear filters
  filtersApplied,
  appliedFilters, 
}) {
  
  // Extract and sanitize filter display values
  const reportDisplay = 
    activeReport?.displayName || 
    appliedFilters?.reportName || 
    appliedFilters?.reportCode || 
    "YSA Report";

  const headDisplay = 
    appliedFilters?.headCode || 
    appliedFilters?.head || 
    appliedFilters?.searchHeadCode || 
    "None Selected";

  const scopeDisplay = 
    appliedFilters?.scope || 
    appliedFilters?.selectedViewCode || 
    appliedFilters?.viewCode || 
    "None Selected";

  const dateValue = 
    appliedFilters?.reportDate || 
    appliedFilters?.date;

  // Render values smoothly whether objects or raw strings
  const cleanReport = typeof reportDisplay === "object" ? reportDisplay?.displayName : reportDisplay;
  const cleanHead = typeof headDisplay === "object" ? `${headDisplay.headCode || ""} - ${headDisplay.headName || ""}` : headDisplay;
  const cleanScope = typeof scopeDisplay === "object" ? scopeDisplay?.displayName || scopeDisplay?.viewCode : scopeDisplay;
  const cleanDate = dateValue ? (dayjs(dateValue).isValid() ? dayjs(dateValue).format("DD MMM YYYY") : dateValue) : "Not Set";

  return (
    <Paper
      elevation={0}
      sx={{
        p: "12px 0px", // Seamless edge padding alignment
        borderRadius: 0,
        bgcolor: "transparent", // 🟢 COMPLETELY REMOVES WHITE BOX TO MATCH BACKGROUND PERFECTLY
        display: "flex",
        justifyContent: "space-between",
        flexDirection: "row",
        flexShrink: 0,
        alignItems: "center",
        gap: 2,
      }}
    >
      {/* Left Module: Identity */}
      <Box display="flex" alignItems="center" gap={2} sx={{ minWidth: 200 }}>
        <Box
          sx={{
            background: "linear-gradient(135deg, #6366f1 0%, #4f46e5 100%)",
            borderRadius: "12px",
            width: 46,
            height: 46,
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            boxShadow: "0 4px 12px rgba(79, 70, 229, 0.25)",
          }}
        >
          <AnalyticsIcon sx={{ color: "#fff", fontSize: 24 }} />
        </Box>
        <Box sx={{ overflow: "hidden" }}>
          <Typography variant="h6" sx={{ fontWeight: 800, color: "text.primary", letterSpacing: "-0.5px", lineHeight: 1.2 }}>
            {cleanReport}
          </Typography>
          <Typography variant="caption" sx={{ color: "text.secondary", fontWeight: 500, display: "block", mt: 0.2 }}>
            Matrix Live Analytics
          </Typography>
        </Box>
      </Box>

      {/* ================= PREMIUM APPLIED FILTER PILLS ================= */}
      {filtersApplied && (
        <Box
          display="flex"
          alignItems="center"
          justifyContent="flex-start"
          gap={2}
          sx={{
            flexGrow: 1,
            mx: 2,
            px: 3,
            borderLeft: "1px solid",
            borderColor: "divider",
            borderRight: "1px solid",
            borderColor: "divider",
            overflowX: "auto",
            scrollbarWidth: "none",
            "&::-webkit-scrollbar": { display: "none" },
          }}
        >
          {/* Pill 1: Report Info */}
          <Box sx={{
            display: "flex", alignItems: "center", gap: 1.5, p: "6px 14px", borderRadius: "10px",
            background: "#eff6ff", border: "1px solid #bfdbfe", minWidth: 130, maxWidth: 180,
            transition: "all 0.2s", "&:hover": { transform: "translateY(-1px)", boxShadow: "0 4px 6px rgba(0,0,0,0.03)" }
          }}>
            <AssignmentIcon sx={{ color: "#2563eb", fontSize: 18 }} />
            <Box sx={{ overflow: "hidden" }}>
              <Typography variant="caption" sx={{ color: "#1e40af", fontWeight: 700, fontSize: "9px", textTransform: "uppercase", display: "block" }}>
                Target Report
              </Typography>
              <Typography variant="body2" noWrap sx={{ fontWeight: 700, color: "#1e3a8a", fontSize: "12px" }}>
                {cleanReport}
              </Typography>
            </Box>
          </Box>

          {/* Pill 2: Account Head Selector */}
          <Box sx={{
            display: "flex", alignItems: "center", gap: 1.5, p: "6px 14px", borderRadius: "10px",
            background: "#ecfdf5", border: "1px solid #a7f3d0", minWidth: 160, maxWidth: 220,
            transition: "all 0.2s", "&:hover": { transform: "translateY(-1px)", boxShadow: "0 4px 6px rgba(0,0,0,0.03)" }
          }}>
            <AccountBalanceIcon sx={{ color: "#059669", fontSize: 18 }} />
            <Box sx={{ overflow: "hidden" }}>
              <Typography variant="caption" sx={{ color: "#065f46", fontWeight: 700, fontSize: "9px", textTransform: "uppercase", display: "block" }}>
                Account Head
              </Typography>
              <Typography variant="body2" noWrap sx={{ fontWeight: 700, color: "#064e3b", fontSize: "12px" }}>
                {cleanHead}
              </Typography>
            </Box>
          </Box>

          {/* Pill 3: Scope View Layout */}
          <Box sx={{
            display: "flex", alignItems: "center", gap: 1.5, p: "6px 14px", borderRadius: "10px",
            background: "#f5f3ff", border: "1px solid #ddd6fe", minWidth: 120, maxWidth: 170,
            transition: "all 0.2s", "&:hover": { transform: "translateY(-1px)", boxShadow: "0 4px 6px rgba(0,0,0,0.03)" }
          }}>
            <LayersIcon sx={{ color: "#7c3aed", fontSize: 18 }} />
            <Box sx={{ overflow: "hidden" }}>
              <Typography variant="caption" sx={{ color: "#5b21b6", fontWeight: 700, fontSize: "9px", textTransform: "uppercase", display: "block" }}>
                Scope Context
              </Typography>
              <Typography variant="body2" noWrap sx={{ fontWeight: 700, color: "#4c1d95", fontSize: "12px" }}>
                {cleanScope}
              </Typography>
            </Box>
          </Box>

          {/* Pill 4: Selected Target Date */}
          <Box sx={{
            display: "flex", alignItems: "center", gap: 1.5, p: "6px 14px", borderRadius: "10px",
            background: "linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%)", border: "1px solid #fde68a", minWidth: 125,
            transition: "all 0.2s", "&:hover": { transform: "translateY(-1px)", boxShadow: "0 4px 6px rgba(0,0,0,0.03)" }
          }}>
            <CalendarMonthIcon sx={{ color: "#d97706", fontSize: 18 }} />
            <Box sx={{ overflow: "hidden" }}>
              <Typography variant="caption" sx={{ color: "#92400e", fontWeight: 700, fontSize: "9px", textTransform: "uppercase", display: "block" }}>
                Report Date
              </Typography>
              <Typography variant="body2" noWrap sx={{ fontWeight: 800, color: "#78350f", fontSize: "12px" }}>
                {cleanDate}
              </Typography>
            </Box>
          </Box>
        </Box>
      )}

      {/* Right Module: Contextual Actions Control Block */}
      <Box display="flex" alignItems="center" gap={1}>
        
        {/* 🟢 DYNAMICALLY SHOW REMOVE FILTERS ACTION WHEN FILTERS EXIST */}
        {filtersApplied && (
          <Tooltip title="Remove Applied Filters" arrow placement="bottom">
            <IconButton
              onClick={onClearFilters}
              size="medium"
              sx={{
                p: 1.2,
                borderRadius: "12px",
                border: "1px solid #fee2e2",
                bgcolor: "#fef2f2",
                color: "#ef4444",
                boxShadow: "0 2px 4px rgba(239, 68, 68, 0.05)",
                transition: "all 0.2s",
                "&:hover": {
                  bgcolor: "#ef4444",
                  color: "#ffffff",
                  boxShadow: "0 4px 12px rgba(239, 68, 68, 0.25)",
                  transform: "translateY(-1px)",
                  borderColor: "#ef4444"
                },
              }}
            >
              <FilterAltOffIcon sx={{ fontSize: 20 }} />
            </IconButton>
          </Tooltip>
        )}

        {/* Primary Filter Selector Trigger */}
        <Tooltip title="Modify Report Criteria" arrow placement="bottom">
          <IconButton
            onClick={onOpenFilter}
            size="medium"
            sx={{
              p: 1.2,
              borderRadius: "12px",
              border: "1px solid",
              borderColor: "divider",
              bgcolor: "background.paper",
              color: "primary.main",
              boxShadow: "0 2px 6px rgba(0,0,0,0.04)",
              transition: "all 0.2s",
              "&:hover": {
                bgcolor: "primary.main",
                color: "#ffffff",
                boxShadow: "0 4px 12px rgba(79, 70, 229, 0.25)",
                transform: "translateY(-1px)"
              },
            }}
          >
            <TuneIcon sx={{ fontSize: 20 }} />
          </IconButton>
        </Tooltip>
      </Box>
    </Paper>
  );
}


import React, { useState, useEffect, useCallback } from "react";
import {
  Box,
  Paper,
  Typography,
  Stack,
  Autocomplete,
  TextField,
} from "@mui/material";

import {
  DatePicker,
  LocalizationProvider,
} from "@mui/x-date-pickers";

import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";

import CalendarMonthIcon from "@mui/icons-material/CalendarMonth";
import ManageSearchOutlinedIcon from "@mui/icons-material/ManageSearchOutlined";
import SearchIcon from "@mui/icons-material/Search";
import RestartAltIcon from "@mui/icons-material/RestartAlt";

import { useSelector } from "react-redux";
import dayjs from "dayjs";

import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import { getPermissions } from "../../utils/CommonUtilities";

import BalanceDateWiseTable from "./Components/BalanceDateWiseTable";
import { StyledButton } from "./Components/BalanceDifferenceStyles";


export default function BalanceParticularSearchScreen() {

  const { callApi } = useApi();
  const showSnackBar = useCustomSnackbar();

  const user = useSelector((state) => state.auth.user);
  const selectedMenu = useSelector(
    (state) => state.menus.selectedMenuItem
  );

  const permissions = getPermissions(selectedMenu);


  // ---------------------------------------------------------
  // TABLE / SEARCH STATE
  // ---------------------------------------------------------

  const [rows, setRows] = useState([]);
  const [rowCount, setRowCount] = useState(0);
  const [loading, setLoading] = useState(false);

  // Important:
  // This tells us whether Search has been clicked.
  // Do NOT use rows.length for this.
  const [searched, setSearched] = useState(false);

  const [filtersExpanded, setFiltersExpanded] = useState(true);


  // ---------------------------------------------------------
  // FILTER STATE
  // ---------------------------------------------------------

  const [etlDate, setEtlDate] = useState(null);

  const [branch, setBranch] = useState("");
  const [branchInput, setBranchInput] = useState("");
  const [branches, setBranches] = useState([]);

  const [currency, setCurrency] = useState("");
  const [currencyInput, setCurrencyInput] = useState("");
  const [currencies, setCurrencies] = useState([]);

  const [cgl, setCgl] = useState("");
  const [cglInput, setCglInput] = useState("");
  const [cgls, setCgls] = useState([]);


  // ---------------------------------------------------------
  // PAGINATION
  // ---------------------------------------------------------

  const [paginationModel, setPaginationModel] = useState({
    page: 0,
    pageSize: 25,
  });


  // ---------------------------------------------------------
  // FETCH CURRENCIES
  // ---------------------------------------------------------

  const fetchCurrencies = useCallback(async () => {
    try {
      const res = await callApi(
        "/CM/common-master/currency-code-name-only",
        null,
        "GET"
      );

      const data = (res?.data || []).sort((a, b) =>
        a.currencyCode === "INR"
          ? -1
          : b.currencyCode === "INR"
          ? 1
          : a.currencyName.localeCompare(b.currencyName)
      );

      setCurrencies(data);
    } catch (e) {
      showSnackBar("Currency data not available", "error");
    }
  }, [callApi, showSnackBar]);


  // ---------------------------------------------------------
  // FETCH BRANCH / CGL SEARCH DATA
  // ---------------------------------------------------------

  const fetchSearchData = useCallback(
    async (type, term) => {

      if (!term || term.length < 3) return;

      try {

        let circleValue = "";

        if (permissions?.wholebank === true) {
          circleValue = "null";
        } else if (
          user?.isCircle === true ||
          permissions?.circle
        ) {
          circleValue = user?.circleCode;
        }


        const url =
          type === "branch"
            ? `/CM/common-master/branches-code-name-only?q=${encodeURIComponent(
                term
              )}&circleCode=${circleValue || ""}`
            : `/CM/common-master/cgl-code-description-only?q=${encodeURIComponent(
                term
              )}`;


        const res = await callApi(url, null, "GET");


        if (type === "branch") {

          setBranches(
            (res?.data || []).map(
              (item) => `${item.code}-${item.name}`
            )
          );

        } else {

          setCgls(
            (res?.data || []).map(
              (item) =>
                `${item.cglNumber} - ${item.description}`
            )
          );

        }

      } catch (e) {
        console.error(e);
      }
    },
    [callApi, permissions, user]
  );


  // ---------------------------------------------------------
  // INITIAL DATA
  // ---------------------------------------------------------

  useEffect(() => {
    fetchCurrencies();
  }, [fetchCurrencies]);


  // ---------------------------------------------------------
  // GET ETL DATE
  // ---------------------------------------------------------

  useEffect(() => {

    const getDate = async () => {

      try {

        const res = await callApi(
          "/PS/file/fincore-date",
          {},
          "GET"
        );

        const raw =
          res?.data?.userDate ||
          res?.data?.etlDate ||
          res?.date ||
          "";

        if (raw) {
          setEtlDate(
            dayjs(raw.split("T")[0])
          );
        }

      } catch (e) {
        console.error("ETL Date Error:", e);
      }

    };

    getDate();

  }, [callApi]);


  // ---------------------------------------------------------
  // FETCH TABLE DATA
  // ---------------------------------------------------------

  const fetchData = useCallback(
    async (page = 0, size = 25) => {

      if (!etlDate) return;

      try {

        setLoading(true);


        // KEEPING YOUR EXISTING API PAYLOAD
        const payload = {
          fromDate: etlDate.format("YYYY-MM-DD"),
          toDate: etlDate.format("YYYY-MM-DD"),

          branchCode:
            branch?.split("-")[0] || null,

          currency:
            currency || null,

          cgl:
            cgl?.split(" - ")[0] || null,
        };


        // KEEPING YOUR EXISTING API
        const res = await callApi(
          `/ES/differences/search?page=${page}&size=${size}`,
          payload,
          "POST"
        );


        const content =
          res?.data?.content ||
          res?.content ||
          [];


        const formattedRows = content.map(
          (item, index) => ({
            ...item,

            id:
              item.id ||
              `row-${page}-${index}`,

            GLCC_VAL:
              `${item.branchCode || ""} ${
                item.currency || ""
              } ${item.cgl || ""}`,
          })
        );


        setRows(formattedRows);


        setRowCount(
          res?.data?.totalElements ||
          res?.totalElements ||
          0
        );


      } catch (e) {

        console.error("Search API Error:", e);

        // IMPORTANT:
        // Keep table visible even when API returns no data.
        setRows([]);
        setRowCount(0);

        showSnackBar(
          "No records found",
          "error"
        );

      } finally {

        setLoading(false);

      }

    },
    [
      callApi,
      etlDate,
      branch,
      currency,
      cgl,
      showSnackBar,
    ]
  );


  // ---------------------------------------------------------
  // SEARCH
  // ---------------------------------------------------------

  const handleSearch = () => {

    // Search has happened.
    // This is independent of rows.length.
    setSearched(true);

    // Collapse filters after search.
    setFiltersExpanded(false);

    // Always start table from first page.
    setPaginationModel((prev) => ({
      ...prev,
      page: 0,
    }));

  };


  // ---------------------------------------------------------
  // FETCH DATA AFTER SEARCH / PAGINATION
  // ---------------------------------------------------------

  useEffect(() => {

    if (!searched) return;

    if (filtersExpanded) return;

    fetchData(
      paginationModel.page,
      paginationModel.pageSize
    );

  }, [
    searched,
    filtersExpanded,
    paginationModel.page,
    paginationModel.pageSize,
    fetchData,
  ]);


  // ---------------------------------------------------------
  // RESET
  // ---------------------------------------------------------

  const handleReset = () => {

    setRows([]);
    setRowCount(0);

    setBranch("");
    setBranchInput("");

    setCurrency("");
    setCurrencyInput("");

    setCgl("");
    setCglInput("");

    setBranches([]);
    setCgls([]);

    setSearched(false);

    setFiltersExpanded(true);

    setPaginationModel({
      page: 0,
      pageSize: 25,
    });

  };


  // ---------------------------------------------------------
  // UI
  // ---------------------------------------------------------

  return (
    <Box
      sx={{
        p: {
          xs: 1,
          sm: 2,
        },
      }}
    >

      {/* =====================================================
          HEADER + FILTER CARD
          ===================================================== */}

      <Paper
        elevation={0}
        sx={{
          p: {
            xs: 1.5,
            sm: 2.5,
          },

          mt: {
            xs: -1,
            sm: -2,
          },

          mb: 3,

          bgcolor: "rgba(255,255,255,.4)",

          backdropFilter: "blur(4px)",

          border: "1px solid",

          borderColor: "divider",

          borderRadius: {
            xs: 2,
            sm: 3,
          },

          overflow: "hidden",
        }}
      >


        {/* =================================================
            HEADER
            ================================================= */}

        <Box
          sx={{
            mb: filtersExpanded ? 1 : 0.5,

            p: {
              xs: 1,
              sm: 1.2,
            },

            borderRadius: 2,

            bgcolor: "background.paper",

            boxShadow: 2,

            borderLeft: "6px solid",

            borderColor: "primary.main",
          }}
        >

          <Stack
            direction={{
              xs: "column",
              sm: "row",
            }}
            alignItems={{
              xs: "flex-start",
              sm: "center",
            }}
            justifyContent="space-between"
            spacing={2}
          >

            <Stack
              direction="row"
              spacing={{
                xs: 1.5,
                sm: 2,
              }}
              alignItems="center"
              sx={{
                width: "100%",
              }}
            >

              <CalendarMonthIcon
                color="primary"
                sx={{
                  fontSize: {
                    xs: 30,
                    sm: 36,
                  },

                  flexShrink: 0,
                }}
              />


              <Box
                sx={{
                  minWidth: 0,
                }}
              >

                <Stack
                  direction="row"
                  spacing={1}
                  alignItems="center"
                >

                  <Typography
                    variant="subtitle1"
                    fontWeight={700}
                    sx={{
                      fontSize: {
                        xs: ".95rem",
                        sm: "1rem",
                        md: "1.05rem",
                      },
                    }}
                  >
                    Date Wise Balance Search
                  </Typography>


                  <Typography
                    sx={{
                      px: 1,
                      py: 0.25,

                      borderRadius: 1.5,

                      bgcolor:
                        "rgba(88,70,159,.08)",

                      color:
                        "primary.main",

                      fontSize: ".7rem",

                      fontWeight: 700,
                    }}
                  >
                    Date Wise
                  </Typography>

                </Stack>


                <Typography
                  variant="body2"
                  color="text.secondary"
                  sx={{
                    mt: 0.2,

                    fontSize: {
                      xs: ".75rem",
                      sm: ".82rem",
                    },
                  }}
                >
                  View balance differences for a selected
                  date and track reconciliation history.
                </Typography>

              </Box>

            </Stack>


            {/* =================================================
                EDIT FILTERS
                IMPORTANT: USE searched, NOT rows.length
                ================================================= */}

            {searched && (
              <StyledButton
                variant="contained"
                startIcon={
                  <ManageSearchOutlinedIcon />
                }
                onClick={() =>
                  setFiltersExpanded(true)
                }
                sx={{
                  textTransform: "none",

                  borderRadius: "8px",

                  fontWeight: 600,

                  minWidth: {
                    xs: "100%",
                    sm: 140,
                  },

                  width: {
                    xs: "100%",
                    sm: "auto",
                  },

                  height: {
                    xs: 38,
                    sm: 32,
                  },
                }}
              >
                Edit Filters
              </StyledButton>
            )}

          </Stack>

        </Box>


        {/* =====================================================
            FILTERS
            ===================================================== */}

        {filtersExpanded && (

          <Box
            sx={{
              mt: 3,
            }}
          >

            <Box
              sx={{
                display: "grid",

                gridTemplateColumns: {
                  xs: "1fr",

                  sm: "repeat(2, 1fr)",

                  md: "repeat(4, 1fr)",
                },

                gap: 2,
              }}
            >


              {/* ============================
                  ETL DATE
                  ============================ */}

              <LocalizationProvider
                dateAdapter={AdapterDayjs}
              >

                <DatePicker
                  value={etlDate}
                  format="DD-MM-YYYY"
                  maxDate={etlDate}
                  onChange={setEtlDate}

                  slotProps={{
                    textField: {
                      label: "ETL Date*",

                      fullWidth: true,

                      InputLabelProps: {
                        shrink: true,
                      },

                      placeholder:
                        "DD-MM-YYYY",
                    },
                  }}
                />

              </LocalizationProvider>


              {/* ============================
                  BRANCH
                  ============================ */}

              <Autocomplete
                autoHighlight
                forcePopupIcon={false}

                value={branch}

                inputValue={branchInput}

                options={branches}

                noOptionsText={
                  branchInput.length < 3
                    ? "Please enter at least 3 characters"
                    : "No Options"
                }

                onInputChange={(
                  e,
                  value,
                  reason
                ) => {

                  setBranchInput(value);

                  if (
                    reason === "input" &&
                    value.length >= 3
                  ) {

                    fetchSearchData(
                      "branch",
                      value
                    );

                  }

                }}

                onChange={(
                  e,
                  value
                ) => {

                  setBranch(
                    value || ""
                  );

                }}

                renderInput={(params) => (

                  <TextField
                    {...params}

                    label="Branch Code or Name*"

                    placeholder="eg. 12345 or ABC"

                    fullWidth

                    InputLabelProps={{
                      shrink: true,
                    }}
                  />

                )}
              />


              {/* ============================
                  CURRENCY
                  ============================ */}

              <Autocomplete
                autoHighlight

                options={currencies}

                value={
                  currencies.find(
                    (c) =>
                      c.currencyCode ===
                      currency
                  ) || null
                }

                inputValue={
                  currencyInput
                }

                getOptionLabel={(o) =>
                  o
                    ? `${o.currencyCode} (${o.currencyName})`
                    : ""
                }

                onInputChange={(
                  e,
                  value
                ) => {

                  setCurrencyInput(
                    value
                  );

                }}

                onChange={(
                  e,
                  value
                ) => {

                  setCurrency(
                    value?.currencyCode ||
                      ""
                  );

                  setCurrencyInput(
                    value
                      ? `${value.currencyCode} - ${value.currencyName}`
                      : ""
                  );

                }}

                onOpen={
                  fetchCurrencies
                }

                renderInput={(params) => (

                  <TextField
                    {...params}

                    label="Currency*"

                    placeholder="Please select Currency"

                    fullWidth

                    InputLabelProps={{
                      shrink: true,
                    }}
                  />

                )}
              />


              {/* ============================
                  CGL
                  ============================ */}

              <Autocomplete
                autoHighlight

                forcePopupIcon={false}

                value={cgl}

                inputValue={cglInput}

                options={cgls}

                noOptionsText={
                  cglInput.length < 3
                    ? "Please enter at least 3 characters"
                    : "No Options"
                }

                onInputChange={(
                  e,
                  value,
                  reason
                ) => {

                  setCglInput(value);

                  if (
                    reason === "input" &&
                    value.length >= 3
                  ) {

                    fetchSearchData(
                      "cgl",
                      value
                    );

                  }

                }}

                onChange={(
                  e,
                  value
                ) => {

                  setCgl(
                    value || ""
                  );

                  setCglInput(
                    value || ""
                  );

                }}

                renderInput={(params) => (

 

import React, { useCallback, useEffect, useState } from 'react'
import useApi from '../../hooks/useApi'
import Validation from './Validation';
import useCustomSnackbar from '../../utils/useCustomSnackbar';
import { Autocomplete, Box, Button, FormControl, Grid, Input, InputLabel, MenuItem, Select, TextField } from '@mui/material';
import debounce from 'lodash/debounce';
import styled from '@emotion/styled';

const filterMap = {
    CURRENCY: { type: "autocomplete", multiValue: true, validate: "validateCurrency" },
    CGL: { type: "autocomplete", multiValue: true, validate: "validateCgl" },
    JOURNAL_NUMBER: { type: "input", multiValue: false, validate: "validateJrnNo" },
    TRANSACTION_CODE: { type: "input", multiValue: true, validate: "validateTxnCode" },
    BATCH_ID: { type: "input", multiValue: false, validate: "validateBatchId" },
    ACCOUNT: { type: "input", multiValue: false, validate: "validateAccNo" }
}

const AddButton = styled(Button)(({ theme }) => ({
    display: "flex",
    justifyContent: "center",
    alignItems: "center"
}));

const StyledFormControl = styled(FormControl)(({ theme }) => ({
    margin: "5px"
}));

const AddBox = styled(Box)(({ theme }) => ({
    display: "flex",
    alignItems: "center",
    justifyContent: "center"
}));


const CustomTextField = styled(TextField)(({ theme }) => ({
    display: 'flex',
    flexGrow: 1
}));

export default function Filter({ handleFilter, getValues }) {
    const [values, setValues] = useState([]);
    const [filterField, setFilterField] = useState('CGL');
    const [isMinInput, setIsMinInput] = useState();
    const [inputInstance, setInputInstance] = useState("");
    const snackbar = useCustomSnackbar();
    const { callApi } = useApi();

    const setFilter = () => {
        if ((filterField === "CURRENCY" || filterField === "CGL") && inputInstance === "") {
            snackbar("Kindly select the value!", "error");
            return
        }
        let isValid = Validation[filterMap[filterField].validate](inputInstance);
        if (isValid != null) {
            snackbar(isValid, "error")
            return;
        }
        handleFilter({ field: filterField, value: inputInstance, multiValue: filterMap[filterField].multiValue })
        setInputInstance("");
    }

    const debouncedFetchCgls = useCallback(debounce(async (value, type, isMinInput) => {
        await fetchCgls(value, type, isMinInput);
    }, 100), []);

    async function fetchCurrencies() {
        const response = await callApi(
            "/CM/common-master/currency",
            null,
            "GET",
        );
        console.log(response);
        if (response) {
            setValues(response.data || [])
        } else {
            snackbar("Failed to fetch currency list!")
        }
    }

    async function fetchCgls(term, reason, isMinInput) {
        console.log(term + " | " + reason)
        if (reason === "input") {
            // Fires instantly as soon as the 3rd character is typed
            if (term?.length < 3) {
                // if (inputInstance?.length != 0) {
                if (isMinInput) {
                    setIsMinInput(false);
                }
                setValues([])
                // }
                return;
            }
            if (!isMinInput) {
                setIsMinInput(true);
            }

            try {
                const res = await callApi(`/CM/common-master/cgl-code-description-only?q=${encodeURIComponent(term)}`);
                if (res && res.success) {
                    setValues(res?.data);
                } else {
                    setValues([]);
                    snackbar(res?.message, "error")
                }
            } catch (e) {
                snackbar(e.message, "error")
            }
        }

    }

    const handleSelectChange = (e) => {
        setFilterField(e.target.value);
        setInputInstance("");
        // setIsAutoCompleteSet(false);
        setValues([]);
    }

    useEffect(() => {
        const fetchData = async () => {
            await fetchCurrencies();
        }
        if (filterField === "CURRENCY") {
            fetchData();
        }
    }, [filterField])

    return (
        <Box>
            <Grid container spacing={1}>
                <Grid item size={{ md: 6, p: 1 }}>
                    <StyledFormControl variant="outlined" fullWidth >
                        <InputLabel >Select Filter</InputLabel>
                        <Select
                            value={filterField || ''}
                            label="Select Filter"
                            onChange={handleSelectChange}
                        >
                            <MenuItem value={"CURRENCY"}>Currency</MenuItem>
                            <MenuItem value={"CGL"}>CGL</MenuItem>
                            <MenuItem value={"JOURNAL_NUMBER"}>Journal Number</MenuItem>
                            <MenuItem value={"TRANSACTION_CODE"}>Transaction Code</MenuItem>
                            <MenuItem value={"BATCH_ID"}>Batch Id</MenuItem>
                            <MenuItem value={"ACCOUNT"}>Account</MenuItem>
                        </Select>
                    </StyledFormControl>
                </Grid>
                <Grid item size={{ md: 6, p: 1 }}>
                    {filterField === "CURRENCY" &&
                        <Autocomplete
                            options={values || []}
                            value={inputInstance}
                            // inputValue={inputInstance}
                            // className={styles.flexiBox}
                            onInputChange={(event, value, reason) => {
                                // setIsAutoCompleteSet((prev) => { if (prev && reason == "input") { return false } });
                                setInputInstance('')
                            }}
                            renderInput={(params) => <TextField {...params} label="CURRENCY" />}
                            filterOptions={(options, { inputValue }) => { return options.filter((val) => val.startsWith(inputValue.toUpperCase()) && !getValues("CURRENCY")?.includes(val)) }}
                            onChange={(e, v, r) => {
                                if (r === "selectOption") {
                                    // setIsAutoCompleteSet(true);
                                    setInputInstance(v);
                                } else if (r === "clear") {
                                    // setIsAutoCompleteSet(false);
                                    setInputInstance('')
                                }
                                // else {
                                // setIsAutoCompleteSet(false);
                                // }
                            }}
                            noOptionsText={
                                ("No Options")
                            }
                        />

                    }
                    {filterField === "CGL" &&
                        <Autocomplete
                            options={values.map((each) => each.cglNumber)}
                            value={inputInstance}
                            // inputValue={inputInstance}
                            // className={styles.flexiBox}
                            onInputChange={(event, value, reason) => {
                                //  setIsAutoCompleteSet((prev) => { if (prev && reason == "input") { return false } });
                                debouncedFetchCgls(value, reason, isMinInput)
                            }}
                            renderInput={(params) => <TextField {...params} label="CGL" />}
                            filterOptions={(options) => { return options.filter((val) => !getValues("CGL")?.includes(val)) }}
                            onChange={(e, v, r) => {
                                if (r === "selectOption") {
                                    // setIsAutoCompleteSet(true);
                                    setInputInstance(v);
                                    setValues([]);
                                } else if (r === "clear") {
                                    // setIsAutoCompleteSet(false);
                                    setInputInstance('');
                                    setValues([]);
                                }
                                // else {
                                // setIsAutoCompleteSet(false);
                                // }
                            }}
                            noOptionsText={
                                (!isMinInput) ? "Please enter at least 3 characters" : "No Options"
                            }
                        />
                    }
                    {filterField === "JOURNAL_NUMBER" &&
                        <StyledFormControl variant="outlined" fullWidth>
                            <TextField
                                id="outlined-controlled"
                                label="JOURNAL NUMBER"
                                slotProps={{
                                    htmlInput: { maxLength: 10 }
                                }
                                }
                                value={inputInstance}
                                onChange={(e) => {
                                    setInputInstance(e.target.value)
                                }}
                            />
                        </StyledFormControl>
                    }
                    {filterField === "TRANSACTION_CODE" &&
                        <StyledFormControl variant="outlined" fullWidth>
                            <CustomTextField
                                id="outlined-controlled"
                                label="TRANSACTION CODE"
                                slotProps={{
                                    htmlInput: { maxLength: 5 }
                                }
                                }
                                value={inputInstance}
                                onChange={(e) => {
                                    setInputInstance(e.target.value)
                                }}
                            />
                        </StyledFormControl>
                    }
                    {filterField === "BATCH_ID" &&
                        <StyledFormControl variant="outlined" fullWidth >
                            <CustomTextField
                                id="outlined-controlled"
                                label="BATCH_ID"
                                slotProps={{
                                    htmlInput: { maxLength: 10 }
                                }
                                }
                                value={inputInstance}
                                onChange={(e) => {
                                    setInputInstance(e.target.value)
                                }}
                            />
                        </StyledFormControl>}
                    {filterField === "ACCOUNT" &&
                        <StyledFormControl variant="outlined" fullWidth >
                            <CustomTextField
                                id="outlined-controlled"
                                label="ACCOUNT"
                                slotProps={{
                                    htmlInput: { maxLength: 10 }
                                }
                                }
                                value={inputInstance}
                                onChange={(e) => {
                                    setInputInstance(e.target.value)
                                }}
                            />
                        </StyledFormControl>}
                </Grid>
            </Grid>
            {!(filterField === '') &&
                <AddBox >
                    <AddButton variant='contained' onClick={setFilter}>Add</AddButton>
                </AddBox>
            }
        </Box>
    )
}

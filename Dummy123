import React, { useEffect, useState, useCallback } from 'react'
import {
  Box, Typography, Chip, Paper, Tabs, Tab,
  Button, IconButton, Dialog, DialogContent, DialogTitle, Collapse
} from '@mui/material'
import { LocalizationProvider } from '@mui/x-date-pickers/LocalizationProvider';
import { DesktopDatePicker } from '@mui/x-date-pickers/DesktopDatePicker';
import { AdapterDayjs } from '@mui/x-date-pickers/AdapterDayjs';
import dayjs from 'dayjs';
import DisplayTab from './DisplayTab';
import useApi from '../../hooks/useApi';
import {
  AccountBalance, Public, Download, Delete, Close, CalendarMonthOutlined,
  ReceiptLongOutlined, VerifiedUserOutlined, CompareArrowsOutlined,
  AdjustOutlined, StorageOutlined, AccountBalanceOutlined,
  ExpandMoreOutlined, InfoOutlined, AutoAwesome, FilterAltOutlined,
  PlaylistAddCheckOutlined, CloudDownloadOutlined
} from '@mui/icons-material';
import debounce from 'lodash/debounce'
import downloadFile from '../../utils/DownloadUtils';
import useCustomSnackbar from '../../utils/useCustomSnackbar';
import styles from './BranchPosition.module.css'
import Filter from './Filter';

const alterDateFormat = (date) => {
  const dateRegex = /^(0[1-9]|[12][0-9]|3[01])([-/.])(0[1-9]|1[0-2])\2(\d{4})$/;
  return date.replace(dateRegex, '$4$2$3$2$1');
}

// Category metadata drives both the summary cards and the accordion rows.
const categoryMeta = {
  TSD: { label: "Technical Suspense", category: "Technical Suspense Difference", icon: <ReceiptLongOutlined fontSize="small" />, role: "rolePurple" },
  CSD: { label: "CGL Suspense", category: "CGL Suspense Difference", icon: <VerifiedUserOutlined fontSize="small" />, role: "roleTeal" },
  BCD: { label: "Balance Compare", category: "Balance Compare Difference", icon: <CompareArrowsOutlined fontSize="small" />, role: "roleAmber" },
}

const filterFieldColors = {
  CURRENCY: { bg: '#E1F5EE', text: '#0F8A6C' },
  CGL: { bg: '#EEEDFE', text: '#6C5CE7' },
  JOURNAL_NUMBER: { bg: '#E6F1FB', text: '#1D6FB8' },
  TRANSACTION_CODE: { bg: '#FBEAF0', text: '#C23E70' },
  BATCH_ID: { bg: '#F1EFE8', text: '#6B6A63' },
  ACCOUNT: { bg: '#FFF1E0', text: '#C9761A' },
}

// Simple flat-design bank illustration, built inline so there's no external
// image asset/licensing to manage. Sparkle accents sit around it via CSS.
function BankIllustration() {
  return (
    <svg width="120" height="92" viewBox="0 0 120 92" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="10" y="76" width="100" height="8" rx="2" fill="#DCD5FE" />
      <polygon points="60,10 108,34 12,34" fill="#C9BFFC" />
      <rect x="16" y="34" width="88" height="38" fill="#EEEDFE" />
      <rect x="26" y="42" width="10" height="30" rx="2" fill="#8F7FF0" />
      <rect x="44" y="42" width="10" height="30" rx="2" fill="#8F7FF0" />
      <rect x="62" y="42" width="10" height="30" rx="2" fill="#8F7FF0" />
      <rect x="80" y="42" width="10" height="30" rx="2" fill="#8F7FF0" />
      <rect x="12" y="72" width="96" height="4" fill="#6C5CE7" />
      <circle cx="60" cy="22" r="4" fill="#6C5CE7" />
    </svg>
  )
}

function SummaryCard({ meta, count, isLoading, onDownload }) {
  const hasCount = typeof count === 'number';
  const isReconciled = hasCount && count === 0;
  return (
    <Paper elevation={0} className={`${styles.summaryCard} ${styles[meta.role]}`}>
      {isReconciled && <AutoAwesome className={styles.cardSparkleBadge} />}
      <Box className={styles.summaryCardHeader}>
        <Box className={styles.summaryCardIcon}>{meta.icon}</Box>
        <Typography className={styles.summaryCardLabel}>{meta.label}</Typography>
      </Box>
      <Typography className={styles.summaryCardCount}>{isLoading ? '—' : (hasCount ? count : '—')}</Typography>
      <Typography className={styles.summaryCardCaption}>{isLoading ? 'Checking…' : 'Records found'}</Typography>
      <Button
        className={styles.summaryDownloadButton}
        variant="outlined"
        size="small"
        startIcon={<Download fontSize="small" />}
        disabled={!hasCount || count === 0}
        onClick={onDownload}
      >
        Download
      </Button>
    </Paper>
  )
}

export default function BranchPosition() {
  const [userDate, setUserDate] = useState(null);
  const [dataRows, setDataRows] = useState({});
  const [breakupDataRows, setBreakupDataRows] = useState({});
  const { callApi } = useApi();
  const [glifDataFilter, setGlifDataFilter] = useState({});
  const [loading, setLoading] = useState("N"); //"N","Y","BCD","TSD","CSD"
  const showSnackBar = useCustomSnackbar();
  const [mode, setMode] = useState("DD");
  const [isDialogOpen, setIsDialogOpen] = useState(false);
  const [expandedCategory, setExpandedCategory] = useState("TSD");
  const user = JSON.parse(localStorage.getItem('user'));

  /* DATA FETCHING FUNCTIONS */
  const debouncedFetchDifference = useCallback(debounce(async (type) => {
    if (mode === "DD") {
      await fetchDifference(type);
    }
  }, 100), [userDate, mode]);

  async function fetchDifference() {
    const payload = {
      date: userDate,
      branch: user.branch.toString().padStart(5, 0),
      paginationModel: { page: 0, pageSize: 100 }
    }
    try {
      setLoading("Y");
      const res = await callApi("/ES/branch-position/get-difference", payload, "POST");
      if (res && res.success) {
        setDataRows(res.data);
      } else {
        showSnackBar(res.message, "error")
        setDataRows({});
      }
      setLoading("N");
    } catch (e) {
      setLoading("N");
      showSnackBar(e.message, "error")
    }
  }

  async function fetchIndividualDifference(type, paginationModel) {
    const payload = {
      date: userDate,
      branch: user.branch.toString().padStart(5, 0),
      differenceType: type,
      paginationModel
    }
    try {
      setLoading(type);
      const res = await callApi("/ES/branch-position/get-difference", payload, "POST");
      if (res && res.success) {
        setDataRows((prev) => { return { ...prev, [type]: res.data[type] || [] } });
      } else {
        showSnackBar(res.message, "error")
      }
      setLoading("N");
    } catch (e) {
      setLoading("N");
      showSnackBar(e.message, "error")
    }
  }

  const fetchDetailedData = async (type, { cgl, currency, firstErrorDate }) => {
    const payload = {
      branch: user.branch.toString().padStart(5, 0),
      cgl, currency,
      startDate: alterDateFormat(firstErrorDate),
      endDate: userDate,
      differenceType: type
    }
    try {
      const res = await callApi("/ES/branch-position/get-detailed-difference", payload, 'POST');
      if (res && res.success) {
        setBreakupDataRows(() => { return { type, content: res.data || [] } });
      } else {
        showSnackBar(res.message, "error")
      }
    } catch (e) {
      showSnackBar(e.message, "error")
    }
  }

  const blobErrorHandler = (error) => {
    if (error instanceof Blob) {
      error.text().then((errorMessage) => {
        try {
          const errorJson = JSON.parse(errorMessage);
          showSnackBar(errorJson?.message, "error");
        } catch (e) {
          showSnackBar(`Error: ${errorMessage}`);
        }
      });
    } else {
      showSnackBar(error.message, "error");
    }
  }

  const exportData = async (filePref, differenceType) => {
    const payload = {
      branch: user.branch.toString().padStart(5, 0),
      date: userDate,
      differenceType
    }
    try {
      const res = await callApi("/ES/branch-position/export-difference", payload, 'POST', 'blob', 'application/octet-stream');
      if (res) {
        const filename = `${filePref}_${payload.branch}_${alterDateFormat(userDate)}`
        const fileData = new Blob([res]);
        downloadFile(fileData, "xlsx", filename, false);
      } else {
        throw new Error("Failed to download file!")
      }
    } catch (e) {
      blobErrorHandler(e);
    }
  }

  const exportDetailedData = async () => {
    if (breakupDataRows?.content.length == 0) {
      showSnackBar("No Rows to download!", "error")
    }
    const cgl = breakupDataRows.content[0].cgl
    const currency = breakupDataRows.content[0].currency
    const branch = user.branch.toString().padStart(5, 0)
    const differenceType = breakupDataRows.type
    const firstErrorDate = breakupDataRows.content[0].firstErrorDate;
    const payload = {
      branch, cgl, currency,
      startDate: alterDateFormat(firstErrorDate),
      endDate: userDate,
      differenceType
    }
    try {
      const res = await callApi("/ES/branch-position/export-detailed-difference", payload, 'POST', 'blob', 'application/octet-stream');
      if (res) {
        const filename = `${differenceType}_${branch}_${currency}_${cgl}_${alterDateFormat(userDate)}`
        const fileData = new Blob([res]);
        downloadFile(fileData, "xlsx", filename, false);
      } else {
        throw new Error("Failed to download file!")
      }
    } catch (e) {
      blobErrorHandler(e);
    }
  }

  const exportGlifData = async () => {
    const payload = {
      branch: user.branch.toString().padStart(5, 0),
      date: userDate,
      filters: [
        { field: "BRANCH_CODE", operator: "EQUALS", value: user.branch.toString().padStart(5, 0) },
        { field: "TRANS_DATE", operator: "EQUALS", value: userDate },
        ...Object.entries(glifDataFilter).map(([key, entry]) => { return { ["field"]: key, ["operator"]: entry.operator, ["value"]: entry.value } })
      ]
    }
    try {
      const res = await callApi("/ES/branch-position/export-glif-data", payload, 'POST', 'blob', 'application/octet-stream');
      if (res) {
        const branch = user.branch.toString().padStart(5, 0)
        let filename = `glif_${branch}_${alterDateFormat(userDate)}${Object.keys(glifDataFilter).length > 0 ? "_filtered" : ""}`;
        const fileData = new Blob([res]);
        downloadFile(fileData, "xlsx", filename, false);
      } else {
        throw new Error("Failed to download file!")
      }
    } catch (error) {
      blobErrorHandler(error);
    }
  }

  useEffect(() => {
    const fetchData = async () => {
      try {
        const res = await callApi("/ES/branch-position/user-date");
        if (res && res.success) {
          setUserDate(res.data.substring(0, 10));
        } else {
          showSnackBar(res.message, "error")
        }
      } catch (e) {
        showSnackBar(e.message, "error")
      }
    }
    fetchData();

    return () => {
      setUserDate(null);
      setBreakupDataRows({});
      setDataRows(null);
      setIsDialogOpen(false);
      setGlifDataFilter({});
      setLoading("N");
      setMode("DD")
    }
  }, []);

  useEffect(() => {
    if (userDate == null) { return; }
    setBreakupDataRows({});
    debouncedFetchDifference();
  }, [userDate, debouncedFetchDifference]);

  useEffect(() => {
    if (!breakupDataRows?.content) { return; }
    setIsDialogOpen(true);
  }, [breakupDataRows]);

  const closeDialog = () => {
    setBreakupDataRows({});
    setIsDialogOpen(false);
  }

  const handleFilter = (filter) => {
    if (!filter.multiValue) {
      setGlifDataFilter((prev) => { return { ...prev, [filter.field]: { operator: "EQUALS", value: filter.value } } })
      return;
    }
    if (glifDataFilter[filter.field]) {
      if (glifDataFilter[filter.field].value.length >= 10) {
        showSnackBar("only 10 filter values allowed!", "error");
        return;
      } else {
        if (new Set(glifDataFilter[filter.field].value).has(filter.value)) {
          showSnackBar("value already present in the filter!", "error")
          return;
        }
      }
      setGlifDataFilter((prev) => { return { ...prev, [filter.field]: { operator: "IN", value: [...prev[filter.field].value, filter.value] } } })
      return
    }
    setGlifDataFilter((prev) => { return { ...prev, [filter.field]: { operator: "IN", value: [filter.value] } } })
  }

  const deleteFilter = (key) => {
    const { [key]: _, ...rem } = glifDataFilter;
    setGlifDataFilter(rem);
  }

  const deleteFilterValue = (key, deleteVal) => {
    const newArray = glifDataFilter[key].value.filter((val) => val != deleteVal);
    if (newArray.length > 0) {
      setGlifDataFilter((prev) => { return { ...prev, [key]: { ...prev[key], value: newArray } } })
    } else {
      deleteFilter(key)
    }
  }

  const getFiterData = (field) => {
    return glifDataFilter[field]?.value || [];
  }

  const getCategoryCount = (type) => {
    const bucket = dataRows?.[type];
    if (!bucket) return null;
    if (typeof bucket?.page?.totalElements === 'number') return bucket.page.totalElements;
    if (Array.isArray(bucket?.content)) return bucket.content.length;
    return null;
  }

  const activeFilterCount = Object.keys(glifDataFilter).length;

  return (
    <>
      <Box className={styles.appShell}>
        {/* ---- Sidebar: branch context, date, navigation ---- */}
        <Box className={styles.sidebar}>
          <Box className={styles.sidebarBrand}>
            <Box className={styles.sidebarBrandIconWrap}>
              <Box className={styles.sidebarBrandIcon}>
                <AccountBalanceOutlined fontSize="small" />
              </Box>
              <AutoAwesome className={styles.brandSparkle} />
            </Box>
            <Typography className={styles.sidebarBrandText}>Branch Position</Typography>
          </Box>

          <Box className={styles.infoCard}>
            <Box className={styles.infoCardIcon}><AccountBalance fontSize="small" /></Box>
            <Box>
              <Typography className={styles.infoCardLabel}>Branch</Typography>
              <Typography className={styles.infoCardValue}>{user?.branch?.toString().padStart(5, 0)}</Typography>
              <Typography className={styles.infoCardSubvalue}>{user?.branchName}</Typography>
            </Box>
          </Box>

          <Box className={styles.infoCard}>
            <Box className={styles.infoCardIcon}><Public fontSize="small" /></Box>
            <Box>
              <Typography className={styles.infoCardLabel}>Circle</Typography>
              <Typography className={styles.infoCardValue}>{user?.circleCode}</Typography>
              <Typography className={styles.infoCardSubvalue}>{user?.circleName}</Typography>
            </Box>
          </Box>

          <Box className={styles.infoCard} sx={{ marginBottom: '16px' }}>
            <Box className={styles.infoCardIcon}><CalendarMonthOutlined fontSize="small" /></Box>
            <Box sx={{ flexGrow: 1 }}>
              <Typography className={styles.infoCardLabel}>Report Date</Typography>
              <LocalizationProvider dateAdapter={AdapterDayjs}>
                <DesktopDatePicker
                  value={userDate ? dayjs(userDate.substring(0, 11), 'YYYY-MM-DD') : dayjs()}
                  onChange={(newVal) => { newVal ? setUserDate(newVal.format('YYYY-MM-DD')) : setUserDate(dayjs().format('YYYY-MM-DD')) }}
                  maxDate={dayjs()}
                  format='DD-MM-YYYY'
                  closeOnSelect={true}
                  slotProps={{
                    textField: {
                      size: 'small', fullWidth: true, variant: 'standard',
                      InputProps: { disableUnderline: true, sx: { fontSize: '13px', fontWeight: 600, color: 'rgba(30,20,60,0.85)' } }
                    }
                  }}
                  slots={{ actionBar: () => null }}
                />
              </LocalizationProvider>
            </Box>
          </Box>

          <Tabs
            orientation="vertical"
            className={styles.navTabs}
            value={mode}
            onChange={() => {
              setMode((mode === "DD") ? "GE" : "DD");
              setGlifDataFilter({})
            }}
            TabIndicatorProps={{ style: { display: 'none' } }}
            aria-label="branch position mode navigation"
          >
            <Tab
              value="DD" className={styles.navTab}
              icon={<AdjustOutlined fontSize="small" />} iconPosition="start"
              label="Difference Data"
              disabled={loading != "N" && mode != "DD"}
            />
            <Tab
              value="GE" className={styles.navTab}
              icon={<StorageOutlined fontSize="small" />} iconPosition="start"
              label="GLIF Data"
              disabled={loading != "N" && mode != "GE"}
            />
          </Tabs>

          <Box className={styles.sidebarFooter}>
            <Box className={styles.sidebarIllustration}>
              <AutoAwesome className={styles.sparkleTopRight} />
              <AutoAwesome className={styles.sparkleBottomLeft} />
              <AutoAwesome className={styles.sparkleMidRight} />
              <BankIllustration />
            </Box>
          </Box>
        </Box>

        {/* ---- Main content ---- */}
        <Box className={styles.mainContent}>
          {mode === "DD" && (
            <>
              <Box className={styles.pageHeaderRow}>
                <Typography className={styles.pageHeaderTitle}>Difference data</Typography>
                <AutoAwesome className={styles.headerSparkle} />
              </Box>
              <Typography className={styles.pageHeaderSubtitle}>
                Reconciliation status for {userDate ? dayjs(userDate).format('DD-MM-YYYY') : '—'}
              </Typography>

              <Box className={styles.summaryRow}>
                {Object.entries(categoryMeta).map(([type, meta]) => (
                  <SummaryCard
                    key={type}
                    meta={meta}
                    count={getCategoryCount(type)}
                    isLoading={loading === "Y" || loading === type}
                    onDownload={() => exportData(type, type)}
                  />
                ))}
              </Box>

              <Box className={styles.accordionList}>
                {Object.entries(categoryMeta).map(([type, meta]) => {
                  const count = getCategoryCount(type);
                  const isOpen = expandedCategory === type;
                  const isLoading = loading === "Y" || loading === type;
                  return (
                    <Box key={type} className={styles.accordionRow}>
                      <Box
                        className={styles.accordionHeader}
                        onClick={() => setExpandedCategory(isOpen ? null : type)}
                      >
                        <Box className={styles.accordionHeaderIcon} sx={{
                          backgroundColor: meta.role === 'rolePurple' ? '#EEEDFE' : meta.role === 'roleTeal' ? '#E1F5EE' : '#FFF1E0',
                          color: meta.role === 'rolePurple' ? '#6C5CE7' : meta.role === 'roleTeal' ? '#10A37F' : '#C9761A',
                        }}>
                          {meta.icon}
                        </Box>
                        <Typography className={styles.accordionHeaderLabel}>{meta.label}</Typography>
                        <Chip
                          size="small"
                          className={styles.accordionCountChip}
                          label={isLoading ? '…' : (typeof count === 'number' ? `${count} rows` : '—')}
                          sx={{
                            backgroundColor: (count === 0) ? '#E1F5EE' : (count > 0) ? '#FFF1E0' : '#F1EFE8',
                            color: (count === 0) ? '#0F8A6C' : (count > 0) ? '#A56814' : '#6B6A63',
                          }}
                        />
                        <Button
                          size="small"
                          variant="outlined"
                          startIcon={<Download fontSize="small" />}
                          disabled={!count}
                          onClick={(e) => { e.stopPropagation(); exportData(type, type); }}
                          sx={{ textTransform: 'none', borderRadius: '8px' }}
                        >
                          Download
                        </Button>
                        <Box className={`${styles.accordionChevron} ${isOpen ? styles.accordionChevronOpen : ''}`}>
                          <ExpandMoreOutlined fontSize="small" />
                        </Box>
                      </Box>
                      <Collapse in={isOpen} timeout="auto" unmountOnExit>
                        <DisplayTab
                          category={meta.category}
                          type={type}
                          level={1}
                          hideHeader
                          flat
                          data={dataRows[type] || []}
                          clickHandler={fetchDetailedData}
                          downloadHandler={exportData}
                          loading={isLoading}
                          requestData={fetchIndividualDifference}
                        />
                      </Collapse>
                    </Box>
                  )
                })}
              </Box>

              <Box className={styles.infoBanner}>
                <InfoOutlined fontSize="small" sx={{ color: '#6C5CE7', mt: '1px' }} />
                <Typography className={styles.infoBannerText}>
                  Download will include all Difference data for branch {user?.branch?.toString().padStart(5, 0)} on {userDate ? dayjs(userDate).format('DD-MM-YYYY') : '—'}.
                </Typography>
              </Box>
            </>
          )}

          {mode === "GE" && (
            <>
              <Box className={styles.pageHeaderRow}>
                <Typography className={styles.pageHeaderTitle}>GLIF data</Typography>
                <AutoAwesome className={styles.headerSparkle} />
              </Box>
              <Typography className={styles.pageHeaderSubtitle}>
                Download GLIF data for your branch and selected date.
              </Typography>

              {/* Row 1 — Add filter (field + value + Add button) */}
              <Box className={styles.glifSection}>
                <Box className={styles.glifSectionHeader}>
                  <Box className={styles.glifSectionIcon}><FilterAltOutlined fontSize="small" /></Box>
                  <Typography className={styles.glifSectionTitle}>Add Filter</Typography>
                </Box>
                <Typography className={styles.typographyLabel} sx={{ mb: 1 }}>
                  Add up to 10 values per filter field.
                </Typography>
                <Filter handleFilter={handleFilter} getValues={getFiterData} />
              </Box>

              {/* Row 2 — Applied filters */}
              <Box className={styles.glifSection}>
                <Box className={styles.glifSectionHeader} sx={{ marginBottom: 0 }}>
                  <Box className={styles.glifSectionIcon}><PlaylistAddCheckOutlined fontSize="small" /></Box>
                  <Typography className={styles.glifSectionTitle}>Applied Filters ({activeFilterCount})</Typography>
                  {activeFilterCount > 0 && (
                    <button className={styles.clearAllLink} onClick={() => setGlifDataFilter({})}>
                      Clear All
                    </button>
                  )}
                </Box>
                <Box sx={{ marginTop: '14px' }}>
                  {activeFilterCount === 0 ? (
                    <Typography variant="caption" sx={{ color: 'rgba(30,20,60,0.45)' }}>
                      No filters applied yet — results will include the full branch and date.
                    </Typography>
                  ) : (
                    <Box className={styles.chipValues}>
                      {Object.entries(glifDataFilter).map(([key, val]) => {
                        const color = filterFieldColors[key] || { bg: '#F1EFE8', text: '#6B6A63' };
                        const items = Array.isArray(val.value) ? val.value : [val.value];
                        return items.map((ent, index) => (
                          <Chip
                            key={`${key}-${index}`}
                            size="small"
                            className={styles.filterFieldChip}
                            label={`${key.replaceAll('_', ' ')}: ${ent}`}
                            onDelete={() => Array.isArray(val.value) ? deleteFilterValue(key, ent) : deleteFilter(key)}
                            deleteIcon={<Delete fontSize="small" />}
                            sx={{ backgroundColor: color.bg, color: color.text }}
                          />
                        ))
                      })}
                    </Box>
                  )}
                </Box>
              </Box>
{/* Row 3 — Download */}
              <Box className={styles.glifSection}>
                <Box className={styles.glifSectionHeader}>
                  <Box className={styles.glifSectionIcon}><CloudDownloadOutlined fontSize="small" /></Box>
                  <Typography className={styles.glifSectionTitle}>Download GLIF Data</Typography>
                </Box>
                <Box className={styles.infoBanner} sx={{ marginTop: 0, marginBottom: '16px' }}>
                  <InfoOutlined fontSize="small" sx={{ color: '#6C5CE7', mt: '1px' }} />
                  <Typography className={styles.infoBannerText}>
                    Download will include all GLIF data for branch {user?.branch?.toString().padStart(5, 0)} on {userDate ? dayjs(userDate).format('DD-MM-YYYY') : '—'} with the applied filters.
                  </Typography>
                </Box>
                <Button
                  fullWidth
                  variant="contained"
                  startIcon={<Download />}
                  onClick={() => exportGlifData()}
                  sx={{ textTransform: 'none', borderRadius: '8px', fontWeight: 600, height: '44px' }}
                >
                  Download GLIF Data
                </Button>
              </Box>
            </>
          )}
        </Box>
      </Box>

      <Dialog
        className={styles.dialog}
        open={isDialogOpen}
        onClose={closeDialog}
        fullWidth
        PaperProps={{ className: styles.dialogPaper }}
      >
        <DialogTitle className={styles.dialogTitle}>
          <Typography className={styles.typographyLabel} sx={{ flexGrow: 1 }}>
            Difference break-up
          </Typography>
          <IconButton
            className={styles.dialogButton}
            disabled={breakupDataRows?.data?.length == 0}
            onClick={exportDetailedData}
            size="small"
            title="Download breakup"
          >
            <Download fontSize="small" />
          </IconButton>
          <IconButton className={styles.dialogButton} onClick={closeDialog} size="small" title="Close">
            <Close fontSize="small" />
          </IconButton>
        </DialogTitle>
        <DialogContent>
          <DisplayTab data={breakupDataRows || []} category={"Difference Breakup"} type={breakupDataRows?.type} level={2} closeHandler={() => closeDialog()} />
        </DialogContent>
      </Dialog>
    </>
  )
}

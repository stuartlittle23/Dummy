  display: "flex",
  flexDirection: "column",
  height: "100%",
  justifyContent: "center",
  alignItems: "center",
}));

const CustomNoRowsOverlay = () => (
  <OverlayBox>
    <ErrorOutlineIcon fontSize="large" color="action" />
    <Typography variant="h5" fontSize="1.2rem" color="text.secondary">
      No transactions available for the selected criteria
    </Typography>
  </OverlayBox>
);
  const TransactionTable = ({ data, loading, onDownload, rowCount, paginationModel, setPaginationModel, userInputs, sourceOptions }) => {
  const rows = data?.data || [];
  const balances = data?.extraData || {};

 const showBalances = 
    userInputs?.sourceFlags?.length === sourceOptions?.length && 
    !userInputs?.minAmount && 
    !userInputs?.maxAmount &&
    rows.length > 0; 

  return (
    <StyledDataBox sx={{ mt: 2, height : '100%' ,display: 'flex', flexDirection: 'column' }}>
      
      {/* MASTER HEADER: Unified Actions & Balances */}
      <Box 
        sx={{ 
          p: 2, 
          mb: 3, 
          mt: -2,
          borderRadius: '16px',
          background: "rgba(255, 255, 255, 0.1)",
          backdropFilter: "blur(12px)",
          border: "1px solid rgba(255, 255, 255, 0.3)",
          boxShadow: "0 4px 20px rgba(0,0,0,0.03)",
          display: 'flex',
          flexDirection: 'column',
          gap: 2
        }}
      >
        {/* ROW 1: TITLE, RECORDS & EXPORT */}

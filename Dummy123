CREATE OR REPLACE TRIGGER REQUEST_VID_TRIGGER
BEFORE INSERT ON REQUEST_VOUCHER
FOR EACH ROW

DECLARE

    v_count NUMBER;

    v_prefix VARCHAR2(20);

BEGIN

    v_prefix :=
            'VID-' ||
            TO_CHAR(SYSDATE, 'YYMM') ||
            '-';

    SELECT COUNT(*)
    INTO v_count
    FROM REQUEST_VOUCHER
    WHERE VID LIKE v_prefix || '%';

    :NEW.VID :=
            v_prefix ||
            LPAD(v_count + 1, 5, '0');

END;
/

.pageShell{display:flex;gap:14px;padding:12px;min-height:calc(100vh - 24px);box-sizing:border-box;background:linear-gradient(135deg,#faf9ff,#f2f0fb,#faf9ff)}
.leftPanel{width:255px;min-width:255px;height:calc(100vh - 48px);position:sticky;top:12px;box-sizing:border-box;padding:16px;border-radius:14px!important;background:rgba(255,255,255,.58)!important;border:1px solid rgba(92,67,190,.10)!important;box-shadow:0 5px 22px rgba(55,40,120,.06)!important;backdrop-filter:blur(18px);overflow:hidden}
.panelHeader{display:flex;align-items:center;gap:10px;margin-bottom:16px}.panelHeaderIcon{width:42px;height:42px;border-radius:11px;display:flex;align-items:center;justify-content:center;color:#6045d6;background:rgba(96,69,214,.08)}.panelHeaderIcon svg{font-size:22px}.panelTitle{font-size:16px!important;font-weight:650!important;color:#171c36}.titleAccent{width:30px;height:2px;margin-top:5px;border-radius:3px;background:#6545d8}
.branchInfoCard{padding:10px 12px;border-radius:11px!important;background:rgba(255,255,255,.48)!important;border:1px solid rgba(92,67,190,.08)!important;box-shadow:none!important}.infoBlock{display:flex;align-items:center;gap:10px;padding:9px 0}.infoIcon{width:34px;height:34px;flex-shrink:0;border-radius:9px;display:flex;align-items:center;justify-content:center;color:#6045d6;background:rgba(96,69,214,.07)}.infoIcon svg{font-size:18px}.infoLabel{font-size:9px!important;font-weight:650!important;letter-spacing:.45px;color:#74798d!important}.infoValue{font-size:15px!important;font-weight:700!important;color:#20243c!important;margin-top:2px}.infoSubValue{font-size:11px!important;color:#646a80!important;margin-top:2px}.dateInfo{flex:1;min-width:0}.sideDatePicker{width:100%}.sideDatePicker .MuiOutlinedInput-root{height:34px;border-radius:7px;background:rgba(255,255,255,.65)}.sideDatePicker .MuiInputBase-input{font-size:11px;padding:7px}
.sideNavigation{display:flex;flex-direction:column;gap:4px;margin-top:15px}.navButton{justify-content:flex-start!important;min-height:38px!important;padding:7px 10px!important;border-radius:8px!important;text-transform:none!important;font-size:12px!important;font-weight:550!important;color:#3f465e!important}.navButton svg{font-size:18px!important}.navButtonActive{background:rgba(255,255,255,.82)!important;color:#6045d6!important;box-shadow:0 3px 12px rgba(75,55,150,.06);border-left:3px solid #6045d6!important}.sidebarDecoration{position:absolute;bottom:12px;left:0;right:0;text-align:center;color:rgba(96,69,214,.08)}.sidebarDecoration svg{font-size:75px}
.mainContent{flex:1;min-width:0}.pageHeading{padding:4px 2px 12px}.pageTitle{font-size:21px!important;font-weight:700!important;color:#171c36}.pageSubtitle{font-size:12px!important;color:#70768a!important;margin-top:3px}
.summaryGrid{margin-bottom:12px}.summaryCard{height:118px!important;min-height:118px!important;padding:13px!important;position:relative;border-radius:12px!important;background:rgba(255,255,255,.62)!important;border:1px solid rgba(92,67,190,.09)!important;box-shadow:0 5px 18px rgba(55,40,120,.055)!important;backdrop-filter:blur(12px)}.summaryIcon{width:34px;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center}.summaryIcon svg{font-size:19px}.summaryContent{margin-left:9px}.summaryTitle{font-size:12px!important;font-weight:600!important;color:#252a42}.summaryCount{font-size:25px!important;line-height:1!important;font-weight:700!important;margin-top:9px!important;color:#6045d6}.summaryLabel{font-size:10px!important;color:#72788b;margin-top:3px!important}.cardDownload{position:absolute!important;right:10px;bottom:9px;font-size:10px!important;padding:3px 8px!important;min-width:0!important;border-radius:6px!important;color:#6045d6!important;border-color:rgba(96,69,214,.35)!important;text-transform:none!important}.moreButton{display:none}.purple .summaryIcon{color:#6045d6;background:rgba(96,69,214,.08)}.green .summaryIcon{color:#31936f;background:rgba(49,147,111,.08)}.orange .summaryIcon{color:#c98224;background:rgba(201,130,36,.08)}
.differenceSections{display:flex;flex-direction:column;gap:7px}.differenceSection{border-radius:10px!important;background:rgba(255,255,255,.62)!important;border:1px solid rgba(92,67,190,.08)!important;box-shadow:0 3px 14px rgba(55,40,120,.04)!important;overflow:hidden}.sectionHeader{height:48px;padding:0 12px;display:flex;align-items:center;justify-content:space-between;cursor:pointer}.sectionHeaderLeft,.sectionHeaderRight{display:flex;align-items:center;gap:8px}.sectionIcon{width:29px;height:29px;border-radius:7px;display:flex;align-items:center;justify-content:center;color:#6045d6;background:rgba(96,69,214,.07)}.sectionIcon svg{font-size:16px}.sectionTitleText{font-size:13px!important;font-weight:600!important;color:#292e43}.rowCount{font-size:10px;padding:4px 7px;border-radius:5px;color:#6045d6;background:rgba(96,69,214,.06)}.sectionDownload{font-size:10px!important;padding:3px 8px!important;border-radius:6px!important;text-transform:none!important;color:#6045d6!important;border-color:rgba(96,69,214,.3)!important}.sectionDownload svg{font-size:15px!important}.tableWrapper{border-top:1px solid rgba(92,67,190,.06)}.noRowsOverlay{font-size:12px;color:#777d90}.tableActionButton{color:#6045d6!important}
.glifContainer{padding:18px;border-radius:12px!important;background:rgba(255,255,255,.62)!important;border:1px solid rgba(92,67,190,.08)!important;box-shadow:0 5px 18px rgba(55,40,120,.05)!important}.glifHeader{display:flex;align-items:center;justify-content:space-between;padding-bottom:12px}.glifHeader .pageTitle{font-size:19px!important}.glifHeader .pageSubtitle{font-size:11px!important}.glifFilterArea{padding-top:12px}.glifFilterHeader{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}.sectionTitle{font-size:13px!important;font-weight:600!important;color:#292e43}.sectionSubtitle{font-size:10px!important;color:#777d90!important;margin-top:2px!important}.filterList{margin-top:7px}.activeFilterRow{display:flex;align-items:center;gap:8px;padding:6px 8px;border-radius:7px;background:rgba(255,255,255,.58);border:1px solid rgba(92,67,190,.06)}.activeFilterLabel{width:105px;font-size:10px!important;font-weight:600!important;color:#50566b}.activeFilterValues{flex:1;display:flex;flex-wrap:wrap;gap:4px}.filterChip{font-size:10px!important;height:24px!important;color:#6045d6!important;background:rgba(96,69,214,.07)!important}.emptyFilterText{font-size:11px!important;color:#7a8092;margin-top:8px!important}.primaryButton{font-size:11px!important;text-transform:none!important;background:#6045d6!important;padding:6px 12px!important;border-radius:7px!important}.infoNote{padding:9px 12px;margin-top:9px;display:flex;gap:8px;align-items:center;font-size:10px}.dialogPaper{max-width:96%!important;border-radius:12px!important}.dialogTitle{display:flex!important;justify-content:space-between;align-items:center;padding:12px 16px!important}.dialogTitleText{font-size:16px!important;font-weight:650!important}.dialogSubtitle{font-size:10px!important;color:#777d90}.dialogActions{display:flex;gap:5px}
@media(max-width:900px){.pageShell{display:block}.leftPanel{width:100%;min-width:0;height:auto;position:relative;margin-bottom:10px}.sidebarDecoration{display:none}.summaryCard{height:115px!important;min-height:115px!important}}

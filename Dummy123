const [cglInput, setCglInput] = useState("");



const CGL_ALLOWED_REGEX = /^[A-Za-z0-9 ]*$/;




inputValue={cglInput}

onInputChange={(e, value, reason) => {
  if (reason === "input" && !CGL_ALLOWED_REGEX.test(value)) {
    return;
  }

  setCglInput(value);
  handleSearchChange(value, reason, "cgl");
}}



onChange={(e, value) => {
  update("cgl", value);
  setCglInput(value || "");
}}






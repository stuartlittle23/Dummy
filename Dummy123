import { useCallback, useEffect, useState } from "react";
import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import downloadFile from "../../utils/DownloadUtils";
import dayjs from "dayjs";
import ReceiptIcon from "@mui/icons-material/Receipt";

import {
  Box,
  Paper,
  Typography,
  Stack,
  Button,
} from "@mui/material";

import {
  StyledBox,
  StyledFormHeader,
} from "./components/TransactionStyles";

import TransactionFilters from "./components/TransactionFilters";
import TransactionTable from "./components/TransactionTable";
import { areUserInputsValid } from "./utils/InputValidations";
import { useSelector } from "react-redux";

const TransactionEnquiryScreen = () => {
  const { callApi } = useApi();
  const snackbar = useCustomSnackbar();

  const user = useSelector((state) => state.auth.user);

  const [currencies, setCurrencies] = useState([]);
  const [data, setData] = useState(null);
  const [loading, setLoading] = useState(false);
  const [sourceOptions, setSourceOptions] = useState([]);
  const [etlDate, setEtlDate] = useState(null);

  // NEW
  const [filtersExpanded, setFiltersExpanded] =
    useState(true);

  const [userInputs, setUserInputs] = useState({
    branch:
      user?.isCircle === "N"
        ? `${user.branch}-${user.branchName}`
        : "",
    currency: null,
    cgl: "",
    fromDate: null,
    toDate: null,
    minAmount: "",
    maxAmount: "",
    sourceFlags: [],
  });

  const fetchCurrencies = useCallback(async () => {
    const res = await callApi(
      "/CM/common-master/currency-code-name-only",
      null,
      "GET"
    );

    const formattedCurrencies =
      res?.data?.map(
        (c) =>
          `${c.currencyCode} (${c.currencyName})`
      ) || [];

    const sortedCurrencies =
      formattedCurrencies.sort((a, b) => {
        if (a.startsWith("INR")) return -1;
        if (b.startsWith("INR")) return 1;
        return a.localeCompare(b);
      });

    setCurrencies(sortedCurrencies);
  }, [callApi]);

  const [rowCount, setRowCount] = useState(0);

  const [paginationModel, setPaginationModel] =
    useState({
      page: 0,
      pageSize: 10,
    });

  const fetchTransactions = useCallback(async () => {
    try {
      if (!areUserInputsValid(userInputs)) return;

      setLoading(true);

      const payload = {
        branch:
          userInputs?.branch?.split(" (")[0],
        currency:
          userInputs?.currency?.split(" (")[0],
        cgl:
          userInputs?.cgl?.split(" - ")[0],
        fromDate: dayjs(
          userInputs?.fromDate
        ).format("DD/MM/YYYY"),
        toDate: dayjs(
          userInputs?.toDate
        ).format("DD/MM/YYYY"),
        minAmount: userInputs.minAmount
          ? Number(userInputs.minAmount)
          : null,
        maxAmount: userInputs.maxAmount
          ? Number(userInputs.maxAmount)
          : null,
        sourceFlags: (
          userInputs.sourceFlags || []
        ).map((item) => item.flagId),
        page: paginationModel.page,
        size: paginationModel.pageSize,
      };

      const res = await callApi(
        "/ES/transaction-con/transactions",
        payload,
        "POST"
      );

      if (res?.data?.length > 0) {
        setData(res);
        setRowCount(res.totalElements || 0);
      } else {
        setData({
          data: [],
          extraData: null,
        });
        setRowCount(0);
      }
    } catch {
      snackbar(
        "Failed to fetch transactions",
        "error"
      );
    } finally {
      setLoading(false);
    }
  }, [
    userInputs,
    callApi,
    paginationModel,
    snackbar,
  ]);

  const handleDownload = async () => {
    const payload = {
      branch:
        userInputs?.branch
          ?.split("-")[0]
          .trim(),
      currency:
        userInputs?.currency?.split(" (")[0],
      cgl:
        userInputs?.cgl?.split(" -")[0],
      fromDate: dayjs(
        userInputs?.fromDate
      ).format("DD/MM/YYYY"),
      toDate: dayjs(
        userInputs?.toDate
      ).format("DD/MM/YYYY"),
      minAmount: userInputs.minAmount
        ? Number(userInputs.minAmount)
        : null,
      maxAmount: userInputs.maxAmount
        ? Number(userInputs.maxAmount)
        : null,
      sourceFlags: (
        userInputs.sourceFlags || []
      ).map((item) => item.flagId),
    };

    const res = await callApi(
      "/ES/transaction-con/transactions-download",
      payload,
      "POST",
      "arraybuffer"
    );

    if (res?.byteLength) {
      downloadFile(
        res,
        "excel",
        "transactions"
      );
    }
  };

  useEffect(() => {
    if (rowCount > 0) fetchTransactions();
  }, [
    paginationModel.page,
    paginationModel.pageSize,
    fetchTransactions,
    rowCount,
  ]);

  const resetState = () => {
    setData(null);
    setRowCount(0);
    setLoading(false);

    // NEW
    setFiltersExpanded(true);

    setUserInputs({
      branch: "",
      currency: null,
      cgl: "",
      fromDate: null,
      toDate: null,
      minAmount: "",
      maxAmount: "",
    });

    setPaginationModel({
      page: 0,
      pageSize: 10,
    });
  };

  useEffect(() => {
    const fetchSystemDate = async () => {
      try {
        const dateRes = await callApi(
          "/PS/file/fincore-date",
          {},
          "GET"
        );

        const etlRaw =
          dateRes?.data?.etlDate;

        const etl = etlRaw
          ? dayjs(etlRaw.split("T")[0])
          : dayjs();

        setEtlDate(etl);
      } catch (e) {
        console.error(
          "System Date Fetch Error:",
          e
        );
      }
    };

    fetchSystemDate();
  }, [callApi]);

  useEffect(() => {
    const fetchFlags = async () => {
      try {
        const res = await callApi(
          "/CM/common-master/source-flag",
          null,
          "GET"
        );

        const flags = res?.data || [];

        setSourceOptions(flags);

        if (flags.length > 0) {
          setUserInputs((prev) => ({
            ...prev,
            sourceFlags: flags,
          }));
        }
      } catch (e) {
        console.error("Flags error:", e);
      }
    };

    fetchFlags();
  }, [callApi]);

  return (
    <>
      <Box sx={{ p: 1 }}>
        <Paper
          elevation={0}
          sx={{
            p: 2,
            mb: 3,
            bgcolor:
              "rgba(255, 255, 255, 0.4)",
            backdropFilter: "blur(4px)",
            border: "1px solid",
            borderColor: "divider",
            borderRadius: 3,
          }}
        >
          <Box
            sx={{
              mb: filtersExpanded ? 2 : 1,
              p: 2,
              borderRadius: 2,
              bgcolor: "background.paper",
              boxShadow: 2,
              borderLeft: "6px solid",
              borderColor: "primary.main",
            }}
          >
            <Stack
              direction="row"
              alignItems="center"
              justifyContent="space-between"
            >
              {/* LEFT */}
              <Stack
                direction="row"
                spacing={2}
                alignItems="center"
              >
                <ReceiptIcon
                  color="primary"
                  fontSize="large"
                />

                <Box>
                  <Typography
                    variant="h6"
                    fontWeight={700}
                    lineHeight={1.2}
                  >
                    Transaction Search &
                    Records Enquiry
                  </Typography>

                  <Typography
                    variant="body2"
                    color="text.secondary"
                    sx={{ mt: 0.5 }}
                  >
                    Enter the required
                    details below to retrieve
                    and view historical
                    transaction records.
                  </Typography>
                </Box>
              </Stack>

              {/* BUTTON */}
              {data && (
                <Button
                  variant="contained"
                  size="small"
                  onClick={() =>
                    setFiltersExpanded(
                      (prev) => !prev
                    )
                  }
                  sx={{
                    textTransform: "none",
                    borderRadius: "8px",
                    fontWeight: 600,
                    minWidth: "140px",
                  }}
                >
                  {filtersExpanded
                    ? "Hide Filters"
                    : "Modify Search"}
                </Button>
              )}
            </Stack>

            {/* SUMMARY CHIPS */}
            {data && !filtersExpanded && (
              <Stack
                direction="row"
                spacing={1}
                sx={{
                  mt: 2,
                  flexWrap: "wrap",
                }}
              >
                {[
                  `Branch: ${userInputs?.branch}`,
                  `Currency: ${userInputs?.currency}`,
                  `CGL: ${userInputs?.cgl}`,
                  `Date: ${dayjs(
                    userInputs?.fromDate
                  ).format(
                    "DD MMM"
                  )} - ${dayjs(
                    userInputs?.toDate
                  ).format("DD MMM YYYY")}`,
                ].map((item, index) => (
                  <Box
                    key={index}
                    sx={{
                      px: 1.5,
                      py: 0.7,
                      borderRadius: "20px",
                      bgcolor:
                        "rgba(88, 70, 159, 0.08)",
                      border:
                        "1px solid rgba(88, 70, 159, 0.15)",
                      fontSize: "0.78rem",
                      fontWeight: 500,
                    }}
                  >
                    {item}
                  </Box>
                ))}
              </Stack>
            )}
          </Box>

          {/* FILTERS */}
          {filtersExpanded && (
            <TransactionFilters
              userInputs={userInputs}
              setUserInputs={setUserInputs}
              currencies={currencies}
              fetchCurrencies={fetchCurrencies}
              onSubmit={() => {
                setPaginationModel((prev) => ({
                  ...prev,
                  page: 0,
                }));

                fetchTransactions();

                setFiltersExpanded(false);
              }}
              resetState={resetState}
              user={user}
              sourceOptions={sourceOptions}
              etlDate={etlDate}
            />
          )}
        </Paper>

        {data && (
          <TransactionTable
            data={data}
            loading={loading}
            userInputs={userInputs}
            sourceOptions={sourceOptions}
            onDownload={handleDownload}
            rowCount={rowCount}
            paginationModel={
              paginationModel
            }
            setPaginationModel={
              setPaginationModel
            }
          />
        )}
      </Box>
    </>
  );
};

export default TransactionEnquiryScreen;

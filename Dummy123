                          color="primary"
                          onClick={() => onToggle(node)}
                          disabled={isLoading}
                          sx={{
                            mr: 1,
                            border: 1,
                            borderColor: isExpanded ? "primary.dark" : "divider",
                            borderRadius: "50%",
                            height: 20,
                            width: 20,
                            p: 0,

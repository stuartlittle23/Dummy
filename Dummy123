.summaryCard {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 320px;
  background-color: #ffffff;
  border: 1px solid rgba(108, 92, 231, 0.08);
  border-radius: 18px;
  padding: 18px 20px 20px;
  overflow: hidden;
  transition: box-shadow 0.2s ease, transform 0.15s ease, border-color 0.2s ease;
}

.summaryCard:hover {
  box-shadow: 0 12px 32px rgba(76, 60, 150, 0.14);
  transform: translateY(-3px);
  border-color: rgba(108, 92, 231, 0.18);
}

/* Thin colored accent bar along the top — small detail that reads as
   "designed", not templated */
.summaryCard::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 4px;
  border-radius: 18px 18px 0 0;
}
.rolePurple::before { background: linear-gradient(90deg, #6C5CE7, #9B8FEF); }
.roleTeal::before   { background: linear-gradient(90deg, #10A37F, #4FD1AE); }
.roleAmber::before  { background: linear-gradient(90deg, #C9761A, #F0A94E); }

/* ---- Header: ~10% of height, compact ---- */
.summaryCardHeader {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}

.summaryCardIcon {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.summaryCardLabel {
  font-size: 13.5px;
  font-weight: 700;
  color: rgba(30, 20, 60, 0.85);
  line-height: 1.25;
}

/* ---- Description: fixed 2-line clamp, ~15% of height ---- */
.summaryCardDescription {
  font-size: 11.5px;
  line-height: 1.4;
  color: rgba(30, 20, 60, 0.5);
  margin-top: 10px;
  flex-shrink: 0;
  text-align: left;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 32px;
}

/* ---- Center block: flex:1 makes this eat ALL remaining space —
   this is what gives you the ~70-80% visual weight on the number ---- */
.summaryCardCenter {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 6px;
}

.summaryCardCount {
  font-size: 46px;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -0.02em;
}

.summaryCardCaption {
  font-size: 12.5px;
  font-weight: 600;
  color: rgba(30, 20, 60, 0.45);
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

/* ---- Actions: ~15% of height, compact, pinned to bottom ---- */
.summaryCardActions {
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex-shrink: 0;
  margin-top: 12px;
}

.viewDetailsButton {
  width: 100%;
  height: 38px !important;
  text-transform: none !important;
  border-radius: 10px !important;
  font-weight: 600 !important;
  font-size: 13px !important;
  box-shadow: 0 4px 12px rgba(108, 92, 231, 0.28) !important;
}

.downloadButtonOutlined {
  width: 100%;
  height: 34px !important;
  text-transform: none !important;
  border-radius: 10px !important;
  font-weight: 600 !important;
  font-size: 12px !important;
  border-width: 1.5px !important;
}

.rolePurple .summaryCardIcon { background-color: #EEEDFE; color: #6C5CE7; }
.rolePurple .summaryCardCount { color: #6C5CE7; }
.rolePurple .downloadButtonOutlined { border-color: #6C5CE7 !important; color: #6C5CE7 !important; }

.roleTeal .summaryCardIcon { background-color: #E1F5EE; color: #10A37F; }
.roleTeal .summaryCardCount { color: #10A37F; }
.roleTeal .downloadButtonOutlined { border-color: #10A37F !important; color: #10A37F !important; }

.roleAmber .summaryCardIcon { background-color: #FFF1E0; color: #C9761A; }
.roleAmber .summaryCardCount { color: #C9761A; }
.roleAmber .downloadButtonOutlined { border-color: #C9761A !important; color: #C9761A !important; }

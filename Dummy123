                        <Tooltip
                          title="Copy Data (Excel Format)"
                          placement="top"
                          arrow
                        >
                          <IconButton
                            size="small"
                            onClick={(e) => {
                              e.stopPropagation(); // Prevents row toggle when clicking the copy button

                              const rows = [];

                              // 1. Get headers starting exactly from the clicked node's level downward
                              const allHeaders = Array.from(document.querySelectorAll("th")).map(th => th.innerText.trim()).filter(Boolean);
                              const hierarchyHeaders = allHeaders.slice(node.level, maxVisibleLevel + 1);
                              const metricHeaders = activeMetrics.map((m) => m.displayName || m.logicalName);
                              rows.push([...hierarchyHeaders, ...metricHeaders].join("\t"));

                              // 2. Recursive function to traverse children and build Tab-Separated columns
                              const traverse = (currentNode) => {
                                // Create an array of empty strings based on the max visible hierarchy depth
                                const originalColumns = Array(maxVisibleLevel + 1).fill(
                                  "",
                                );

                                // Place the current node's name in its specific column level (creates the diagonal alignment)
                                originalColumns[currentNode.level] = currentNode.name;

                                // Map over active metrics to grab amounts dynamically
                                const metrics = activeMetrics.map((m) => {
                                  const value = currentNode[m.logicalName];

                                  // If the value is strictly null or undefined, leave it blank
                                  if (value === null || value === undefined)
                                    return "";

                                  // If it is a valid number (including 0), format to 2 dacimal places
                                  return !isNaN(value)
                                    ? Number(value).toFixed(2)
                                    : value;
                                });

                                // Slice the columns dynamically to match the header offset perfectly
                                const shiftedColumns = originalColumns.slice(node.level);

                                // Combine the hierarchy columns and the metric columns, separated by Tabs
                                const rowString = [...shiftedColumns, ...metrics].join(
                                  "\t",
                                );
                                rows.push(rowString);

                                // If this node has loaded children, recursively run them so they are included in the copy
                                if (
                                  currentNode.children &&
                                  currentNode.children.length > 0
                                ) {
                                  currentNode.children.forEach((child) =>
                                    traverse(child),
                                  );
                                }
                              };

                              // 3. Start the recursive generation from the clicked row
                              traverse(node);

                              // 4. Join all the generated rows with a Newline character
                              const combinedData = rows.join("\n");

                              // 5. Send the perfectly formatted block to the clipboard
                              navigator.clipboard
                                .writeText(combinedData)
                                .then(() => {
                                  showSnackBar(
                                    "Data copied in Spreadsheet format",
                                    "success",
                                  );
                                })
                                .catch((err) => {
                                  console.error("Failed to copy text: ", err);
                                  showSnackBar("Failed to copy text", "error");
                                });
                            }}
                            sx={{ ml: 2, padding: "2px" }}
                          >
                            <ContentCopyIcon
                              sx={{ fontSize: 16, color: "text.secondary" }}
                            />
                          </IconButton>
                        </Tooltip>


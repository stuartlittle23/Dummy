package com.fincore.enquiry_service.specification;

import com.fincore.enquiry_service.dto.GridFilter;
import com.fincore.enquiry_service.dto.LedgerEnquiryRequest;
import com.fincore.enquiry_service.model.LedgerTransaction;
import jakarta.persistence.criteria.Expression;
import jakarta.persistence.criteria.Path;
import jakarta.persistence.criteria.Predicate;
import jakarta.persistence.criteria.Root;
import org.springframework.data.jpa.domain.Specification;

import java.math.BigDecimal;
import java.sql.Timestamp;
import java.text.SimpleDateFormat;
import java.util.ArrayList;
import java.util.Date;
import java.util.List;

public class LedgerSpecification {

    public static Specification<LedgerTransaction> build(LedgerEnquiryRequest dto) {

        return (root, query, cb) -> {

            List<Predicate> predicates = new ArrayList<>();

            /* CGL */
            predicates.add(cb.equal(root.get("cgl"), dto.getCgl()));

            /* DATE RANGE */
            predicates.add(cb.between(root.get("transactionDate"), parseTimestamp(dto.getFromDate(), false), parseTimestamp(dto.getToDate(), true)));

            /* CURRENCY */
            if (dto.getCurrencies() != null && !"ALL".equalsIgnoreCase(dto.getCurrencies())) {

                predicates.add(cb.equal(root.get("currency"), dto.getCurrencies()));
            }

            /* SOURCE FLAGS */
            if (dto.getSourceFlags() != null && !dto.getSourceFlags().isEmpty() && !dto.getSourceFlags().contains("ALL")) {

                predicates.add(root.get("sourceFlag").in(dto.getSourceFlags()));
            }

            /* CIRCLE */
            if ("DOMESTIC".equals(dto.getCircle())) {
                predicates.add(cb.notEqual(root.get("branch").get("circle").get("circleCode"), "021"));
            } else if ("FOREIGN".equals(dto.getCircle())) {
                predicates.add(cb.equal(root.get("branch").get("circle").get("circleCode"), "021"));
            } else if (!"ALL".equals(dto.getCircle())) {
                predicates.add(cb.equal(root.get("branch").get("circle").get("circleCode"), dto.getCircle()));
            }

            /* BRANCHES */
            if (dto.getBranches() != null && !dto.getBranches().isEmpty() && !dto.getBranches().contains("ALL")) {
                predicates.add(root.get("branch").get("code").in(dto.getBranches()));
            }

            /* GRID FILTERS */
            if (dto.getGridFilters() != null && !dto.getGridFilters().isEmpty()) {
                for (GridFilter filter : dto.getGridFilters()) {
                    if (filter.getField() == null || filter.getOperator() == null || filter.getValue() == null) {
                        continue;
                    }
                    String field = filter.getField();
                    String operator = filter.getOperator();
                    Path<?> path = getPath(root, field);

                    /* DATE FILTERS */
                    if (path.getJavaType().equals(Date.class) || path.getJavaType().equals(Timestamp.class)) {

                        Expression<Date> truncDate = cb.function("TRUNC", Date.class, path);
                        Date filterDate = parseDate(filter.getValue().toString());

                        switch (operator) {
                            case "equals" -> predicates.add(cb.equal(truncDate, filterDate));
                            case "after" -> predicates.add(cb.greaterThan(truncDate, filterDate));
                            case "onOrAfter" -> predicates.add(cb.greaterThanOrEqualTo(truncDate, filterDate));
                            case "before" -> predicates.add(cb.lessThan(truncDate, filterDate));
                            case "onOrBefore" -> predicates.add(cb.lessThanOrEqualTo(truncDate, filterDate));
                        }
                        continue;
                    }

                    /* BIGDECIMAL FILTERS */
                    if (path.getJavaType().equals(BigDecimal.class)) {

                        BigDecimal numberValue = new BigDecimal(filter.getValue().toString());
                        Expression<BigDecimal> numberPath = path.as(BigDecimal.class);

                        switch (operator) {

                            case "=", "equals", "is" -> predicates.add(cb.equal(numberPath, numberValue));
                            case "!=", "not" -> predicates.add(cb.notEqual(numberPath, numberValue));
                            case ">" -> predicates.add(cb.greaterThan(numberPath, numberValue));
                            case ">=" -> predicates.add(cb.greaterThanOrEqualTo(numberPath, numberValue));
                            case "<" -> predicates.add(cb.lessThan(numberPath, numberValue));
                            case "<=" -> predicates.add(cb.lessThanOrEqualTo(numberPath, numberValue));
                            case "isEmpty" -> predicates.add(cb.isNull(path));
                            case "isNotEmpty" -> predicates.add(cb.isNotNull(path));
                        }
                        continue;
                    }


                    /* LONG FILTERS */
                    if (path.getJavaType().equals(Long.class)) {

                        Long numberValue = Long.valueOf(filter.getValue().toString());
                        Expression<Long> numberPath = path.as(Long.class);

                        switch (operator) {

                            case "=", "equals", "is" -> predicates.add(cb.equal(numberPath, numberValue));
                            case "!=", "not" -> predicates.add(cb.notEqual(numberPath, numberValue));
                            case ">" -> predicates.add(cb.greaterThan(numberPath, numberValue));
                            case ">=" -> predicates.add(cb.greaterThanOrEqualTo(numberPath, numberValue));
                            case "<" -> predicates.add(cb.lessThan(numberPath, numberValue));
                            case "<=" -> predicates.add(cb.lessThanOrEqualTo(numberPath, numberValue));
                        }
                        continue;
                    }

                    /* NUMBER FILTERS */
                    if (Number.class.isAssignableFrom(path.getJavaType())) {

                        Double numberValue = Double.valueOf(filter.getValue().toString());
                        Expression<Number> numberPath = path.as(Number.class);

                        switch (operator) {
                            case "=", "equals", "is" -> predicates.add(cb.equal(numberPath, numberValue));
                            case "!=", "not" -> predicates.add(cb.notEqual(numberPath, numberValue));
                            case ">" -> predicates.add(cb.gt(numberPath, numberValue));
                            case ">=" -> predicates.add(cb.ge(numberPath, numberValue));
                            case "<" -> predicates.add(cb.lt(numberPath, numberValue));
                            case "<=" -> predicates.add(cb.le(numberPath, numberValue));
                            case "isEmpty" -> predicates.add(cb.isNull(path));
                            case "isNotEmpty" -> predicates.add(cb.isNotNull(path));
                        }
                        continue;
                    }

                    /* STRING FILTERS */
                    Expression<String> expression = cb.lower(path.as(String.class));
                    String value = filter.getValue().toString().toLowerCase();

                    switch (operator) {
                        case "contains" -> predicates.add(cb.like(expression, "%" + value + "%"));
                        case "startsWith" -> predicates.add(cb.like(expression, value + "%"));
                        case "endsWith" -> predicates.add(cb.like(expression, "%" + value));
                        case "equals", "is", "=" -> predicates.add(cb.equal(expression, value));
                        case "!=", "not" -> predicates.add(cb.notEqual(expression, value));
                        case "isAnyOf" -> {

                            if (filter.getValue() instanceof List<?> values) {
                                List<String> lowerValues = values.stream().map(Object::toString).map(String::toLowerCase).toList();
                                predicates.add(expression.in(lowerValues));
                            } else {
                                predicates.add(cb.equal(expression, filter.getValue().toString().toLowerCase()));
                            }
                        }

                        case "isEmpty" -> predicates.add(cb.or(cb.isNull(path), cb.equal(expression, "")));
                        case "isNotEmpty" -> predicates.add(cb.and(cb.isNotNull(path), cb.notEqual(expression, "")));
                    }
                }
            }

            return cb.and(predicates.toArray(new Predicate[0]));
        };
    }

    private static Path<?> getPath(Root<LedgerTransaction> root, String field) {

        return switch (field) {

            /* BRANCH */
            case "branchCode" -> root.get("branch").get("code");
            case "branchName" -> root.get("branch").get("name");

            /* CIRCLE */
            case "circleCode" -> root.get("branch").get("circle").get("circleCode");
            case "circleName" -> root.get("branch").get("circle").get("circleName");

            /*
             * CURRENCY
             */
            case "currency" -> root.get("currencyMaster").get("currencyCode");
            case "currencyName" -> root.get("currencyMaster").get("currencyName");

            /* CGL */
            case "cgl" -> root.get("cglMaster").get("cglNumber");
            case "description" -> root.get("cglMaster").get("description");

            /* SOURCE */
            case "sourceName" -> root.get("sourceFlagMaster").get("flagName");

            /* DEFAULT */
            default -> root.get(field);
        };
    }

    private static Timestamp parseTimestamp(String date, boolean endOfDay) {
        try {
            String value = endOfDay ? date + " 23:59:59" : date + " 00:00:00";
            return new Timestamp(new SimpleDateFormat("dd/MM/yyyy HH:mm:ss").parse(value).getTime());
        } catch (Exception e) {
            throw new RuntimeException("Invalid timestamp format : " + date);
        }
    }

    private static Date parseDate(String date) {
        try {
            return new SimpleDateFormat("yyyy-MM-dd").parse(date);
        } catch (Exception e) {
            try {
                return new SimpleDateFormat("dd/MM/yyyy").parse(date);
            } catch (Exception ex) {
                throw new RuntimeException("Invalid date format : " + date);
            }
        }
    }
}

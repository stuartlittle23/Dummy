import React from"react";
import{Box,Paper,Typography,IconButton}from"@mui/material";
import{DataGrid}from"@mui/x-data-grid";
import HistoryIcon from"@mui/icons-material/History";

export default function BalanceDateWiseTable({rows,loading,totalElements,paginationModel,setPaginationModel,onHistory}){
 const columns=[
  {field:"reconRunDate",headerName:"Error Date",flex:1,minWidth:130},
  {field:"GLCC_VAL",headerName:"GLCC",flex:1.4,minWidth:180},
  {field:"cbsBalance",headerName:"CBS Balance",flex:1,minWidth:140},
  {field:"glBalance",headerName:"GL Balance",flex:1,minWidth:140},
  {field:"differenceAmount",headerName:"Difference",flex:1,minWidth:140,renderCell:p=><Typography sx={{fontWeight:700,color:Number(p.value)<0?"#d32f2f":"#2e7d32"}}>{p.value?.toLocaleString?.()??p.value}</Typography>},
  {field:"action",headerName:"Action",sortable:false,filterable:false,width:90,renderCell:p=><IconButton color="primary" onClick={()=>onHistory(p.row)}><HistoryIcon/></IconButton>}
 ];

 return <Paper elevation={0} sx={{width:"100%",border:"1px solid",borderColor:"divider",borderRadius:3,overflow:"hidden"}}>
  <Box sx={{px:2,py:1.5,borderBottom:"1px solid",borderColor:"divider"}}>
   <Typography variant="subtitle1" fontWeight={700}>Balance Difference Records</Typography>
   <Typography variant="body2" color="text.secondary">{loading?"Loading...":`${totalElements.toLocaleString()} record(s) found`}</Typography>
  </Box>
  <DataGrid autoHeight rows={rows} columns={columns} loading={loading} rowCount={totalElements} paginationMode="server" paginationModel={paginationModel} onPaginationModelChange={setPaginationModel} pageSizeOptions={[10,25,50]} disableRowSelectionOnClick sx={{border:0}}/>
 </Paper>
}

  {(mode === "GE") &&
                        <Paper className={styles.gilfPaper}>
                            <Typography className={styles.typographyHeaderCenter}>
                                Download GLIF data of your branch and selected date.
                            </Typography>
                            <Divider className={styles.dividerMargin} />
                            <Grid container className={styles.uniformPaddedContainer} spacing={1}>
                                <Grid item size={{ md: 6 }} className={styles.filterContainer} >
                                    <Paper className={`${styles.filterPaper} ${styles.filterBgInfo}`}>
                                        <Typography>
                                            Add filter for fetching data(Max 10, If multivalued).
                                        </Typography>
                                        <Divider className={styles.dividerMargin} />
                                        <Filter handleFilter={handleFilter} getValues={getFiterData} />
                                    </Paper>
                                </Grid>
                                <Grid item size={{ md: 6 }} className={styles.filterContainer}>
                                    <Paper className={`${styles.filterPaper} ${styles.filterBgSuccess}`}>
                                        <Typography>
                                            Filters added for data fetching.
                                        </Typography>
                                        <Divider className={styles.dividerMargin} />

                                        <Stack spacing={0.5}>
                                            {Object.entries(glifDataFilter).map(([key, val]) => (
                                                <Grid className={styles.filterDisplay} container key={key} spacing={1}>
                                                    <Grid className={`${styles.datePickerContainer} ${styles.filterLabel}`} item size={{ md: 3 }} spacing={1}>
                                                        <Chip
                                                            label={key.toString().replaceAll("_", " ")}
                                                            onDelete={() => deleteFilter(key)}
                                                            deleteIcon={<Delete />}
                                                        />
                                                    </Grid>
                                                    <Grid item size={{ md: 9 }} className={styles.filterValues} >
                                                        {Array.isArray(val.value) ? val.value.map((ent, index) => (<Chip className={styles.chipBg} key={index} onDelete={() => deleteFilterValue(key, ent)} label={ent} />)) : <Typography><Chip className={styles.chipBg} onDelete={() => setGlifDataFilter(() => { const { [key]: _, ...rest } = glifDataFilter; return rest })} label={val.value} /></Typography>}
                                                    </Grid>
                                                </Grid>))}
                                        </Stack>

                                    </Paper>
                                </Grid>
                            </Grid>
                            <Divider className={styles.dividerMargin} />
                            <Box className={styles.centeredButtonBox}>
                                <Button variant="contained" onClick={() => exportGlifData()} >
                                    <Typography>
                                        Download Data
                                    </Typography>
                                </Button>
                            </Box>
                        </Paper >
                    }
                </Paper>
            </Box >
            <Dialog
                className={styles.dialog}
                open={isDialogOpen}
                fullWidth
                PaperProps={{
                    className: styles.dialogPaper

                }}
            >
                <DialogTitle className={styles.dialogTitle} >
                    <Typography className={styles.typographyLabel}>Difference Break-up</Typography>
                    <Button className={styles.dialogButton} disabled={breakupDataRows?.data?.length == 0} onClick={exportDetailedData} variant="contained" size='small'><Download /></Button>
                    <Button className={styles.dialogButton} onClick={closeDialog} variant="contained" size='small'>X</Button>
                </DialogTitle >
                <DialogContent>
                    <DisplayTab data={breakupDataRows || []} category={"Difference Breakup"} type={breakupDataRows?.type} level={2} closeHandler={() => closeDialog()} />
                </DialogContent>
            </Dialog >
        </>

    )
}

const handleExport = async () => {
  if (!etlDate || !branch || !currency || !cgl) return;

  setExportLoading(true);

  try {
    const payload = {
      reconRunDate: etlDate.format("YYYY-MM-DD"),
      branchCode: branch?.split("-")[0] || null,
      currency: currency || null,
      cgl: cgl?.split(" - ")[0] || null,
    };

    const downloadResponse = await callApi(
      "/ES/differences/export",
      payload,
      "POST",
      "arraybuffer"
    );

    const fileName = `Balance_Difference_${payload.branchCode}_${payload.currency}_${payload.cgl}`;

    if (downloadResponse && downloadResponse.byteLength > 0) {
      downloadFile(downloadResponse, "excel", fileName);
      return;
    }
  } catch (error) {
    console.error("Export Error:", error);
    showSnackBar("Download Failed", "error");
  } finally {
    setExportLoading(false);
  }
};

const GLCC_ALLOWED_REGEX = /^[A-Z0-9]*$/;
const GLCC_REGEX = /^\d{5}[A-Z]{3}\d{10}$/;




onChange={(e) => {
  const value = e.target.value.toUpperCase();

  if (!GLCC_ALLOWED_REGEX.test(value)) return;

  setGlcc(value);
  setGlccValidated(false);
  setUserInputs((prev) => ({
    ...prev,
    branch: "",
    currency: null,
    cgl: "",
  }));

  if (GLCC_REGEX.test(value)) {
    validateGlcc(value);
  }
}}

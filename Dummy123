RequestVoucher terminateVoucher(
        Long id,
        String terminatedBy);




@Override
public RequestVoucher terminateVoucher(
        Long id,
        String terminatedBy) {

    RequestVoucher requestVoucher =
            requestVoucherRepository.findById(id)
            .orElseThrow(() ->
                    new RuntimeException("Voucher not found"));

    requestVoucher.setStatus("TERMINATED");

    requestVoucher.setTerminatedBy(
            terminatedBy);

    requestVoucher.setTerminatedAt(
            new Timestamp(System.currentTimeMillis()));

    return requestVoucherRepository
            .save(requestVoucher);
}




@PutMapping("/terminate-voucher/{id}")
public RequestVoucher terminateVoucher(
        @PathVariable Long id,
        @RequestParam String terminatedBy) {

    return journalRequestService
            .terminateVoucher(id, terminatedBy);
}






import React from "react";
import {
  Dialog,
  DialogContent,
  DialogContentText,
  DialogTitle,
  IconButton,
  Typography,
  Box,
  Fade,
} from "@mui/material";
import CloseSharpIcon from "@mui/icons-material/CloseSharp";
import ErrorOutlineIcon from "@mui/icons-material/ErrorOutline";
import LockIcon from "@mui/icons-material/Lock";
import BlockIcon from "@mui/icons-material/Block";
import SecurityIcon from "@mui/icons-material/Security";
import AccessTimeIcon from "@mui/icons-material/AccessTime";
import WarningAmberIcon from "@mui/icons-material/WarningAmber";
import DoNotDisturbIcon from "@mui/icons-material/DoNotDisturb";

// Normalized keys to match standard camelCase convention
const iconMap = {
  invalid: { icon: <SecurityIcon />, color: "error.main" },
  error: { icon: <ErrorOutlineIcon />, color: "error.main" },
  locked: { icon: <LockIcon />, color: "error.main" },
  restricted: { icon: <BlockIcon />, color: "warning.main" },
  rateLimit: { icon: <AccessTimeIcon />, color: "warning.main" },
  denied: { icon: <DoNotDisturbIcon />, color: "error.main" },
  warning: { icon: <WarningAmberIcon />, color: "warning.main" },
};

// Added smooth fade transition
const Transition = React.forwardRef(function Transition(props, ref) {
  return <Fade ref={ref} {...props} />;
});

const LoginErrorDialog = ({
  showErrorDialog,
  onDialogClose,
  title,
  content,
  type = "error",
}) => {
  // Safety fallback if an unknown type is passed
  const { icon, color } = iconMap[type] || iconMap.error;

  return (
    <Dialog
      open={showErrorDialog}
      fullWidth
      maxWidth="sm"
      onClose={onDialogClose}
      TransitionComponent={Transition}
      aria-labelledby="login-error-dialog-title"
      aria-describedby="login-error-dialog-description"
      sx={{
        backdropFilter: "blur(4px)",
        "& .MuiDialog-paper": { borderRadius: 2 },
      }}
    >
      <DialogTitle
        id="login-error-dialog-title"
        sx={{
          backgroundColor: color,
          color: "white",
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
          padding: 2,
        }}
      >
        <Box display="flex" alignItems="center">
          {React.cloneElement(icon, {
            sx: { mr: 1.5, fontSize: "1.75rem" },
            "aria-hidden": true,
          })}
          <Typography
            variant="h6"
            component="span"
            sx={{ fontWeight: 600, fontSize: "1.1rem" }}
          >
            {title || "Error"}
          </Typography>
        </Box>
        <IconButton
          onClick={onDialogClose}
          sx={{ color: "white" }}
          aria-label="close dialog"
        >
          <CloseSharpIcon />
        </IconButton>
      </DialogTitle>

      <DialogContent sx={{ padding: 3, pt: "24px !important" }}>
        <DialogContentText
          id="login-error-dialog-description"
          sx={{ color: "text.primary" }}
        >
          <Typography variant="body1">{content}</Typography>
        </DialogContentText>
      </DialogContent>
    </Dialog>
  );
};

export default LoginErrorDialog;





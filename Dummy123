
import React from "react";
import { Typography, Chip, IconButton, Tooltip } from "@mui/material";
import HistoryIcon from "@mui/icons-material/History";

export const getBalanceParticularColumns = (onViewDetails) => [
  {
    field: "reconRunDate",
    headerName: "ERROR DATE",
    flex: 1,
    minWidth: 120,
    renderCell: (params) => (
      <Typography variant="body2" sx={{ fontWeight: 500, color: "#334155" }}>
        {params.value || "-"}
      </Typography>
    ),
  },
  {
    field: "GLCC_VAL",
    headerName: "GLCC DETAILS",
    flex: 1.5,
    minWidth: 200,
    renderCell: (params) => (
      <Chip
        label={params.value}
        size="small"
        sx={{
          fontWeight: 600,
          fontSize: "0.75rem",
          backgroundColor: "#f1f5f9",
          color: "#475569",
          border: "1px solid #e2e8f0",
        }}
      />
    ),
  },
  {
    field: "cbsBalance",
    headerName: "CBS BALANCE",
    flex: 1,
    minWidth: 130,
    align: "right",
    headerAlign: "right",
    renderCell: (params) => (
      <Typography variant="body2" sx={{ fontFamily: "monospace", fontWeight: 600 }}>
        {params.value != null ? Number(params.value).toLocaleString() : "0.00"}
      </Typography>
    ),
  },
  {
    field: "glBalance",
    headerName: "GL BALANCE",
    flex: 1,
    minWidth: 130,
    align: "right",
    headerAlign: "right",
    renderCell: (params) => (
      <Typography variant="body2" sx={{ fontFamily: "monospace", fontWeight: 600 }}>
        {params.value != null ? Number(params.value).toLocaleString() : "0.00"}
      </Typography>
    ),
  },
  {
    field: "differenceAmount",
    headerName: "DIFFERENCE",
    flex: 1.2,
    minWidth: 150,
    align: "right",
    headerAlign: "right",
    renderCell: (params) => {
      const val = params.value || 0;
      const isNegative = val < 0;
      return (
        <Chip
          label={Number(val).toLocaleString()}
          size="small"
          sx={{
            fontWeight: 700,
            backgroundColor: isNegative ? "#fef2f2" : "#f0fdf4",
            color: isNegative ? "#dc2626" : "#16a34a",
            border: `1px solid ${isNegative ? "#fecaca" : "#bbf7d0"}`,
            fontFamily: "monospace",
            px: 1,
          }}
        />
      );
    },
  },
  {
    field: "action",
    headerName: "ACTION",
    width: 90,
    sortable: false,
    align: "center",
    headerAlign: "center",
    renderCell: (params) => (
      <Tooltip title="View Details">
        <IconButton
          size="small"
          sx={{
            color: "#6366f1",
            backgroundColor: "#eef2ff",
            "&:hover": { backgroundColor: "#e0e7ff" },
          }}
          onClick={() => onViewDetails(params.row)}
        >
          <HistoryIcon fontSize="small" />
        </IconButton>
      </Tooltip>
    ),
  },
];

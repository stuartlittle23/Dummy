import React from "react";
import { Box, Typography, Chip } from "@mui/material";
import { DataGrid } from "@mui/x-data-grid";
import ErrorOutlineOutlinedIcon from "@mui/icons-material/ErrorOutlineOutlined";

const columns = [
  { field: "errorDate", headerName: "Error Date", flex: 1 },
  { field: "branchCode", headerName: "Branch", flex: 1 },
  { field: "currency", headerName: "Currency", flex: 1 },
  { field: "cgl", headerName: "CGL", flex: 1 },
  { field: "cbsBalance", headerName: "CBS Balance", flex: 1.2 },
  { field: "glBalance", headerName: "GL Balance", flex: 1.2 },
  { field: "differenceAmount", headerName: "Difference Amount", flex: 1.3 },
  { field: "diffYesterday", headerName: "Diff. Yesterday", flex: 1.2 },
  { field: "type", headerName: "Type", flex: 0.8 },
  { field: "head", headerName: "Head", flex: 0.8 },
];

export default function BalanceDateWiseTable({
  rows = [],
  loading = false,
  totalElements = 0,
  paginationModel,
  setPaginationModel,
}) {
  const tableRows = rows.map((r, i) => ({
    ...r,
    id: r.id || `date-${i}`,
    errorDate: r.errorDate || r.etlDate || r.date || "-",
    branchCode: r.branchCode || r.branch || "-",
    currency: r.currency || "-",
    cgl: r.cgl || r.cglNumber || "-",
    cbsBalance: r.cbsBalance ?? "-",
    glBalance: r.glBalance ?? "-",
    differenceAmount: r.differenceAmount ?? r.difference ?? "-",
    diffYesterday: r.diffYesterday ?? "-",
    type: r.type || "-",
    head: r.head || "-",
  }));

  return (
    <Box sx={{ mt: 2.5, width: "100%" }}>
      <Box
        sx={{
          width: "100%",
          height: 470,
          p: 1.2,
          borderRadius: 3,
          bgcolor: "rgba(255,255,255,.45)",
          border: "1px solid",
          borderColor: "divider",
          overflow: "hidden",
        }}
      >
        <Box
          sx={{
            width: "100%",
            height: "100%",
            bgcolor: "background.paper",
            borderRadius: 2.5,
            border: "1px solid",
            borderColor: "divider",
            overflow: "hidden",
          }}
        >
          <Box
            sx={{
              height: 62,
              px: 2.5,
              display: "flex",
              alignItems: "center",
              gap: 1.5,
            }}
          >
            <Typography
              sx={{
                fontSize: "1.05rem",
                fontWeight: 700,
              }}
            >
              Balance Difference Records
            </Typography>

            <Chip
              label={totalElements ? `${totalElements} Records` : "No Records"}
              size="small"
              sx={{
                height: 25,
                bgcolor: "rgba(88,70,159,.08)",
                color: "primary.main",
                fontSize: ".7rem",
                fontWeight: 700,
              }}
            />
          </Box>

          <DataGrid
            rows={tableRows}
            columns={columns}
            loading={loading}
            rowCount={totalElements}
            pagination
            paginationMode="server"
            paginationModel={paginationModel}
            onPaginationModelChange={setPaginationModel}
            pageSizeOptions={[25, 50, 100]}
            disableRowSelectionOnClick
            hideFooterSelectedRowCount
            slots={{
              noRowsOverlay: () => (
                <Box
                  sx={{
                    height: "100%",
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                    gap: 1,
                  }}
                >
                  <ErrorOutlineOutlinedIcon
                    sx={{ fontSize: 23, color: "text.secondary" }}
                  />
                  <Typography
                    sx={{
                      fontSize: ".9rem",
                      fontWeight: 600,
                      color: "text.secondary",
                    }}
                  >
                    No difference records available for the selected criteria
                  </Typography>
                </Box>
              ),
            }}
            sx={{
              height: "calc(100% - 62px)",
              border: 0,

              "& .MuiDataGrid-columnHeaders": {
                height: 55,
                minHeight: 55,
                bgcolor: "rgba(88,70,159,.035)",
                borderTop: "1px solid",
                borderBottom: "1px solid",
                borderColor: "divider",
              },

              "& .MuiDataGrid-columnHeader": {
                px: 1.5,
                outline: "none",
              },

              "& .MuiDataGrid-columnHeaderTitle": {
                fontSize: ".78rem",
                fontWeight: 700,
                color: "primary.dark",
              },

              "& .MuiDataGrid-cell": {
                px: 1.5,
                fontSize: ".8rem",
                borderBottom: "1px solid",
                borderColor: "rgba(0,0,0,.05)",
                outline: "none",
              },

              "& .MuiDataGrid-row:hover": {
                bgcolor: "rgba(88,70,159,.025)",
              },

              "& .MuiDataGrid-virtualScroller": {
                minHeight: 250,
              },

              "& .MuiDataGrid-footerContainer": {
                height: 52,
                minHeight: 52,
                borderTop: "1px solid",
                borderColor: "divider",
              },

              "& .MuiTablePagination-root": {
                fontSize: ".8rem",
              },

              "& .MuiDataGrid-overlay": {
                bgcolor: "transparent",
              },
            }}
          />
        </Box>
      </Box>
    </Box>
  );
}

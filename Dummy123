/* ==========================================================================
   BranchPosition — Premium enterprise layout
   Cards with View Details / Download only. No inline accordion tables.
   ========================================================================== */

.appShell {
  display: flex;
  align-items: stretch;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 2px 24px rgba(76, 60, 150, 0.12);
  border: 1px solid rgba(108, 92, 231, 0.1);
  min-height: 78vh; /* <-- the ONE value to adjust overall screen height */
  background-color: #ffffff;
}

/* ---- Sidebar ---------------------------------------------------------- */

.sidebar {
  width: 264px;
  flex-shrink: 0;
  background-color: #FAF9FE;
  border-right: 1px solid rgba(108, 92, 231, 0.1);
  padding: 20px 16px;
  display: flex;
  flex-direction: column;
}

.sidebarBrand {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 20px;
  padding: 0 4px;
}

.sidebarBrandIconWrap {
  position: relative;
}

.sidebarBrandIcon {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background-color: #EEEDFE;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6C5CE7;
}

.brandSparkle {
  position: absolute;
  top: -6px;
  right: -6px;
  font-size: 13px !important;
  color: #B8AEFB;
}

.sidebarBrandText {
  font-size: 15px;
  font-weight: 600;
  color: rgba(30, 20, 60, 0.87);
}

.infoCard {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px;
  border: 1px solid rgba(108, 92, 231, 0.12);
  border-radius: 10px;
  background-color: #ffffff;
  margin-bottom: 8px;
}

.infoCardIcon {
  width: 30px;
  height: 30px;
  border-radius: 8px;
  background-color: #F5F3FF;
  color: #6C5CE7;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.infoCardLabel {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: rgba(30, 20, 60, 0.4);
  margin: 0 0 2px;
}

.infoCardValue {
  font-size: 14px;
  font-weight: 700;
  color: rgba(30, 20, 60, 0.9);
  line-height: 1.3;
}

.infoCardSubvalue {
  font-size: 12px;
  color: rgba(30, 20, 60, 0.55);
}

/* Date field — FIX: proper outlined field so the calendar icon has a box
   to sit inside. The earlier "standard + disableUnderline" variant had no
   border/container, which is why the icon looked misplaced/floating. */
.dateCard {
  padding: 10px;
  border: 1.5px solid #6C5CE7;
  border-radius: 10px;
  background-color: #F8F7FF;
  margin-bottom: 16px;
}

.dateCard .infoCardLabel {
  margin-bottom: 6px;
  color: #6C5CE7;
}

.navTabs {
  margin-top: 4px;
}

.navTab {
  color: rgba(30, 20, 60, 0.6) !important;
  font-weight: 500;
  text-transform: none;
  align-items: center;
  flex-direction: row;
  justify-content: flex-start;
  min-height: 42px;
  border-radius: 10px;
  padding: 8px 12px;
  border-left: 3px solid transparent;
  transition: background-color 0.15s ease, color 0.15s ease;
}

.navTab:hover {
  background-color: rgba(108, 92, 231, 0.06);
}

.navTab:global(.Mui-selected) {
  background-color: #EEEDFE !important;
  color: #6C5CE7 !important;
  border-left: 3px solid #6C5CE7;
  font-weight: 700;
}

.navTab:global(.Mui-disabled) {
  opacity: 0.4;
}

.sidebarFooter {
  margin-top: auto;
  padding-top: 12px;
}

.sidebarIllustration {
  position: relative;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 12px 0 4px;
}

.sparkleTopRight {
  position: absolute;
  top: 2px;
  right: 28%;
  font-size: 15px !important;
  color: #C9BFFC;
}

.sparkleBottomLeft {
  position: absolute;
  bottom: 6px;
  left: 22%;
  font-size: 10px !important;
  color: #C9BFFC;
  opacity: 0.8;
}

.sparkleMidRight {
  position: absolute;
  top: 38%;
  right: 14%;
  font-size: 9px !important;
  color: #DCD5FE;
}

/* ---- Main content ------------------------------------------------------- */

.mainContent {
  flex: 1;
  min-width: 0;
  padding: 24px;
  background-color: #FDFCFF;
  display: flex;
  flex-direction: column;
}

.pageHeaderRow {
  display: flex;
  align-items: center;
  gap: 6px;
}

.headerSparkle {
  font-size: 17px !important;
  color: #B8AEFB;
}

.pageHeaderTitle {
  font-size: 20px;
  font-weight: 700;
  color: rgba(20, 14, 45, 0.9);
  margin: 0 0 2px;
}

.pageHeaderSubtitle {
  font-size: 13px;
  color: rgba(30, 20, 60, 0.5);
  margin: 0 0 22px;
}

.highlightDate {
  font-weight: 700;
  color: #6C5CE7;
}

/* ---- Summary cards — the ONLY UI for each category now. Equal height,
   aligned via the parent grid's `align-items: stretch`. ---------------------- */

.summaryRow {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  align-items: stretch;
}

.summaryCard {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 100%;
  min-height: 190px;
  background-color: #ffffff;
  border: 1px solid rgba(108, 92, 231, 0.1);
  border-radius: 16px;
  padding: 18px;
  transition: box-shadow 0.15s ease, transform 0.1s ease;
}

.summaryCard:hover {
  box-shadow: 0 8px 24px rgba(76, 60, 150, 0.1);
  transform: translateY(-1px);
}

.cardSparkleBadge {
  position: absolute;
  top: 12px;
  right: 14px;
  font-size: 16px !important;
  color: #10A37F;
}

.summaryCardTop {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.summaryCardHeader {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 10px;
}

.summaryCardIcon {
  width: 38px;
  height: 38px;
  border-radius: 11px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.summaryCardLabel {
  font-size: 14px;
  font-weight: 700;
  color: rgba(30, 20, 60, 0.85);
  line-height: 1.25;
}

.summaryCardCount {
  font-size: 28px;
  font-weight: 700;
  line-height: 1;
}

.summaryCardCaption {
  font-size: 12px;
  font-weight: 600;
  margin-top: 2px;
}

.summaryCardActions {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 16px;
}

.viewDetailsButton {
  width: 100%;
  height: 36px !important;
  text-transform: none !important;
  border-radius: 9px !important;
  font-weight: 600 !important;
  font-size: 13px !important;
  box-shadow: 0 3px 10px rgba(108, 92, 231, 0.3) !important;
}

.downloadButtonSecondary {
  width: 100%;
  height: 34px !important;
  text-transform: none !important;
  border-radius: 9px !important;
  font-weight: 600 !important;
  font-size: 12.5px !important;
  background-color: #F5F3FF !important;
  color: #6C5CE7 !important;
  box-shadow: none !important;
}

.downloadButtonSecondary:hover {
  background-color: #EEEDFE !important;
}

.rolePurple .summaryCardIcon { background-color: #EEEDFE; color: #6C5CE7; }
.rolePurple .summaryCardCount { color: #6C5CE7; }

.roleTeal .summaryCardIcon { background-color: #E1F5EE; color: #10A37F; }
.roleTeal .summaryCardCount { color: #10A37F; }
.roleTeal .summaryCardCaption { color: #0F8A6C; }

.roleAmber .summaryCardIcon { background-color: #FFF1E0; color: #C9761A; }
.roleAmber .summaryCardCount { color: #C9761A; }
.roleAmber .summaryCardCaption { color: #A56814; }

.infoBanner {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 12px 16px;
  border-radius: 10px;
  background-color: #F5F3FF;
  border: 1px solid rgba(108, 92, 231, 0.15);
  margin-top: 20px;
}

.infoBannerText {
  font-size: 12.5px;
  color: rgba(30, 20, 60, 0.6);
  line-height: 1.5;
}

/* ---- Full-width GLIF sections --------------------------------------------- */

.glifSection {
  width: 100%;
  background-color: #ffffff;
  border: 1px solid rgba(108, 92, 231, 0.1);
  border-radius: 14px;
  padding: 18px 22px;
  margin-bottom: 14px;
  box-shadow: 0 1px 6px rgba(76, 60, 150, 0.05);
}

.glifSectionHeader {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
}

.glifSectionIcon {
  width: 32px;
  height: 32px;
  border-radius: 9px;
  background-color: #F5F3FF;
  color: #6C5CE7;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.glifSectionTitle {
  font-size: 14px;
  font-weight: 700;
  color: rgba(30, 20, 60, 0.87);
  flex-grow: 1;
}

.chipValues {
  display: flex;
  row-gap: 8px;
  column-gap: 8px;
  flex-wrap: wrap;
  align-items: center;
}

.filterFieldChip {
  font-weight: 600 !important;
}

.typographyLabel {
  font-size: 12.5px;
  color: rgba(30, 20, 60, 0.55);
}

.clearAllLink {
  font-size: 12px;
  font-weight: 600;
  color: #6C5CE7;
  cursor: pointer;
  background: none;
  border: none;
  padding: 0;
}

.clearAllLink:hover {
  text-decoration: underline;
}

.downloadRow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 6px 4px;
}

.downloadRowText {
  font-size: 12px;
  color: rgba(30, 20, 60, 0.5);
  line-height: 1.5;
}

.downloadRowButton {
  text-transform: none !important;
  border-radius: 8px !important;
  font-weight: 600 !important;
  flex-shrink: 0;
  box-shadow: 0 2px 8px rgba(108, 92, 231, 0.25) !important;
}

/* ---- Details dialog — single dialog, drill-down with Back ------------------------ */

.dialogPaper {
  border-radius: 16px;
  max-height: 75vh;
  box-shadow: 0 12px 48px rgba(76, 60, 150, 0.2);
}

.dialogTitle {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 600;
  border-bottom: 1px solid rgba(108, 92, 231, 0.1);
}

.dialogTitleText {
  font-size: 15px;
  font-weight: 700;
  color: rgba(30, 20, 60, 0.87);
  flex-grow: 1;
}

.dialogButton {
  flex-grow: 0;
  margin: 4px;
}

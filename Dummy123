<DataGrid
  rows={data || []}
  columns={balanceColumns}
  loading={typeof loading === "object" ? loading?.balance : loading}
  rowCount={rowCount}
  pagination
  paginationMode="server"
  pageSizeOptions={[25, 50, 75, 100]}
  paginationModel={{
    page: fetchConf.page,
    pageSize: fetchConf.pageSize,
  }}
  onPaginationModelChange={(model) => {
    // Prevent MUI DataGrid internal re-renders from dispatching duplicate/reset state updates
    if (fetchConf.page === model.page && fetchConf.pageSize === model.pageSize) {
      return;
    }
    setFetchConf((prev) => ({
      ...prev,
      page: model.page,
      pageSize: model.pageSize,
    }));
  }}
  sortingMode="server"
  sortingOrder={["asc", "desc"]}
  sortModel={[
    {
      field: "date",
      sort: fetchConf.sortIn?.toLowerCase() || "desc",
    },
  ]}
  onSortModelChange={(model) => {
    if (!model || model.length === 0) return;

    const newSortIn = model[0].sort ? model[0].sort.toUpperCase() : "DESC";

    setFetchConf((prev) => {
      // Prevent DataGrid row re-hydration from resetting page to 0 unless user clicked a new sort
      if (prev.sortIn === newSortIn) {
        return prev;
      }
      return {
        ...prev,
        sortIn: newSortIn,
        page: 0,
      };
    });
  }}
  slots={{
    noRowsOverlay: CustomNoRowsOverlay,
  }}
  rowHeight={45}
  disableRowSelectionOnClick
  sx={{
    borderRadius: "20px",
    backgroundColor: "rgba(255,255,255,0.4)",
    border: "1px solid rgba(255,255,255,0.3)",
    "& .MuiDataGrid-columnHeaders": {
      bgcolor: "#f8f9fa",
      fontWeight: 700,
    },
  }}
/>

package com.tcs.fincore.CommonRequestService.service.strategy;

import org.springframework.stereotype.Component;

import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.tcs.fincore.CommonRequestService.exception.ResourceNotFoundException;
import com.tcs.fincore.CommonRequestService.model.CommonReq;
import com.tcs.fincore.CommonRequestService.model.FileType;
import com.tcs.fincore.CommonRequestService.model.enums.RequestType;
import com.tcs.fincore.CommonRequestService.repository.FileTypeRepository;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

@Component
@RequiredArgsConstructor
@Slf4j
public class FileTypeStrategy implements RequestTypeStrategy {
    private final FileTypeRepository fileTypeRepo;
    private final ObjectMapper objectMapper;

    @Override
    public RequestType getRequestType() {
        return RequestType.FILE_TYPE_MASTER;
    }

    @Override
    public void processApproval(CommonReq request) throws JsonProcessingException {
        switch (request.getChangeType()) {
            case ADD:
                handleAdd(request);
                break;
            case UPDATE:
                handleUpdate(request);
                break;
            case DELETE:
                handleDelete(request);
                break;
            default:
                throw new UnsupportedOperationException(
                        "Change type " + request.getChangeType() + " is not supported.");

        }

    }

    private void handleAdd(CommonReq request) throws JsonProcessingException {

        FileType fileType = objectMapper.readValue(request.getPayload(), FileType.class);
        FileType saveFileType = fileTypeRepo.save(fileType);
        log.info("Successfully added new File");

    }

    private void handleUpdate(CommonReq request) throws JsonProcessingException {

        String targetId = request.getTargetId();

        if (targetId == null || targetId.isBlank()) {
            throw new IllegalArgumentException("Target ID is required for an UPDATE operation.");
        }

        log.info("Fetching existing File with ID: {} for update.", targetId);
        String[] parts = targetId.split("_", 2);

        String type = parts[0];
        String filePattern = parts[1];

        // FileType existingFileType =
        // fileTypeRepo.findById(Long.valueOf(targetId)).orElseThrow(
        // () -> new ResourceNotFoundException("File Type with ID '" + targetId + "' not
        // found for update."));
        FileType existingFileType = fileTypeRepo
                .findByTypeAndFilePattern(type, filePattern)
                .orElseThrow(() -> new ResourceNotFoundException("Not found"));

        FileType updates = objectMapper.readValue(request.getPayload(), FileType.class);

        existingFileType.setIncludeFile(updates.getIncludeFile());
        existingFileType.setFrequency(updates.getFrequency());
        existingFileType.setStream(updates.getStream());
        fileTypeRepo.save(existingFileType);

        log.info("Successfullyu Updated File with ID", targetId);
    }

    private void handleDelete(CommonReq request) throws JsonProcessingException {
        log.info("entered the delete method");

        String targetId = request.getTargetId();

        if (targetId == null || targetId.isBlank()) {
            throw new IllegalArgumentException("Target ID is required for an DELETE operation.");
        }
        String[] parts = targetId.split("_", 2);
        String type = parts[0];
        String filePattern = parts[1];

        FileType existingFileType = fileTypeRepo
                .findByTypeAndFilePattern(type, filePattern).orElseThrow(
                        () -> new ResourceNotFoundException(
                                "File Type with ID '" + targetId + "' not found for Delete."));

        fileTypeRepo.deleteByTypeAndFilePattern(type, filePattern);
        log.info("Successfully Deleted File with ID", targetId);
    }
}

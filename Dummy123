onChange={(newValue) => {
  if (!newValue || !newValue.isValid()) {
    setReportDateError("Please enter a valid Report Date");
    return;
  }

  if (newValue.isBefore(MIN_ALLOWED_DATE, "day")) {
    setReportDateError(
      `Report Date cannot be earlier than ${MIN_ALLOWED_DATE.format("DD-MM-YYYY")}`
    );
    return;
  }

  if (etlDate && newValue.isAfter(dayjs(etlDate), "day")) {
    setReportDateError("Report Date cannot be later than ETL Date");
    return;
  }

  setReportDateError(null);
  setUserDate(newValue.format("YYYY-MM-DD"));
}}

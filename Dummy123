import React, { useEffect, useState } from 'react'
import { Box, Grid, Typography, Chip, Paper, Stack, Tabs, Tab, Divider, Button, Dialog, DialogContent, DialogActions, Collapse, Autocomplete, TextField, DialogTitle, Icon, Select, MenuItem, FormControl, InputLabel, Snackbar } from '@mui/material'
import { LocalizationProvider } from '@mui/x-date-pickers/LocalizationProvider';
import { DatePicker } from '@mui/x-date-pickers/DatePicker';
import { AdapterDayjs } from '@mui/x-date-pickers/AdapterDayjs';
import dayjs from 'dayjs';
import DisplayTab from './DisplayTab';
import useApi from '../../hooks/useApi';
import { AccountBalance, Public, Download, EventAvailable, Delete } from '@mui/icons-material';
import debounce from 'lodash/debounce'
import { useCallback } from 'react';
import { DesktopDatePicker } from '@mui/x-date-pickers/DesktopDatePicker';
import downloadFile from '../../utils/DownloadUtils';
import useCustomSnackbar from '../../utils/useCustomSnackbar';
import styles from './BranchPosition.module.css'
import Filter from './Filter';

const suspenseMap = {
    "CSD": "CGL suspense difference",
    "TSD": "Technical suspense difference",
    "BCD": "Balance compare difference"
}

const alterDateFormat = (date) => {
    const dateRegex = /^(0[1-9]|[12][0-9]|3[01])([-/.])(0[1-9]|1[0-2])\2(\d{4})$/;
    return date.replace(dateRegex, '$4$2$3$2$1');
}

export default function BranchPosition() {
    const [userDate, setUserDate] = useState(null);
    const [dataRows, setDataRows] = useState({});
    const [breakupDataRows, setBreakupDataRows] = useState({});
    const { callApi } = useApi();
    const [glifDataFilter, setGlifDataFilter] = useState({});
    const [loading, setLoading] = useState("N"); //"N","Y","BCD","TSD","CSD"
    const showSnackBar = useCustomSnackbar();
    const [mode, setMode] = useState("DD");
    const [isDialogOpen, setIsDialogOpen] = useState(false);
    const user = JSON.parse(localStorage.getItem('user'));

    console.log(userDate);

    /* DATA FETCHING FUNCTIONS */
    const debouncedFetchDifference = useCallback(debounce(async (type) => {
        if (mode === "DD") {
            await fetchDifference(type);
        }
    }, 100), [userDate, mode]);

    //fetching initial combined difference of all types
    async function fetchDifference() {
        const payload = {
            date: userDate,
            branch: user.branch.toString().padStart(5, 0),
            paginationModel: {
                page: 0,
                pageSize: 100
            }
        }
        try {
            setLoading("Y");
            const res = await callApi("/ES/branch-position/get-difference", payload, "POST");
            if (res && res.success) {
                setDataRows(res.data);
            } else {
                showSnackBar(res.message, "error")
                setDataRows({});
            }
            setLoading("N");
        } catch (e) {
            setLoading("N");
            showSnackBar(e.message, "error")
        }
    }

    //fetching diffence according to type
    async function fetchIndividualDifference(type, paginationModel) {
        const payload = {
            date: userDate,
            branch: user.branch.toString().padStart(5, 0),
            differenceType: type,
            paginationModel
        }
        try {
            setLoading(type);
            const res = await callApi("/ES/branch-position/get-difference", payload, "POST");
            if (res && res.success) {
                setDataRows((prev) => { return { ...prev, [type]: res.data[type] || [] } });
            } else {
                showSnackBar(res.message, "error")
            }
            setLoading("N");
        } catch (e) {
            setLoading("N");
            showSnackBar(e.message, "error")
        }
    }

    //fetches difference breakup for the GLCC and Date
    const fetchDetailedData = async (type, { cgl, currency, firstErrorDate }) => {
        const payload = {
            branch: user.branch.toString().padStart(5, 0),
            cgl,
            currency,
            startDate: alterDateFormat(firstErrorDate),
            endDate: userDate,
            differenceType: type
        }

        try {
            const res = await callApi("/ES/branch-position/get-detailed-difference", payload, 'POST');
            if (res && res.success) {
                setBreakupDataRows(() => { return { type, content: res.data || [] } });
            } else {
                showSnackBar(res.message, "error")
            }
        } catch (e) {
            showSnackBar(e.message, "error")
        }

    }

    /* Helper Functions */
    const blobErrorHandler = (error) => {
        if (error instanceof Blob) {
            error.text().then((errorMessage) => {
                // Try to parse as JSON if the server sends JSON errors
                try {
                    const errorJson = JSON.parse(errorMessage);
                    showSnackBar(errorJson?.message, "error");
                } catch (e) {
                    showSnackBar(`Error: ${errorMessage}`);
                }
            });
        } else {
            showSnackBar(error.message, "error");
        }
    }

    /* DATA EXPORT FUNCTIONS */
    //Export Difference Data according to the Difference Type and Date
    const exportData = async (filePref, differenceType) => {
        const payload = {
            branch: user.branch.toString().padStart(5, 0),
            date: userDate,
            differenceType
        }
        try {
            const res = await callApi("/ES/branch-position/export-difference", payload, 'POST', 'blob', 'application/octet-stream');
            if (res) {
                const filename = `${filePref}_${payload.branch}_${alterDateFormat(userDate)}`
                const fileData = new Blob([res]);
                // const contentDisposition = res.headers['content-disposition'];
                // let fileName = 'default_filename.ext'; // Fallback name

                // if (contentDisposition) {
                //     const fileNameMatch = contentDisposition.match(/filename="?([^"]+)"?/);
                //     if (fileNameMatch && fileNameMatch[1]) {
                //         fileName = fileNameMatch[1];
                //     }
                // }
                downloadFile(fileData, "xlsx", filename, false);
            } else {
                throw new Error("Failed to download file!")
            }
        } catch (e) {
            blobErrorHandler(e);
        }

    }

    //Exports Difference break-up data according to GLCC and date
    const exportDetailedData = async () => {
        if (breakupDataRows?.content.length == 0) {
            showSnackBar("No Rows to download!", "error")
        }
        const cgl = breakupDataRows.content[0].cgl
        const currency = breakupDataRows.content[0].currency
        const branch = user.branch.toString().padStart(5, 0)
        const differenceType = breakupDataRows.type
        const firstErrorDate = breakupDataRows.content[0].firstErrorDate;
        const payload = {
            branch,
            cgl,
            currency,
            startDate: alterDateFormat(firstErrorDate),
            endDate: userDate,
            differenceType
        }
        try {
            const res = await callApi("/ES/branch-position/export-detailed-difference", payload, 'POST', 'blob', 'application/octet-stream');
            if (res) {
                const filename = `${differenceType}_${branch}_${currency}_${cgl}_${alterDateFormat(userDate)}`
                const fileData = new Blob([res]);
                // const contentDisposition = res.headers['content-disposition'];
                // let fileName = 'default_filename.ext'; // Fallback name

                // if (contentDisposition) {
                //     const fileNameMatch = contentDisposition.match(/filename="?([^"]+)"?/);
                //     if (fileNameMatch && fileNameMatch[1]) {
                //         fileName = fileNameMatch[1];
                //     }
                // }
                downloadFile(fileData, "xlsx", filename, false);
            } else {
                throw new Error("Failed to download file!")
            }
        } catch (e) {
            blobErrorHandler(e);
        }

    }

    //Exports GIFF Data for the branch, date and applied filters
    const exportGlifData = async () => {
        const payload = {
            branch: user.branch.toString().padStart(5, 0),
            date: userDate,
            filters: [
                {
                    field: "BRANCH_CODE",
                    operator: "EQUALS",
                    value: user.branch.toString().padStart(5, 0)
                },
                {
                    field: "TRANS_DATE",
                    operator: "EQUALS",
                    value: userDate
                },
                ...Object.entries(glifDataFilter).map(([key, entry]) => { return { ["field"]: key, ["operator"]: entry.operator, ["value"]: entry.value } })
            ]
        }
        try {
            const res = await callApi("/ES/branch-position/export-glif-data", payload, 'POST', 'blob', 'application/octet-stream');
            if (res) {
                const branch = user.branch.toString().padStart(5, 0)
                let filename = `glif_${branch}_${alterDateFormat(userDate)}${Object.keys(glifDataFilter).length > 0 ? "_filtered" : ""}`;
                const fileData = new Blob([res]);
                // const contentDisposition = res.headers['content-disposition'];
                // let fileName = 'default_filename.ext'; // Fallback name

                // if (contentDisposition) {
                //     const fileNameMatch = contentDisposition.match(/filename="?([^"]+)"?/);
                //     if (fileNameMatch && fileNameMatch[1]) {
                //         fileName = fileNameMatch[1];
                //     }
                // }
                downloadFile(fileData, "xlsx", filename, false);
            } else {
                throw new Error("Failed to download file!")
            }
        } catch (error) {
            blobErrorHandler(error);
        }
    }


    /* Side Effects */
    useEffect(() => {
        const fetchData = async () => {
            try {
                const res = await callApi("/ES/branch-position/user-date");
                if (res && res.success) {
                    setUserDate(res.data.substring(0, 10));
                } else {
                    showSnackBar(res.message, "error")
                }
            } catch (e) {
                showSnackBar(e.message, "error")
            }
        }
        fetchData();

        return () => {
            setUserDate(null);
            setBreakupDataRows({});
            setDataRows(null);
            setIsDialogOpen(false);
            setGlifDataFilter({});
            setLoading("N");
            setMode("DD")
        }

    }, []);

    //Fetching Data when user changes date
    useEffect(() => {
        if (userDate == null) {
            return;
        }
        setBreakupDataRows({});
        debouncedFetchDifference();
    }, [userDate, debouncedFetchDifference]);

    //Opening the Difference BreakeUp Dialog when the data available
    useEffect(() => {
        if (!breakupDataRows?.content) {
            return;
        }
        setIsDialogOpen(true);
    }, [breakupDataRows]);

    /*Closes Detailed Breakup of difference*/
    const closeDialog = () => {
        setBreakupDataRows({});
        setIsDialogOpen(false);
    }

    /* Filter Updation functions */
    const handleFilter = (filter) => {
        if (!filter.multiValue) {
            setGlifDataFilter((prev) => { return { ...prev, [filter.field]: { operator: "EQUALS", value: filter.value } } })
            return;
        }
        if (glifDataFilter[filter.field]) {
            if (glifDataFilter[filter.field].value.length >= 10) {
                showSnackBar("only 10 filter values allowed!", "error");
                return;
            } else {
                if (new Set(glifDataFilter[filter.field].value).has(filter.value)) {
                    showSnackBar("value already present in the filter!", "error")
                    return;
                }
            }
            setGlifDataFilter((prev) => { return { ...prev, [filter.field]: { operator: "IN", value: [...prev[filter.field].value, filter.value] } } })
            return
        }
        setGlifDataFilter((prev) => { return { ...prev, [filter.field]: { operator: "IN", value: [filter.value] } } })
    }

    const deleteFilter = (key) => {
        const { [key]: _, ...rem } = glifDataFilter;
        setGlifDataFilter(rem);
    }

    const deleteFilterValue = (key, deleteVal) => {
        const newArray = glifDataFilter[key].value.filter((val) => val != deleteVal);
        if (newArray.length > 0) {
            setGlifDataFilter((prev) => { return { ...prev, [key]: { ...prev[key], value: newArray } } })
        } else {
            deleteFilter(key)
        }
    }

    /* passes current filter data to the filter module */
    const getFiterData = (field) => {
        return glifDataFilter[field]?.value || [];
    }


    return (
        <>
            <Box >
                <Box >
                    <Grid container
                        className={styles.outerGridContainer}
                        spacing={1}>
                        <Grid item size={{ md: 9 }}>
                            <Paper className={styles.uniformPaddedContainer}>
                                <Typography className={styles.typographyHeader}>
                                    Branch Details
                                </Typography>
                                <Divider className={styles.dividerMargin} />
                                <Grid container className={styles.uniformPaddedContainer} direction="row" spacing={2}>
                                    {/* Branch Code */}
                                    <Grid item size={{ xs: 12, md: 4 }}>
                                        <Box display="flex" alignItems="center" gap={1}>
                                            <AccountBalance color="primary" fontSize="small" />
                                            <Typography variant="body1">
                                                <strong>Branch Code:</strong> {user?.branch.toString().padStart(5, 0)}
                                            </Typography>
                                        </Box>
                                    </Grid>

                                    {/* Branch Name */}
                                    <Grid item size={{ xs: 12, md: 8 }}>
                                        <Box display="flex" alignItems="center" gap={1}>
                                            <AccountBalance color="action" fontSize="small" />
                                            <Typography variant="body1">
                                                <strong>Branch Name:</strong> {user?.branchName}
                                            </Typography>
                                        </Box>
                                    </Grid>

                                    {/* Circle Code */}
                                    <Grid item size={{ xs: 12, md: 4 }}>
                                        <Box display="flex" alignItems="center" gap={1}>
                                            <Public color="primary" fontSize="small" />
                                            <Typography variant="body1">
                                                <strong>Circle Code:</strong> {user?.circleCode}
                                            </Typography>
                                        </Box>
                                    </Grid>

                                    {/* Circle Name */}
                                    <Grid item size={{ xs: 12, md: 8 }}>
                                        <Box display="flex" alignItems="center" gap={1}>
                                            <Public color="action" fontSize="small" />
                                            <Typography variant="body1">
                                                <strong>Circle Name:</strong> {user?.circleName}
                                            </Typography>
                                        </Box>
                                    </Grid>

                                </Grid>
                            </Paper>
                        </Grid>
                        <Grid className={styles.datePickerContainer} item size={{ md: 3 }}>
                            <Paper className={styles.uniformPaddedContainer} >
                                <Typography className={styles.typographyHeader}>
                                    Select Date
                                </Typography>
                                <Divider className={styles.dividerMargin} />
                                <LocalizationProvider dateAdapter={AdapterDayjs}>
                                    <DesktopDatePicker
                                        value={userDate ? dayjs(userDate.substring(0, 11), 'YYYY-MM-DD') : dayjs()}
                                        onChange={(newVal) => { newVal ? setUserDate(newVal.format('YYYY-MM-DD')) : setUserDate(dayjs().format('YYYY-MM-DD')) }}
                                        maxDate={dayjs()}
                                        format='DD-MM-YYYY'
                                        closeOnSelect={true}
                                        slots={{
                                            actionBar: () => null
                                        }} />
                                </LocalizationProvider>
                            </Paper>
                        </Grid>
                    </Grid>
                </Box>
                {/* </Paper> */}
                <Paper className={styles.contentPaper}>
                    <Tabs
                        className={styles.dividerMargin, styles.tabs}
                        value={mode}
                        onChange={() => {
                            setMode((mode === "DD") ? "GE" : "DD");
                            setGlifDataFilter({})
                        }}
                        indicatorColor="secondary"
                        aria-label="secondary tabs example"
                    >
                        <Tab value="DD" className={styles.tab} label="Difference Data" disabled={loading != "N" && mode != "DD"} />
                        <Tab value="GE" className={styles.tab} label="GLIF Data" disabled={loading != "N" && mode != "GE"} />
                    </Tabs>
                    {(mode === "DD") &&
                        <Box className={styles.contentBox}>
                            <DisplayTab category="Technical Suspense Difference" type="TSD" level={1} data={dataRows["TSD"] || []}
                                clickHandler={fetchDetailedData} downloadHandler={exportData} loading={loading === "Y" || loading === "TSD"} requestData={fetchIndividualDifference} />
                            <DisplayTab category="CGL Suspense Difference" type="CSD" level={1} data={dataRows["CSD"] || []}
                                clickHandler={fetchDetailedData} downloadHandler={exportData} loading={loading === "Y" || loading === "CSD"} requestData={fetchIndividualDifference} />
                            <DisplayTab category="Balance Compare Difference" type="BCD" level={1} data={dataRows["BCD"] || []}
                                clickHandler={fetchDetailedData} downloadHandler={exportData} loading={loading === "Y" || loading === "BCD"} requestData={fetchIndividualDifference} />
                        </Box>
                    }
                    {(mode === "GE") &&
                        <Paper className={styles.gilfPaper}>
                            <Typography className={styles.typographyHeaderCenter}>
                                Download GLIF data of your branch and selected date.
                            </Typography>
                            <Divider className={styles.dividerMargin} />
                            <Grid container className={styles.uniformPaddedContainer} spacing={1}>
                                <Grid item size={{ md: 6 }} className={styles.filterContainer} >
                                    <Paper className={`${styles.filterPaper} ${styles.filterBgInfo}`}>
                                        <Typography>
                                            Add filter for fetching data(Max 10, If multivalued).
                                        </Typography>
                                        <Divider className={styles.dividerMargin} />
                                        <Filter handleFilter={handleFilter} getValues={getFiterData} />
                                    </Paper>
                                </Grid>
                                <Grid item size={{ md: 6 }} className={styles.filterContainer}>
                                    <Paper className={`${styles.filterPaper} ${styles.filterBgSuccess}`}>
                                        <Typography>
                                            Filters added for data fetching.
                                        </Typography>
                                        <Divider className={styles.dividerMargin} />

                                        <Stack spacing={0.5}>
                                            {Object.entries(glifDataFilter).map(([key, val]) => (
                                                <Grid className={styles.filterDisplay} container key={key} spacing={1}>
                                                    <Grid className={`${styles.datePickerContainer} ${styles.filterLabel}`} item size={{ md: 3 }} spacing={1}>
                                                        <Chip
                                                            label={key.toString().replaceAll("_", " ")}
                                                            onDelete={() => deleteFilter(key)}
                                                            deleteIcon={<Delete />}
                                                        />
                                                    </Grid>
                                                    <Grid item size={{ md: 9 }} className={styles.filterValues} >
                                                        {Array.isArray(val.value) ? val.value.map((ent, index) => (<Chip className={styles.chipBg} key={index} onDelete={() => deleteFilterValue(key, ent)} label={ent} />)) : <Typography><Chip className={styles.chipBg} onDelete={() => setGlifDataFilter(() => { const { [key]: _, ...rest } = glifDataFilter; return rest })} label={val.value} /></Typography>}
                                                    </Grid>
                                                </Grid>))}
                                        </Stack>

                                    </Paper>
                                </Grid>
                            </Grid>
                            <Divider className={styles.dividerMargin} />
                            <Box className={styles.centeredButtonBox}>
                                <Button variant="contained" onClick={() => exportGlifData()} >
                                    <Typography>
                                        Download Data
                                    </Typography>
                                </Button>
                            </Box>
                        </Paper >
                    }
                </Paper>
            </Box >
            <Dialog
                className={styles.dialog}
                open={isDialogOpen}
                fullWidth
                PaperProps={{
                    className: styles.dialogPaper

                }}
            >
                <DialogTitle className={styles.dialogTitle} >
                    <Typography className={styles.typographyLabel}>Difference Break-up</Typography>
                    <Button className={styles.dialogButton} disabled={breakupDataRows?.data?.length == 0} onClick={exportDetailedData} variant="contained" size='small'><Download /></Button>
                    <Button className={styles.dialogButton} onClick={closeDialog} variant="contained" size='small'>X</Button>
                </DialogTitle >
                <DialogContent>
                    <DisplayTab data={breakupDataRows || []} category={"Difference Breakup"} type={breakupDataRows?.type} level={2} closeHandler={() => closeDialog()} />
                </DialogContent>
            </Dialog >
        </>

    )
}

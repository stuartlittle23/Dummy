          border: "1px solid #e2e8f0",
          backgroundColor: "#ffffff",
          boxShadow: "0px 4px 20px rgba(0, 0, 0, 0.02)",
        }}
      >
        <CardContent sx={{ p: 2.5, "&:last-child": { pb: 2.5 } }}>
          <Grid container spacing={2} alignItems="center">
            {/* ETL DATE */}
            <Grid item xs={12} sm={6} md={2.5}>
              <LocalizationProvider dateAdapter={AdapterDayjs}>
                <DatePicker
                  label="ETL Date"
                  value={etlDate ? dayjs(etlDate) : null}
                  onChange={(newValue) => {
                    const formattedDate = newValue ? newValue.format("YYYY-MM-DD") : "";
                    setEtlDate(formattedDate);
                    updateFilter("date", formattedDate);
                  }}
                  slotProps={{
                    textField: {
                      fullWidth: true,
                      size: "small",
                      sx: customInputStyles,
                    },
                  }}
                />
              </LocalizationProvider>
            </Grid>

            {/* BRANCH CODE */}
            <Grid item xs={12} sm={6} md={2}>
              <TextField
                fullWidth
                label="Branch Code"
                size="small"
                value={filters.branchCode}
                onChange={(e) =>
                  updateFilter("branchCode", validateBranchCode(e.target.value))
                }
                sx={customInputStyles}
              />
            </Grid>

            {/* CURRENCY */}
            <Grid item xs={12} sm={6} md={2}>
              <TextField
                fullWidth
                label="Currency"
                size="small"
                value={filters.currency}
                onChange={(e) =>
                  updateFilter("currency", validateCurrency(e.target.value))
                }
                sx={customInputStyles}
              />
            </Grid>

            {/* CGL NUMBER */}
            <Grid item xs={12} sm={6} md={3.5}>
              <TextField
                fullWidth
                label="CGL Number"
                size="small"
                value={filters.cgl}
                onChange={(e) => updateFilter("cgl", validateCGL(e.target.value))}
                InputProps={{
                  startAdornment: (
                    <InputAdornment position="start">
                      <SearchIcon fontSize="small" sx={{ color: "#94a3b8" }} />
                    </InputAdornment>
                  ),
                }}
                sx={customInputStyles}
              />
            </Grid>

            {/* SEARCH BUTTON */}
            <Grid item xs={12} md={2}>
              <Button
                fullWidth
                variant="contained"
                disableElevation
                startIcon={<FilterListIcon />}
                onClick={() => {
                  setPaginationModel((prev) => ({ ...prev, page: 0 }));
                  fetchData(filters.date, 0, paginationModel.pageSize);
                }}
                sx={{
                  height: "40px",
                  borderRadius: "24px",
                  textTransform: "none",
                  fontWeight: 700,
                  fontSize: "0.875rem",
                  background: "linear-gradient(135deg, #6366f1 0%, #4f46e5 100%)",
                  boxShadow: "0px 4px 12px rgba(99, 102, 241, 0.25)",
                  "&:hover": {
                    background: "linear-gradient(135deg, #4f46e5 0%, #4338ca 100%)",
                  },
                }}
              >
                Search
              </Button>
            </Grid>
          </Grid>
        </CardContent>
      </Card>

      {/* DATA GRID CONTAINER */}
      <Paper
        elevation={0}
        sx={{
          width: "100%",
          borderRadius: "16px",
          border: "1px solid #e2e8f0",
          overflow: "hidden",
          backgroundColor: "#ffffff",
          boxShadow: "0px 4px 20px rgba(0, 0, 0, 0.02)",
        }}
      >
        <Box
          sx={{
            p: 2,
            px: 3,
            backgroundColor: "#ffffff",
            borderBottom: "1px solid #f1f5f9",
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
          }}
        >
          <Typography variant="body2" sx={{ color: "#64748b", fontWeight: 600 }}>
            {loading
              ? "Loading data..."
              : `Showing ${rows.length} of ${totalElements.toLocaleString()} record(s)`}
          </Typography>
        </Box>

        <Box sx={{ height: 520, width: "100%" }}>
          <DataGrid
            rows={rows}
            columns={columns}
            rowCount={totalElements}
            loading={loading}
            paginationMode="server"
            paginationModel={paginationModel}
            onPaginationModelChange={setPaginationModel}
            pageSizeOptions={[10, 25, 50]}
            disableRowSelectionOnClick
            sx={{
              border: "none",
              "& .MuiDataGrid-columnHeaders": {
                backgroundColor: "#f8fafc",
                color: "#64748b",
                fontSize: "0.75rem",
                fontWeight: 800,
                letterSpacing: "0.5px",
                borderBottom: "1px solid #e2e8f0",
              },
              "& .MuiDataGrid-cell": {
                borderColor: "#f1f5f9",
              },
              "& .MuiDataGrid-row:hover": {
                backgroundColor: "#f8fafc",
              },
            }}
          />
        </Box>
      </Paper>

      {/* DETAILS DIALOG */}
      <Dialog
        open={openHistory}
        onClose={() => setOpenHistory(false)}
        fullWidth
        maxWidth="sm"
        PaperProps={{
          sx: { borderRadius: "20px", p: 1 },
        }}
      >
        <DialogTitle sx={{ pb: 1 }}>
          <Stack direction="row" alignItems="center" spacing={1.5}>
            <Avatar sx={{ bgcolor: "#eef2ff", color: "#6366f1" }}>
              <AccountBalanceWalletIcon fontSize="small" />
            </Avatar>
            <Typography variant="h6" sx={{ fontWeight: 700, flexGrow: 1, color: "#0f172a" }}>
              Difference Details
            </Typography>
            <IconButton onClick={() => setOpenHistory(false)} size="small">
              <CloseIcon />
            </IconButton>
          </Stack>
        </DialogTitle>

        <Divider />

        <DialogContent sx={{ py: 3 }}>
          {selectedRow && (
            <Grid container spacing={2}>
              <Grid item xs={6}>
                <Typography variant="caption" color="text.secondary" fontWeight={500}>
                  Reconciliation Date
                </Typography>
                <Typography variant="body2" sx={{ fontWeight: 700, color: "#1e293b" }}>
                  {selectedRow.reconRunDate || "N/A"}
                </Typography>
              </Grid>

              <Grid item xs={6}>
                <Typography variant="caption" color="text.secondary" fontWeight={500}>
                  Branch Code
                </Typography>
                <Typography variant="body2" sx={{ fontWeight: 700, color: "#1e293b" }}>
                  {selectedRow.branchCode || "N/A"}
                </Typography>
              </Grid>

              <Grid item xs={6}>
                <Typography variant="caption" color="text.secondary" fontWeight={500}>
                  Currency
                </Typography>
                <Typography variant="body2" sx={{ fontWeight: 700, color: "#1e293b" }}>
                  {selectedRow.currency || "N/A"}
                </Typography>
              </Grid>

              <Grid item xs={6}>
                <Typography variant="caption" color="text.secondary" fontWeight={500}>
                  CGL Number
                </Typography>
                <Typography variant="body2" sx={{ fontWeight: 700, color: "#1e293b" }}>
                  {selectedRow.cgl || "N/A"}
                </Typography>
              </Grid>

              <Grid item xs={12}>
                <Divider sx={{ my: 1 }} />
              </Grid>

              <Grid item xs={6}>
                <Paper variant="outlined" sx={{ p: 2, textAlign: "center", borderRadius: "12px", borderColor: "#e2e8f0" }}>
                  <Typography variant="caption" color="text.secondary" fontWeight={500}>
                    CBS Balance
                  </Typography>
                  <Typography variant="h6" sx={{ fontWeight: 800, color: "#0f172a", fontFamily: "monospace" }}>
                    {selectedRow.cbsBalance != null
                      ? Number(selectedRow.cbsBalance).toLocaleString()
                      : "0.00"}
                  </Typography>
                </Paper>
              </Grid>

              <Grid item xs={6}>
                <Paper variant="outlined" sx={{ p: 2, textAlign: "center", borderRadius: "12px", borderColor: "#e2e8f0" }}>
                  <Typography variant="caption" color="text.secondary" fontWeight={500}>
                    GL Balance
                  </Typography>
                  <Typography variant="h6" sx={{ fontWeight: 800, color: "#0f172a", fontFamily: "monospace" }}>
                    {selectedRow.glBalance != null
                      ? Number(selectedRow.glBalance).toLocaleString()
                      : "0.00"}
                  </Typography>
                </Paper>
              </Grid>

              <Grid item xs={12}>
                <Box
                  sx={{
                    p: 2,
                    borderRadius: "12px",
                    backgroundColor: selectedRow.differenceAmount < 0 ? "#fef2f2" : "#f0fdf4",
                    border: `1px solid ${
                      selectedRow.differenceAmount < 0 ? "#fecaca" : "#bbf7d0"
                    }`,
                    textAlign: "center",
                  }}
                >
                  <Typography variant="caption" color="text.secondary" fontWeight={600}>
                    Net Difference Amount
                  </Typography>
                  <Typography
                    variant="h5"
                    sx={{
                      fontWeight: 800,
                      fontFamily: "monospace",
                      color: selectedRow.differenceAmount < 0 ? "#dc2626" : "#16a34a",
                    }}
                  >
                    {selectedRow.differenceAmount != null
                      ? Number(selectedRow.differe

import React, { useState, useCallback, useEffect } from "react";
import {
  Box,
  Paper,
  Typography,
  IconButton,
  Grid,
  Card,
  CardContent,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  InputAdornment,
  Breadcrumbs,
  Link,
  Chip,
  Button,
  Divider,
  Tooltip,
  TextField,
  Avatar,
  Stack,
} from "@mui/material";
import { DataGrid } from "@mui/x-data-grid";
import HistoryIcon from "@mui/icons-material/HistoryVisibility";
import CloseIcon from "@mui/icons-material/Close";
import SearchIcon from "@mui/icons-material/Search";
import NavigateNextIcon from "@mui/icons-material/NavigateNext";
import AccountBalanceWalletIcon from "@mui/icons-material/AccountBalanceWallet";
import RefreshIcon from "@mui/icons-material/Refresh";
import FilterListIcon from "@mui/icons-material/FilterList";
import useApi from "../../hooks/useApi";
import useValidation from "./Validation";
import dayjs from "dayjs";
import { LocalizationProvider, DatePicker } from "@mui/x-date-pickers";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";

const BalanceParticularSearchScreen = () => {
  const { callApi } = useApi();
  const { validateBranchCode, validateCurrency, validateCGL } = useValidation();

  const [filters, setFilters] = useState({
    date: "",
    branchCode: "",
    currency: "",
    cgl: "",
  });

  const [rows, setRows] = useState([]);
  const [loading, setLoading] = useState(false);
  const [totalElements, setTotalElements] = useState(0);
  const [etlDate, setEtlDate] = useState(null);

  const [paginationModel, setPaginationModel] = useState({
    page: 0,
    pageSize: 10,
  });

  const [openHistory, setOpenHistory] = useState(false);
  const [selectedRow, setSelectedRow] = useState(null);

  const updateFilter = (key, value) =>
    setFilters((prev) => ({ ...prev, [key]: value }));

  // ETL Date Fetching
  useEffect(() => {
    const fetchDefaultETLDate = async () => {
      try {
        const response = await callApi("/PS/file/fincore-date", {}, "GET");
        const dateVal = response?.data?.etlDate || response?.date || "";
        if (dateVal) {
          setEtlDate(dateVal);
          updateFilter("date", dateVal);
          fetchData(dateVal, 0, paginationModel.pageSize);
        }
      } catch (err) {
        console.error("ETL Date Error:", err);
      }
    };
    fetchDefaultETLDate();
  }, []);

  // Main Search API Call
  const fetchData = useCallback(
    async (date, pageIndex, pageSize) => {
      if (!date) return;
      setLoading(true);
      try {
        const payload = {
          fromDate: date,
          toDate: date,
          branchCode: filters.branchCode || null,
          currency: filters.currency || null,
          cgl: filters.cgl || null,
        };

        const response = await callApi(
          `/ES/differences/search?page=${pageIndex}&size=${pageSize}`,
          payload,
          "POST"
        );

        const content = response?.data?.content || response?.content || [];
        const mappedRows = content.map((item, index) => ({
          id: item.id || `row-${pageIndex}-${index}`,
          ...item,
          GLCC_VAL: `${item.branchCode || ""} / ${item.currency || ""} / ${item.cgl || ""}`,
        }));

        setRows(mappedRows);
        setTotalElements(
          response?.data?.totalElements || response?.totalElements || 0
        );
      } catch (err) {
        console.error("Search Fail:", err);
        setRows([]);
      } finally {
        setLoading(false);
      }
    },
    [filters, callApi]
  );

  useEffect(() => {
    if (filters.date) {
      fetchData(filters.date, paginationModel.page, paginationModel.pageSize);
    }
  }, [paginationModel.page, paginationModel.pageSize]);

  // Table Columns Definition
  const columns = [
    {
      field: "reconRunDate",
      headerName: "Error Date",
      flex: 1,
      minWidth: 120,
      renderCell: (params) => (
        <Typography variant="body2" sx={{ fontWeight: 500, color: "#475569" }}>
          {params.value || "-"}
        </Typography>
      ),
    },
    {
      field: "GLCC_VAL",
      headerName: "GLCC (Branch / CCY / CGL)",
      flex: 1.5,
      minWidth: 200,
      renderCell: (params) => (
        <Chip
          label={params.value}
          size="small"
          variant="outlined"
          sx={{
            borderColor: "#cbd5e1",
            fontWeight: 600,
            fontSize: "0.75rem",
            backgroundColor: "#f8fafc",
          }}
        />
      ),
    },
    {
      field: "cbsBalance",
      headerName: "CBS Balance",
      flex: 1,
      minWidth: 130,
      align: "right",
      headerAlign: "right",
      renderCell: (params) => (
        <Typography variant="body2" sx={{ fontFamily: "monospace" }}>
          {params.value != null ? Number(params.value).toLocaleString() : "0.00"}
        </Typography>
      ),
    },
    {
      field: "glBalance",
      headerName: "GL Balance",
      flex: 1,
      minWidth: 130,
      align: "right",
      headerAlign: "right",
      renderCell: (params) => (
        <Typography variant="body2" sx={{ fontFamily: "monospace" }}>
          {params.value != null ? Number(params.value).toLocaleString() : "0.00"}
        </Typography>
      ),
    },
    {
      field: "differenceAmount",
      headerName: "Difference",
      flex: 1.2,
      minWidth: 150,
      align: "right",
      headerAlign: "right",
      renderCell: (params) => {
        const val = params.value || 0;
        const isNegative = val < 0;
        return (
          <Chip
            label={Number(val).toLocaleString()}
            size="small"
            sx={{
              fontWeight: 700,
              backgroundColor: isNegative ? "#ffebee" : "#e8f5e9",
              color: isNegative ? "#c62828" : "#2e7d32",
              fontFamily: "monospace",
              px: 1,
            }}
          />
        );
      },
    },
    {
      field: "action",
      headerName: "Action",
      width: 100,
      sortable: false,
      align: "center",
      headerAlign: "center",
      renderCell: (params) => (
        <Tooltip title="View Difference Details">
          <IconButton
            size="small"
            sx={{
              color: "#6366f1",
              backgroundColor: "#eeefec",
              "&:hover": { backgroundColor: "#e0e7ff" },
            }}
            onClick={() => {
              setSelectedRow(params.row);
              setOpenHistory(true);
            }}
          >
            <HistoryIcon fontSize="small" />
          </IconButton>
        </Tooltip>
      ),
    },
  ];

  return (
    <Box
      sx={{
        width: "100%",
        minHeight: "100vh",
        backgroundColor: "#f4f5f7",
        p: { xs: 2, md: 4 },
      }}
    >
      {/* HEADER & BREADCRUMBS */}
      <Box sx={{ mb: 3 }}>
        <Breadcrumbs
          separator={<NavigateNextIcon fontSize="small" />}
          aria-label="breadcrumb"
          sx={{ mb: 1, fontSize: "0.85rem" }}
        >
          <Link underline="hover" color="inherit" href="#">
            Compare Difference
          </Link>
          <Typography color="text.primary" sx={{ fontWeight: 600 }}>
            Search
          </Typography>
        </Breadcrumbs>
        <Stack direction="row" justifyContent="space-between" alignItems="center">
          <Typography variant="h5" sx={{ fontWeight: 700, color: "#1e293b" }}>
            Balance Search & Reconciliation
          </Typography>
          <Button
            startIcon={<RefreshIcon />}
            size="small"
            sx={{ color: "#64748b" }}
            onClick={() => fetchData(filters.date, 0, paginationModel.pageSize)}
          >
            Refresh
          </Button>
        </Stack>
      </Box>

      {/* FILTER BAR CONTAINER */}
      <Card
        elevation={0}
        sx={{
          mb: 3,
          borderRadius: 3,
          border: "1px solid #e2e8f0",
          boxShadow: "0 4px 20px rgba(0, 0, 0, 0.03)",
        }}
      >
        <CardContent sx={{ p: 2.5, "&:last-child": { pb: 2.5 } }}>
          <Grid container spacing={2} alignItems="center">
            {/* ETL DATE */}
            <Grid item xs={12} sm={6} md={2.5}>
              <LocalizationProvider dateAdapter={AdapterDayjs}>
                <DatePicker
                  label="ETL Date"
                  value={etlDate ? dayjs(etlDate) : null}
                  onChange={(newValue) => {
                    const formattedDate = newValue ? newValue.format("YYYY-MM-DD") : "";
                    setEtlDate(formattedDate);
                    updateFilter("date", formattedDate);
                  }}
                  slotProps={{
                    textField: {
                      fullWidth: true,
                      size: "small",
                      sx: {
                        "& .MuiOutlinedInput-root": {
                          borderRadius: "10px",
                          backgroundColor: "#f8fafc",
                        },
                      },
                    },
                  }}
                />
              </LocalizationProvider>
            </Grid>

            {/* BRANCH CODE */}
            <Grid item xs={12} sm={6} md={2}>
              <TextField
                fullWidth
                label="Branch Code"
                size="small"
                value={filters.branchCode}
                onChange={(e) =>
                  updateFilter("branchCode", validateBranchCode(e.target.value))
                }
                sx={{
                  "& .MuiOutlinedInput-root": {
                    borderRadius: "10px",
                    backgroundColor: "#f8fafc",
                  },
                }}
              />
            </Grid>

            {/* CURRENCY */}
            <Grid item xs={12} sm={6} md={2}>
              <TextField
                fullWidth
                label="Currency"
                size="small"
                value={filters.currency}
                onChange={(e) =>
                  updateFilter("currency", validateCurrency(e.target.value))
                }
                sx={{
                  "& .MuiOutlinedInput-root": {
                    borderRadius: "10px",
                    backgroundColor: "#f8fafc",
                  },
                }}
              />
            </Grid>

            {/* CGL NUMBER */}
            <Grid item xs={12} sm={6} md={3.5}>
              <TextField
                fullWidth
                label="CGL Number"
                size="small"
                value={filters.cgl}
                onChange={(e) => updateFilter("cgl", validateCGL(e.target.value))}
                InputProps={{
                  startAdornment: (
                    <InputAdornment position="start">
                      <SearchIcon fontSize="small" sx={{ color: "#94a3b8" }} />
                    </InputAdornment>
                  ),
                }}
                sx={{
                  "& .MuiOutlinedInput-root": {
                    borderRadius: "10px",
                    backgroundColor: "#f8fafc",
                  },
                }}
              />
            </Grid>

            {/* SEARCH BUTTON */}
            <Grid item xs={12} md={2}>
              <Button
                fullWidth
                variant="contained"
                disableElevation
                startIcon={<FilterListIcon />}
                onClick={() => {
                  setPaginationModel((prev) => ({ ...prev, page: 0 }));
                  fetchData(filters.date, 0, paginationModel.pageSize);
                }}
                sx={{
                  height: "40px",
                  borderRadius: "10px",
                  textTransform: "none",
                  fontWeight: 600,
                  backgroundColor: "#6366f1",
                  "&:hover": { backgroundColor: "#4f46e5" },
                }}
              >
                Search
              </Button>
            </Grid>
          </Grid>
        </CardContent>
      </Card>

      {/* DATA TABLE */}
      <Paper
        elevation={0}
        sx={{
          width: "100%",
          borderRadius: 3,
          border: "1px solid #e2e8f0",
          overflow: "hidden",
          boxShadow: "0 4px 20px rgba(0, 0, 0, 0.03)",
        }}
      >
        <Box
          sx={{
            p: 2,
            px: 3,
            backgroundColor: "#ffffff",
            borderBottom: "1px solid #f1f5f9",
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
          }}
        >
          <Typography variant="subtitle2" sx={{ color: "#64748b", fontWeight: 600 }}>
            {loading
              ? "Fetching Records..."
              : `Total Records Found: ${totalElements.toLocaleString()}`}
          </Typography>
        </Box>

        <Box sx={{ height: 500, width: "100%" }}>
          <DataGrid
            rows={rows}
            columns={columns}
            rowCount={totalElements}
            loading={loading}
            paginationMode="server"
            paginationModel={paginationModel}
            onPaginationModelChange={setPaginationModel}
            pageSizeOptions={[10, 25, 50]}
            disableRowSelectionOnClick
            sx={{
              border: "none",
              "& .MuiDataGrid-columnHeaders": {
                backgroundColor: "#f8fafc",
                color: "#475569",
                fontSize: "0.8rem",
                fontWeight: 700,
                textTransform: "uppercase",
                letterSpacing: "0.5px",
              },
              "& .MuiDataGrid-cell": {
                borderColor: "#f1f5f9",
              },
              "& .MuiDataGrid-row:hover": {
                backgroundColor: "#f8fafc",
              },
            }}
          />
        </Box>
      </Paper>

      {/* DETAILS DIALOG */}
      <Dialog
        open={openHistory}
        onClose={() => setOpenHistory(false)}
        fullWidth
        maxWidth="sm"
        PaperProps={{
          sx: { borderRadius: 3, p: 1 },
        }}
      >
        <DialogTitle sx={{ pb: 1 }}>
          <Stack direction="row" alignItems="center" spacing={1.5}>
            <Avatar sx={{ bgcolor: "#e0e7ff", color: "#6366f1" }}>
              <AccountBalanceWalletIcon fontSize="small" />
            </Avatar>
            <Typography variant="h6" sx={{ fontWeight: 700, flexGrow: 1 }}>
              Difference Details
            </Typography>
            <IconButton onClick={() => setOpenHistory(false)} size="small">
              <CloseIcon />
            </IconButton>
          </Stack>
        </DialogTitle>

        <Divider />

        <DialogContent sx={{ py: 3 }}>
          {selectedRow && (
            <Grid container spacing={2}>
              <Grid item xs={6}>
                <Typography variant="caption" color="text.secondary">
                  Reconciliation Date
                </Typography>
                <Typography variant="body2" sx={{ fontWeight: 600 }}>
                  {selectedRow.reconRunDate || "N/A"}
                </Typography>
              </Grid>

              <Grid item xs={6}>
                <Typography variant="caption" color="text.secondary">
                  Branch Code
                </Typography>
                <Typography variant="body2" sx={{ fontWeight: 600 }}>
                  {selectedRow.branchCode || "N/A"}
                </Typography>
              </Grid>

              <Grid item xs={6}>
                <Typography variant="caption" color="text.secondary">
                  Currency
                </Typography>
                <Typography variant="body2" sx={{ fontWeight: 600 }}>
                  {selectedRow.currency || "N/A"}
                </Typography>
              </Grid>

              <Grid item xs={6}>
                <Typography variant="caption" color="text.secondary">
                  CGL Number
                </Typography>
                <Typography variant="body2" sx={{ fontWeight: 600 }}>
                  {selectedRow.cgl || "N/A"}
                </Typography>
              </Grid>

              <Grid item xs={12}>
                <Divider sx={{ my: 1 }} />
              </Grid>

              <Grid item xs={6}>
                <Paper variant="outlined" sx={{ p: 1.5, textAlign: "center", borderRadius: 2 }}>
                  <Typography variant="caption" color="text.secondary">
                    CBS Balance
                  </Typography>
                  <Typography variant="h6" sx={{ fontWeight: 700, color: "#1e293b" }}>
                    {selectedRow.cbsBalance != null
                      ? Number(selectedRow.cbsBalance).toLocaleString()
                      : "0.00"}
                  </Typography>
                </Paper>
              </Grid>

              <Grid item xs={6}>
                <Paper variant="outlined" sx={{ p: 1.5, textAlign: "center", borderRadius: 2 }}>
                  <Typography variant="caption" color="text.secondary">
                    GL Balance
                  </Typography>
                  <Typography variant="h6" sx={{ fontWeight: 700, color: "#1e293b" }}>
                    {selectedRow.glBalance != null
                      ? Number(selectedRow.glBalance).toLocaleString()
                      : "0.00"}
                  </Typography>
                </Paper>
              </Grid>

              <Grid item xs={12}>
                <Box
                  sx={{
                    p: 2,
                    borderRadius: 2,
                    backgroundColor: selectedRow.differenceAmount < 0 ? "#fef2f2" : "#f0fdf4",
                    border: `1px solid ${
                      selectedRow.differenceAmount < 0 ? "#fecaca" : "#bbf7d0"
                    }`,
                    textAlign: "center",
                  }}
                >
                  <Typography variant="caption" color="text.secondary">
                    Net Variance / Difference
                  </Typography>
                  <Typography
                    variant="h5"
                    sx={{
                      fontWeight: 800,
                      color: selectedRow.differenceAmount < 0 ? "#dc2626" : "#16a34a",
                    }}
                  >
                    {selectedRow.differenceAmount != null
                      ? Number(selectedRow.differenceAmount).toLocaleString()
                      : "0.00"}
                  </Typography>
                </Box>
              </Grid>
            </Grid>
          )}
        </DialogContent>

        <DialogActions sx={{ px: 3, pb: 2 }}>
          <Button
            variant="outlined"
            onClick={() => setOpenHistory(false)}
            sx={{ borderRadius: "8px", textTransform: "none", fontWeight: 600 }}
          >
            Close
          </Button>
        </DialogActions>
      </Dialog>
    </Box>
  );
};

export default BalanceParticularSearchScreen;


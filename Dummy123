function SummaryCard({meta,count,isLoading,onDownload,onView}){
 const hasCount=typeof count==='number'
 return(
  <Paper elevation={0} className={`${styles.summaryCard} ${styles[meta.role]}`}>
   <Box className={styles.summaryCardTop}>
    <Box className={styles.summaryCardIcon}>{meta.icon}</Box>
    <Typography className={styles.summaryCardLabel}>{meta.label}</Typography>
   </Box>
   <Box className={styles.summaryCardCenter}>
    <Typography className={styles.summaryCardCount}>{isLoading?'—':hasCount?count:'—'}</Typography>
    <Typography className={styles.summaryCardCaption}>{isLoading?'Checking…':'Records found'}</Typography>
   </Box>
   <Box className={styles.summaryCardActions}>
    <Button className={styles.viewDetailsButton} variant="contained" size="small" disabled={!hasCount} onClick={onView}>
     View Details
    </Button>
    <Button className={styles.summaryDownloadButton} variant="outlined" size="small" startIcon={<Download fontSize="small"/>} disabled={!hasCount||count===0} onClick={onDownload}>
     Download
    </Button>
   </Box>
  </Paper>
 )
}

export default function BranchPosition(){
 const[userDate,setUserDate]=useState(null)
 const[dataRows,setDataRows]=useState({})
 const[breakupDataRows,setBreakupDataRows]=useState({})
 const{callApi}=useApi()
 const[glifDataFilter,setGlifDataFilter]=useState({})
 const[loading,setLoading]=useState("N")
 const showSnackBar=useCustomSnackbar()
 const[mode,setMode]=useState("DD")
 const[isDialogOpen,setIsDialogOpen]=useState(false)
 const[detailsOpen,setDetailsOpen]=useState(false)
 const[detailsType,setDetailsType]=useState(null)
 const user=JSON.parse(localStorage.getItem('user'))
 const branchCode=user?.branch?.toString().padStart(5,0)

 const debouncedFetchDifference=useCallback(debounce(async()=>{
  if(mode==="DD")await fetchDifference()
 },100),[userDate,mode])

 async function fetchDifference(){
  const payload={date:userDate,branch:branchCode,paginationModel:{page:0,pageSize:100}}
  try{
   setLoading("Y")
   const res=await callApi("/ES/branch-position/get-difference",payload,"POST")
   if(res?.success)setDataRows(res.data)
   else{showSnackBar(res.message,"error");setDataRows({})}
  }catch(e){showSnackBar(e.message,"error")}
  finally{setLoading("N")}
 }

 async function fetchIndividualDifference(type,paginationModel){
  const payload={date:userDate,branch:branchCode,differenceType:type,paginationModel}
  try{
   setLoading(type)
   const res=await callApi("/ES/branch-position/get-difference",payload,"POST")
   if(res?.success)setDataRows(prev=>({...prev,[type]:res.data[type]||[]}))
   else showSnackBar(res.message,"error")
  }catch(e){showSnackBar(e.message,"error")}
  finally{setLoading("N")}
 }

 const fetchDetailedData=async(type,{cgl,currency,firstErrorDate})=>{
  const payload={branch:branchCode,cgl,currency,startDate:alterDateFormat(firstErrorDate),endDate:userDate,differenceType:type}
  try{
   const res=await callApi("/ES/branch-position/get-detailed-difference",payload,'POST')
   if(res?.success)setBreakupDataRows({type,content:res.data||[]})
   else showSnackBar(res.message,"error")
  }catch(e){showSnackBar(e.message,"error")}
 }

 const blobErrorHandler=error=>{
  if(error instanceof Blob){
   error.text().then(message=>{
    try{showSnackBar(JSON.parse(message)?.message,"error")}
    catch{showSnackBar(`Error: ${message}`,"error")}
   })
  }else showSnackBar(error.message,"error")
 }

 const exportData=async(filePref,differenceType)=>{
  const payload={branch:branchCode,date:userDate,differenceType}
  try{
   const res=await callApi("/ES/branch-position/export-difference",payload,'POST','blob','application/octet-stream')
   if(!res)throw new Error("Failed to download file!")
   downloadFile(new Blob([res]),"xlsx",`${filePref}_${branchCode}_${alterDateFormat(userDate)}`,false)
  }catch(e){blobErrorHandler(e)}
 }

 const exportDetailedData=async()=>{
  if(!breakupDataRows?.content?.length){showSnackBar("No Rows to download!","error");return}
  const first=breakupDataRows.content[0]
  const payload={branch:branchCode,cgl:first.cgl,currency:first.currency,startDate:alterDateFormat(first.firstErrorDate),endDate:userDate,differenceType:breakupDataRows.type}
  try{
   const res=await callApi("/ES/branch-position/export-detailed-difference",payload,'POST','blob','application/octet-stream')
   if(!res)throw new Error("Failed to download file!")
   downloadFile(new Blob([res]),"xlsx",`${breakupDataRows.type}_${branchCode}_${first.currency}_${first.cgl}_${alterDateFormat(userDate)}`,false)
  }catch(e){blobErrorHandler(e)}
 }

 const exportGlifData=async()=>{
  const payload={
   branch:branchCode,
   date:userDate,
   filters:[
    {field:"BRANCH_CODE",operator:"EQUALS",value:branchCode},
    {field:"TRANS_DATE",operator:"EQUALS",value:userDate},
    ...Object.entries(glifDataFilter).map(([key,entry])=>({field:key,operator:entry.operator,value:entry.value}))
   ]
  }
  try{
   const res=await callApi("/ES/branch-position/export-glif-data",payload,'POST','blob','application/octet-stream')
   if(!res)throw new Error("Failed to download file!")
   downloadFile(new Blob([res]),"xlsx",`glif_${branchCode}_${alterDateFormat(userDate)}${Object.keys(glifDataFilter).length>0?"_filtered":""}`,false)
  }catch(e){blobErrorHandler(e)}
 }

 useEffect(()=>{
  const fetchData=async()=>{
   try{
    const res=await callApi("/ES/branch-position/user-date")
    if(res?.success)setUserDate(res.data.substring(0,10))
    else showSnackBar(res.message,"error")
   }catch(e){showSnackBar(e.message,"error")}
  }
  fetchData()
  return()=>{
   setUserDate(null)
   setBreakupDataRows({})
   setDataRows({})
   setIsDialogOpen(false)
   setDetailsOpen(false)
   setGlifDataFilter({})
   setLoading("N")
   setMode("DD")
  }
 },[])

 useEffect(()=>{
  if(!userDate)return
  setBreakupDataRows({})
  debouncedFetchDifference()
 },[userDate,debouncedFetchDifference])

 useEffect(()=>{
  if(breakupDataRows?.content)setIsDialogOpen(true)
 },[breakupDataRows])

 const closeDialog=()=>{
  setBreakupDataRows({})
  setIsDialogOpen(false)
 }

 const openDetails=type=>{
  setDetailsType(type)
  setDetailsOpen(true)
 }

 const closeDetails=()=>{
  setDetailsOpen(false)
  setDetailsType(null)
 }

 const handleFilter=filter=>{
  if(!filter.multiValue){
   setGlifDataFilter(prev=>({...prev,[filter.field]:{operator:"EQUALS",value:filter.value}}))
   return
  }
  if(glifDataFilter[filter.field]){
   if(glifDataFilter[filter.field].value.length>=10){
    showSnackBar("only 10 filter values allowed!","error")
    return
   }
   if(new Set(glifDataFilter[filter.field].value).has(filter.value)){
    showSnackBar("value already present in the filter!","error")
    return
   }
   setGlifDataFilter(prev=>({...prev,[filter.field]:{operator:"IN",value:[...prev[filter.field].value,filter.value]}}))
   return
  }
  setGlifDataFilter(prev=>({...prev,[filter.field]:{operator:"IN",value:[filter.value]}}))
 }

 const deleteFilter=key=>{
  const{[key]:_,...rem}=glifDataFilter
  setGlifDataFilter(rem)
 }

 const deleteFilterValue=(key,deleteVal)=>{
  const newArray=glifDataFilter[key].value.filter(val=>val!=deleteVal)
  if(newArray.length)setGlifDataFilter(prev=>({...prev,[key]:{...prev[key],value:newArray}}))
  else deleteFilter(key)
 }

 const getFiterData=field=>glifDataFilter[field]?.value||[]
 const getCategoryCount=type=>{
  const bucket=dataRows?.[type]
  if(!bucket)return null
  if(typeof bucket?.page?.totalElements==='number')return bucket.page.totalElements
  if(Array.isArray(bucket?.content))return bucket.content.length
  return null
 }

 const activeFilterCount=Object.keys(glifDataFilter).length
 const detailsData=detailsType?dataRows?.[detailsType]||{}:{}
 const detailsMeta=detailsType?categoryMeta[detailsType]:null

 return(
  <Box className={styles.appShell}>
   <Box className={styles.sidebar}>
    <Box className={styles.sidebarBrand}>
     <Box className={styles.sidebarBrandIconWrap}>
      <Box className={styles.sidebarBrandIcon}><AccountBalanceOutlined fontSize="small"/></Box>
      <AutoAwesome className={styles.brandSparkle}/>
     </Box>
     <Typography className={styles.sidebarBrandText}>Branch Position</Typography>
    </Box>

    <Box className={styles.infoCard}>
     <Box className={styles.infoCardIcon}><AccountBalance fontSize="small"/></Box>
     <Box>
      <Typography className={styles.infoCardLabel}>Branch</Typography>
      <Typography className={styles.infoCardValue}>{branchCode}</Typography>
      <Typography className={styles.infoCardSubvalue}>{user?.branchName}</Typography>
     </Box>
    </Box>

    <Box className={styles.infoCard}>
     <Box className={styles.infoCardIcon}><Public fontSize="small"/></Box>
     <Box>
      <Typography className={styles.infoCardLabel}>Circle</Typography>
      <Typography className={styles.infoCardValue}>{user?.circleCode}</Typography>
      <Typography className={styles.infoCardSubvalue}>{user?.circleName}</Typography>
     </Box>
    </Box>

    <Box className={styles.infoCard}>
     <Box className={styles.infoCardIcon}><CalendarMonthOutlined fontSize="small"/></Box>
     <Box sx={{flexGrow:1,minWidth:0}}>
      <Typography className={styles.infoCardLabel}>Report Date</Typography>
      <LocalizationProvider dateAdapter={AdapterDayjs}>
       <DesktopDatePicker
        value={userDate?dayjs(userDate):null}
        onChange={newVal=>newVal&&setUserDate(newVal.format('YYYY-MM-DD'))}
        maxDate={dayjs()}
        format="DD-MM-YYYY"
        closeOnSelect
        slotProps={{textField:{size:'small',fullWidth:true,variant:'standard',InputProps:{disableUnderline:true,sx:{fontSize:'13px',fontWeight:600,color:'rgba(30,20,60,.85)'}}}}}
        slots={{actionBar:()=>null}}
       />
      </LocalizationProvider>
     </Box>
    </Box>

    <Tabs
     orientation="vertical"
     className={styles.navTabs}
     value={mode}
     onChange={(e,value)=>{setMode(value);setGlifDataFilter({})}}
     TabIndicatorProps={{style:{display:'none'}}}
     aria-label="branch position mode navigation"
    >
     <Tab value="DD" className={styles.navTab} icon={<AdjustOutlined fontSize="small"/>} iconPosition="start" label="Difference Data" disabled={loading!=="N"&&mode!=="DD"}/>
     <Tab value="GE" className={styles.navTab} icon={<StorageOutlined fontSize="small"/>} iconPosition="start" label="GLIF Data" disabled={loading!=="N"&&mode!=="GE"}/>
    </Tabs>

    <Box className={styles.sidebarFooter}>
     <Box className={styles.sidebarIllustration}>
      <AutoAwesome className={styles.sparkleTopRight}/>
      <AutoAwesome className={styles.sparkleBottomLeft}/>
      <AutoAwesome className={styles.sparkleMidRight}/>
      <BankIllustration/>
     </Box>
    </Box>
   </Box>

   <Box className={styles.mainContent}>
    {mode==="DD"&&(
     <>
      <Box className={styles.pageHeaderRow}>
       <Box>
        <Typography className={styles.pageHeaderTitle}>Difference data</Typography>
        <Typography className={styles.pageHeaderSubtitle}>
         Reconciliation status for {userDate?dayjs(userDate).format('DD-MM-YYYY'):'—'}
        </Typography>
       </Box>
       <AutoAwesome className={styles.headerSparkle}/>
      </Box>

      <Box className={styles.summaryRow}>
       {Object.entries(categoryMeta).map(([type,meta])=>(
        <SummaryCard
         key={type}
         meta={meta}
         count={getCategoryCount(type)}
         isLoading={loading==="Y"||loading===type}
         onView={()=>openDetails(type)}
         onDownload={()=>exportData(type,type)}
        />
       ))}
      </Box>

      <Box className={styles.infoBanner}>
       <InfoOutlined fontSize="small"/>
       <Typography className={styles.infoBannerText}>
        Select View Details to review the reconciliation records for the selected report date.
       </Typography>
      </Box>
     </>
    )}

    {mode==="GE"&&(
     <>
      <Box className={styles.pageHeaderRow}>
       <Typography className={styles.pageHeaderTitle}>GLIF data</Typography>
       <AutoAwesome className={styles.headerSparkle}/>
      </Box>
      <Typography className={styles.pageHeaderSubtitle}>Download GLIF data for your branch and selected date.</Typography>

      <Box className={styles.glifSection}>
       <Box className={styles.glifSectionHeader}>
        <Box className={styles.glifSectionIcon}><FilterAltOutlined fontSize="small"/></Box>
        <Typography className={styles.glifSectionTitle}>Add Filter</Typography>
       </Box>
       <Typography className={styles.typographyLabel} sx={{mb:1}}>Add up to 10 values per filter field.</Typography>
       <Filter handleFilter={handleFilter} getValues={getFiterData}/>
      </Box>

      <Box className={styles.glifSection}>
       <Box className={styles.glifSectionHeader} sx={{marginBottom:0}}>
        <Box className={styles.glifSectionIcon}><PlaylistAddCheckOutlined fontSize="small"/></Box>
        <Typography className={styles.glifSectionTitle}>Applied Filters ({activeFilterCount})</Typography>
        {activeFilterCount>0&&<button className={styles.clearAllLink} onClick={()=>setGlifDataFilter({})}>Clear All</button>}
       </Box>
       <Box sx={{marginTop:'14px'}}>
        {activeFilterCount===0?
         <Typography variant="caption" sx={{color:'rgba(30,20,60,.45)'}}>No filters applied yet — results will include the full branch and date.</Typography>:
         <Box className={styles.chipValues}>
          {Object.entries(glifDataFilter).map(([key,val])=>{
           const color=filterFieldColors[key]||{bg:'#F1EFE8',text:'#6B6A63'}
           const items=Array.isArray(val.value)?val.value:[val.value]
           return items.map((ent,index)=>(
            <Chip
             key={`${key}-${index}`}
             size="small"
             className={styles.filterFieldChip}
             label={`${key.replaceAll('_',' ')}: ${ent}`}
             onDelete={()=>Array.isArray(val.value)?deleteFilterValue(key,ent):deleteFilter(key)}
             deleteIcon={<Delete fontSize="small"/>}
             sx={{backgroundColor:color.bg,color:color.text}}
            />
           ))
          })}
         </Box>
        }
       </Box>
      </Box>

      <Box className={styles.glifSection}>
       <Box className={styles.glifSectionHeader}>
        <Box className={styles.glifSectionIcon}><CloudDownloadOutlined fontSize="small"/></Box>
        <Typography className={styles.glifSectionTitle}>Download GLIF Data</Typography>
       </Box>
       <Box className={styles.infoBanner} sx={{marginTop:0,marginBottom:'16px'}}>
        <InfoOutlined fontSize="small"/>
        <Typography className={styles.infoBannerText}>Download will include all GLIF data for branch {branchCode} on {userDate?dayjs(userDate).format('DD-MM-YYYY'):'—'} with the applied filters.</Typography>
       </Box>
       <Button fullWidth variant="contained" startIcon={<Download/>} onClick={exportGlifData} sx={{textTransform:'none',borderRadius:'8px',fontWeight:600,height:'44px'}}>Download GLIF Data</Button>
      </Box>
     </>
    )}
   </Box>

   <Dialog open={detailsOpen} onClose={closeDetails} fullWidth maxWidth="xl" PaperProps={{className:styles.detailsDialogPaper}}>
    <DialogTitle className={styles.detailsDialogTitle}>
     <Box>
      <Typography className={styles.detailsDialogHeading}>{detailsMeta?.label||"Difference Details"}</Typography>
      <Typography className={styles.detailsDialogSubtitle}>{detailsData?.page?.totalElements??detailsData?.content?.length??0} records found</Typography>
     </Box>
     <Box className={styles.detailsDialogActions}>
      <Button size="small" variant="contained" startIcon={<Download fontSize="small"/>} disabled={!detailsData?.content?.length} onClick={()=>exportData(detailsType,detailsType)}>Download</Button>
      <IconButton onClick={closeDetails} size="small"><Close fontSize="small"/></IconButton>
     </Box>
    </DialogTitle>
    <DialogContent className={styles.detailsDialogContent}>
     <DisplayTab
      data={detailsData}
      category={detailsMeta?.category}
      type={detailsType}
      level={1}
      hideHeader
      flat
      clickHandler={fetchDetailedData}
      downloadHandler={exportData}
      loading={loading===detailsType||loading==="Y"}
      requestData={fetchIndividualDifference}
     />
    </DialogContent>
   </Dialog>

   <Dialog className={styles.dialog} open={isDialogOpen} onClose={closeDialog} fullWidth PaperProps={{className:styles.dialogPaper}}>
    <DialogTitle className={styles.dialogTitle}>
     <Typography className={styles.typographyLabel} sx={{flexGrow:1}}>Difference break-up</Typography>
     <IconButton className={styles.dialogButton} disabled={!breakupDataRows?.content?.length} onClick={exportDetailedData} size="small" title="Download breakup"><Download fontSize="small"/></IconButton>
     <IconButton className={styles.dialogButton} onClick={closeDialog} size="small" title="Close"><Close fontSize="small"/></IconButton>
    </DialogTitle>
    <DialogContent>
     <DisplayTab data={breakupDataRows||[]} category="Difference Breakup" type={breakupDataRows?.type} level={2} closeHandler={closeDialog}/>
    </DialogContent>
   </Dialog>
  </Box>
 )
}

/**
 * ─────────────────────────────────────────────────────────────────────────
 * DESIGN CONCEPT
 * This is a "ledger" themed rework, not a copy of the reference screens.
 * Idea: reconciliation tools live and die by how fast you can spot a
 * mismatch, so the whole screen is built around ONE signature element —
 * a live "ledger tape" summary strip that reduces the result set to three
 * numbers (Matched / Mismatched / Net Difference) before the user ever
 * reads a row. Data amounts are set in a monospaced, tabular-figure font
 * throughout (like a real ledger/statement) so columns of numbers align
 * visually — regular UI text stays in a humanist sans so it doesn't feel
 * like a spreadsheet dump.
 *
 * Palette:
 *   Ink        #0F172A  (headings, primary text)
 *   Slate      #475569  (secondary text)
 *   Canvas     #F6F7FB  (page background)
 *   Card       #FFFFFF
 *   Accent     #3730A3 -> #4F46E5 (indigo, used sparingly: primary action + tape)
 *   Positive   #15803D
 *   Negative   #B91C1C
 *   Line       #E2E8F0
 * ─────────────────────────────────────────────────────────────────────────
 */

const ACCENT = "#4F46E5";
const ACCENT_DARK = "#3730A3";
const INK = "#0F172A";
const SLATE = "#475569";
const LINE = "#E2E8F0";
const POSITIVE = "#15803D";
const NEGATIVE = "#B91C1C";
const CANVAS = "#F6F7FB";

const mono = `"JetBrains Mono", "Roboto Mono", Menlo, Consolas, monospace`;
const sans = `"Inter", "Segoe UI", system-ui, sans-serif`;

// ---------------------------------------------------------------------------
// Mock data — replace with real API wiring. Shape mirrors the original
// `selectedRow` object (differenceAmount, etc.) used in the history dialog.
// ---------------------------------------------------------------------------
const CURRENCIES = ["INR", "USD", "EUR", "GBP", "AED"];

function generateMockRows(count = 18) {
  return Array.from({ length: count }).map((_, i) => {
    const diff = Math.round((Math.random() - 0.45) * 500000) / 100;
    return {
      id: `TXN-${100000 + i}`,
      glcc: `GL${(400000000000 + i * 137).toString().slice(0, 18)}`,
      branchCode: `${1000 + (i % 12)}`,
      branchName: ["Andheri", "Bandra", "Fort", "Powai", "Thane"][i % 5],
      currency: CURRENCIES[i % CURRENCIES.length],
      bookBalance: Math.round((50000 + i * 3172.4) * 100) / 100,
      systemBalance: Math.round((50000 + i * 3172.4 - diff) * 100) / 100,
      differenceAmount: diff,
      date: new Date(2026, 6, 1 + (i % 28)).toLocaleDateString("en-GB"),
      status: Math.abs(diff) < 0.01 ? "matched" : Math.abs(diff) > 2000 ? "critical" : "review",
    };
  });
}

const STATUS_META = {
  matched: { label: "Matched", color: POSITIVE, bg: "#F0FDF4" },
  review: { label: "Needs review", color: "#B45309", bg: "#FFFBEB" },
  critical: { label: "Critical", color: NEGATIVE, bg: "#FEF2F2" },
};

const DATE_PRESETS = ["Today", "Last 7 days", "This month", "Custom range"];

// ---------------------------------------------------------------------------

function FieldLabel({ icon, children }) {
  return (
    <Stack direction="row" spacing={0.75} alignItems="center" sx={{ mb: 0.75 }}>
      <Box sx={{ color: ACCENT, display: "flex" }}>{icon}</Box>
      <Typography sx={{ fontFamily: sans, fontSize: 12.5, fontWeight: 700, color: SLATE, letterSpacing: 0.2 }}>
        {children}
      </Typography>
    </Stack>
  );
}

function StatTapeCell({ label, value, tone, sub }) {
  return (
    <Box sx={{ flex: 1, px: { xs: 2, md: 3 }, py: 2 }}>
      <Typography sx={{ fontFamily: sans, fontSize: 11.5, fontWeight: 700, color: "rgba(255,255,255,0.65)", letterSpacing: 0.6, textTransform: "uppercase" }}>
        {label}
      </Typography>
      <Typography
        sx={{
          fontFamily: mono,
          fontSize: { xs: 20, md: 26 },
          fontWeight: 700,
          color: tone || "#fff",
          fontVariantNumeric: "tabular-nums",
          lineHeight: 1.3,
        }}
      >
        {value}
      </Typography>
      {sub && (
        <Typography sx={{ fontFamily: sans, fontSize: 12, color: "rgba(255,255,255,0.55)" }}>{sub}</Typography>
      )}
    </Box>
  );
}


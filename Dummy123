.navTab {
  color: #4f459b !important;
  font-weight: 500;
  text-transform: none;
  align-items: center;
  flex-direction: row;
  justify-content: flex-start;
  min-height: 35px;
  border-radius: 10px;
  padding: 8px 12px;
  border-left: 3px solid transparent;
  transition: background-color 0.15s ease, color 0.15s ease;
  gap: 10px;
  box-shadow: none !important;
  background: rgba(108, 92, 231, 0.06);
}

.navTab:hover {
  background: rgba(108, 92, 231, 0.12);
}

.navTab:global(.Mui-selected) {
  background: linear-gradient(90deg, #4f459b 0%, #9B8FEF 100%);
  color: #FFFFFF !important;
  border-left: 3px solid #4f459b;
  font-weight: 700;
  min-height: 35px;
  box-shadow: 0 3px 10px rgba(108, 92, 231, 0.3) !important;
}

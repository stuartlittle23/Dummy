{/* Pagination footer */}
<Stack direction="row" alignItems="center" justifyContent="flex-end" spacing={2} sx={{ pt: 1 }}>
  <Typography sx={{ fontSize: 12.5, color: SLATE }}>Rows per page</Typography>
  <Select
    size="small"
    variant="standard"
    value={paginationModel.pageSize}
    onChange={(e) => setPaginationModel({ page: 0, pageSize: Number(e.target.value) })}
    sx={{ fontSize: 12.5, "& .MuiOutlinedInput-notchedOutline": { border: "none" } }}
  >
    {[8, 16, 32].map((n) => (
      <MenuItem key={n} value={n}>{n}</MenuItem>
    ))}
  </Select>
  <Typography sx={{ fontSize: 12.5, color: SLATE, fontVariantNumeric: "tabular-nums" }}>
    {pageStart + 1}–{pageEnd} of {totalElements}
  </Typography>
  <Stack direction="row" spacing={0.5}>
    <IconButton size="small" disabled={paginationModel.page === 0} onClick={() => setPaginationModel((p) => ({ ...p, page: p.page - 1 }))}>
      <ChevronLeftRoundedIcon fontSize="small" />
    </IconButton>
    <IconButton size="small" disabled={pageEnd >= totalElements} onClick={() => setPaginationModel((p) => ({ ...p, page: p.page + 1 }))}>
      <ChevronRightRoundedIcon fontSize="small" />
    </IconButton>
  </Stack>
</Stack>

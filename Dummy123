
.appShell {
  display: flex;
  align-items: stretch;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 2px 24px rgba(76, 60, 150, 0.12);
  border: 1px solid rgba(108, 92, 231, 0.1);
  min-height: 78vh;
  background-color: rgba(255, 255, 255, 0.219);
  backdrop-filter: blur(12px);
}

/* ---- Sidebar ---------------------------------------------------------- */

.sidebar {
  width: 320px;
  flex-shrink: 0;
  background-color: rgba(250, 249, 254, 0.521);
  backdrop-filter: blur(10px);
  border-right: 1px solid rgba(108, 92, 231, 0.1);
  padding: 20px 16px;
  display: flex;
  flex-direction: column;
}

.sidebarBrand {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 20px;
  padding: 0 4px;
}

.sidebarBrandIconWrap {
  position: relative;
}

.sidebarBrandIcon {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background-color: #EEEDFE;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #58469F;
}

.brandSparkle {
  position: absolute;
  top: -6px;
  right: -6px;
  font-size: 13px !important;
  color: #B8AEFB;
}

.sidebarBrandText {
  font-size: 15px;
  font-weight: 600;
  color: rgba(30, 20, 60, 0.87);
}

.infoCard {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px;
  border: 1px solid rgba(108, 92, 231, 0.12);
  border-radius: 10px;
  background-color: rgba(255, 255, 255, 0.815);
  margin-bottom: 8px;
}

.infoCardIcon {
  width: 30px;
  height: 30px;
  border-radius: 8px;
  background-color: #F5F3FF;
  color: #58469F;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.infoCardLabel {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: rgba(30, 20, 60, 0.4);
  margin: 0 0 2px;
}

.infoCardValue {
  font-size: 14px;
  font-weight: 700;
  color: rgba(30, 20, 60, 0.9);
  line-height: 1.3;
}

.infoCardSubvalue {
  font-size: 12px;
  color: rgba(30, 20, 60, 0.55);
}

.dateCard {
  padding: 10px;
  border: 1px solid rgba(108, 92, 231, 0.10);
  border-radius: 10px;
  background-color: #F8F7FF;
  margin-bottom: 16px;
}

.dateCard .infoCardLabel {
  margin-bottom: 6px;
  color: #58469F;
}

.dateCard .MuiOutlinedInput-notchedOutline {
  border: none !important;
}

.dateCard .MuiOutlinedInput-root:hover .MuiOutlinedInput-notchedOutline {
  border: none !important;
}

.dateCard .MuiOutlinedInput-root.Mui-focused .MuiOutlinedInput-notchedOutline {
  border: none !important;
}

.navTabs {
  width: 100%;
  margin-top: -10px;
  margin-bottom: 20px;
  background: #f8f7ff7c;
  border-bottom: 1px solid #ddd;
}

.navTab {
  flex: 1;
  max-width: none !important;
  min-height: 56px !important;
  color: rgba(30, 20, 60, 0.55) !important;
  font-weight: 600;
  text-transform: none;
  border-radius: 0;
  padding: 8px 12px;
  background: transparent;
  border-bottom: 2px solid transparent;
  box-shadow: none !important;
}

.navTab:hover {
  background: transparent;
  color: #58469F !important;
}

.navTab:global(.Mui-selected) {
  color: #58469F !important;
  background: #ffffff73;
  border-bottom: 2px solid #58469F;
  font-weight: 700;
  box-shadow: none !important;
}

.navTab:global(.Mui-disabled) {
  opacity: 0.4;
}

.sidebarFooter {
  margin-top: auto;
  padding-top: 12px;
}

.sidebarIllustration {
  position: relative;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 12px 0 4px;
}

.sparkleTopRight {
  position: absolute;
  top: 2px;
  right: 28%;
  font-size: 15px !important;
  color: #C9BFFC;
}

.sparkleBottomLeft {
  position: absolute;
  bottom: 6px;
  left: 22%;
  font-size: 10px !important;
  color: #C9BFFC;
  opacity: 0.8;
}

.sparkleMidRight {
  position: absolute;
  top: 38%;
  right: 14%;
  font-size: 9px !important;
  color: #DCD5FE;
}

/* ---- Main content ------------------------------------------------------- */

.mainContent {
  flex: 1;
  min-width: 0;
  padding: 24px;
  background-color: rgba(253, 252, 255, 0.096);
  display: flex;
  flex-direction: column;
}

.pageHeaderRow {
  display: flex;
  align-items: center;
  gap: 6px;
}

.headerSparkle {
  font-size: 17px !important;
  color: #B8AEFB;
}

.pageHeaderTitle {
  font-size: 15px;
  font-weight: 600;
  color: rgba(20, 14, 45, 0.9);
  margin: 0 0 2px;
}

.pageHeaderSubtitle {
  font-size: 13px;
  color: rgba(30, 20, 60, 0.5);
  margin: 0 0 22px;
}

.highlightDate {
  font-weight: 700;
  color: #58469F;
}

/* ---- Summary cards ----------------------------------------------------- */

.summaryRow {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  align-items: stretch;
  flex: 1;
}

.summaryCard {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 80%;
  min-height: 320px;
  background-color: #ffffff0a;
  border: 1px solid rgba(108, 92, 231, 0.08);
  border-radius: 18px;
  padding: 18px 20px 20px;
  overflow: hidden;
  transition: box-shadow 0.2s ease, transform 0.15s ease, border-color 0.2s ease;
}

.summaryCard:hover {
  box-shadow: 0 12px 32px rgba(76, 60, 150, 0.14);
  transform: translateY(-3px);
  border-color: rgba(108, 92, 231, 0.18);
}


.summaryCard::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 4px;
  border-radius: 18px 18px 0 0;
}
.rolePurple::before { background: linear-gradient(90deg, #58469F, #9B8FEF); }
.roleTeal::before   { background: linear-gradient(90deg, #58469F, #9B8FEF); }
.roleAmber::before  { background: linear-gradient(90deg, #58469F, #9B8FEF); }

.summaryCardHeader {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}

.summaryCardIcon {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.summaryCardLabel {
  font-size: 13.5px;
  font-weight: 700;
  color: rgba(30, 20, 60, 0.85);
  line-height: 1.25;
}

.summaryCardDescription {
  font-size: 11.5px;
  line-height: 1.4;
  color: rgba(30, 20, 60, 0.5);
  margin-top: 10px;
  flex-shrink: 0;
  text-align: left;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 32px;
}

.summaryCardCenter {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 6px;
}

.summaryCardCount {
  font-size: 46px;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -0.02em;
}

.summaryCardCaption {
  font-size: 12.5px;
  font-weight: 600;
  color: rgba(30, 20, 60, 0.45);
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.summaryCardActions {
  display: flex;
  flex-direction: row;
  gap: 8px;
  flex-shrink: 0;
  margin-top: 12px;
}

.viewDetailsButton {
  width: 100%;
  height: 38px !important;
  text-transform: none !important;
  border-radius: 10px !important;
  font-weight: 600 !important;
  font-size: 13px !important;
  box-shadow: 0 4px 12px rgba(108, 92, 231, 0.28) !important;
}

.downloadButtonOutlined {
  width: 100%;
  height: 38px !important;
  text-transform: none !important;
  border-radius: 10px !important;
  font-weight: 600 !important;
  font-size: 12px !important;
  border-width: 1.5px !important;
}

.rolePurple .summaryCardIcon { background-color: #EEEDFE; color: #58469F; }

.roleTeal .summaryCardIcon { background-color: #EEEDFE; color: #58469F; }

.roleAmber .summaryCardIcon { background-color: #EEEDFE; color: #58469F; }

.infoBanner {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 12px 16px;
  border-radius: 10px;
  background-color: rgba(255, 255, 255, 0.158);
  border: 1px solid rgba(108, 92, 231, 0.15);
  margin-top: 20px;
  backdrop-filter: blur(12px);
}

.infoBannerText {
  font-size: 12.5px;
  color: rgba(30, 20, 60, 0.6);
  line-height: 1.5;
}



.glifSection {
  width: 100%;
  background-color: rgba(255, 255, 255, 0.493);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(108, 92, 231, 0.1);
  border-radius: 14px;
  padding: 18px 22px;
  margin-bottom: 14px;
  box-shadow: 0 1px 6px rgba(76, 60, 150, 0.05);
}

.glifSectionHeader {
  display: flex;
  align-items: center;
  gap: 2px;
  margin-bottom: 14px;
}

.glifSectionIcon {
  width: 32px;
  height: 32px;
  border-radius: 9px;
  background-color: #F5F3FF;
  color: #58469F;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.glifSectionTitle {
  font-size: 14px;
  font-weight: 700;
  color: rgba(30, 20, 60, 0.87);
  /* flex-grow: 1; */
}

.chipValues {
  display: flex;
  row-gap: 8px;
  column-gap: 8px;
  flex-wrap: wrap;
  align-items: center;
}

.filterFieldChip {
  font-weight: 600 !important;
}

.typographyLabel {
  font-size: 12.5px;
  color: rgba(30, 20, 60, 0.55);
}

.clearAllLink {
  font-size: 12px;
  font-weight: 600;
  color: #58469F;
  cursor: pointer;
  background: none;
  border: none;
  padding: 0;
}

.clearAllLink:hover {
  text-decoration: underline;
}

.downloadRow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 6px 4px;
}

.downloadRowText {
  font-size: 12px;
  color: rgba(30, 20, 60, 0.5);
  line-height: 1.5;
}

.downloadRowButton {
  text-transform: none !important;
  border-radius: 8px !important;
  font-weight: 600 !important;
  flex-shrink: 0;
  box-shadow: 0 2px 8px rgba(108, 92, 231, 0.25) !important;
}

/* ---- Details dialog ---------------------------------------------------- */

.dialogPaper {
  border-radius: 16px;
  max-height: 65vh;
  width: 80vw;
  max-width: 1400px !important;
  box-shadow: 0 12px 48px rgba(76, 60, 150, 0.2);
}

.dialogTitle {
  display: flex;
  align-items: center;
  gap: 4px;
  font-weight: 600;
  border-bottom: 1px solid rgba(108, 92, 231, 0.1);
}

.dialogTitleText {
  font-size: 15px;
  font-weight: 700;
  color: rgba(30, 20, 60, 0.87);
  flex-grow: 1;
}

.dialogButton {
  flex-grow: 0;
  margin: 4px;
}

/* ---- Empty-state box inside the grid ---------------------------------- */

.emptyStateBox {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 32px 16px;
  width: calc(100% - 32px);
  margin: 8px 16px;
  border: 1px dashed rgba(108, 92, 231, 0.25);
  border-radius: 12px;
  background-color: #FBFAFF;
}

.bankIllustration {
  position: relative;
  width: 100%;
  height: 150px;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  overflow: hidden;
  transform: translateY(-50px);
}

.bankGlow {
  width: 150px;
  height: 150px;
  border-radius: 50% 50% 0 0;
  background: radial-gradient(circle, rgba(108,92,231,0.22) 0%, rgba(108,92,231,0.08) 50%, transparent 72%);
  display: flex;
  justify-content: center;
  align-items: center;
}

.bankIcon {
  font-size: 62px !important;
  color: #58469F;
  opacity: 0.8;
}

.bankSparkle1 {
  position: absolute;
  top: 20px;
  left: 22%;
  color: #B8AEFB;
  font-size: 16px !important;
}

.bankSparkle2 {
  position: absolute;
  top: 42px;
  right: 20%;
  color: #C9BFFC;
  font-size: 12px !important;
}

.bankSparkle3 {
  position: absolute;
  top: 75px;
  left: 30%;
  color: #DCD5FE;
  font-size: 9px !important;
}

.summaryCardDescription {
  font-size: 12px;
  line-height: 1.4;
  color: rgba(30, 20, 60, 0.55);
  margin-top: 10px;
  padding: 0 4px;
  text-align: left;
}


.searchResetRow {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-top: 10px;
  width: 100%;
}

.searchResetRow button {
  flex:1;
  min-height: 35px;
}

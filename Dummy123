const [highValueData, setHighValueData] = useState([]);
const [highValueLoading, setHighValueLoading] = useState(false);
const [highValueDetailsOpen, setHighValueDetailsOpen] = useState(false);




const fetchHighValueTransactions = async () => {
  const payload = {
    branch: effectiveBranchCode,
    date: userDate,
    filters: [
      { field: "BRANCH_CODE", operator: "EQUALS", value: effectiveBranchCode },
      { field: "TRANS_DATE", operator: "EQUALS", value: userDate }
    ]
  };

  try {
    setHighValueLoading(true);

    const res = await callApi(
      "/ES/branch-position/get-high-value-transactions",
      payload,
      "POST"
    );

    if (res?.success) {
      setHighValueData(res.data || []);
    } else {
      setHighValueData([]);
      showSnackBar(res?.message || "No data found.", "error");
    }
  } catch (e) {
    setHighValueData([]);
    showSnackBar(e.message, "error");
  } finally {
    setHighValueLoading(false);
  }
};



useEffect(() => {
  if (userDate == null) {
    return;
  }

  setBreakupDataRows({});
  debouncedFetchDifference();
  fetchHighValueTransactions();
}, [userDate, effectiveBranchCode, debouncedFetchDifference]);





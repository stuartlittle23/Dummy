onInputChange={(event, newInputValue, reason) => {
  // CRITICAL FIX: Stops the dropdown from closing and collapsing on option select/clicks
  if (reason === "reset" || reason === "blur") return;

  if (newInputValue.length > 30) return;

  setBranchSearch(newInputValue);

  if (newInputValue.length >= 3) {
    fetchSearchData("branch", newInputValue);
  } else if (newInputValue.length === 0) {
    // Only wipe out the data options if the user manually cleared/backspaced the text out
    setBranches([]);
  }
}}




onInputChange={(event, newInputValue, reason) => {
  // CRITICAL FIX: Stops the dropdown from closing and collapsing on option select/clicks
  if (reason === "reset" || reason === "blur") return;

  if (newInputValue.length > 30) return;

  setCglSearch(newInputValue);

  if (reason === "input" && newInputValue.length >= 3) {
    fetchSearchData("cgl", newInputValue);
  }

  if (newInputValue.length === 0) {
    // Only wipe out the data options if the user manually cleared/backspaced the text out
    setCgls(["All CGLs"]);
  }
}}

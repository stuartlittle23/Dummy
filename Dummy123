import React, { useState, useCallback, useEffect } from "react";
import {
  Box,
  Paper,
  Typography,
  IconButton,
  Grid,
  Card,
  CardContent,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  InputAdornment,
  Breadcrumbs,
  Link,
  Chip,
  Button,
  Divider,
  Tooltip,
  TextField,
  Avatar,
  Stack,
  GlobalStyles,
} from "@mui/material";
import { DataGrid } from "@mui/x-data-grid";
import HistoryIcon from "@mui/icons-material/History";
import CloseIcon from "@mui/icons-material/Close";
import SearchIcon from "@mui/icons-material/Search";
import NavigateNextIcon from "@mui/icons-material/NavigateNext";
import AccountBalanceWalletIcon from "@mui/icons-material/AccountBalanceWallet";
import RefreshIcon from "@mui/icons-material/Refresh";
import FilterListIcon from "@mui/icons-material/FilterList";
import useApi from "../../hooks/useApi";
import useValidation from "./Validation";
import dayjs from "dayjs";
import { LocalizationProvider, DatePicker } from "@mui/x-date-pickers";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";

const BalanceParticularSearchScreen = () => {
  const { callApi } = useApi();
  const { validateBranchCode, validateCurrency, validateCGL } = useValidation();

  const [filters, setFilters] = useState({
    date: "",
    branchCode: "",
    currency: "",
    cgl: "",
  });

  const [rows, setRows] = useState([]);
  const [loading, setLoading] = useState(false);
  const [totalElements, setTotalElements] = useState(0);
  const [etlDate, setEtlDate] = useState(null);

  const [paginationModel, setPaginationModel] = useState({
    page: 0,
    pageSize: 10,
  });

  const [openHistory, setOpenHistory] = useState(false);
  const [selectedRow, setSelectedRow] = useState(null);

  const updateFilter = (key, value) =>
    setFilters((prev) => ({ ...prev, [key]: value }));

  // ETL Date Fetching
  useEffect(() => {
    const fetchDefaultETLDate = async () => {
      try {
        const response = await callApi("/PS/file/fincore-date", {}, "GET");
        const dateVal = response?.data?.etlDate || response?.date || "";
        if (dateVal) {
          setEtlDate(dateVal);
          updateFilter("date", dateVal);
          fetchData(dateVal, 0, paginationModel.pageSize);
        }
      } catch (err) {
        console.error("ETL Date Error:", err);
      }
    };
    fetchDefaultETLDate();
  }, []);

  // Main Search API Call
  const fetchData = useCallback(
    async (date, pageIndex, pageSize) => {
      if (!date) return;
      setLoading(true);
      try {
        const payload = {
          fromDate: date,
          toDate: date,
          branchCode: filters.branchCode || null,
          currency: filters.currency || null,
          cgl: filters.cgl || null,
        };

        const response = await callApi(
          `/ES/differences/search?page=${pageIndex}&size=${pageSize}`,
          payload,
          "POST"
        );

        const content = response?.data?.content || response?.content || [];
        const mappedRows = content.map((item, index) => ({
          id: item.id || `row-${pageIndex}-${index}`,
          ...item,
          GLCC_VAL: `${item.branchCode || ""} / ${item.currency || ""} / ${item.cgl || ""}`,
        }));

        setRows(mappedRows);
        setTotalElements(
          response?.data?.totalElements || response?.totalElements || 0
        );
      } catch (err) {
        console.error("Search Fail:", err);
        setRows([]);
      } finally {
        setLoading(false);
      }
    },
    [filters, callApi]
  );

  useEffect(() => {
    if (filters.date) {
      fetchData(filters.date, paginationModel.page, paginationModel.pageSize);
    }
  }, [paginationModel.page, paginationModel.pageSize]);

  // Input Field Custom Styling for smooth rounded borders
  const customInputStyles = {
    "& .MuiOutlinedInput-root": {
      borderRadius: "24px",
      backgroundColor: "#ffffff",
      fontSize: "0.875rem",
      boxShadow: "0px 2px 4px rgba(0, 0, 0, 0.02)",
      transition: "all 0.2s ease-in-out",
      "& fieldset": {
        borderColor: "#e2e8f0",
      },
      "&:hover fieldset": {
        borderColor: "#cbd5e1",
      },
      "&.Mui-focused fieldset": {
        borderColor: "#818cf8",
        borderWidth: "1.5px",
      },
    },
    "& .MuiInputLabel-root": {
      fontSize: "0.85rem",
      color: "#64748b",
    },
  };

  // Table Columns Definition
  const columns = [
    {
      field: "reconRunDate",
      headerName: "ERROR DATE",
      flex: 1,
      minWidth: 120,
      renderCell: (params) => (
        <Typography variant="body2" sx={{ fontWeight: 500, color: "#334155" }}>
          {params.value || "-"}
        </Typography>
      ),
    },
    {
      field: "GLCC_VAL",
      headerName: "GLCC DETAILS",
      flex: 1.5,
      minWidth: 200,
      renderCell: (params) => (
        <Chip
          label={params.value}
          size="small"
          sx={{
            fontWeight: 600,
            fontSize: "0.75rem",
            backgroundColor: "#f1f5f9",
            color: "#475569",
            border: "1px solid #e2e8f0",
          }}
        />
      ),
    },
    {
      field: "cbsBalance",
      headerName: "CBS BALANCE",
      flex: 1,
      minWidth: 130,
      align: "right",
      headerAlign: "right",
      renderCell: (params) => (
        <Typography variant="body2" sx={{ fontFamily: "monospace", fontWeight: 600 }}>
          {params.value != null ? Number(params.value).toLocaleString() : "0.00"}
        </Typography>
      ),
    },
    {
      field: "glBalance",
      headerName: "GL BALANCE",
      flex: 1,
      minWidth: 130,
      align: "right",
      headerAlign: "right",
      renderCell: (params) => (
        <Typography variant="body2" sx={{ fontFamily: "monospace", fontWeight: 600 }}>
          {params.value != null ? Number(params.value).toLocaleString() : "0.00"}
        </Typography>
      ),
    },
    {
      field: "differenceAmount",
      headerName: "DIFFERENCE",
      flex: 1.2,
      minWidth: 150,
      align: "right",
      headerAlign: "right",
      renderCell: (params) => {
        const val = params.value || 0;
        const isNegative = val < 0;
        return (
          <Chip
            label={Number(val).toLocaleString()}
            size="small"
            sx={{
              fontWeight: 700,
              backgroundColor: isNegative ? "#fef2f2" : "#f0fdf4",
              color: isNegative ? "#dc2626" : "#16a34a",
              border: `1px solid ${isNegative ? "#fecaca" : "#bbf7d0"}`,
              fontFamily: "monospace",
              px: 1,
            }}
          />
        );
      },
    },
    {
      field: "action",
      headerName: "ACTION",
      width: 90,
      sortable: false,
      align: "center",
      headerAlign: "center",
      renderCell: (params) => (
        <Tooltip title="View Details">
          <IconButton
            size="small"
            sx={{
              color: "#6366f1",
              backgroundColor: "#eef2ff",
              "&:hover": { backgroundColor: "#e0e7ff" },
            }}
            onClick={() => {
              setSelectedRow(params.row);
              setOpenHistory(true);
            }}
          >
            <HistoryIcon fontSize="small" />
          </IconButton>
        </Tooltip>
      ),
    },
  ];

  return (
    <Box
      sx={{
        width: "100%",
        minHeight: "100vh",
        background: "linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%)",
        p: { xs: 2, md: 3 },
      }}
    >
      <GlobalStyles
        styles={{
          body: { backgroundColor: "#f8fafc" },
        }}
      />

      {/* TOP HEADER & BREADCRUMBS BAR */}

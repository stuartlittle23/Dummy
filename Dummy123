.navTabs {
  width: 100%;
  margin-bottom: 20px;
  background: rgba(108, 92, 231, 0.06);
  border-radius: 12px;
  padding: 4px;
  min-height: 48px;
}




.navTab {
  flex: 1;
  max-width: none !important;
  min-height: 44px !important;
  color: #4f459b !important;
  font-weight: 600;
  text-transform: none;
  border-radius: 9px;
  padding: 8px 12px;
  gap: 8px;
  box-shadow: none !important;
  background: transparent;
}

.navTab:hover {
  background: rgba(108, 92, 231, 0.08);
}

.navTab:global(.Mui-selected) {
  background: linear-gradient(90deg, #4f459b 0%, #9B8FEF 100%);
  color: #FFFFFF !important;
  font-weight: 700;
  box-shadow: 0 3px 10px rgba(108, 92, 231, 0.25) !important;
}

.navTab:global(.Mui-disabled) {
  opacity: 0.4;
}

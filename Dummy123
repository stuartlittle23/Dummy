{filterField === "CURRENCY" &&
    <Autocomplete
        options={values || []}
        value={values.find((v) => v.currencyCode === inputInstance) || null}
        size="small"
        getOptionLabel={(option) => option ? `${option.currencyCode} (${option.currencyName})` : ''}
        isOptionEqualToValue={(option, value) => option.currencyCode === value?.currencyCode}
        onInputChange={(event, value, reason) => {
            setInputInstance('')
        }}
        renderInput={(params) => <TextField {...params} label="Currency" error={!!fieldError} helperText={fieldError} />}
        filterOptions={(options, { inputValue }) => {
            return options.filter((val) =>
                (val.currencyCode.startsWith(inputValue.toUpperCase()) || val.currencyName.toUpperCase().includes(inputValue.toUpperCase()))
                && !getValues("CURRENCY")?.includes(val.currencyCode)
            )
        }}
        onChange={(e, v, r) => {
            setFieldError(null);
            if (r === "selectOption") {
                setInputInstance(v.currencyCode);
            } else if (r === "clear") {
                setInputInstance('')
            }
        }}
        noOptionsText={"No Options"}
    />
}

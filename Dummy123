import org.springframework.format.annotation.DateTimeFormat;

import java.time.LocalDate;
import java.util.Map;

@Getter
public class BranchPosDifferenceReqDTO {
    @NotNull
    @Pattern(regexp = "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$")
    private String date;

    @NotNull
    @Size(max = 5,min=5)
    private String branch;

    private  DifferenceType differenceType;
    private  Map<String,Integer> paginationModel;
    @JsonCreator
    public BranchPosDifferenceReqDTO(
        @JsonProperty(value = "date",required = true) String date,
        @JsonProperty (value = "branch",required = true) String branch,
        @JsonProperty(value = "differenceType",required = false) DifferenceType differenceType,
        @JsonProperty(value = "paginationModel",required=false) Map<String,Integer> paginationModel
    ){
      this.date=date;
      this.branch=branch;
      this.differenceType=differenceType;
      this.paginationModel=paginationModel;
    }
}





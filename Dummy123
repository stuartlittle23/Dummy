package com.fincore.enquiry_service.specification;

import jakarta.persistence.criteria.Expression;
import jakarta.persistence.criteria.Path;
import jakarta.persistence.criteria.Predicate;
import jakarta.persistence.criteria.Root;
import org.springframework.data.jpa.domain.Specification;

import com.fincore.enquiry_service.dto.GetPayloadDTO;
import com.fincore.enquiry_service.dto.GridFilter;
import com.fincore.enquiry_service.model.GlTransactions;

import java.sql.Timestamp;
import java.text.SimpleDateFormat;
import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.util.ArrayList;
import java.util.Date;
import java.util.List;

public class TransactionEnquirySpecification {

    public static Specification<GlTransactions> build(GetPayloadDTO dto) {

        return (root, query, cb) -> {

            List<Predicate> predicates = new ArrayList<>();

            String branch = dto.getBranch().split("-")[0];

            DateTimeFormatter formatter = DateTimeFormatter.ofPattern("dd/MM/yyyy");

            LocalDate fromDate = LocalDate.parse(dto.getFromDate(), formatter);

            LocalDate toDate = LocalDate.parse(dto.getToDate(), formatter);

            /* BRANCH */
            predicates.add(
                    cb.equal(
                            root.get("branchCode"),
                            branch));

            /* CURRENCY */
            predicates.add(
                    cb.equal(
                            root.get("currency"),
                            dto.getCurrency()));

            /* CGL */
            predicates.add(
                    cb.equal(
                            root.get("cgl"),
                            dto.getCgl()));

            /* DATE RANGE */
            predicates.add(
                    cb.between(
                            root.get("transactionDate"),
                            fromDate,
                            toDate));

            /* SOURCE FLAGS */
            if (dto.getSourceFlags() != null
                    && !dto.getSourceFlags().isEmpty()
                    && !dto.getSourceFlags().contains("ALL")) {

                predicates.add(
                        root.get("sourceFlag")
                                .in(dto.getSourceFlags()));
            }

            /* MIN AMOUNT */
            if (dto.getMinAmount() != null) {

                predicates.add(
                        cb.or(
                                cb.greaterThanOrEqualTo(
                                        root.get("debitAmount"),
                                        dto.getMinAmount()),
                                cb.greaterThanOrEqualTo(
                                        root.get("creditAmount"),
                                        dto.getMinAmount())));
            }

            /* MAX AMOUNT */
            if (dto.getMaxAmount() != null) {

                predicates.add(
                        cb.or(
                                cb.lessThanOrEqualTo(
                                        root.get("debitAmount"),
                                        dto.getMaxAmount()),
                                cb.lessThanOrEqualTo(
                                        root.get("creditAmount"),
                                        dto.getMaxAmount())));
            }

            /* GRID FILTERS */
            if (dto.getGridFilters() != null
                    && !dto.getGridFilters().isEmpty()) {

                for (GridFilter filter : dto.getGridFilters()) {

                    if (filter.getField() == null
                            || filter.getOperator() == null
                            || filter.getValue() == null) {
                        continue;
                    }

                    String field = filter.getField();
                    String operator = filter.getOperator();

                    Path<?> path = getPath(root, field);

                    /* DATE FILTERS */
                    if (path.getJavaType().equals(Date.class)
                            || path.getJavaType().equals(Timestamp.class)
                            || path.getJavaType().equals(LocalDate.class)) {

                        Date filterDate = parseDate(filter.getValue().toString());

                        Expression<Date> truncDate = cb.function(
                                "TRUNC",
                                Date.class,
                                path);

                        switch (operator) {

                            case "equals" -> predicates.add(
                                    cb.equal(
                                            truncDate,
                                            filterDate));

                            case "after" -> predicates.add(
                                    cb.greaterThan(
                                            truncDate,
                                            filterDate));

                            case "onOrAfter" -> predicates.add(
                                    cb.greaterThanOrEqualTo(
                                            truncDate,
                                            filterDate));

                            case "before" -> predicates.add(
                                    cb.lessThan(
                                            truncDate,
                                            filterDate));

                            case "onOrBefore" -> predicates.add(
                                    cb.lessThanOrEqualTo(
                                            truncDate,
                                            filterDate));
                        }

                        continue;
                    }

                    if (path.getJavaType().equals(Double.class)) {

                        Double numberValue = Double.valueOf(filter.getValue().toString());

                        Expression<Double> numberPath = path.as(Double.class);

                        switch (operator) {

                            case "=", "equals", "is" -> predicates.add(
                                    cb.equal(
                                            numberPath,
                                            numberValue));

                            case "!=", "not" -> predicates.add(
                                    cb.notEqual(
                                            numberPath,
                                            numberValue));

                            case ">" -> predicates.add(
                                    cb.greaterThan(
                                            numberPath,
                                            numberValue));

                            case ">=" -> predicates.add(
                                    cb.greaterThanOrEqualTo(
                                            numberPath,
                                            numberValue));

                            case "<" -> predicates.add(
                                    cb.lessThan(
                                            numberPath,
                                            numberValue));

                            case "<=" -> predicates.add(
                                    cb.lessThanOrEqualTo(
                                            numberPath,
                                            numberValue));

                            case "isEmpty" -> predicates.add(
                                    cb.isNull(path));

                            case "isNotEmpty" -> predicates.add(
                                    cb.isNotNull(path));
                        }

                        continue;
                    }

                    /* STRING FILTERS */
                    Expression<String> expression = cb.lower(
                            path.as(String.class));

                    String value = filter.getValue()
                            .toString()
                            .toLowerCase();

                    switch (operator) {

                        case "contains" -> predicates.add(
                                cb.like(
                                        expression,
                                        "%" + value + "%"));

                        case "startsWith" -> predicates.add(
                                cb.like(
                                        expression,
                                        value + "%"));

                        case "endsWith" -> predicates.add(
                                cb.like(
                                        expression,
                                        "%" + value));

                        case "equals", "is", "=" -> predicates.add(
                                cb.equal(
                                        expression,
                                        value));

                        case "not" -> predicates.add(
                                cb.notEqual(
                                        expression,
                                        value));

                        case "isAnyOf" -> {

                            if (filter.getValue() instanceof List<?> values) {

                                List<String> lowerValues = values.stream()
                                        .map(Object::toString)
                                        .map(String::toLowerCase)
                                        .toList();

                                predicates.add(
                                        expression.in(lowerValues));

                            } else {

                                predicates.add(
                                        cb.equal(
                                                expression,
                                                filter.getValue()
                                                        .toString()
                                                        .toLowerCase()));
                            }
                        }

                        case "isEmpty" -> predicates.add(
                                cb.or(
                                        cb.isNull(path),
                                        cb.equal(expression, "")));

                        case "isNotEmpty" -> predicates.add(
                                cb.and(
                                        cb.isNotNull(path),
                                        cb.notEqual(expression, "")));
                    }
                }
            }

            return cb.and(
                    predicates.toArray(
                            new Predicate[0]));
        };
    }

    // =========================================================
    // NEW: 3-Level Offset Calculation Specification
    // =========================================================
    @SuppressWarnings({"rawtypes", "unchecked"})
    public static Specification<GlTransactions> strictlyBefore(
            Object targetDate,
            Object targetPostDate,
            Object targetId,
            String sortOrder) {

        return (root, query, cb) -> {
            boolean isDesc = "DESC".equalsIgnoreCase(sortOrder);

            // --- LEVEL 1: Transaction Date ---
            Predicate dateBefore = isDesc ?
                    cb.greaterThan(root.get("transactionDate"), (Comparable) targetDate) :
                    cb.lessThan(root.get("transactionDate"), (Comparable) targetDate);

            Predicate dateEqual = cb.equal(root.get("transactionDate"), targetDate);

            // --- LEVEL 2: Post Date ---
            Predicate postDateBefore = isDesc ?
                    cb.greaterThan(root.get("postDate"), (Comparable) targetPostDate) :
                    cb.lessThan(root.get("postDate"), (Comparable) targetPostDate);

            Predicate postDateEqual = cb.equal(root.get("postDate"), targetPostDate);

            // --- LEVEL 3: Transaction ID ---
            Predicate idBefore = isDesc ?
                    cb.greaterThan(root.get("transactionId").as(String.class), targetId.toString()) :
                    cb.lessThan(root.get("transactionId").as(String.class), targetId.toString());

            // --- COMBINE LOGIC ---
            // 1. Date is strictly before OR
            // 2. Date is same AND Post Date is strictly before OR
            // 3. Date is same AND Post Date is same AND ID is strictly before
            return cb.or(
                    dateBefore,
                    cb.and(dateEqual, postDateBefore),
                    cb.and(dateEqual, postDateEqual, idBefore)
            );
        };
    }

    private static Path<?> getPath(
            Root<GlTransactions> root,
            String field) {

        return switch (field) {

            case "date" -> root.get("transactionDate");

            case "journalNumber" -> root.get("journalId");

            case "batchId" -> root.get("batchId");

            case "sourceFlag" -> root.get("sourceFlag");

            case "particulars" -> root.get("narration");

            case "postDate" -> root.get("postDate");

            default -> root.get(field);
        };
    }

    private static Date parseDate(String date) {

        try {

            return new SimpleDateFormat(
                    "yyyy-MM-dd").parse(date);

        } catch (Exception e) {

            try {

                return new SimpleDateFormat(
                        "dd/MM/yyyy").parse(date);

            } catch (Exception ex) {

                throw new RuntimeException(
                        "Invalid date format : " + date);
            }
        }
    }
}

{isBranchVisible && (
                      <Grid size={{ xs: 12, sm: isCircleVisible ? 6 : 12 }}>
                        <Autocomplete
                          multiple
                          size="small"
                          disableCloseOnSelect
                          options={["All Branches", ...branches]}
                          loading={loading.branch}
                          value={filters.branches}
                          inputValue={branchSearch}
                          onInputChange={(event, newInputValue) => {
                            if (newInputValue.length > 30) return;

                            setBranchSearch(newInputValue);

                            if (newInputValue.length >= 3) {
                              fetchSearchData("branch", newInputValue);
                            } else {
                              setBranches([]);
                            }
                          }}
                          onChange={(_, val) => {
                            handleBranchChange(val);
                            setBranchSearch("");
                          }}
                          renderTags={() => null}
                          renderOption={(props, option, { selected }) => (
                            <li {...props} key={option}>
                              <Checkbox
                                size="small"
                                style={{ marginRight: 8 }}
                                checked={selected}
                              />
                              <Typography variant="body2">{option}</Typography>
                            </li>
                          )}
                          renderInput={(p) => (
                            <TextField
                              {...p}
                              label="Select Branches"
                              variant="standard"
                              required
                              placeholder={"Enter atleast 3 digits..."}
                              InputProps={{
                                ...p.InputProps,
                                maxLength: 30,
                                endAdornment: (
                                  <InputAdornment
                                    position="end"
                                    sx={{ mb: 0.5 }}
                                  >
                                    <Stack
                                      direction="row"
                                      alignItems="center"
                                      spacing={1}
                                    >
                                      <CustomChip
                                        label={
                                          filters.branches.includes("All Branches")
                                            ? "All Branches"
                                            : `${filters.branches.length} Selected`
                                        }
                                        color={
                                          filters.branches.includes("All Branches")
                                            ? "default"
                                            : "primary"
                                        }
                                        sx={{
                                          fontWeight: 700,
                                          fontSize: "0.7rem",
                                        }}
                                      />
                                      {!filters.branches.includes("All Branches") &&
                                        filters.branches.length > 0 && (
                                          <IconButton
                                            size="small"
                                            onClick={() =>
                                              setViewList(
                                                viewList === "branches"
                                                  ? null
                                                  : "branches",
                                              )
                                            }
                                            color={
                                              viewList === "branches"
                                                ? "primary"
                                                : "default"
                                            }
                                            sx={{
                                              transition: "0.2s",
                                              bgcolor: viewList
                                                ? "rgba(25, 118, 210, 0.08)"
                                                : "transparent",
                                            }}
                                          >
                                            {viewList === "branches" ? (
                                              <VisibilityOffIcon fontSize="small" />
                                            ) : (
                                              <VisibilityIcon fontSize="small" />
                                            )}
                                          </IconButton>
                                        )}
                                    </Stack>
                                    {p.InputProps.endAdornment}
                                  </InputAdornment>
                                ),
                              }}
                            />
                          )}
                        />
                      </Grid>
                    )}
                  </Grid>
                </Paper>
              </Grid>
            )}

            {/* 2. ACCOUNT ZONE */}
            <Grid
              size={{ xs: 12, md: !isBranchUser && !(isCircleUser && filters.enquiryType ==="CONSOLIDATED")?6:12,}}
            >
              <Paper
                variant="outlined"
                sx={{
                  p: 3,
                  borderRadius: "20px",
                  bgcolor: "rgba(0,0,0,0.01)",
                  borderStyle: "dashed",
                }}
              >
                <SectionHeader
                  icon={<SearchIcon fontSize="small" />}
                  title="Account Details"
                />
                <Grid container spacing={2}>
                  <Grid size={{ xs: 12, sm: 7 }}>
                    <Autocomplete
                      multiple
                      autoHighlight
                      disableCloseOnSelect
                      renderTags={() => null}
                      limitTags={0}
                      value={filters.cgl}
                      options={[
                        "All CGLs",
                        ...cgls.filter((c) => c !== "All CGLs"),
                      ]}
                      clearIcon={filters.cgl ? undefined : null}
                      noOptionsText={
                        filters.enquiryType !== "CONSOLIDATED" &&
                        (!filters.cgl || filters.cgl.length < 3)
                          ? "Please enter at least 3 characters"
                          : "No Options"
                      }
                     onInputChange={(event, newInputValue, reason) => {
  if (newInputValue.length > 30) return;

  if (reason === "input" && newInputValue.length >= 3) {
    fetchSearchData("cgl", newInputValue);
  }

  if (reason === "clear" || reason === "blur") {
    setCgls([]);
  }
}}
                      onChange={(_, v) => handleCglChange(v)}
                      renderOption={(props, option, { selected }) => (
                        <li {...props}>
                          <Checkbox checked={selected} />
                          {option}
                        </li>
                      )}
                      renderInput={(params) => (
                        <TextField
                          {...params}
                          variant="standard"
                          label="CGL *"
                          placeholder={"Enter atleast 3 characters..."}
                          InputProps={{
                            ...params.InputProps,
                            startAdornment: null,
                            endAdornment: (
                              <>
                                {filters.cgl.length > 0 && (
                                  <>
                                    <CustomChip
                                      label={
                                        filters.cgl.includes("All CGLs")
                                          ? "All CGLs"
                                          : `${filters.cgl.length} Selected`
                                      }
                                      color={
                                        filters.cgl.includes("All CGLs")
                                          ? "default"
                                          : "primary"
                                      }
                                    />
                                    {!filters.cgl.includes("All CGLs") &&
                                      filters.cgl.length > 0 && (
                                        <IconButton
                                          size="small"
                                          onClick={() =>
                                            setViewList(
                                              viewList === "cgl" ? null : "cgl",
                                            )
                                          }
                                        >
                                          {viewList === "cgl" ? (
                                            <VisibilityOffIcon fontSize="small" />
                                          ) : (
                                            <VisibilityIcon fontSize="small" />
                                          )}
                                        </IconButton>
                                      )}
                                  </>
                                )}
                                {params.InputProps.endAdornment}
                              </>
                            ),
                          }}
                        />
                      )}
                      loadingText="Searching Cgls..."
                    />
                  </Grid>

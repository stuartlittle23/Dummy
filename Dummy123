const handleReset = () => {
  // Clear Circle only when editable
  if (hasWholeBank) {
    setSelectedCircle(null);
    setCircleInput('');
  }

  // Clear Branch only when editable
  if (!isBranchUser) {
    setSelectedBranch(null);
    setBranchInput('');
    setBranchOptions([]);
  }

  // Clear Report Date
  setUserDate(null);

  // Clear results and filters
  setGlifDataFilter({});
  setReportDateError(null);
  setDataRows({});
  setBreakupDataRows({});
  setSelectedGlcc('');
};

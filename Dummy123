onInputChange={(event, newInputValue, reason) => {
  // 1. ADD THIS BLOCK: If the reason is clear/reset, wipe the text state clean
  if (reason === "clear" || reason === "reset" || !newInputValue) {
    setHeadInputValue("");
    return;
  }

  // 2. Keep the rest of your original code exactly the same below it:
  if (reason === "reset") return;

  const filteredValue = newInputValue.replace(/[^a-zA-Z0-9 ]/g, "");

  if (filteredValue !== headInputValue) {
    setHeadInputValue(filteredValue);
  }
}}

{/* START DATE */}
<LocalizationProvider dateAdapter={AdapterDayjs}>
  <StyledFormBox sx={{ flex: 1 }}>
    <DatePicker
      value={userInputs?.fromDate || null}
      onChange={(v) => {
        update("fromDate", v);

        // Clear End Date if invalid
        if (
          userInputs?.toDate &&
          dayjs(userInputs.toDate).isBefore(v)
        ) {
          update("toDate", null);
        }
      }}
      format="DD-MM-YYYY"
      minDate={dayjs("2026-03-31")}
      maxDate={etlDate}
      slotProps={{
        textField: {
          label: "Start Date*",
          fullWidth: true,
          InputLabelProps: { shrink: true },
          readOnly: true,
          sx: {
            "& .MuiInputLabel-root": {
              fontWeight: 500,
            },
            "& .MuiInputBase-input": {
              caretColor: "transparent",
            },
          },
        },
      }}
    />
  </StyledFormBox>

  {/* END DATE */}
  <StyledFormBox sx={{ flex: 1 }}>
    <DatePicker
      value={userInputs?.toDate || null}
      onChange={(v) => update("toDate", v)}
      format="DD-MM-YYYY"
      disabled={!userInputs?.fromDate}
      minDate={
        userInputs?.fromDate
          ? dayjs(userInputs.fromDate)
          : dayjs("2026-03-31")
      }
      maxDate={etlDate}
      slotProps={{
        textField: {
          label: "End Date*",
          fullWidth: true,
          InputLabelProps: { shrink: true },
          readOnly: true,
          sx: {
            "& .MuiInputLabel-root": {
              fontWeight: 500,
            },
            "& .MuiInputBase-input": {
              caretColor: "transparent",
            },
          },
        },
      }}
    />
  </StyledFormBox>
</LocalizationProvider>

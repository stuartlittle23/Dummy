// Pre-parse the reportDate string into a valid dayjs instance or null
const parsedDatePickerValue = reportDate ? dayjs(reportDate) : null;


<LocalizationProvider dateAdapter={AdapterDayjs}>
  <DatePicker
    label="Report Date"
    // Use the explicit safely parsed object or null
    value={parsedDatePickerValue} 
    format="YYYY-MM-DD"
    minDate={minLimit}
    maxDate={etlDate || dayjs()}
    views={["year", "month", "day"]}
    disabled={!reportCode || isApplying}
    onChange={(newValue) => {
      // MUI sends a dayjs instance here if valid
      if (newValue && dayjs.isDayjs(newValue) && newValue.isValid()) {
        let correctedValue = newValue;
        
        // Handle manual typed inputs for 2-digit years (e.g. 26 -> 2026)
        if (correctedValue.year() < 100) {
          correctedValue = correctedValue.set("year", correctedValue.year() + 2000);
        }
        setReportDate(correctedValue.format("YYYY-MM-DD"));
      } else {
        setReportDate("");
      }
    }}
    onError={(error) => {
      setBalanceDateError(error || null);
    }}
    slotProps={{
      textField: {
        size: "small",
        fullWidth: true,
        placeholder: "YYYY-MM-DD",
        error: !!balanceDateError,
        sx: {
          bgcolor: "white",
          borderRadius: 1,
        },
        helperText: (
          <span
            style={{
              fontStyle: "italic",
              fontSize: "0.75rem",
              display: "flex",
              alignItems: "center",
              gap: "4px",
              marginTop: "4px",
            }}
          >
            <InfoIcon sx={{ fontSize: "0.625rem" }} />
            Please select a date to initiate drill-down analysis.
          </span>
        ),
      },
      // ... keep your day, monthButton, yearButton sx properties unchanged
    }}
  />
</LocalizationProvider>

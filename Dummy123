import React, { useMemo, useState } from "react";
import { Box, Button, Paper, Typography, Collapse } from "@mui/material";
import { Download, ExpandMore, ExpandLess, Visibility } from "@mui/icons-material";
import { DataGrid, GridOverlay } from "@mui/x-data-grid";
import styled from "@emotion/styled";

const StyledDataGrid = styled(DataGrid)({
  maxHeight: "300px",
  minHeight: "70px",
  "& .MuiDataGrid-cell:focus,& .MuiDataGrid-columnHeader:focus,& .MuiDataGrid-cell:focus-within,& .MuiDataGrid-columnHeader:focus-within": { outline: "none" },
  "& .MuiDataGrid-columnHeader": { backgroundColor: "#faf9fe" },
  "& .MuiDataGrid-columnHeaderTitle": { fontSize: "12px", fontWeight: 700 },
  "& .MuiDataGrid-cell": { fontSize: "12px" }
});

const MainPaper = styled(Paper)({
  borderRadius: "12px",
  overflow: "hidden",
  border: "1px solid rgba(80,70,150,.1)",
  boxShadow: "0 3px 12px rgba(60,45,130,.04)"
});

const rawColumns = [
  { field:"reconRunDate",headerName:"Report Date",width:105,headerAlign:"center",align:"center",sortable:false,filterable:false },
  { field:"date",headerName:"Report Date",width:105,headerAlign:"center",align:"center",sortable:false,filterable:false },
  { field:"firstErrorDate",headerName:"First Error Date",width:115,headerAlign:"center",align:"center" },
  { field:"branchCode",headerName:"Branch Code",width:105,headerAlign:"center",align:"center" },
  { field:"currency",headerName:"Currency",width:80,headerAlign:"center",align:"center" },
  { field:"cgl",headerName:"CGL",width:120,headerAlign:"center",align:"center" },
  { field:"balance",headerName:"Amount",minWidth:130,flex:1,align:"right",headerAlign:"right" },
  { field:"inrBalance",headerName:"INR Balance",minWidth:130,flex:1,align:"right",headerAlign:"right" },
  { field:"cbsBalance",headerName:"CBS Balance",minWidth:130,flex:1,align:"right",headerAlign:"right",sortable:false,filterable:false },
  { field:"glBalance",headerName:"GL Balance",minWidth:130,flex:1,align:"right",headerAlign:"right",sortable:false,filterable:false },
  { field:"differenceAmount",headerName:"Difference Amount",minWidth:140,flex:1,align:"right",headerAlign:"right",sortable:false,filterable:false },
  { field:"diffBwYesterday",headerName:"Diff Bw Yesterday",minWidth:140,flex:1,align:"right",headerAlign:"right",sortable:false,filterable:false },
  { field:"type",headerName:"Type",width:90 },
  { field:"head",headerName:"Head",width:100 }
];

export default function DisplayTab({ level,type,data={},category,clickHandler=()=>{},downloadHandler=()=>{},requestData=()=>{},loading=false }) {
  const [paginationModel,setPaginationModel]=useState({page:0,pageSize:100});
  const [expanded,setExpanded]=useState(false);
  const rows=data?.content||[];
  const count=data?.page?.totalElements??rows.length;

  const columns=useMemo(()=>{
    if(!rows.length)return[];
    const fields=Object.keys(rows[0]);
    const cols=rawColumns.filter(c=>fields.includes(c.field));
    if(level===1)cols.push({
      field:"action",headerName:"Action",width:70,headerAlign:"center",align:"center",sortable:false,filterable:false,
      renderCell:(params)=><Button size="small" onClick={()=>clickHandler(type,params.row)} sx={{minWidth:30,color:"#5739c8"}}><Visibility fontSize="small"/></Button>
    });
    return cols;
  },[rows,level,type,clickHandler]);

  const handlePagination=(model)=>{
    setPaginationModel(model);
    requestData(type,model);
  };

  const NoRows=()=>(
    <GridOverlay>
      <Typography sx={{fontSize:12,color:"#737c91"}}>No data found</Typography>
    </GridOverlay>
  );

  const download=()=>downloadHandler(type,type);

  if(level===2){
    return (
      <MainPaper>
        <StyledDataGrid
          rows={rows}
          columns={columns}
          getRowId={(row)=>row?.id||`${row.head}-${row.cgl}`}
          autoHeight
          hideFooter
          disableRowSelectionOnClick
          slots={{noRowsOverlay:NoRows}}
          loading={loading}
        />
      </MainPaper>
    );
  }

  return (
    <MainPaper>
      <Box sx={{height:"62px",display:"flex",alignItems:"center",px:2}}>
        <Box sx={{width:34,height:34,borderRadius:"10px",display:"flex",alignItems:"center",justifyContent:"center",background:"#f1edff",color:"#5739c8",mr:1.5}}>
          <Visibility fontSize="small"/>
        </Box>
        <Typography sx={{fontSize:14,fontWeight:700,color:"#172039",flex:1}}>{category}</Typography>
        <Box sx={{px:1.2,py:.5,mr:1.5,borderRadius:"8px",background:"#f3f0ff",color:"#5739c8",fontSize:11,fontWeight:700}}>{count} rows</Box>
        <Button size="small" variant="outlined" startIcon={<Download/>} disabled={!count} onClick={download} sx={{textTransform:"none",fontSize:11,mr:1}}>
          Download
        </Button>
        <Button size="small" onClick={()=>setExpanded(v=>!v)} sx={{minWidth:30,color:"#59647d"}}>
          {expanded?<ExpandLess/>:<ExpandMore/>}
        </Button>
      </Box>

      <Collapse in={expanded} timeout={180}>
        <StyledDataGrid
          rows={rows}
          columns={columns}
          pagination
          paginationMode="server"
          paginationModel={paginationModel}
          rowCount={data?.page?.totalElements||0}
          pageSizeOptions={[100]}
          onPaginationModelChange={handlePagination}
          getRowId={(row)=>row?.id||`${row.head}-${row.cgl}`}
          disableRowSelectionOnClick
          slots={{noRowsOverlay:NoRows}}
          loading={loading}
          sx={{border:0}}
        />
      </Collapse>
    </MainPaper>
  );
}

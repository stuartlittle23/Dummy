CREATE SEQUENCE REQUEST_VOUCHER_SEQ
START WITH 1
INCREMENT BY 1
NOCACHE;



import org.springframework.jdbc.core.JdbcTemplate;

import java.time.YearMonth;
import java.time.format.DateTimeFormatter;



@Autowired
private JdbcTemplate jdbcTemplate;


long countByVidStartingWith(String prefix);



private String generateVid() {

    Long sequence = jdbcTemplate.queryForObject(
            "SELECT REQUEST_VOUCHER_SEQ.NEXTVAL FROM DUAL",
            Long.class);

    String monthPrefix = YearMonth.now()
            .format(DateTimeFormatter.ofPattern("yyMM"));

    return "VID-"
            + monthPrefix
            + "-"
            + String.format("%05d", sequence);
}



requestVoucher.setVid(generateVid());




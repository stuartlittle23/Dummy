    const showSnackBar = useCustomSnackbar();

    const user = JSON.parse(localStorage.getItem("user"));


    /* ---------------- FETCH DIFFERENCE DATA ---------------- */

    const debouncedFetchDifference = useCallback(
        debounce(async () => {
            await fetchDifference();
        }, 100),
        [userDate]
    );


    async function fetchDifference() {

        const payload = {
            date: userDate,
            branch: user.branch.toString().padStart(5, "0"),
            paginationModel: {
                page: 0,
                pageSize: 100
            }
        };

        try {

            setLoading("Y");

            const res = await callApi(
                "/ES/branch-position/get-difference",
                payload,
                "POST"
            );

            if (res?.success) {
                setDataRows(res.data || {});
            } else {
                showSnackBar(res?.message, "error");
                setDataRows({});
            }

        } catch (e) {
            showSnackBar(e.message, "error");
        } finally {
            setLoading("N");
        }
    }


    async function fetchIndividualDifference(type, paginationModel) {

        const payload = {
            date: userDate,
            branch: user.branch.toString().padStart(5, "0"),
            differenceType: type,
            paginationModel
        };

        try {

            setLoading(type);

            const res = await callApi(
                "/ES/branch-position/get-difference",
                payload,
                "POST"
            );

            if (res?.success) {

                setDataRows((prev) => ({
                    ...prev,
                    [type]: res.data?.[type] || {}
                }));

            } else {
                showSnackBar(res?.message, "error");
            }

        } catch (e) {
            showSnackBar(e.message, "error");
        } finally {
            setLoading("N");
        }
    }


    /* ---------------- DETAIL DATA ---------------- */

    const fetchDetailedData = async (
        type,
        { cgl, currency, firstErrorDate }
    ) => {

        const payload = {
            branch: user.branch.toString().padStart(5, "0"),
            cgl,
            currency,
            startDate: alterDateFormat(firstErrorDate),
            endDate: userDate,
            differenceType: type
        };

        try {

            const res = await callApi(
                "/ES/branch-position/get-detailed-difference",
                payload,
                "POST"
            );

            if (res?.success) {

                setBreakupDataRows({
                    type,
                    content: res.data || []
                });

            } else {
                showSnackBar(res?.message, "error");
            }

        } catch (e) {
            showSnackBar(e.message, "error");
        }
    };


    /* ---------------- EXPORT ---------------- */

    const blobErrorHandler = (error) => {

        if (error instanceof Blob) {

            error.text().then((message) => {

                try {

                    const json = JSON.parse(message);

                    showSnackBar(json?.message, "error");

                } catch {
                    showSnackBar(`Error: ${message}`, "error");
                }

            });

        } else {

            showSnackBar(error?.message, "error");

        }
    };


    const exportData = async (filePref, differenceType) => {

        const payload = {
            branch: user.branch.toString().padStart(5, "0"),
            date: userDate,
            differenceType
        };

        try {

            const res = await callApi(
                "/ES/branch-position/export-difference",
                payload,
                "POST",
                "blob",
                "application/octet-stream"
            );

            if (!res) {
                throw new Error("Failed to download file!");
            }

            const filename =
                `${filePref}_${payload.branch}_${alterDateFormat(userDate)}`;

            downloadFile(
                new Blob([res]),
                "xlsx",
                filename,
                false
            );

        } catch (e) {
            blobErrorHandler(e);
        }
    };


    const exportDetailedData = async () => {

        if (!breakupDataRows?.content?.length) {
            showSnackBar("No Rows to download!", "error");
            return;
        }

        const firstRow = breakupDataRows.content[0];

        const cgl = firstRow.cgl;
        const currency = firstRow.currency;
        const branch = user.branch.toString().padStart(5, "0");
        const differenceType = breakupDataRows.type;
        const firstErrorDate = firstRow.firstErrorDate;

        const payload = {
            branch,
            cgl,
            currency,
            startDate: alterDateFormat(firstErrorDate),
            endDate: userDate,
            differenceType
        };

        try {

            const res = await callApi(
                "/ES/branch-position/export-detailed-difference",
                payload,
                "POST",
                "blob",
                "application/octet-stream"
            );

            if (!res) {
                throw new Error("Failed to download file!");
            }

            const filename =
                `${differenceType}_${branch}_${currency}_${cgl}_${alterDateFormat(userDate)}`;

            downloadFile(
                new Blob([res]),
                "xlsx",
                filename,
                false
            );

        } catch (e) {
            blobErrorHandler(e);
        }
    };


    const exportGlifData = async () => {

        const branch = user.branch.toString().padStart(5, "0");

        const payload = {
            branch,
            date: userDate,
            filters: [
                {
                    field: "BRANCH_CODE",
                    operator: "EQUALS",
                    value: branch
                },
                {
                    field: "TRANS_DATE",
                    operator: "EQUALS",
                    value: userDate
                },
                ...Object.entries(glifDataFilter).map(
                    ([key, entry]) => ({
                        field: key,
                        operator: entry.operator,
                        value: entry.value
                    })
                )
            ]
        };

        try {

            const res = await callApi(
                "/ES/branch-position/export-glif-data",
                payload,
                "POST",
                "blob",
                "application/octet-stream"
            );

            if (!res) {
                throw new Error("Failed to download file!");
            }

            const filename =
                `glif_${branch}_${alterDateFormat(userDate)}${
                    Object.keys(glifDataFilter).length > 0
                        ? "_filtered"
                        : ""
                }`;

            downloadFile(
                new Blob([res]),
                "xlsx",
                filename,
                false
            );

        } catch (e) {
            blobErrorHandler(e);
        }
    };


    /* ---------------- FILTERS ---------------- */

    const handleFilter = (filter) => {

        if (!filter.multiValue) {

            setGlifDataFilter((prev) => ({
                ...prev,
                [filter.field]: {
                    operator: "EQUALS",
                    value: filter.value
                }
            }));

            return;
        }


        if (glifDataFilter[filter.field]) {

            if (glifDataFilter[filter.field].value.length >= 10) {

                showSnackBar(
                    "Only 10 filter values allowed!",
                    "error"
                );

                return;
            }


            if (
                new Set(
                    glifDataFilter[filter.field].value
                ).has(filter.value)
            ) {

                showSnackBar(
                    "Value already present in the filter!",
                    "error"
                );

                return;
            }


            setGlifDataFilter((prev) => ({
                ...prev,
                [filter.field]: {
                    operator: "IN",
                    value: [
                        ...prev[filter.field].value,
                        filter.value
                    ]
                }
            }));

            return;
        }


        setGlifDataFilter((prev) => ({
            ...prev,
            [filter.field]: {
                operator: "IN",
                value: [filter.value]
            }
        }));
    };


    const deleteFilter = (key) => {

        const {
            [key]: removed,
            ...remaining
        } = glifDataFilter;

        setGlifDataFilter(remaining);
    };


    const deleteFilterValue = (key, deleteVal) => {

        const newArray =
            glifDataFilter[key].value.filter(
                (val) => val !== deleteVal
            );

        if (newArray.length > 0) {

            setGlifDataFilter((prev) => ({
                ...prev,
                [key]: {
                    ...prev[key],
                    value: newArray
                }
            }));

        } else {

            deleteFilter(key);
        }
    };


    const getFilterData = (field) => {
        return glifDataFilter[field]?.value || [];
    };


    /* ---------------- SIDE EFFECTS ---------------- */

    useEffect(() => {

        const fetchData = async () => {

            try {

                const res = await callApi(
                    "/ES/branch-position/user-date"
                );

                if (res?.success) {

                    setUserDate(
                        res.data.substring(0, 10)
                    );

                } else {

                    showSnackBar(
                        res?.message,
                        "error"
                    );
                }

            } catch (e) {

                showSnackBar(
                    e.message,
                    "error"
                );
            }
        };

        fetchData();

        return () => {
            debouncedFetchDifference.cancel();
        };

    }, []);


    useEffect(() => {

        if (!userDate) {
            return;
        }

        setBreakupDataRows({});
        debouncedFetchDifference();

    }, [userDate]);


    useEffect(() => {

        if (breakupDataRows?.content) {
            setIsDialogOpen(true);
        }

    }, [breakupDataRows]);


    const closeDialog = () => {

        setBreakupDataRows({});
        setIsDialogOpen(false);

    };


    /* ---------------- UI ---------------- */

    return (

        <Box className={styles.pageShell}>

            {/* LEFT STATIC PANEL */}

            <Paper className={styles.leftPanel}>

                <Box className={styles.panelHeader}>

                    <Box className={styles.panelHeaderIcon}>
                        <AccountBalance />
                    </Box>

                    <Box>
                        <Typography className={styles.panelTitle}>
                            Branch position
                        </Typography>

                        <Box className={styles.titleAccent} />
                    </Box>

                </Box>


                <Box className={styles.branchInfoCard}>

                    <Box className={styles.infoBlock}>

                        <Box className={styles.infoIcon}>
                            <AccountBalance />
                        </Box>

                        <Box>
                            <Typography className={styles.infoLabel}>
                                BRANCH
                            </Typography>

                            <Typography className={styles.infoValue}>
                                {user?.branch
                                    ?.toString()
                                    .padStart(5, "0")}
                            </Typography>

                            <Typography className={styles.infoSubValue}>
                                {user?.branchName}
                            </Typography>
                        </Box>

                    </Box>


                    <Divider />


                    <Box className={styles.infoBlock}>

                        <Box className={styles.infoIcon}>
                            <Public />
                        </Box>

                        <Box>
                            <Typography className={styles.infoLabel}>
                                CIRCLE
                            </Typography>

                            <Typography className={styles.infoValue}>
                                {user?.circleCode}
                            </Typography>

                            <Typography className={styles.infoSubValue}>
                                {user?.circleName}
                            </Typography>
                        </Box>

                    </Box>


                    <Divider />


                    <Box className={styles.infoBlock}>

                        <Box className={styles.infoIcon}>
                            <CalendarMonth />
                        </Box>

                        <Box className={styles.dateInfo}>
                            <Typography className={styles.infoLabel}>
                                REPORT DATE
                            </Typography>

                            <LocalizationProvider
                                dateAdapter={AdapterDayjs}
                            >

                                <DesktopDatePicker
                                    value={
                                        userDate
                                            ? dayjs(userDate)
                                            : null
                                    }
                                    onChange={(newValue) => {

                                        if (newValue) {
                                            setUserDate(
                                                newValue.format(
                                                    "YYYY-MM-DD"
                                                )
                                            );
                                        }

                                    }}
                                    maxDate={dayjs()}
                                    format="DD-MM-YYYY"
                                    closeOnSelect
                                    slots={{
                                        actionBar: () => null
                                    }}
                                    slotProps={{
                                        textField: {
                                            size: "small",
                                            className:
                                                styles.sideDatePicker
                                        }
                                    }}
                                />

                            </LocalizationProvider>

                        </Box>

                    </Box>

                </Box>


                {/* NAVIGATION */}

                <Box className={styles.sideNavigation}>

                    <Button
                        className={`${styles.navButton} ${
                            mode === "DD"
                                ? styles.navButtonActive
                                : ""
                        }`}
                        onClick={() => {
                            setMode("DD");
                            setGlifDataFilter({});
                        }}
                        startIcon={<Tune />}
                    >
                        Difference data
                    </Button>


                    <Button
                        className={`${styles.navButton} ${
                            mode === "GE"
                                ? styles.navButtonActive
                                : ""
                        }`}
                        onClick={() => setMode("GE")}
                        startIcon={<Storage />}
                    >
                        GLIF data
                    </Button>

                </Box>


                <Box className={styles.sidebarDecoration}>
                    <AccountBalance />
                </Box>


            </Paper>


            {/* MAIN CONTENT */}

            <Box className={styles.mainContent}>

                {mode === "DD" && (

                    <>

                        <Box className={styles.pageHeading}>

                            <Typography className={styles.pageTitle}>
                                Difference data
                            </Typography>

                            <Typography className={styles.pageSubtitle}>
                                Reconciliation status for{" "}
                                {userDate
                                    ? dayjs(userDate).format(
                                        "DD-MM-YYYY"
                                    )
                                    : ""}
                            </Typography>

                        </Box>


                        {/* SUMMARY CARDS */}

                        <Grid
                            container
                            spacing={2}
                            className={styles.summaryGrid}
                        >

                            {differenceCards.map((ca


SELECT * FROM GLIF_BAL_JULY WHERE BATCH_ID IN   (SELECT  BATCH_ID FROM GLIF_BAL_JULY
WHERE TIME_FORMAT(MILLIS_TO_TIMESTAMP(TRANS_DATE), 'dd-MM-yyyy') = '20-07-2026' AND CGL = '1260505001' AND BATCH_ID !=''  AND BRANCH_CODE = '00002'  GROUP BY BRANCH_CODE , CURRENCY , BATCH_ID HAVING SUM(AMOUNT) <> 0 ) ;


SELECT * FROM GLIF_BAL_JULY
WHERE JOURNAL_NUMBER IN   (SELECT  JOURNAL_NUMBER FROM GLIF_BAL_JULY
WHERE TIME_FORMAT(MILLIS_TO_TIMESTAMP(TRANS_DATE), 'dd-MM-yyyy') = '20-07-2026' AND CGL = '1260505001' AND BATCH_ID =''  AND BRANCH_CODE = '00002'  GROUP BY BRANCH_CODE , CURRENCY , JOURNAL_NUMBER HAVING SUM(AMOUNT) <> 0 ) ;

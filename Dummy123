@Query("""
       SELECT r FROM RequestVoucher r
       WHERE
       (:status IS NULL
            OR :status = 'ALL'
            OR r.status = :status)

       AND (:categoryId IS NULL
            OR r.categoryId = :categoryId)

       AND (:allowedRole IS NULL
            OR r.allowedRole = :allowedRole)

       AND (:vid IS NULL
            OR LOWER(r.vid)
            LIKE LOWER(CONCAT('%', :vid, '%')))

       AND (:description IS NULL
            OR LOWER(r.description)
            LIKE LOWER(CONCAT('%', :description, '%')))

       AND (:sdReqNo IS NULL
            OR LOWER(r.sdReqNo)
            LIKE LOWER(CONCAT('%', :sdReqNo, '%')))

       AND (
            :fromDate IS NULL
            OR :toDate IS NULL
            OR r.createdAt BETWEEN :fromDate AND :toDate
       )
       """)
List<RequestVoucher> searchVid(

        @Param("status") String status,

        @Param("categoryId") Long categoryId,

        @Param("allowedRole") Long allowedRole,

        @Param("vid") String vid,

        @Param("description") String description,

        @Param("sdReqNo") String sdReqNo,

        @Param("fromDate") Timestamp fromDate,

        @Param("toDate") Timestamp toDate);






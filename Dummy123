  const exportGlifData = async () => {
    
     if(!selectedBranch || !userDate){
      showSnackBar("Please select Branch and Report Date before downloading.","error");
      return;
    }

    if(!glifDataFilter || glifDataFilter.length===0){
      showSnackBar("Please select atleast one filter before downloading.","error");
      return;
    }

  const payload = {
    branch: effectiveBranchCode,
    date: userDate?.format("YYYY-MM-DD"),
    filters: [
      { field: "BRANCH_CODE", operator: "EQUALS", value: effectiveBranchCode},
      { field: "TRANS_DATE", operator: "EQUALS", value: userDate },
      ...Object.entries(glifDataFilter).map(([key, entry]) => { return { ["field"]: key, ["operator"]: entry.operator, ["value"]: entry.value } })
    ]
  }
  try {
    const res = await callApi("/ES/branch-position/export-glif-data", payload, 'POST', 'blob', 'application/octet-stream');
    if (res) {

      const text = await res.text();
      try {
        const parsed = JSON.parse(text);
        if (parsed.success === false) {
          showSnackBar(parsed.message || "No data found.", "error");
          return;
        }
      } catch  {
        // not JSON 
      }

      const branch = effectiveBranchCode
      let filename = `glif_${branch}_${alterDateFormat(userDate)}${Object.keys(glifDataFilter).length > 0 ? "_filtered" : ""}`;
      const fileData = new Blob([text]);
      downloadFile(fileData, "xlsx", filename, false);
    } else {
      throw new Error("Failed to download file!")
    }
  } catch (error) {
    blobErrorHandler(error);
  }
}

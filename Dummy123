const handleSearch = useCallback(() => {
  const { cgl, balanceDate } = filters;

  if (cgl.length === 0 || !balanceDate) {
    showSnackBar("Please fill all required fields", "warning");
    return;
  }

  if (!balanceDate?.isValid?.()) {
    showSnackBar("Invalid date selected", "warning");
    return;
  }

  if (balanceDate.isBefore(MIN_ALLOWED_DATE, "day")) {
    showSnackBar(
      `Date cannot be earlier than ${MIN_ALLOWED_DATE.format(DATE_FORMAT)}`,
      "warning"
    );
    return;
  }

  if (etlDate?.isValid?.() && balanceDate.isAfter(etlDate, "day")) {
    showSnackBar(
      `Date cannot exceed ETL date ${etlDate.format(DATE_FORMAT)}`,
      "warning"
    );
    return;
  }

  setPaginationModel({
    page: 0,
    pageSize: paginationModel.pageSize,
  });

  setSortModel([
    {
      field: "balanceDate",
      sort: "desc",
    },
  ]);

  setFilterModel({
    items: [],
  });

  setSearchQuery({
    ...filters,
  });
}, [
  filters,
  etlDate,
  MIN_ALLOWED_DATE,
  DATE_FORMAT,
  paginationModel.pageSize,
  showSnackBar,
]);

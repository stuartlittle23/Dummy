onInputChange={(event, newInputValue, reason) => {
  // 1. Safe fallback: if newInputValue is null/undefined, treat it as an empty string
  const value = newInputValue || "";

  // 2. STOP ALL DROPDOWN CLOSES: Ignore internal Material-UI state refreshes completely
  if (reason === "reset" || reason === "blur") {
    return;
  }

  if (value.length > 30) return;

  setBranchSearch(value);

  if (value.length >= 3) {
    fetchSearchData("branch", value);
  } else if (value === "") {
    // 3. Wipes the data array ONLY when the text field is completely blank
    setBranches([]);
  }
}}
onChange={(_, val) => {
  handleBranchChange(val);
  // Kept clean so selecting an item doesn't force close the dropdown panel
}}

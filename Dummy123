>
                <Stack
                  direction={{ xs: "column", sm: "row" }}
                  spacing={{ xs: 2, sm: 4 }}
                  alignItems={{ xs: "stretch", sm: "center" }} // Better mobile alignment
                  sx={{ width: "100%" }}
                >
                  <Stack
                    direction="row"
                    spacing={2}
                    alignItems="center"
                    sx={{ minWidth: 100 }}
                  >
                    <DateRangeIcon />
                    <Typography sx={{ fontWeight: 700 }}>
                      Balance Date *
                    </Typography>
                  </Stack>
                  <Box sx={{ width: { xs: "100%", sm: 300, md: 400 } }}>
                    <DatePicker
                      value={filters.balanceDate}
                      format="DD-MM-YYYY"
                      minDate={minLimit}
                      maxDate={maxLimit}
                      views={["year", "month", "day"]}
                      onChange={(value) => {
                        onFilterChange("balanceDate", value);
                      }}
                      onError={(error) => {
                        setBalanceDateError(error || null);
                      }}
                      slotProps={{
                        textField: {
                          size: "small",
                          fullWidth: true,
                          placeholder: "DD-MM-YYYY",
                          error: !!balanceDateError,
                          sx: {
                            bgcolor: "white",
                            borderRadius: 1,
                            flex: 1,
                            required: true,
                            "& .MuiPickersInputBase-sectionsContainer": {
                              opacity: "1",
                            },
                          },
                        },
                        day: {
                          sx: {
                            fontWeight: 600,
                            "&.MuiPickersDay-root": { color: "#111" },
                            "&.MuiPickersDay-today": {
                              border: "2px solid #58469f",
                              fontWeight: 800,
                            },
                            "&.Mui-selected": {
                              backgroundColor: "#58469f !important",
                              color: "#fff !important",
                              fontWeight: 800,
                            },
                            "&:hover": {
                              backgroundColor: "rgba(88,70,159,0.08)",
                            },
                            "&.Mui-disabled": {
                              color: "rgba(0,0,0,0.25) !important",
                              backgroundColor: "rgba(0,0,0,0.04)",
                              opacity: 0.45,
                              textDecoration: "line-through",
                            },
                          },
                        },
                        monthButton: {
                          sx: {
                            fontWeight: 700,
                            "&.Mui-selected": {
                              backgroundColor: "#58469f !important",
                              color: "#fff !important",
                            },
                            "&.Mui-disabled": {
                              color: "rgba(0,0,0,0.25) !important",
                              opacity: 0.45,
                              textDecoration: "line-through",
                              backgroundColor: "rgba(0,0,0,0.04)",
                            },
                          },
                        },
                        yearButton: {
                          sx: {
                            fontWeight: 700,
                            "&.Mui-selected": {
                              backgroundColor: "#58469f !important",
                              color: "#fff !important",
                            },
                            "&.Mui-disabled": {
                              color: "rgba(0,0,0,0.25) !important",
                              opacity: 0.45,
                              textDecoration: "line-through",
                              backgroundColor: "rgba(0,0,0,0.04)",
                            },
                          },
                        },
                      }}
                    />
                  </Box>
                </Stack>
              </Paper>
            </Grid>
          </Grid>

          <Grid size={{ xs: 12 }}>
            {validationMessages.length > 0 && (
              <Paper
                sx={{
                  mt: 1,
                  p: 1.5,
                  borderRadius: 2,
                  border: "1px solid",
                  borderColor: "#ff4d4f",
                  bgcolor: "#fff1f0",
                }}
              >
                <Stack spacing={0.5}>
                  {validationMessages.map((msg, index) => (
                    <Typography
                      key={index}
                      variant="body2"
                      sx={{ color: "#d32f2f", fontWeight: 600 }}
                    >
                      • {msg}
                    </Typography>
                  ))}
                </Stack>
              </Paper>
            )}
          </Grid>

          {/* UPDATED ACTION BUTTONS: Flex adjustments so buttons span full width on tiny screens */}
          <Box
            sx={{
              mt: 3,
              position: "sticky",
              bottom: 12,
              zIndex: 20,
              display: "flex",
              flexDirection: { xs: "column-reverse", sm: "row" },
              justifyContent: "flex-end",
              gap: 2,
            }}
          >
            <Button
              variant="outlined"
              startIcon={<RestartAltIcon />}
              onClick={onReset}
              sx={{
                borderRadius: 2,
                textTransform: "none",
                fontWeight: 700,
                width: { xs: "100%", sm: "auto" },
              }}
            >
              Reset
            </Button>
            <Button
              variant="contained"
              startIcon={<SearchIcon />}
              onClick={onFetch}
              disabled={
                !filters.circle ||
                filters.currencies.length === 0 ||
                filters.cgl.length === 0 ||
                !filters.balanceDate ||
                balanceDateError
              }
              loading={fetchLoading}
              sx={{
                borderRadius: 2,
                px: { xs: 2, sm: 4 },
                textTransform: "none",
                fontWeight: 800,
                width: { xs: "100%", sm: "auto" },
              }}
            >
              Search
            </Button>
          </Box>
        </CardContent>
      </Card>
    </Box>
  );
};

export default BalanceLedgerForm;

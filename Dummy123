<Autocomplete
  size="small"
  fullWidth
  value={selectedCircle}
  options={circleOptions}
  loading={circleLoading}
  getOptionLabel={(o) => o ? `${o.code} - ${o.name}` : ''}
  isOptionEqualToValue={(o, v) => o.code === v?.code}
  inputValue={circleInput}
  onInputChange={(e, val) => setCircleInput(val)}
  onChange={(e, val) => setSelectedCircle(val)}
  noOptionsText="No Options"
  renderInput={(params) => (
    <TextField
      {...params}
      label="Circle"
      inputProps={{
        ...params.inputProps,
        title: selectedCircle?.name || ""
      }}
    />
  )}
/>

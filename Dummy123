onInputChange={(event, newInputValue, reason) => {
  if (newInputValue.length > 30) return;

  // 1. If it's an internal MUI reset from selecting an option, DO NOT clear the data
  if (reason === "reset") return;

  setBranchSearch(newInputValue);

  if (newInputValue.length >= 3) {
    fetchSearchData("branch", newInputValue);
  } else if (newInputValue === "") {
    // 2. Clear data ONLY when the input field is physically 100% empty
    setBranches([]);
  }
}}
onChange={(_, val) => {
  handleBranchChange(val);
  // 3. REMOVED setBranchSearch("") from here so it doesn't force a wipeout on click!
}}

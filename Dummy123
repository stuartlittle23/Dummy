 {/* 2. ACCOUNT ZONE */}
            <Grid
              size={{ xs: 12, md: isCircleVisible || isBranchVisible ? 6 : 12 }}
            >
              <Paper
                variant="outlined"
                sx={{
                  p: 3,
                  borderRadius: "20px",
                  bgcolor: "rgba(0,0,0,0.01)",
                  borderStyle: "dashed",
                }}
              >
                <SectionHeader
                  icon={<SearchIcon fontSize="small" />}
                  title="Account Details"
                />
                <Grid container spacing={2}>
                  <Grid size={{ xs: 12, sm: 7 }}>
                    <Autocomplete
                      forcePopupIcon={false}
                      autoHighlight
                      value={filters.cgl}
                      options={cgls}
                      clearIcon={filters.cgl ? undefined : null}
                      noOptionsText={
                        filters.cgl && filters.cgl < 3
                          ? "Please enter at least 3 characters"
                          : "No Options"
                      }
                      onInputChange={(e, v) => {
                        if (v.length >= 3) fetchSearchData("cgl", v);
                      }}
                      onChange={(_, v) => onFilterChange("cgl", v)}
                      renderInput={(params) => (
                        <TextField
                          {...params}
                          label="CGL"
                          required
                          InputLabelProps={{ shrink: true }}
                          placeholder="eg. 9999999999"
                          variant="standard"
                          inputProps={{
                            ...params.inputProps,
                            maxLength: 30,
                          }}
                        />
                      )}
                      loadingText="Searching Cgls..."
                    />
                  </Grid>
                  <Grid size={{ xs: 12, sm: 5 }}>
                    <Autocomplete
                      size="small"
                      options={["All Currencies", ...currencies]}
                      value={filters.currencies}
                      onChange={(_, v) =>
                        onFilterChange("currencies", v || "ALL")
                      }
                      renderInput={(p) => (
                        <TextField
                          {...p}
                          label="Currency"
                          required
                          variant="standard"
                          inputProps={{
                            ...p.inputProps,
                            maxLength: 30,
                          }}
                        />
                      )}
                    />
                  </Grid>
                </Grid>
              </Paper>
            </Grid>

            {/* ROW 2: INDIVIDUAL BRANCH TRAY */}
            {viewBranchList && hasSelectedBranches && (
              <Grid size={{ xs: 12 }}>
                <Collapse in={viewBranchList && hasSelectedBranches}>
                  <Paper
                    variant="outlined"
                    sx={{
                      borderRadius: "20px",
                      bgcolor: "#fff",
                      border: "1px solid #e0e6ed",
                      overflow: "hidden",
                      mb: 1.5,
                      boxShadow: "0 4px 20px rgba(0,0,0,0.05)",
                    }}
                  >
                    {/* Sticky Header */}
                    <Stack
                      direction="row"
                      justifyContent="space-between"
                      alignItems="center"
                      sx={{
                        p: 2,
                        borderBottom: "1px solid #f0f0f0",
                        bgcolor: "rgba(25, 118, 210, 0.02)",
                      }}
                    >
                      <Stack direction="row" spacing={1} alignItems="center">
                        <Typography
                          variant="caption"
                          sx={{
                            fontWeight: 800,
                            color: "primary.main",
                            letterSpacing: 1,
                          }}
                        >
                          SELECTED BRANCHES
                        </Typography>
                        <CustomChip
                          label={filters.branches.length}
                          color="primary"
                          sx={{ height: 20 }}
                        />
                      </Stack>

                      <Button
                        size="small"
                        color="error"
                        variant="text"
                        startIcon={<DeleteSweepIcon />}
                        onClick={() => {
                          onFilterChange("branches", ["ALL"]);
                          setViewBranchList(false);
                        }}
                        sx={{
                          p: 1,
                          fontWeight: 700,
                          "&:hover": {
                            color: "white",
                            background: "#9f0400",
                          },
                        }}
                      >
                        Clear All
                      </Button>
                    </Stack>

                    {/* Scrollable Area with Individual Remove */}
                    {/* Scrollable Area with Individual Remove using standard MUI Chip */}
                    <Box
                      sx={{
                        p: 2,
                        maxHeight: "250px",
                        overflowY: "auto",
                        display: "flex",
                        flexWrap: "wrap",
                        gap: 1,
                        "&::-webkit-scrollbar": { width: "6px" },
                        "&::-webkit-scrollbar-track": { background: "#f1f1f1" },
                        "&::-webkit-scrollbar-thumb": {
                          background: "#ccc",
                          borderRadius: "10px",
                        },
                      }}
                    >
                      {filters.branches.map((b) => (
                        <Chip
                          key={b}
                          label={b}
                          color="primary"
                          variant="outlined"
                          // Standard MUI Chip handles onDelete by showing the 'X' icon automatically
                          onDelete={() => removeBranch(b)}
                          sx={{
                            borderRadius: "8px",
                            bgcolor: "white",
                            fontWeight: 500,
                            "& .MuiChip-deleteIcon": {
                              color: "error.main",
                              transition: "0.2s",
                              "&:hover": {
                                color: "#d32f2f",
                                transform: "scale(1.2)",
                              },
                            },
                            "&:hover": {
                              bgcolor: "#f5f9ff",
                              borderColor: "primary.main",
                            },
                          }}
                        />
                      ))}
                    </Box>
                  </Paper>
                </Collapse>
              </Grid>
            )}

            {/* 3. TIMELINE & FLAGS ZONE */}
            <Grid size={{ xs: 12 }}>
              <Paper
                sx={{
                  p: 2.5,
                  borderRadius: "20px",
                  // background:
                  //   "linear-gradient(90deg, #1976d2 0%, #1565c0 100%)",
                  background: "#58469f",
                  color: "white",
                }}
              >
                <Stack
                  direction={{ xs: "column", md: "row" }}
                  spacing={3}
                  alignItems="center"
                >
                  <Stack
                    direction="row"
                    spacing={1}
                    alignItems="center"
                    sx={{ minWidth: 100 }}
                  >
                    <DateRangeIcon />
                    <Typography sx={{ fontWeight: 700 }}>
                      From Date *
                    </Typography>
                  </Stack>

                  <DatePicker
                    value={filters.fromDate}
                    format="DD/MM/YYYY"
                    minDate={minLimit}
                    maxDate={filters.toDate || maxLimit}
                    views={["year", "month", "day"]}
                    onChange={(value) => {
                      onFilterChange("fromDate", value);

                      if (
                        value &&
                        filters.toDate &&
                        value.isValid() &&
                        filters.toDate.isValid()
                      ) {
                        if (value.isAfter(filters.toDate, "day")) {
                          setFromDateError("fromGreaterThanTo");
                          setToDateError("toLessThanFrom");
                        } else {
                          setFromDateError(null);
                          setToDateError(null);
                        }
                      } else {
                        setFromDateError(null);
                      }
                    }}
                    onError={(error) => {
                      if (error) {
                        setFromDateError(error);
                      } else if (
                        filters.fromDate &&
                        filters.toDate &&
                        filters.fromDate.isAfter(filters.toDate, "day")
                      ) {
                        setFromDateError("fromGreaterThanTo");
                      } else {
                        setFromDateError(null);
                      }
                    }}
                    slotProps={{
                      textField: {
                        size: "small",
                        fullWidth: true,
                        placeholder: "DD/MM/YYYY",
                        error: !!fromDateError,
                        sx: {
                          bgcolor: "white",
                          borderRadius: 1,
                          flex: 1,
                        },
                      },

                      day: {
                        sx: {
                          fontWeight: 600,
                          "&.MuiPickersDay-root": {
                            color: "#111",
                          },
                          "&.MuiPickersDay-today": {
                            border: "2px solid #58469f",
                            fontWeight: 800,
                          },
                          "&.Mui-selected": {
                            backgroundColor: "#58469f !important",
                            color: "#fff !important",
                            fontWeight: 800,
                          },
                          "&:hover": {
                            backgroundColor: "rgba(88,70,159,0.08)",
                          },
                          "&.Mui-disabled": {
                            color: "rgba(0,0,0,0.25) !important",
                            backgroundColor: "rgba(0,0,0,0.04)",
                            opacity: 0.45,
                            textDecoration: "line-through",
                          },
                        },
                      },

                      monthButton: {
                        sx: {
                          fontWeight: 700,
                          "&.Mui-selected": {
                            backgroundColor: "#58469f !important",
                            color: "#fff !important",
                          },
                          "&.Mui-disabled": {
                            color: "rgba(0,0,0,0.25) !important",
                            opacity: 0.45,
                            textDecoration: "line-through",
                            backgroundColor: "rgba(0,0,0,0.04)",
                          },
                        },
                      },

                      yearButton: {
                        sx: {
                          fontWeight: 700,
                          "&.Mui-selected": {
                            backgroundColor: "#58469f !important",
                            color: "#fff !important",
                          },
                          "&.Mui-disabled": {
                            color: "rgba(0,0,0,0.25) !important",
                            opacity: 0.45,
                            textDecoration: "line-through",
                            backgroundColor: "rgba(0,0,0,0.04)",
                          },
                        },
                      },
                    }}
                  />

                  <Stack
                    direction="row"
                    spacing={1}
                    alignItems="center"
                    sx={{ minWidth: 100 }}
                  >
                    <DateRangeIcon />
                    <Typography sx={{ fontWeight: 700 }}>To Date *</Typography>
                  </Stack>

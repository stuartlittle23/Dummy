
import { LocalizationProvider } from "@mui/x-date-pickers/LocalizationProvider";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";
import { DatePicker } from "@mui/x-date-pickers/DatePicker";
import dayjs from "dayjs";





<LocalizationProvider dateAdapter={AdapterDayjs}>
  <DatePicker
    label="Report Date"
    format="DD/MM/YYYY"
    value={reportDate ? dayjs(reportDate) : null}
    minDate={dayjs("2026-03-31")}  // Enforces your March 31, 2026 start
    maxDate={dayjs()}              // Restricts future dates & fixes the 6-digit glitch
    slotProps={{
      textField: {
        size: "small",
        fullWidth: true,
      },
    }}
    onChange={(newValue) => {
      // Keeps your state format as YYYY-MM-DD for your API
      setReportDate(newValue && newValue.isValid() ? newValue.format("YYYY-MM-DD") : "");
    }}
  />
</LocalizationProvider>



const isApplyEnabled = useMemo(() => {
  if (!reportCode || !viewCode || !head?.headCode || !reportDate) return false;

  // Validate date boundaries
  const selectedDate = dayjs(reportDate);
  const isValidRange = 
    selectedDate.isValid() && 
    !selectedDate.isAfter(dayjs(), "day") && 
    !selectedDate.isBefore(dayjs("2026-03-31"), "day");

  if (!isValidRange) return false;
  if (isCircleScope || isBranchScope) return !!entityCode;
  return true;
}, [reportCode, viewCode, head, entityCode, reportDate, isCircleScope, isBranchScope]);

package com.fincore.enquiry_service.dto;

import com.fasterxml.jackson.annotation.JsonCreator;
import com.fasterxml.jackson.annotation.JsonProperty;
import com.fincore.enquiry_service.enums.DifferenceType;
import jakarta.validation.constraints.NotNull;
import jakarta.validation.constraints.Pattern;
import jakarta.validation.constraints.Size;
import lombok.Getter;
import lombok.NonNull;
import org.springframework.format.annotation.DateTimeFormat;

import java.time.LocalDate;

@Getter
public class DetailedDifferenceReqDTO {

    @NotNull
    @DateTimeFormat(iso = DateTimeFormat.ISO.DATE)
    private final LocalDate startDate;

    @NotNull
    @DateTimeFormat(iso = DateTimeFormat.ISO.DATE)
    private final LocalDate endDate;

    @Pattern(regexp = "^\\d{5}$", message = "branchCode must be exactly 5 digits (e.g., 00001)")
    private String branch;

    @Pattern(regexp = "^[A-Z]{3}$", message = "currency must be 3 uppercase letters (e.g., USD)")
    private String currency;

    @Pattern(regexp = "^\\d{10}$", message = "cgl must be exactly 10 digits")
    private String cgl;

    @NotNull
    private final DifferenceType differenceType;

    @JsonCreator
    public DetailedDifferenceReqDTO(
            @JsonProperty("startDate") LocalDate startDate,
            @JsonProperty("endDate") LocalDate endDate,
            @JsonProperty("branch") String branch,
            @JsonProperty("cgl") String cgl,
            @JsonProperty("currency") String currency,
            @JsonProperty("differenceType") DifferenceType differenceType
    ){
        this.startDate=startDate;
        this.endDate=endDate;
        this.branch=branch;
        this.cgl=cgl;
        this.currency=currency;
        this.differenceType=differenceType;
    }
}


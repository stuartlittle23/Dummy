    public StreamingResponseBody exportGlifData(BranchPosGlifExtractReqDTO dto) throws IOException {
        LocalDate trans_date=dto.getDate();
        String branch_code=dto.getBranch();
        final SXSSFWorkbook workbook = new SXSSFWorkbook(100);
        Map<String, CellStyle> styles = getCellStyles(workbook);
        CellStyle numberStyle = styles.get("numeric");
        SXSSFSheet sheet = workbook.createSheet("data");
        sheet.trackAllColumnsForAutoSizing();
        final AtomicInteger rowNum = new AtomicInteger(0);

        try {

            Consumer<List<List<Object>>> consumer = list -> {
                if (rowNum.get() == 0) {
                    Row row = sheet.createRow(rowNum.getAndIncrement());
                    List<Object> headers = list.removeFirst();
                    IntStream.range(0, headers.size()).forEach((int i) -> {
                        row.createCell(i).setCellValue(headers.get(i).toString().replaceAll("_", " "));
                    });
                }
                writeRows(sheet, list, rowNum, numberStyle);
            };
            Map<String, Object> resultFormat = Map.of(
                    "resultFormat", "arrayLines", "header", true
            );
            druidRestClient.executeStreamedQuery(DruidQueryBuilder.buildQuery(dto.getFilters(), resultFormat), consumer, new TypeReference<List<Object>>() {
            });
        } catch (Exception e) {
            workbook.dispose();
            throw new RuntimeException();
        }
        autoSizeSheetAndUntrack(sheet);
        return outputStream -> {
            workbook.write(outputStream);
            workbook.dispose();
        };
    }

    private void writeRows(Sheet sheet, List<List<Object>> list, AtomicInteger rowNum, CellStyle numberStyle) {
        list.forEach((List<Object> data) -> {
            Row row = sheet.createRow(rowNum.getAndIncrement());
            IntStream.range(0, data.size()).forEach((int i) -> {
                Cell cell = row.createCell(i);
                Object value = data.get(i);
                if (value instanceof Number) {
                    cell.setCellValue(((Number) value).doubleValue());
                    cell.setCellStyle(numberStyle);
                } else {
                    cell.setCellValue(value.toString());
                }
            });
        });
    }

    //
    private void writeHeader(Sheet sheet, ResultSetMetaData metaData) throws SQLException {
        Row headerRow = sheet.createRow(0);
        for (int i = 1; i <= metaData.getColumnCount(); i++) {
            Cell cell = headerRow.createCell(i - 1);
            String columnName = metaData.getColumnLabel(i);
            if (columnName == null || columnName.isEmpty()) {
                columnName = metaData.getColumnName(i);
            }
            cell.setCellValue(columnName.replaceAll("_", " "));
        }
    }

    private void autoSizeSheetAndUntrack(SXSSFSheet sheet) {
        if (sheet.getPhysicalNumberOfRows() > 0) {
            Row headerRow = sheet.getRow(0);
            if (headerRow != null) {
                for (int i = headerRow.getFirstCellNum(); i < headerRow.getLastCellNum(); i++) {
                    sheet.autoSizeColumn(i);
                }
            }
        }
        sheet.untrackAllColumnsForAutoSizing();
    }

    private Map<String, CellStyle> getCellStyles(SXSSFWorkbook workbook) {
        Map<String, CellStyle> styles = new HashMap<>();
        DataFormat format = workbook.createDataFormat();
        CellStyle numberStyle = workbook.createCellStyle();
        numberStyle.setDataFormat(format.getFormat("#,##0.0000"));
        numberStyle.setAlignment(HorizontalAlignment.RIGHT);
        styles.put("numeric", numberStyle);
        return styles;
    }

    private RowCallbackHandler getHandler(Sheet sheet, AtomicInteger rowNum, int columnCount, CellStyle numberStyle) {
        return rs -> {
            try {
                if (rowNum.get() == 0) {
                    ResultSetMetaData metaData = rs.getMetaData();
                    writeHeader(sheet, metaData);
                    rowNum.getAndIncrement();
                }
                Row row = sheet.createRow(rowNum.getAndIncrement());
                for (int i = 1; i <= columnCount; i++) {
                    Cell cell = row.createCell(i - 1);
                    Object value = rs.getObject(i);
                    if (value == null) {
                        cell.setCellValue("");
                    } else {
                        if (value instanceof Number) {
                            cell.setCellValue(((Number) value).doubleValue());
                            cell.setCellStyle(numberStyle);
                        } else {
                            cell.setCellValue(value.toString());
                        }
                    }
                }
            } catch (SQLException e) {
                throw new RuntimeException("Error processing row", e);
            }
        };
    }

    private void executeQuery(Map<String, Object> params, RowCallbackHandler handler) {
        jdbcTemplate.query(new PreparedStatementCreator() {
            @Override
            public PreparedStatement createPreparedStatement(Connection con) throws SQLException {
                PreparedStatement ps = con.prepareStatement(
                        (String) params.get("query"),
                        ResultSet.TYPE_FORWARD_ONLY,
                        ResultSet.CONCUR_READ_ONLY
                );
                ps.setFetchSize(1000);
                if (params.get("parameters") instanceof List<?> parameters) {
                    for (int i = 1; i <= parameters.size(); i++) {
                        ps.setObject(i, parameters.get(i - 1));
                    }
                }
                return ps;
            }
        }, handler);
    }


const RAIL_BG = "#111827";
const ACCENT = "#6366F1";
const ACCENT_LIGHT = "#818CF8";
const INK = "#0F172A";
const SLATE = "#64748B";
const LINE = "#E7E9F2";
const POSITIVE = "#15803D";
const NEGATIVE = "#B91C1C";
const CANVAS = "#F5F6FA";

const mono = `"JetBrains Mono", "Roboto Mono", Menlo, Consolas, monospace`;
const sans = `"Inter", "Segoe UI", system-ui, sans-serif`;

async function callApi(date, pageIndex, pageSize, filters) {
  await new Promise((r) => setTimeout(r, 550));
  const total = 26;
  const start = pageIndex * pageSize;
  const rows = Array.from({ length: Math.min(pageSize, Math.max(total - start, 0)) }).map((_, i) => {
    const idx = start + i;
    const diff = Math.round((Math.random() - 0.4) * 400000) / 100;
    const cbs = Math.round((80000 + idx * 4231.7) * 100) / 100;
    return {
      id: `ROW-${idx}`,
      errorDate: date,
      glcc: `GL${(410000000000 + idx * 173).toString().slice(0, 18)}`,
      cbsBalance: cbs,
      glBalance: Math.round((cbs - diff) * 100) / 100,
      differenceAmount: diff,
      branchCode: filters?.branch || `${1000 + (idx % 12)}`,
      currency: filters?.currency || "INR",
    };
  });
  return { totalElements: total, rows };
}

const CURRENCIES = ["INR", "USD", "EUR", "GBP", "AED"];

function fmt(n) {
  return Number(n).toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}
function today() {
  return new Date().toISOString().slice(0, 10);
}

function RailField({ icon, label, children }) {
  return (
    <Box sx={{ mb: 2.5 }}>
      <Stack direction="row" spacing={0.75} alignItems="center" sx={{ mb: 0.75 }}>
        <Box sx={{ color: ACCENT_LIGHT, display: "flex" }}>{icon}</Box>
        <Typography sx={{ fontSize: 11.5, fontWeight: 700, color: "rgba(255,255,255,0.55)", letterSpacing: 0.5, textTransform: "uppercase" }}>
          {label}
        </Typography>
      </Stack>
      {children}
    </Box>
  );
}

const railFieldSx = {
  "& .MuiInputBase-root": {
    fontFamily: sans,
    fontSize: 14,
    fontWeight: 600,
    color: "#fff",
    bgcolor: "rgba(255,255,255,0.06)",
    borderRadius: "10px",
  },
  "& .MuiOutlinedInput-notchedOutline": { borderColor: "rgba(255,255,255,0.12)" },
  "&:hover .MuiOutlinedInput-notchedOutline": { borderColor: "rgba(255,255,255,0.25)" },
  "& .Mui-focused .MuiOutlinedInput-notchedOutline": { borderColor: `${ACCENT_LIGHT} !important` },
  "& .MuiSvgIcon-root": { color: "rgba(255,255,255,0.5)" },
  "& input::placeholder": { color: "rgba(255,255,255,0.35)", opacity: 1 },
};

function DeviationBar({ cbs, gl }) {
  const max = Math.max(cbs, gl, 1);
  const cbsPct = (cbs / max) * 100;
  const glPct = (gl / max) * 100;
  return (
    <Box sx={{ position: "relative", height: 6, borderRadius: 3, bgcolor: "#F1F5F9", mt: 1.25 }}>
      <Box sx={{ position: "absolute", left: 0, top: 0, height: "100%", width: `${cbsPct}%`, borderRadius: 3, bgcolor: "#C7D2FE" }} />
      <Box sx={{ position: "absolute", left: 0, top: -2, height: 10, width: 2, bgcolor: ACCENT, borderRadius: 1, ml: `${glPct}%`, transform: "translateX(-50%)" }} />
    </Box>
  );
}



/* ==========================================================================
   BranchPosition — Premium enterprise layout (v2: taller cards, wider dialog)
   ========================================================================== */

.appShell {
  display: flex;
  align-items: stretch;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 2px 24px rgba(76, 60, 150, 0.12);
  border: 1px solid rgba(108, 92, 231, 0.1);
  min-height: 78vh; /* adjust this ONE value to change overall screen height */
  background-color: rgba(255, 255, 255, 0.219);
  backdrop-filter: blur(12px);
}

/* ---- Sidebar ---------------------------------------------------------- */

.sidebar {
  width: 264px;
  flex-shrink: 0;
  background-color: rgba(250, 249, 254, 0.521);
  backdrop-filter: blur(10px);
  border-right: 1px solid rgba(108, 92, 231, 0.1);
  padding: 20px 16px;
  display: flex;
  flex-direction: column;
}

.sidebarBrand {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 20px;
  padding: 0 4px;
}

.sidebarBrandIconWrap {
  position: relative;
}

.sidebarBrandIcon {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background-color: #EEEDFE;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6C5CE7;
}

.brandSparkle {
  position: absolute;
  top: -6px;
  right: -6px;
  font-size: 13px !important;
  color: #B8AEFB;
}

.sidebarBrandText {
  font-size: 15px;
  font-weight: 600;
  color: rgba(30, 20, 60, 0.87);
}

.infoCard {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px;
  border: 1px solid rgba(108, 92, 231, 0.12);
  border-radius: 10px;
  background-color: rgba(255, 255, 255, 0.815);
  margin-bottom: 8px;
}

.infoCardIcon {
  width: 30px;
  height: 30px;
  border-radius: 8px;
  background-color: #F5F3FF;
  color: #6C5CE7;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.infoCardLabel {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: rgba(30, 20, 60, 0.4);
  margin: 0 0 2px;
}

.infoCardValue {
  font-size: 14px;
  font-weight: 700;
  color: rgba(30, 20, 60, 0.9);
  line-height: 1.3;
}

.infoCardSubvalue {
  font-size: 12px;
  color: rgba(30, 20, 60, 0.55);
}

.dateCard {
  padding: 10px;
  border: 1.5px solid #6C5CE7;
  border-radius: 10px;
  background-color: #F8F7FF;
  margin-bottom: 16px;
}

.dateCard .infoCardLabel {
  margin-bottom: 6px;
  color: #6C5CE7;
}

.navTabs {
  margin-top: 4px;
}
.navTabs:global(.MuiTabs-flexContainer){
  gap:1200px;
}

.navTab {
  color: #FFFF !important;
  font-weight: 500;
  text-transform: none;
  align-items: center;
  flex-direction: row;
  justify-content: flex-start;
  min-height: 35px;
  border-radius: 10px;
  padding: 8px 12px;
  border-left: 3px solid transparent;
  transition: background-color 0.15s ease, color 0.15s ease;
  gap:10px;
  box-shadow: 0 3px 10px rgba(108, 92, 231, 0.3) !important;
  background: linear-gradient(90deg,#4f459b 0%,#9B8FEF 100%);
}

.navTab:hover {
  background-color: rgba(108, 92, 231, 0.06);
}

.navTab:global(.Mui-selected) {
  /* background-color: #6f67e6d0 !important; */
  background: linear-gradient(90deg,#4f459b 0%,#9B8FEF 100%);
  color: #FFFF !important;
  border-left: 3px solid #6C5CE7;
  font-weight: 700;
  min-height: 35px;
}

.navTab:global(.Mui-disabled) {
  opacity: 0.4;
}

.sidebarFooter {
  margin-top: auto;
  padding-top: 12px;
}

.sidebarIllustration {
  position: relative;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 12px 0 4px;
}

.sparkleTopRight {
  position: absolute;
  top: 2px;
  right: 28%;
  font-size: 15px !important;
  color: #C9BFFC;
}

.sparkleBottomLeft {
  position: absolute;
  bottom: 6px;
  left: 22%;
  font-size: 10px !important;
  color: #C9BFFC;
  opacity: 0.8;
}

.sparkleMidRight {
  position: absolute;
  top: 38%;
  right: 14%;
  font-size: 9px !important;
  color: #DCD5FE;
}

/* ---- Main content ------------------------------------------------------- */

.mainContent {
  flex: 1;
  min-width: 0;
  padding: 24px;
  background-color: rgba(253, 252, 255, 0.096);
  display: flex;
  flex-direction: column;
}

.pageHeaderRow {
  display: flex;
  align-items: center;
  gap: 6px;
}

.headerSparkle {
  font-size: 17px !important;
  color: #B8AEFB;
}

.pageHeaderTitle {
  font-size: 20px;
  font-weight: 700;
  color: rgba(20, 14, 45, 0.9);
  margin: 0 0 2px;
}

.pageHeaderSubtitle {
  font-size: 13px;
  color: rgba(30, 20, 60, 0.5);
  margin: 0 0 22px;
}

.highlightDate {
  font-weight: 700;
  color: #6C5CE7;
}

/* ---- Summary cards — CHANGE 1: taller, fills the vertical space, count
   block vertically centered via flex:1 on the middle section. ---------------- */

.summaryRow {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  align-items: stretch;
  flex: 1;
}

.summaryCard {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 80%;
  min-height: 300px;
  background-color: rgba(255, 255, 255, 0.295);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(108, 92, 231, 0.1);
  border-radius: 16px;
  padding: 22px;
  transition: box-shadow 0.15s ease, transform 0.1s ease;
}

.summaryCard:hover {
  box-shadow: 0 8px 24px rgba(76, 60, 150, 0.1);
  transform: translateY(-1px);
}

.cardSparkleBadge {
  position: absolute;
  top: 14px;
  right: 16px;
  font-size: 16px !important;
  color: #10A37F;
}

.summaryCardHeader {
  display: flex;
  align-items: center;
  gap: 10px;
}

.summaryCardIcon {
  width: 38px;
  height: 38px;
  border-radius: 11px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.summaryCardLabel {
  font-size: 14px;
  font-weight: 700;
  color: rgba(30, 20, 60, 0.85);
  line-height: 1.25;
}

/* This block grows to fill the extra vertical space and centers its
   content — this is what pulls the big number into the middle of the
   taller card instead of leaving empty space below it. */
.summaryCardCenter {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 4px;
  padding: 12px 0;
}

.summaryCardCount {
  font-size: 44px;
  font-weight: 700;
  line-height: 1;
}

.summaryCardCaption {
  font-size: 13px;
  font-weight: 600;
  color: rgba(30, 20, 60, 0.5);
}

.summaryCardActions {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.viewDetailsButton {
  width: 100%;
  height: 38px !important;
  text-transform: none !important;
  border-radius: 9px !important;
  font-weight: 600 !important;
  font-size: 13px !important;
  box-shadow: 0 3px 10px rgba(108, 92, 231, 0.3) !important;
}

/* CHANGE 2: outlined style — white background, solid violet border+text
   when enabled. MUI's default disabled treatment (grey border/text) takes
   over automatically when count is 0, so enabled vs disabled now reads
   clearly instead of both looking like faded lavender-on-lavender. */
.downloadButtonOutlined {
  width: 100%;
  height: 36px !important;
  text-transform: none !important;
  border-radius: 9px !important;
  font-weight: 600 !important;
  font-size: 12.5px !important;
  border-width: 1.5px !important;
}


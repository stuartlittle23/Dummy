<DataGrid
  rows={data || []}
  columns={balanceColumns}
  loading={isDataLoading}
  rowCount={rowCount}
  pagination
  paginationMode="server"
  pageSizeOptions={[25, 50, 75, 100]}
  // Control pagination state explicitly
  paginationModel={{
    page: fetchConf.page,
    pageSize: fetchConf.pageSize,
  }}
  // Guard against MUI's internal auto-resets when rows change
  onPaginationModelChange={(model) => {
    setFetchConf((prev) => {
      if (prev.page === model.page && prev.pageSize === model.pageSize) {
        return prev; // Ignore if page hasn't actually changed
      }
      return {
        ...prev,
        page: model.page,
        pageSize: model.pageSize,
      };
    });
  }}
  sortingMode="server"
  sortingOrder={["asc", "desc"]}
  sortModel={[
    {
      field: "date",
      sort: fetchConf.sortIn?.toLowerCase() || "desc",
    },
  ]}
  // Guard against automatic sort triggers resetting pagination
  onSortModelChange={(model) => {
    if (!model || model.length === 0) return;

    const newSortIn = model[0].sort ? model[0].sort.toUpperCase() : "DESC";

    setFetchConf((prev) => {
      if (prev.sortIn === newSortIn) {
        return prev; // STOPS DataGrid re-render from resetting page to 0
      }
      return {
        ...prev,
        sortIn: newSortIn,
        page: 0,
      };
    });
  }}
  slots={{ noRowsOverlay: CustomNoRowsOverlay }}
  rowHeight={45}
  disableRowSelectionOnClick
  sx={{
    borderRadius: "20px",
    backgroundColor: "rgba(255,255,255,0.4)",
    border: "1px solid rgba(255,255,255,0.3)",
    "& .MuiDataGrid-columnHeaders": {
      bgcolor: "#f8f9fa",
      fontWeight: 700,
    },
  }}
/>

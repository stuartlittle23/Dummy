                    <Typography
                      variant="body2"
                      color={isExpanded ? "primary.main" : "text.primary"}
                      sx={{
                        fontWeight: isExpanded ? 700 : node.level === 0 ? 600 : 400,
                        whiteSpace: "nowrap",
                        overflow: "hidden",
                        textOverflow: "ellipsis",
                      }}
                    >
                      {node.name}
                    </Typography>
                  </MotionBox>
                </TableCell>
              );
            }
            return (
              <TableCell
                key={colIndex}
                sx={{
                  borderRight: 1,
                  borderColor: "divider",
                  width: 80,
                  minWidth: 80,
                  bgcolor: "background.default",
                  p: 0,
                }}
              />
            );
          })}

          {/* Dynamic Metrics Columns */}
          {activeMetrics.map((metric, mIdx) => {
            const isLastColumn = mIdx === activeMetrics.length - 1;
            return (
              <TableCell
                key={metric.logicalName}
                align="right"
                sx={{
                  borderRight: 1,
                  borderColor: "divider",
                  p: 0,
                  verticalAlign: "middle",
                }}
              >
                <MotionBox
                  whileHover={{
                    scale: 1.03,
                    zIndex: 20,

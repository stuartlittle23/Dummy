const validateCgl = (val) => {
    const pattern = /^\d{10}$/;
    return pattern.test(val.toString()) ? null : "CGL must be of 10 digits!";
}

const validateCurrency = (val) => {
    const pattern = /^([A-Z]){3}$/;
    return pattern.test(val.toString()) ? null : "Currency Code must be of 3 Capital letters!";
}

const validateBranchCode = (val) => {
    const pattern = /^([0-9]){5}$/;
    return pattern.test(val.toString()) ? null : "Branch code must be of 5 digits!";
}

const validateJrnNo = (val) => {
    const pattern = /^\d+$/;
    return pattern.test(val.toString()) ? null : "Journal Number must be numeric only!";
}

const validateAccNo = (val) => {
    const pattern = /^\d{10}$/;
    return pattern.test(val.toString()) ? null : "Account Number must be 10 digits only!";
}

const validateTxnCode = (val) => {
    const pattern = /^\d{5}$/;
    return pattern.test(val.toString()) ? null : "Transaction code must be 5 digits only!";
}
const validateBatchId = (val) => {
    return null
}

export default { validateCgl, validateCurrency, validateBranchCode, validateJrnNo, validateAccNo, validateTxnCode, validateBatchId };

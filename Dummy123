if (res?.data) {
  let opts = [];

  if (type === "branch") {
    opts = res.data.map(
      (i) => `${i.code}-${i.name}`
    );

    setBranches(opts);

  } else if (type === "cgl") {

    opts = res.data.map(
      (i) => `${i.cglNumber} - ${i.description}`
    );

    setCgls(
      hasWholeBank
        ? ["All CGLs", ...opts]
        : opts
    );

  } else if (type === "currency") {

    opts = res.data.map(
      (i) => `${i.currencyCode} - ${i.description}`
    );

    setCurrencyOptions(opts);
  }
}

package com.fincore.enquiry_service.service.utils;

import com.fincore.enquiry_service.dto.GridFilter;

import java.util.*;

public class DruidQueryBuilder {
    public static Map<String, Object> buildQuery(List<GridFilter> filters,Map<String,Object> resultType) {
        StringBuilder sql = new StringBuilder("SELECT TIME_FORMAT(MILLIS_TO_TIMESTAMP(POST_DATE),'dd-MM-yyyy') as POST_DATE, " +
                "JOURNAL_NUMBER, " +
                "BRCH, " +
                "FCY_CODE, " +
                "BRANCH_CODE, " +
                "CURRENCY, " +
                "CGL, " +
                "TRANSACTION_CODE, " +
                "DESCRIPTION, " +
//                "BATCH_ID, " +
                "TIME_FORMAT(MILLIS_TO_TIMESTAMP(TRANS_DATE), 'dd-MM-yyyy') as TRANSACTION_DATE, " +
                "AMOUNT, " +
                "LCY_AMT, " +
                "FCY_AMT, " +
                "ACCOUNT, " +
                "SOURCE FROM GLIF");
        List<Map<String, String>> parameters = new ArrayList<>();
        if (filters.size() != 0) {
            sql.append(" WHERE ");
            boolean isFirst=true;
            for (GridFilter filter : filters) {
                appendFilterCondition(sql,parameters,filter,isFirst);
                if(isFirst){
                    isFirst=false;
                }
            }
        }
//        sql.append("GROUP BY CGL,TRANSACTION_CODE,JOURNAl_NUMBER");
        System.out.println(sql);
        Map<String,Object> queryMeta=new HashMap<>();

        queryMeta.put("query", sql.toString());
        queryMeta.put("parameters", parameters);
        queryMeta.putAll(resultType);
        return Collections.unmodifiableMap(queryMeta);
    }


    private static void appendFilterCondition(StringBuilder sql, List<Map<String, String>> parameters, GridFilter filter,boolean isFirst) {
        if(!isFirst){
            sql.append(" AND ");
        }
        if ("EQUALS".equalsIgnoreCase(filter.getOperator())) {
            sql.append(filter.getField()).append(" = ? ");
            if(((String) filter.getValue()).matches("^\\d{4}-\\d{2}-\\d{2}$")){
                parameters.add(Map.of("type", "DATE", "value", String.valueOf(filter.getValue())));
                return;
            }
            parameters.add(Map.of("type", "VARCHAR", "value", String.valueOf(filter.getValue())));
            return;
        }
        if("IN".equalsIgnoreCase(filter.getOperator())){
            sql.append(filter.getField()).append(" IN (");
            ArrayList<?> list;
            if(filter.getValue() instanceof ArrayList<?> arrayList){
                list=arrayList;
            }else{
                list=new ArrayList<>();
            }
            for(int i=0;i<list.size();i++){
                if(i==0){
                    sql.append(" ? ");
                }else {
                    sql.append(",? ");
                }
                parameters.add(Map.of("type", "VARCHAR", "value", String.valueOf(list.get(i))));
            }
            sql.append(")");
            return;
        }
        throw new IllegalArgumentException("Unsupported filter operator: " + filter.getValue());
    }
}

@RestController
@RequestMapping("/api/branch-position")
@RequiredArgsConstructor
public class BranchPositionController {
    private final BranchPositionService branchPositionService;

    /* Fetches the latest ETL completion date*/
    @GetMapping("/user-date")
    public ResponseEntity<ApiResponse<String>> getUserDate(){
        String date=branchPositionService.getUserDate();
        return ResponseEntity.ok(ApiResponse.success(date, "User date fetched Successfully!"));
    }

    /* Fetches the bank difference data for the Date and Branch */
    @PostMapping("/get-difference")
    public ResponseEntity<ApiResponse<Map<String, Page<?>>>> getDifference(@Valid @RequestBody BranchPosDifferenceReqDTO diffReq){
        return ResponseEntity.ok(ApiResponse.success(branchPositionService.getDifference(diffReq),"Difference data fetched successfully!"));
    }

    /* Exports the Difference data for the Date and Branch in EXCEL format */
    @PostMapping("/export-difference")
    public ResponseEntity<StreamingResponseBody> exportDifferenceDate(
            @RequestBody BranchPosDifferenceReqDTO req
    ){
        return ResponseEntity.ok()
                .header(
                        HttpHeaders.CONTENT_DISPOSITION,
                        "attachment; filename=DifferenceData.xlsx")
                .contentType(
                        MediaType.APPLICATION_OCTET_STREAM)
                .body(branchPositionService.exportDifferenceData(req));
    }

    /* Fetches the breakup of the difference observed for the Date and Branch */
    @PostMapping("/get-detailed-difference")
    public ResponseEntity<ApiResponse<List<?>>> getDetailedData(@Valid @RequestBody DetailedDifferenceReqDTO diffReq){
        return ResponseEntity.ok(ApiResponse.success(branchPositionService.getDetailedDifference(diffReq),"Difference data fetched successfully!"));
    }

    /* Exports the breakup of the difference observed for the Date and Branch */
    @PostMapping("/export-detailed-difference")
    public ResponseEntity<StreamingResponseBody> exportDetailedDiff(@RequestBody DetailedDifferenceReqDTO dto){
        return ResponseEntity.ok()
                .header(
                        HttpHeaders.CONTENT_DISPOSITION,
                        "attachment; filename=DifferenceData.xlsx")
                .contentType(
                        MediaType.APPLICATION_OCTET_STREAM)
                .body(branchPositionService.exportDetailedDiff(dto));
    }

    /* Fetches the GLIF data for the Date and Branch*/
    @PostMapping("/get-glif-data")
    public ResponseEntity<List<Map<String,Object>>> getGlifData(@RequestBody BranchPosGlifExtractReqDTO dto) throws IOException {
        return ResponseEntity.ok().body(branchPositionService.fetchGlifData(dto));
    }

    /* Exports the GLIF data for the Date and Branch in EXCEL format */
    @PostMapping("/export-glif-data")
    public ResponseEntity<StreamingResponseBody> exportGlifData(@RequestBody BranchPosGlifExtractReqDTO dto) throws IOException {
        return ResponseEntity.ok()
                .header(
                        HttpHeaders.CONTENT_DISPOSITION,
                        "attachment; filename=GlifData.xlsx")
                .contentType(
                        MediaType.APPLICATION_OCTET_STREAM)
                .body( branchPositionService.exportGlifData(dto));
    }
}



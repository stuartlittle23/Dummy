package com.fincore.process_status_service.consumer;

import com.fincore.process_status_service.dto.AirflowDagEvent;
import com.fincore.process_status_service.dto.UnmappedCglEvent;
import com.fincore.process_status_service.service.ProcessStatusService;
import com.fincore.process_status_service.util.Constants;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

import org.apache.kafka.clients.consumer.ConsumerRecord;
import org.springframework.kafka.annotation.KafkaListener;
import org.springframework.stereotype.Component;

import tools.jackson.databind.JsonNode;
import tools.jackson.databind.ObjectMapper;

@Component
@RequiredArgsConstructor
@Slf4j
public class AirflowEventConsumer {

    private final ProcessStatusService processStatusService;

    private final ObjectMapper objectMapper;

    @KafkaListener(
            topics = "airflow-events",
            groupId = "Airflow_ETL_v1"
    )
    public void consume(ConsumerRecord<String, String> record) {

        log.info("==============================================");
        log.info("AIRFLOW EVENT CONSUMER CALLED");
        log.info("Topic     : {}", record.topic());
        log.info("Partition : {}", record.partition());
        log.info("Offset    : {}", record.offset());
        log.info("Key       : {}", record.key());
        log.info("Payload   : {}", record.value());
        log.info("==============================================");

        try {

            String payload = record.value();

            JsonNode event = objectMapper.readTree(payload);

            log.info("JSON successfully parsed: {}", event);

            String key = record.key();

            /*
             * UNMAPPED CGL EVENT
             */
            if ("unmapped_cgl".equals(key)) {

                log.info("UNMAPPED CGL EVENT RECEIVED");

                UnmappedCglEvent unmappedCglEvent =
                        objectMapper.treeToValue(
                                event,
                                UnmappedCglEvent.class
                        );

                log.info(
                        "Unmapped CGL Event DTO: {}",
                        unmappedCglEvent
                );

                processStatusService.handleUnmappedCglEvent(
                        unmappedCglEvent
                );

                log.info(
                        "UNMAPPED CGL EVENT PROCESSED SUCCESSFULLY"
                );

            }

            /*
             * EOD / AIRFLOW EVENT
             */
            else {

                log.info("AIRFLOW / EOD EVENT RECEIVED");

                AirflowDagEvent dagEvent =
                        objectMapper.treeToValue(
                                event,
                                AirflowDagEvent.class
                        );

                log.info(
                        "Airflow DAG Event: {}",
                        dagEvent
                );

                log.info(
                        "Event Type: {}",
                        dagEvent.getEventType()
                );

                log.info(
                        "Status: {}",
                        dagEvent.getStatus()
                );

                if (String.valueOf(Constants.WAITING_FOR_APPROVAL)
                        .equals(dagEvent.getStatus())) {

                    log.info(
                            "Calling handleAirflowEvent()"
                    );

                    processStatusService.handleAirflowEvent(
                            dagEvent
                    );

                    log.info(
                            "handleAirflowEvent() completed"
                    );
                }

                log.info(
                        "Calling sendProcessStatusUpdates()"
                );

                processStatusService.sendProcessStatusUpdates();

                log.info(
                        "sendProcessStatusUpdates() completed"
                );
            }

        } catch (Exception e) {

            log.error(
                    "ERROR PROCESSING AIRFLOW EVENT - topic={}, partition={}, offset={}, key={}, payload={}",
                    record.topic(),
                    record.partition(),
                    record.offset(),
                    record.key(),
                    record.value(),
                    e
            );

            throw e;
        }
    }
}
spring.kafka.consumer.bootstrap-servers=10.0.17.242:9092
spring.kafka.consumer.key-deserializer=org.apache.kafka.common.serialization.StringDeserializer
spring.kafka.consumer.value-deserializer=org.apache.kafka.common.serialization.StringDeserializer



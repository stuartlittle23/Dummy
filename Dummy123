row.createCell(col++)
                            .setCellValue(
                                    safeString(
                                            rs.getString("DESCRIPTION")
                                    )
                            );

                    row.createCell(col++)
                            .setCellValue(
                                    rs.getBigDecimal("BALANCE") != null
                                            ? rs.getBigDecimal("BALANCE").doubleValue()
                                            : 0
                            );

                    row.createCell(col++)
                            .setCellValue(
                                    rs.getBigDecimal("INR_BALANCE") != null
                                            ? rs.getBigDecimal("INR_BALANCE").doubleValue()
                                            : 0
                            );

                    if (rowNum.get() % 5000 == 0) {

                        try {

                            sheet.flushRows(500);

                        } catch (IOException e) {

                            throw new RuntimeException(e);
                        }

                        log.info(
                                "Processed Rows : {}",
                                rowNum.get()
                        );
                    }
                });

                sheet.flushRows();

                setColumnWidths(sheet);

                workbook.write(out);

                byte[] bytes = out.toByteArray();

                workbook.dispose();

                SearchCriteriaDTO searchDto =
                        new SearchCriteriaDTO();

                String branches =
                        String.join(
                                ", ",
                                dto.getBranches()
                        );

                searchDto.setCircle(dto.getCircle());
                searchDto.setBranch(branches);
                searchDto.setCgl(dto.getCgl());
                searchDto.setCurrency(dto.getCurrencies());
                searchDto.setFromDate(dto.getFromDate());
                searchDto.setToDate(dto.getToDate());

                sendToMyDownloads(
                        userId,
                        searchDto,
                        bytes
                );

                long end =
                        System.currentTimeMillis();

                log.info(
                        "Ledger Balance Export Completed In {} Seconds",
                        (end - start) / 1000
                );

                return bytes;
            }

        } catch (Exception e) {

            log.error(
                    "Ledger Balance Export Failed",
                    e
            );

            throw new RuntimeException(
                    "Export failed",
                    e
            );
        }
    }


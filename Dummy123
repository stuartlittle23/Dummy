const columns = useMemo(() => {

    // Technical Suspense GLIF columns
    if (glifMode) {
        if (!rows.length) return [];

        return Object.keys(rows[0])
            .filter((field) => field.toUpperCase() !== "SUSPENSE_TYPE")
            .map((field) => ({
                field,
                headerName: field.replaceAll("_", " "),
                minWidth: 150,
                flex: 1,
                headerAlign: "center",
                align: "left",
                sortable: true,
                filterable: true,
            }));
    }

    // Existing reconciliation columns
    if (!rows || rows.length === 0) {
        return rawColumns.filter((column) =>
            [
                "firstErrorDate",
                "glcc",
                "balance",
                "cbsBalance",
                "glBalance",
                "differenceAmount",
                "diffBwYesterday",
                "head",
                "type",
            ].includes(column.field)
        );
    }

    const fields = Object.keys(rows[0]);

    let cols = rawColumns.filter((column) => {
        if (column.field === "glcc") {
            return (
                fields.includes("branchCode") ||
                fields.includes("currency") ||
                fields.includes("cgl")
            );
        }

        return fields.includes(column.field);
    });

    if (level === 2) {
        cols = cols.filter((column) => column.field !== "glcc");

        cols.unshift({
            field: "reconRunDate",
            headerName: "Report Date",
            width: 120,
            headerAlign: "center",
            align: "center",
            disableColumnMenu: true,
            sortable: true,
            filterable: true,
        });
    }

    if (level === 1) {
        cols.push({
            field: "action",
            headerName: "History",
            headerAlign: "center",
            align: "center",
            width: 80,
            sortable: false,
            filterable: false,
            disableColumnMenu: true,
            renderCell: (params) => (
                <IconButton
                    onClick={() => clickHandler(type, params.row)}
                    size="small"
                    title="History"
                >
                    <HistoryOutlinedIcon fontSize="small" />
                </IconButton>
            ),
        });
    }

    return cols;

}, [rows, level, type, clickHandler, glifMode]);

import {
  RadioGroup,
  FormControlLabel,
  Radio
} from "@mui/material";



<RadioGroup
    row
    value={searchQuery.reportType}
    onChange={(e) =>
        setSearchQuery(prev => ({
            ...prev,
            reportType: e.target.value,
            branches: ["ALL"]
        }))
    }
>
    <FormControlLabel
        value="COLLISION"
        control={<Radio />}
        label="Collision"
    />

    <FormControlLabel
        value="CONSOLIDATED"
        control={<Radio />}
        label="Consolidated"
    />
</RadioGroup>

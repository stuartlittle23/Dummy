import React, { useState, useCallback, useEffect } from "react";
import {
  TextField,
  Button,
  Box,
  Typography,
  Card,
  CardContent,
  Grid,
  InputAdornment,
  IconButton,
} from "@mui/material";
import SearchIcon from "@mui/icons-material/Search";
import CalendarMonthIcon from "@mui/icons-material/CalendarMonth";
import TuneIcon from "@mui/icons-material/Tune";
import useApi from "../../hooks/useApi";
import useValidation from "./Validation";
import dayjs from "dayjs";
import {
  LocalizationProvider,
  DatePicker,
} from "@mui/x-date-pickers";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";

import BalanceDateWiseTable from "./Components/BalanceDateWiseTable";

const BalanceParticularSearchScreen = () => {
  const { callApi } = useApi();

  const {
    validateBranchCode,
    validateCurrency,
    validateCGL,
  } = useValidation();

  const [filters, setFilters] = useState({
    date: "",
    branchCode: "",
    currency: "",
    cgl: "",
  });

  const [etlDate, setEtlDate] = useState("");

  const [rows, setRows] = useState([]);
  const [totalElements, setTotalElements] = useState(0);
  const [loading, setLoading] = useState(false);

  const [hasSearched, setHasSearched] = useState(false);
  const [filtersExpanded, setFiltersExpanded] = useState(true);

  const [paginationModel, setPaginationModel] = useState({
    page: 0,
    pageSize: 25,
  });

  const updateFilter = (key, value) => {
    setFilters((prev) => ({
      ...prev,
      [key]: value,
    }));
  };

  /*
   * ---------------------------------------------------------
   * GET DEFAULT ETL DATE
   * ---------------------------------------------------------
   */
  useEffect(() => {
    const fetchDefaultETLDate = async () => {
      try {
        const response = await callApi(
          "/PS/file/fincore-date",
          {},
          "GET"
        );

        const defaultDate =
          response?.data?.etlDate ||
          response?.date ||
          "";

        if (defaultDate) {
          setEtlDate(defaultDate);

          setFilters((prev) => ({
            ...prev,
            date: defaultDate,
          }));
        }
      } catch (err) {
        console.error("ETL Date Error:", err);
      }
    };

    fetchDefaultETLDate();
  }, [callApi]);

  /*
   * ---------------------------------------------------------
   * MAIN SEARCH API
   * ---------------------------------------------------------
   */
  const fetchData = useCallback(
    async (
      date,
      pageIndex,
      pageSize,
      searchFilters
    ) => {
      if (!date) {
        setRows([]);
        setTotalElements(0);
        return;
      }

      setLoading(true);

      try {
        const payload = {
          fromDate: date,
          toDate: date,
          branchCode: searchFilters?.branchCode || null,
          currency: searchFilters?.currency || null,
          cgl: searchFilters?.cgl || null,
        };

        const response = await callApi(
          `/ES/differences/search?page=${pageIndex}&size=${pageSize}`,
          payload,
          "POST"
        );

        const content =
          response?.data?.content ||
          response?.content ||
          [];

        const mappedRows = content.map((item, index) => ({
          id:
            item.id ||
            `date-wise-${pageIndex}-${index}`,

          ...item,

          GLCC_VAL:
            item.GLCC_VAL ||
            `${item.branchCode || ""} ${
              item.currency || ""
            } ${item.cgl || ""}`,
        }));

        setRows(mappedRows);

        setTotalElements(
          response?.data?.totalElements ??
            response?.totalElements ??
            0
        );
      } catch (err) {
        console.error("Date Wise Search Failed:", err);

        setRows([]);
        setTotalElements(0);
      } finally {
        setLoading(false);
      }
    },
    [callApi]
  );

  /*
   * ---------------------------------------------------------
   * SEARCH BUTTON
   * ---------------------------------------------------------
   */
  const handleSearch = () => {
    if (!filters.date) {
      return;
    }

    setHasSearched(true);
    setFiltersExpanded(false);

    setPaginationModel({
      page: 0,
      pageSize: paginationModel.pageSize,
    });

    fetchData(
      filters.date,
      0,
      paginationModel.pageSize,
      filters
    );
  };

  /*
   * ---------------------------------------------------------
   * PAGINATION
   * ---------------------------------------------------------
   */
  useEffect(() => {
    if (!hasSearched) {
      return;
    }

    fetchData(
      filters.date,
      paginationModel.page,
      paginationModel.pageSize,
      filters
    );
  }, [
    paginationModel.page,
    paginationModel.pageSize,
    hasSearched,
    fetchData,
  ]);

  /*
   * ---------------------------------------------------------
   * EDIT SEARCH
   * ---------------------------------------------------------
   */
  const handleEditSearch = () => {
    setFiltersExpanded(true);
  };

  return (
    <Box
      sx={{
        width: "100%",
        p: 2,
      }}
    >
      {/* =====================================================
          HEADER
      ====================================================== */}

      <Card
        sx={{
          mb: 2,
          borderRadius: 3,
          boxShadow: "0 2px 10px rgba(0,0,0,0.08)",
        }}
      >
        <CardContent
          sx={{
            py: 2,
            "&:last-child": {
              pb: 2,
            },
          }}
        >
          <Box
            sx={{
              display: "flex",
              alignItems: "center",
              justifyContent: "space-between",
              gap: 2,
            }}
          >
            <Box
              sx={{
                display: "flex",
                alignItems: "center",
                gap: 1.5,
              }}
            >
              {/* ICON */}
              <Box
                sx={{
                  width: 42,
                  height: 42,
                  borderRadius: "50%",
                  display: "flex",
                  alignItems: "center",
                  justifyContent: "center",
                  backgroundColor: "#eef0ff",
                  color: "#303f9f",
                  flexShrink: 0,
                }}
              >
                <CalendarMonthIcon />
              </Box>

              {/* HEADER TEXT */}
              <Box>
                <Box
                  sx={{
                    display: "flex",
                    alignItems: "center",
                    gap: 1,
                    flexWrap: "wrap",
                  }}
                >
                  <Typography
                    sx={{
                      fontSize: 18,
                      fontWeight: 700,
                      color: "#20235a",
                    }}
                  >
                    Date Wise Balance Search
                  </Typography>

                  <Box
                    sx={{
                      px: 1,
                      py: 0.3,
                      borderRadius: 1.5,
                      backgroundColor: "#eef0ff",
                    }}
                  >
                    <Typography
                      sx={{
                        fontSize: 11,
                        fontWeight: 700,
                        color: "#4c4f9e",
                      }}
                    >
                      Date Wise
                    </Typography>
                  </Box>
                </Box>

                <Typography
                  sx={{
                    mt: 0.3,
                    fontSize: 13,
                    color: "#666",
                  }}
                >
                  View balance differences for a selected
                  date and track reconciliation history.
                </Typography>
              </Box>
            </Box>

            {/* EDIT SEARCH */}
            {hasSearched && !filtersExpanded && (
              <Button
                variant="contained"
                size="small"
                startIcon={<TuneIcon />}
                onClick={handleEditSearch}
                sx={{
                  minWidth: 120,
                  borderRadius: 2,
                  textTransform: "none",
                  fontWeight: 600,
                  backgroundColor: "#4d46a5",
                  "&:hover": {
                    backgroundColor: "#3f398f",
                  },
                }}
              >
                Edit Search
              </Button>
            )}
          </Box>
        </CardContent>
      </Card>

      {/* =====================================================
          FILTER CARD
      ====================================================== */}

      {(!hasSearched || filtersExpanded) && (
        <Card
          sx={{
            mb: 2,
            borderRadius: 3,
            boxShadow: "0 2px 10px rgba(0,0,0,0.08)",
          }}
        >
          <CardContent>
            <Grid
              container
              spacing={2}
              alignItems="center"
            >
              {/* ETL DATE */}
              <Grid item xs={12} sm={6} md={3}>
                <LocalizationProvider
                  dateAdapter={AdapterDayjs}
                >
                  <DatePicker
                    label="ETL Date"
                    value={
                      etlDate
                        ? dayjs(etlDate)
                        : null
                    }
                    onChange={(newValue) => {
                      const formattedDate = newValue
                        ? newValue.format("YYYY-MM-DD")
                        : "";

                      setEtlDate(formattedDate);

                      updateFilter(
                        "date",
                        formattedDate
                      );
                    }}
                    slotProps={{
                      textField: {
                        fullWidth: true,
                        size: "small",
                      },
                    }}
                  />
                </LocalizationProvider>
              </Grid>

              {/* BRANCH */}
              <Grid item xs={12} sm={6} md={3}>
                <TextField
                  fullWidth
                  size="small"
                  label="Branch Code or Name"
                  placeholder="eg. 12345 or ABC"
                  value={filters.branchCode}
                  onChange={(e) =>
                    updateFilter(
                      "branchCode",
                      validateBranchCode(
                        e.target.value
                      )
                    )
                  }
                />
              </Grid>

              {/* CURRENCY */}
              <Grid item xs={12} sm={6} md={3}>
                <TextField
                  fullWidth
                  size="small"
                  label="Currency"
                  placeholder="Please select Currency"
                  value={filters.currency}
                  onChange={(e) =>
                    updateFilter(
                      "currency",
                      validateCurrency(
                        e.target.value
                      )
                    )
                  }
                />
              </Grid>

              {/* CGL */}
              <Grid item xs={12} sm={6} md={3}>
                <TextField
                  fullWidth
                  size="small"
                  label="CGL"
                  placeholder="eg. 9999999999"
                  value={filters.cgl}
                  onChange={(e) =>
                    updateFilter(
                      "cgl",
                      validateCGL(
                        e.target.value
                      )
                    )
                  }
                  InputProps={{
                    startAdornment: (
                      <InputAdornment position="start">
                        <SearchIcon fontSize="small" />
                      </InputAdornment>
                    ),
                  }}
                />
              </Grid>

              {/* SEARCH BUTTON - BELOW FIELDS */}
              <Grid
                item
                xs={12}
                sx={{
                  display: "flex",
                  justifyContent: "flex-end",
                  mt: 0.5,
                }}
              >
                <Button
                  variant="contained"
                  startIcon={<SearchIcon />}
                  onClick={handleSearch}
                  disabled={!filters.date}
                  sx={{
                    minWidth: 120,
                    height: 40,
                    borderRadius: 2,
                    textTransform: "none",
                    fontWeight: 600,
                    backgroundColor: "#4d46a5",
                    "&:hover": {
                      backgroundColor: "#3f398f",
                    },
                  }}
                >
                  Search
                </Button>
              </Grid>
            </Grid>
          </CardContent>
        </Card>
      )}

      {/* =====================================================
          DATE WISE TABLE
      ====================================================== */}

      {hasSearched && !filtersExpanded && (
        <BalanceDateWiseTable
          rows={rows}
          loading={loading}
          rowCount={totalElements}
          paginationModel={paginationModel}
          onPaginationModelChange={
            setPaginationModel
          }
        />
      )}
    </Box>
  );
};

export default BalanceParticularSearchScreen;

const fetchBalance = useCallback(
  debounce(async (configOverride) => {
    try {
      setLoading((prev) => ({ ...prev, balance: true }));

      const matched = branch?.match(/^(\d{5})-/);
      if (!matched) return;

      // Use the override passed from useEffect or fall back to state
      const effectiveConfig = configOverride || fetchConf;

      const payload = {
        currency,
        cgl: cgl?.split(" - ")[0],
        branch: matched[1],
        startDate: start ? start.format("DD-MM-YYYY") : "",
        endDate: end ? end.format("DD-MM-YYYY") : "",
        page: effectiveConfig.page,
        size: effectiveConfig.pageSize,
        sortIn: effectiveConfig.sortIn,
      };

      const result = await callApi("/ES/balance/enquires", payload, "POST");

      if (result?.data?.data?.length > 0) {
        setData(result.data.data);
        setRowCount(result.data.totalElements);
        setFiltersExpanded(false);
      } else {
        setData([]);
        setRowCount(0);
      }
    } catch (e) {
      setData([]);
      setRowCount(0);
      showSnackBar("No records found");
    } finally {
      setLoading((prev) => ({ ...prev, balance: false }));
      setSearchLoading(false);
    }
  }, 300),
  [callApi, branch, currency, cgl, start, end] // <-- fetchConf REMOVED from dependencies
);


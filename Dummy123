const handleCurrencyChange = (val) => {
  const clickedAll =
    val.includes("All Currencies") &&
    !filters.currencies.includes("All Currencies");

  const isEmpty = val.length === 0;

  if (clickedAll) {
    onFilterChange(
      "currencies",
      ["All Currencies", ...currencies.filter(c => c !== "All Currencies")]
    );
    setViewList(null);
    return;
  }

  if (isEmpty) {
    onFilterChange("currencies", ["All Currencies"]);
    setViewList(null);
    return;
  }

  const updated = val.filter(v => v !== "All Currencies");

  onFilterChange("currencies", updated);
};

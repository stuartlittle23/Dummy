renderTags={(value, getTagProps) =>
  !viewList.cgl
    ? value.map((option, index) => (
        <CustomChip
          label={option}
          {...getTagProps({ index })}
        />
      ))
    : [
        <Chip
          label={`${value.length} selected`}
        />
      ]
}



};


  const blobErrorHandler = (error) => {
    if (error instanceof Blob) {
      error.text().then((errorMessage) => {
        try {
          const errorJson = JSON.parse(errorMessage);
          showSnackBar(errorJson?.message, "error");
        } catch (e) {
          showSnackBar(`Error: ${errorMessage}`);

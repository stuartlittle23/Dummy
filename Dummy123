onPaginationModelChange={(model) => {
  // Ignore if MUI DataGrid tries to reset page to 0 while we already hold new data
  setFetchConf((prev) => {
    if (prev.page === model.page && prev.pageSize === model.pageSize) {
      return prev;
    }
    return {
      ...prev,
      page: model.page,
      pageSize: model.pageSize,
    };
  });
}}




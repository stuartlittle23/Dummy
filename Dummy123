// ======================= BalanceFilters.jsx =======================

import React from "react";

import {
  TextField,
  Autocomplete,
  Stack,
} from "@mui/material";

import {
  DatePicker,
  LocalizationProvider,
} from "@mui/x-date-pickers";

import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";

import dayjs from "dayjs";

import SearchIcon from "@mui/icons-material/Search";
import RestartAltIcon from "@mui/icons-material/RestartAlt";

import {
  StyledStack,
  StyledFormControl,
  ButtonBox,
  StyledButton,
} from "./BalanceStyles";

export default function BalanceFilters({
  branch,
  setBranch,

  currency,
  setCurrency,

  cgl,
  setCgl,

  start,
  setStart,

  end,
  setEnd,

  currencies,
  branches,
  cgls,

  loading,
  req,

  handleSearchChange,
  fetchCurrencies,

  handleSubmit,
  resetState,

  isNumeric,

  user,
  permissions,

  etlDate,
}) {
  return (
    <>
      <StyledStack direction="row">
        {/* BRANCH */}

        <StyledFormControl>
          <Autocomplete
            disabled={
              !permissions?.wholebank &&
              (user?.isCircle === "N" ||
                permissions?.branch)
            }
            forcePopupIcon={false}
            autoHighlight
            value={branch || ""}
            loading={
              !req.branch && loading.branch
            }
            options={branches}
            noOptionsText={
              req.branch
                ? "Please enter at least 3 characters"
                : "No Options"
            }
            onInputChange={(
              e,
              value,
              reason
            ) => {
              handleSearchChange(
                value,
                reason,
                "branch"
              );
            }}
            onChange={(e, value) =>
              setBranch(value)
            }
            renderInput={(params) => (
              <TextField
                {...params}
                label="Branch Code or Branch Name*"
                placeholder="eg. 12365 or ABC"
                InputLabelProps={{
                  shrink: true,
                }}
                slotProps={{
                  htmlInput: {
                    ...params.inputProps,
                    maxLength:
                      isNumeric(
                        params.inputProps.value
                      )
                        ? 5
                        : 15,
                  },
                }}
              />
            )}
          />
        </StyledFormControl>

        {/* CURRENCY */}

        <StyledFormControl>
          <Autocomplete
            options={currencies || []}
            value={currency || null}
            onOpen={fetchCurrencies}
            onChange={(
              event,
              newValue
            ) => setCurrency(newValue)}
            renderInput={(params) => (
              <TextField
                {...params}
                label="Currency*"
                InputLabelProps={{
                  shrink: true,
                }}
                placeholder="Select Currency"
              />
            )}
          />
        </StyledFormControl>

        {/* CGL */}

        <StyledFormControl>
          <Autocomplete
            forcePopupIcon={false}
            autoHighlight
            value={cgl || ""}
            loading={!req.cgl && loading.cgl}
            options={cgls}
            noOptionsText={
              req.cgl
                ? "Please enter at least 3 characters"
                : "No Options"
            }
            onInputChange={(
              e,
              value,
              reason
            ) => {
              handleSearchChange(
                value,
                reason,
                "cgl"
              );
            }}
            onChange={(e, value) =>
              setCgl(value)
            }
            renderInput={(params) => (
              <TextField
                {...params}
                label="CGL*"
                InputLabelProps={{
                  shrink: true,
                }}
                placeholder="eg. 9999999999"
                slotProps={{
                  htmlInput: {
                    ...params.inputProps,
                    maxLength:
                      isNumeric(
                        params.inputProps.value
                      )
                        ? 10
                        : 30,
                  },
                }}
              />
            )}
          />
        </StyledFormControl>

        {/* DATES */}

        <LocalizationProvider
          dateAdapter={AdapterDayjs}
        >
          {/* START DATE */}

          <StyledFormControl>
            <DatePicker
              value={start || null}
              onChange={(v) => {
                setStart(v);

                if (
                  end &&
                  dayjs(end).isBefore(v)
                ) {
                  setEnd(null);
                }
              }}
              format="DD-MM-YYYY"
              minDate={dayjs("2026-03-31")}
              maxDate={etlDate}
              slotProps={{
                textField: {
                  label: "Start Date*",
                  fullWidth: true,
                  InputLabelProps: {
                    shrink: true,
                  },
                  readOnly: true,
                  sx: {
                    flexGrow: 1,

                    "& .MuiInputBase-input":
                      {
                        caretColor:
                          "transparent",
                      },
                  },
                },
              }}
            />
          </StyledFormControl>

          {/* END DATE */}

          <StyledFormControl>
            <DatePicker
              value={end || null}
              onChange={(v) => setEnd(v)}
              format="DD-MM-YYYY"
              disabled={!start}
              minDate={dayjs(start)}
              maxDate={etlDate}
              slotProps={{
                textField: {
                  label: "End Date*",
                  fullWidth: true,
                  InputLabelProps: {
                    shrink: true,
                  },
                  readOnly: true,
                  sx: {
                    flexGrow: 1,

                    "& .MuiInputBase-input":
                      {
                        caretColor:
                          "transparent",
                      },
                  },
                },
              }}
            />
          </StyledFormControl>
        </LocalizationProvider>
      </StyledStack>

      {/* BUTTONS */}

      <ButtonBox>
        <StyledButton
          variant="contained"
          startIcon={<RestartAltIcon />}
          onClick={resetState}
        >
          Reset
        </StyledButton>

        &nbsp;&nbsp;

        <StyledButton
          variant="contained"
          startIcon={<SearchIcon />}
          disabled={
            !(
              cgl &&
              currency &&
              branch &&
              start &&
              end
            )
          }
          onClick={handleSubmit}
        >
          Search
        </StyledButton>
      </ButtonBox>
    </>
  );
}


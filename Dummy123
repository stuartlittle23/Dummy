
<IconButton
  onClick={() =>
    setViewList((p) => ({
      ...p,
      cgl: !p.cgl,
    }))
  }
>
  {viewList.cgl ? (
    <VisibilityOffIcon />
  ) : (
    <VisibilityIcon />
  )}
</IconButton>



<IconButton
  onClick={() =>

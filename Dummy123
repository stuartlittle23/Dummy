function SummaryCard({
  meta,
  count,
  isLoading,
  onViewDetails,
  onDownload,
  isSelected,
}) {
  const hasCount = typeof count === 'number'

  const isReconciled = hasCount && count === 0

  return (
    <Paper
      elevation={0}
      className={`${styles.summaryCard} ${styles[meta.role]} ${
        isSelected ? styles.summaryCardSelected : ''

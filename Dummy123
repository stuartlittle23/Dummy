@Getter
@Setter
@AllArgsConstructor
@NoArgsConstructor
public class AllowedRoleDto {

    private Long roleId;

    private String roleName;
}




@Query(value = """
    SELECT R.ROLE_ID,
           R.ROLE_NAME
    FROM RESTRICTED_PERMISSION_ELIGIBILITY RPE
    JOIN ROLES R
        ON RPE.ROLE_ID = R.ROLE_ID
    WHERE RPE.MENU_ID = :menuId
      AND R.ROLE_STATUS = 'ACTIVE'
    ORDER BY R.ROLE_NAME
    """,
    nativeQuery = true)
List<Object[]> getAllowedRoles(
        @Param("menuId") Long menuId);


List<AllowedRoleDto> getAllowedRoles(
        Long menuId);





@Override
public List<AllowedRoleDto> getAllowedRoles(
        Long menuId) {

    List<Object[]> roles =
            rolesRepository.getAllowedRoles(menuId);

    List<AllowedRoleDto> response =
            new ArrayList<>();

    for (Object[] role : roles) {

        response.add(
                new AllowedRoleDto(
                        ((Number) role[0]).longValue(),
                        (String) role[1]));
    }

    return response;
}


@GetMapping("/allowed-roles")
public List<AllowedRoleDto> getAllowedRoles(
        @RequestParam Long menuId) {

    return journalRequestService
            .getAllowedRoles(menuId);
}






              <Box className={styles.downloadRow}>
                {/* <Typography className={styles.downloadRowText}>
                  Includes all GLIF data for branch {user?.branch?.toString().padStart(5, 0)} on {formattedDate} with the applied filters.
                </Typography> */}
                <Button
                  variant="contained"
                  size="small"
                  className={styles.downloadRowButton}
                  startIcon={<Download fontSize="small" />}
                  onClick={() => exportGlifData()}
                  sx={{ marginLeft: "auto" }}
                >
                  Download GLIF Data
                </Button>
              </Box>
            </>
          )}
        </Box>
      </Box>

      <Dialog
        open={isDialogOpen}
        onClose={closeDialog}
        maxWidth="xl"
        fullWidth
        PaperProps={{ className: styles.dialogPaper }}
      >
        <DialogTitle className={styles.dialogTitle}>
          <Box sx={{ display: "flex", alignItems: "center", gap: 1 }}>
            <Typography className={styles.dialogTitleText}>
              {dialogView === "category"
                ? activeMeta?.category || "Details"
                : "Difference Break-up"}
            </Typography>

            <Chip
              label={
                dialogView === "category"
                  ? dialogCategoryCount > 0
                    ? `${dialogCategoryCount.toLocaleString(
                        "en-IN"
                      )} Records Found`
                    : "No Records"
                  : breakupDataRows?.content?.length > 0
                  ? `${breakupDataRows.content.length.toLocaleString(
                      "en-IN"
                    )} Records Found`
                  : "No Records"
              }
              size="small"
              sx={{
                fontWeight: 700,
                color: "#58469f",
                bgcolor: "rgba(88, 70, 159, 0.1)",
                borderRadius: "8px",
              }}
            />

            {dialogView === "category" && (
              <Chip
                label={`Report Date: ${dayjs(userDate).format("DD-MM-YYYY")}`}
                size="small"
                sx={{
                  fontWeight: 700,
                  color: "#58469f",
                  bgcolor: "rgba(88, 70, 159, 0.1)",
                  borderRadius: "8px",
                }}
              />
            )}

            {dialogView === "breakup" && (
              <>
                <Chip
                  label={`GLCC: ${selectedGlcc}`}
                  size="small"
                  sx={{
                    fontWeight: 700,
                    color: "#58469f",
                    bgcolor: "rgba(88, 70, 159, 0.1)",
                    borderRadius: "8px",
                  }}
                />
              </>
            )}
          </Box>

          {/* This empty Box is the spacer that pushes everything after it to the right */}
          <Box sx={{ flexGrow: 1 }} />

          {dialogView === "category" && (
            <IconButton
              className={styles.dialogButton}
              disabled={!dialogCategoryCount}
              onClick={() => exportData(dialogType, dialogType)}
              size="small"
              title="Download"
            >
              <Download fontSize="small" />
            </IconButton>
          )}
          {dialogView === "breakup" && (
            <IconButton
              className={styles.dialogButton}
              disabled={breakupDataRows?.data?.length == 0}
              onClick={exportDetailedData}
              size="small"
              title="Download breakup"
            >
              <Download fontSize="small" />
            </IconButton>
          )}

          <IconButton
            className={styles.dialogButton}
            onClick={closeDialog}
            size="small"
            title="Close"
          >
            <Close fontSize="small" />
          </IconButton>
        </DialogTitle>

        <DialogContent>
          {dialogView === "category" && dialogType && (
            <DisplayTab
              category={activeMeta.category}
              type={dialogType}
              level={1}
              hideHeader
              flat
              data={dataRows[dialogType] || []}
              clickHandler={fetchDetailedData}
              downloadHandler={exportData}
              loading={loading === "Y" || loading === dialogType}
              requestData={fetchIndividualDifference}
            />
          )}

          {dialogView === "breakup" && (
            <DisplayTab
              data={breakupDataRows || []}
              category="Difference Breakup"
              type={breakupDataRows?.type}
              level={2}
              hideHeader
              flat
              downloadHandler={exportDetailedData}
            />
          )}
        </DialogContent>
      </Dialog>
    </>
  );
}

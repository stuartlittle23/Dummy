import { LocalizationProvider, DatePicker } from "@mui/x-date-pickers";
import { AdapterDayjs } from "@mui/x-date-pickers/AdapterDayjs";
import dayjs from "dayjs";
import { useSelector } from "react-redux";

import SearchRoundedIcon from "@mui/icons-material/SearchRounded";
import RestartAltRoundedIcon from "@mui/icons-material/RestartAltRounded";
import SwapHorizRoundedIcon from "@mui/icons-material/SwapHorizRounded";
import RefreshRoundedIcon from "@mui/icons-material/RefreshRounded";
import AccountBalanceRoundedIcon from "@mui/icons-material/AccountBalanceRounded";
import PublicRoundedIcon from "@mui/icons-material/PublicRounded";
import NumbersRoundedIcon from "@mui/icons-material/NumbersRounded";
import CalendarMonthRoundedIcon from "@mui/icons-material/CalendarMonthRounded";
import VisibilityRoundedIcon from "@mui/icons-material/VisibilityRounded";
import ErrorOutlineRoundedIcon from "@mui/icons-material/ErrorOutlineRounded";
import CheckCircleRoundedIcon from "@mui/icons-material/CheckCircleRounded";
import ScaleRoundedIcon from "@mui/icons-material/ScaleRounded";

import useApi from "../../hooks/useApi";
import useCustomSnackbar from "../../utils/useCustomSnackbar";
import { getPermissions } from "../../utils/CommonUtilities";

// ─── design tokens ──────────────────────────────────────────────────────
const RAIL_BG = "#020003";
const RAIL_PAPER_BG = "#ecf0f552"; // dropdown/popup background — must contrast with white text
const ACCENT = "#6366F1";
const ACCENT_LIGHT = "#818CF8";
const INK = "#0F172A";
const SLATE = "#64748B";
const LINE = "#E7E9F2";
const POSITIVE = "#0F9D58";
const NEGATIVE = "#D93025";
const CANVAS = "#F5F6FA";
const mono = `"JetBrains Mono", "Roboto Mono", Menlo, Consolas, monospace`;
const sans = `"Inter", "Segoe UI", system-ui, sans-serif`;

const TABLE_AREA_HEIGHT = 560;
const ROW_HEIGHT = 50;

// ─── validation — same regex + messages as your BalanceFilters reference ──
const BRANCH_REGEX = /^[A-Za-z0-9/&(), -]*$/;
const CURRENCY_ALLOWED_REGEX = /^[A-Za-z ()]*$/;
const CGL_ALLOWED_REGEX = /^[A-Za-z0-9._<>/&()= -]*$/;

const INVALID_BRANCH_MSG =
  "Invalid Branch Code/Branch Name format. Only letters, numbers, spaces, '/', '&', '(', ')', '-', and ',' are allowed.";
const INVALID_CURRENCY_MSG =
  "Invalid Currency format. Only letters, spaces, '(' and ')' are allowed.";
const INVALID_CGL_MSG =
  "Invalid CGL format. Only letters, numbers, spaces, '_', '-', '<', '>', '/', '&', '(' and ')' are allowed.";

const isNumeric = (value) => {
  if (value) {
    const regex = /^\d+$/;
    return regex.test(value);
  }
  return false;
};

function fmt(n) {
  if (n === null || n === undefined || n === "") return "0.00";
  return Number(n).toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function RailField({ icon, label, children }) {
  return (
    <Box sx={{ mb: 2.25 }}>
      <Stack direction="row" spacing={0.75} alignItems="center" sx={{ mb: 0.75 }}>
        <Box sx={{ color: ACCENT_LIGHT, display: "flex" }}>{icon}</Box>
        <Typography sx={{ fontSize: 11.5, fontWeight: 700, color: "rgba(255,255,255,0.6)", letterSpacing: 0.5, textTransform: "uppercase" }}>
          {label}
        </Typography>
      </Stack>
      {children}
    </Box>
  );
}

const whiteFieldSx = {
  bgcolor: "#FFFFFF !important",
  borderRadius: "10px",
  "& .MuiInputBase-root": {
    bgcolor: "#FFFFFF !important",
    color: "#0F172A !important",
    borderRadius: "10px",
    fontFamily: sans,
    fontSize: 14,
    fontWeight: 600,
  },
  "& .MuiInputBase-input": {
    color: "#0F172A !important",
    WebkitTextFillColor: "#0F172A !important",
  },
  "& .MuiOutlinedInput-notchedOutline": { border: "none !important" },
  "& .MuiSvgIcon-root": { color: "#475569 !important" },
  "& input::placeholder": { color: "#94A3B8 !important", opacity: 1 },
  "& .MuiFormHelperText-root": { color: "rgba(255,255,255,0.55)", fontSize: 11, mx: 0, mt: 0.5 },
  "& .MuiFormHelperText-root.Mui-error": { color: "#FCA5A5" },
  "& .MuiAutocomplete-clearIndicator, & .MuiAutocomplete-popupIndicator": { color: "#475569 !important" },
};

const whitePopperSx = {
  bgcolor: "#FFFFFF",
  color: "#0F172A",
  "& .MuiAutocomplete-option": { color: "#0F172A" },
  "& .MuiAutocomplete-option.Mui-focused": { bgcolor: "#EEF2FF" },
  "& .MuiAutocomplete-noOptions": { color: "#64748B" },
  "& .MuiAutocomplete-loading": { color: "#64748B" },
};
const railAutocompleteProps = { componentsProps: { paper: { sx: whitePopperSx } } };

function GridEmptyState() {
  return (
    <Paper
      elevation={0}
      sx={{
        border: `1px dashed ${LINE}`,
        borderRadius: "16px",
        bgcolor: "#fff",
        py: 9,
        display: "flex",
        flexDirection: "column",
        alignItems: "center",
        textAlign: "center",
      }}
    >
      <Avatar sx={{ bgcolor: "#EEF2FF", color: ACCENT, width: 56, height: 56, mb: 2 }}>
        <SwapHorizRoundedIcon sx={{ fontSize: 28 }} />
      </Avatar>
      <Typography sx={{ fontWeight: 700, fontSize: 15, color: INK }}>Ready when you are</Typography>
      <Typography sx={{ fontSize: 13.5, color: SLATE, mt: 0.5, maxWidth: 340 }}>
        Set your filters on the left and hit <b style={{ color: ACCENT }}>Search</b>.
      </Typography>
    </Paper>
  );
}

function GridNoRowsOverlay() {
  return (
    <Box sx={{ height: "100%", display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", textAlign: "center", px: 3 }}>
      <Avatar sx={{ bgcolor: "#E6F4EA", color: POSITIVE, width: 56, height: 56, mb: 2 }}>
        <CheckCircleRoundedIcon sx={{ fontSize: 28 }} />
      </Avatar>
      <Typography sx={{ fontWeight: 700, fontSize: 15, color: INK }}>No records match these filters</Typography>
      <Typography sx={{ fontSize: 13.5, color: SLATE, mt: 0.5, maxWidth: 340 }}>
        Try a different date, or clear a filter and search again.
      </Typography>
    </Box>

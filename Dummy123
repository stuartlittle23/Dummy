const DynamicLayout = () => {
  const isComponentFullscreen = useSelector(
    (state) => state.ui.isComponentFullscreen
  );

  return (
    <>
      {/* 
        CRITICAL FIX: Wrapping the layout outlet with Suspense ensures 
        that dynamic/lazy subroutes don't unmount your global headers/sidebars 
        during load navigation changes.
      */}
      <Suspense fallback={<PageLoader />}>
        {!isComponentFullscreen ? <CommonLayout /> : <FullscreenLayout />}
      </Suspense>
    </>
  );
};

const AppRouter = () => {
  const menus = useSelector((state) => state.menus.menus);

  const router = useMemo(() => {
    // Defensively handle empty array fallback safely
    const dynamicRoutes = generateRouteObjects(menus || []);

    const routeConfig = [
      {
        path: "/",
        element: <LaunchScreen />,
        errorElement: <ServerError />, // Root level bubble-up error boundary
      },
      {
        path: "/server-error",
        element: <ServerError />,
      },
      // Protected Routes Layout Group
      {
        element: <PrivateRouter />,
        errorElement: <ServerError />, // Automatically handles any crash inside authentication checks
        children: [
          {
            element: <DynamicLayout />,
            children: [
              { path: "/home", element: <Home /> },
              { path: "/help", element: <Help /> },
              {
                path: "/choose-option/:mainMenuTitle",
                element: <SubmenuSelectionPage />,
              },
              // Safe spreading: if array is null/undefined, layout logic won't break
              ...(dynamicRoutes || []),
            ].filter(Boolean), // Fixed placement inside the actual target child layout array
          },
        ],
      },
      {
        path: "*",
        element: <NotFound />,
      },
    ];

    return createBrowserRouter(routeConfig);
  }, [menus]);

  return (
    <Suspense fallback={<PageLoader />}>
      <RouterProvider router={router} />
    </Suspense>
  );
};

export default AppRouter;

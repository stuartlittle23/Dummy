.uniformPaddedContainer{
    padding: 5px;
    height: 100%
}

.outerGridContainer{
    align-items: flex-start;
    height:100%
}

.datePickerContainer{
    flex-grow: 1;
    height: auto;
    align-self: stretch 
}

.typographyHeader{
    font-size: 16;
    font-weight:100 ;
      overflow-wrap: break-word;
}

.typographyHeaderCenter{
    font-size: 16;
    font-weight:100 ;
    overflow-wrap: break-word;
    text-align: center;
}

.typographyLabel{
    font-size: 14;
    overflow-wrap: break-word;
    flex-grow: 1;
}
.dividerMargin{
    margin-bottom: 5px;
}

.contentPaper{
    margin-top: 10px;
    /* margin-bottom: 5px; */
    /* padding: 5px; */
}

.buttonBox{
 display: flex;
 justify-content: flex-end;
 flex-grow: 1;
 align-content: center;
 align-items: center;
 margin: 2px;
}


.centeredButtonBox{
 display: flex;
 justify-content: center;
 flex-grow: 1;
 align-content: center;
 align-items: center;
 margin: 2px;
}

.flexiBox{
    display:flex;
    padding: 2px;
    width:100%;
}

.chipStack{
    margin: 2px;
    display: flex;
    flex-wrap: wrap;
    align-items: center
}

.chipDivider{
margin: 2px;
}

.boundedGrid{
    padding: 2px;
    border: 1px solid var(--template-palette-secondary-dark);
    border-radius: 5px;
    margin: 3px;
    background-color: var(--template-palette-primary-light) ;
}

.filterBox{
    border: 1px solid var(--template-palette-secondary-dark);
    border-radius: 5px;
}

.formButton{
    flex-grow: 0;
}

.contentBox{
    padding: 2px;
    margin-top: 5px;
    margin-bottom: 5px;
    border-radius: 15px;
    background-color: "rgba(255,255,255,0.0)";
}

.noBg{
     background-color: "rgba(255,255,255,0.0)";
}

.tabs{
    background-color: var(--template-palette-primary-light);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

.tab{
    color:white ;
}

.dialog{
 height: 100%;
 width: 100%; 
}

.dialogPaper{
   max-width: none; 
}

.filterPaper{
     min-height:150px;
     padding:10px; 
     height: 100%;
}

.filterBgSuccess{
    background-color: var(--template-palette-success-light);
}

.filterBgInfo{
    background-color: var(--template-palette-info-light);
}

.filterContainer{
    height: auto;
    align-self: stretch
}

.glifPaper{
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    margin-top:0px 
}

.dialogButton{
    flex-grow: 0;
    margin: 5px
}

.dialogTitle{
    display:flex;
    align-items: center;
}

.chipBg{
    background-color: var(--template-palette-primary-light);
}

.chipValues{
    display: flex;
    row-gap: 3px;
    flex-wrap: wrap
}
.filterLabel{
    border: 1px solid;
    border-radius: 3px;
    border-color: var(--template-palette-primary-dark);
    align-content: center
}
.filterDisplay{
    background-color: rgba(255, 255, 255, 0.5);
    border-radius: 3px;
    padding: 3px
}

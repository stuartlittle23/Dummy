import React,{useCallback,useEffect,useState}from"react";
import{Box,Button,Divider,Grid,Paper,Typography,Dialog,DialogContent,DialogTitle,Stack,Chip}from"@mui/material";
import{AccountBalance,Public,Download,EventAvailable,Business,CalendarMonth,Storage}from"@mui/icons-material";
import{LocalizationProvider}from"@mui/x-date-pickers/LocalizationProvider";
import{DesktopDatePicker}from"@mui/x-date-pickers/DesktopDatePicker";
import{AdapterDayjs}from"@mui/x-date-pickers/AdapterDayjs";
import dayjs from"dayjs";
import debounce from"lodash/debounce";
import DisplayTab from"./DisplayTab";
import Filter from"./Filter";
import useApi from"../../hooks/useApi";
import useCustomSnackbar from"../../utils/useCustomSnackbar";
import downloadFile from"../../utils/DownloadUtils";
import styles from"./BranchPosition.module.css";

const alterDateFormat=date=>{const r=/^(0[1-9]|[12][0-9]|3[01])([-/.])(0[1-9]|1[0-2])\2(\d{4})$/;return date?.replace(r,"$4$2$3$2$1")};

export default function BranchPosition(){
 const[userDate,setUserDate]=useState(null);
 const[dataRows,setDataRows]=useState({});
 const[breakupDataRows,setBreakupDataRows]=useState({});
 const[glifDataFilter,setGlifDataFilter]=useState({});
 const[loading,setLoading]=useState("N");
 const[mode,setMode]=useState("DD");
 const[isDialogOpen,setIsDialogOpen]=useState(false);
 const{callApi}=useApi();
 const showSnackBar=useCustomSnackbar();
 const user=JSON.parse(localStorage.getItem("user"));
 const branchCode=user?.branch?.toString().padStart(5,"0");

 const fetchDifference=useCallback(async()=>{
  if(!userDate)return;
  const payload={date:userDate,branch:branchCode,paginationModel:{page:0,pageSize:100}};
  try{
   setLoading("Y");
   const res=await callApi("/ES/branch-position/get-difference",payload,"POST");
   if(res?.success)setDataRows(res.data);else{showSnackBar(res.message,"error");setDataRows({});}
  }catch(e){showSnackBar(e.message,"error")}finally{setLoading("N")}
 },[userDate,branchCode,callApi,showSnackBar]);

 const debouncedFetchDifference=useCallback(debounce(()=>{if(mode==="DD")fetchDifference()},100),[fetchDifference,mode]);

 async function fetchIndividualDifference(type,paginationModel){
  const payload={date:userDate,branch:branchCode,differenceType:type,paginationModel};
  try{
   setLoading(type);
   const res=await callApi("/ES/branch-position/get-difference",payload,"POST");
   if(res?.success)setDataRows(prev=>({...prev,[type]:res.data[type]||[]}));else showSnackBar(res.message,"error");
  }catch(e){showSnackBar(e.message,"error")}finally{setLoading("N")}
 }

 const fetchDetailedData=async(type,{cgl,currency,firstErrorDate})=>{
  const payload={branch:branchCode,cgl,currency,startDate:alterDateFormat(firstErrorDate),endDate:userDate,differenceType:type};
  try{
   const res=await callApi("/ES/branch-position/get-detailed-difference",payload,"POST");
   if(res?.success)setBreakupDataRows({type,content:res.data||[]});else showSnackBar(res.message,"error");
  }catch(e){showSnackBar(e.message,"error")}
 };

 const blobErrorHandler=error=>{
  if(error instanceof Blob){
   error.text().then(message=>{try{const json=JSON.parse(message);showSnackBar(json?.message,"error")}catch{showSnackBar(`Error: ${message}`,"error")}})
  }else showSnackBar(error.message,"error");
 };

 const exportData=async(filePref,differenceType)=>{
  const payload={branch:branchCode,date:userDate,differenceType};
  try{
   const res=await callApi("/ES/branch-position/export-difference",payload,"POST","blob","application/octet-stream");
   if(!res)throw new Error("Failed to download file!");
   downloadFile(new Blob([res]),"xlsx",`${filePref}_${branchCode}_${alterDateFormat(userDate)}`,false);
  }catch(e){blobErrorHandler(e)}
 };

 const exportDetailedData=async()=>{
  if(!breakupDataRows?.content?.length){showSnackBar("No Rows to download!","error");return}
  const first=breakupDataRows.content[0];
  const payload={branch:branchCode,cgl:first.cgl,currency:first.currency,startDate:alterDateFormat(first.firstErrorDate),endDate:userDate,differenceType:breakupDataRows.type};
  try{
   const res=await callApi("/ES/branch-position/export-detailed-difference",payload,"POST","blob","application/octet-stream");
   if(!res)throw new Error("Failed to download file!");
   downloadFile(new Blob([res]),"xlsx",`${breakupDataRows.type}_${branchCode}_${first.currency}_${first.cgl}_${alterDateFormat(userDate)}`,false);
  }catch(e){blobErrorHandler(e)}
 };

 const exportGlifData=async()=>{
  const payload={
   branch:branchCode,date:userDate,
   filters:[
    {field:"BRANCH_CODE",operator:"EQUALS",value:branchCode},
    {field:"TRANS_DATE",operator:"EQUALS",value:userDate},
    ...Object.entries(glifDataFilter).map(([key,entry])=>({field:key,operator:entry.operator,value:entry.value}))
   ]
  };
  try{
   const res=await callApi("/ES/branch-position/export-glif-data",payload,"POST","blob","application/octet-stream");
   if(!res)throw new Error("Failed to download file!");
   const filtered=Object.keys(glifDataFilter).length?"_filtered":"";
   downloadFile(new Blob([res]),"xlsx",`glif_${branchCode}_${alterDateFormat(userDate)}${filtered}`,false);
  }catch(e){blobErrorHandler(e)}
 };

 useEffect(()=>{
  const fetchData=async()=>{
   try{
    const res=await callApi("/ES/branch-position/user-date");
    if(res?.success)setUserDate(res.data.substring(0,10));else showSnackBar(res.message,"error");
   }catch(e){showSnackBar(e.message,"error")}
  };
  fetchData();
  return()=>{setUserDate(null);setBreakupDataRows({});setDataRows({});setIsDialogOpen(false);setGlifDataFilter({});setLoading("N");setMode("DD")};
 },[]);

 useEffect(()=>{
  if(!userDate)return;
  setBreakupDataRows({});
  debouncedFetchDifference();
  return()=>debouncedFetchDifference.cancel();
 },[userDate,debouncedFetchDifference]);

 useEffect(()=>{if(breakupDataRows?.content)setIsDialogOpen(true)},[breakupDataRows]);

 const handleFilter=filter=>{
  const existing=glifDataFilter[filter.field];
  if(existing){
   const values=Array.isArray(existing.value)?existing.value:[existing.value];
   if(values.length>=10){showSnackBar("Only 10 filter values allowed!","error");return}
   if(values.some(v=>String(v)===String(filter.value))){showSnackBar("Value already present in the filter!","error");return}
   setGlifDataFilter(prev=>({...prev,[filter.field]:{operator:"IN",value:[...values,filter.value]}}));
   return;
  }
  setGlifDataFilter(prev=>({...prev,[filter.field]:{operator:filter.multiValue?"IN":"EQUALS",value:filter.multiValue?[filter.value]:filter.value}}));
 };

 const deleteFilter=key=>{setGlifDataFilter(prev=>{const{[key]:_,...rest}=prev;return rest})};

 const deleteFilterValue=(key,value)=>{
  const current=glifDataFilter[key];
  if(!current)return;
  const values=(Array.isArray(current.value)?current.value:[current.value]).filter(v=>String(v)!==String(value));
  if(values.length)setGlifDataFilter(prev=>({...prev,[key]:{...prev[key],value:prev[key].operator==="IN"?values:values[0]}}));
  else deleteFilter(key);
 };

 const clearAllFilters=()=>setGlifDataFilter({});
 const getFilterData=field=>{const value=glifDataFilter[field]?.value;return Array.isArray(value)?value:value?[value]:[]};

 const cards=[
  {type:"TSD",title:"Technical suspense",icon:<EventAvailable/>,color:"violet"},
  {type:"CSD",title:"CGL suspense",icon:<Business/>,color:"green"},
  {type:"BCD",title:"Balance compare",icon:<AccountBalance/>,color:"orange"}
 ];

 return <Box className={styles.page}>
  <Paper className={styles.sidebar}>
   <Box className={styles.brand}>
    <Box className={styles.brandIcon}><AccountBalance/></Box>
    <Box><Typography className={styles.brandTitle}>Branch position</Typography><Box className={styles.brandLine}/></Box>
    <Typography className={styles.sidebarSparkle}>✦</Typography>
   </Box>
   <Box className={styles.infoCard}>
    <Box className={styles.infoItem}><Box className={styles.infoIcon}><AccountBalance/></Box><Box><Typography className={styles.infoLabel}>BRANCH</Typography><Typography className={styles.infoValue}>{branchCode}</Typography><Typography className={styles.infoSub}>{user?.branchName}</Typography></Box></Box>
    <Divider/>
    <Box className={styles.infoItem}><Box className={styles.infoIcon}><Public/></Box><Box><Typography className={styles.infoLabel}>CIRCLE</Typography><Typography className={styles.infoValue}>{user?.circleCode}</Typography><Typography className={styles.infoSub}>{user?.circleName}</Typography></Box></Box>
    <Divider/>
    <Box className={styles.infoItem}><Box className={styles.infoIcon}><CalendarMonth/></Box><Box className={styles.dateInfo}><Typography className={styles.infoLabel}>REPORT DATE</Typography><LocalizationProvider dateAdapter={AdapterDayjs}><DesktopDatePicker value={userDate?dayjs(userDate):null} onChange={value=>value&&setUserDate(value.format("YYYY-MM-DD"))} maxDate={dayjs()} format="DD-MM-YYYY" closeOnSelect slotProps={{textField:{size:"small"}}}/></LocalizationProvider></Box></Box>
   </Box>
   <Box className={styles.navigation}>
    <Button className={`${styles.navButton} ${mode==="DD"?styles.activeNav:""}`} onClick={()=>setMode("DD")} startIcon={<EventAvailable/>}>Difference data</Button>
    <Button className={`${styles.navButton} ${mode==="GE"?styles.activeNav:""}`} onClick={()=>{setMode("GE");setGlifDataFilter({})}} startIcon={<Storage/>}>GLIF data</Button>
   </Box>
   <Box className={styles.sidebarArtwork}><Box className={styles.artGlow}><AccountBalance className={styles.artBank}/></Box><Box className={styles.artBase}/><Typography className={styles.artSparkleOne}>✦</Typography><Typography className={styles.artSparkleTwo}>✦</Typography></Box>
  </Paper>

  <Box className={styles.main}>
   <Paper className={styles.mainPanel}>
    <Box className={styles.pageHeader}><Box><Typography className={styles.pageTitle}>{mode==="DD"?"Difference data":"GLIF data"}</Typography><Typography className={styles.pageSubtitle}>{mode==="DD"?`Reconciliation status for ${userDate?dayjs(userDate).format("DD-MM-YYYY"):""}`:"Apply filters to download branch GLIF data."}</Typography></Box></Box>

    {mode==="DD"&&<>
     <Grid container className={styles.summaryGrid} spacing={1.5}>
      {cards.map(card=>{
       const rows=dataRows?.[card.type]?.content||[];
       const count=dataRows?.[card.type]?.page?.totalElements??rows.length;
       return <Grid xs={12} md={4} key={card.type}><Paper className={`${styles.summaryCard} ${styles[card.color]}`}><Box className={styles.summaryIcon}>{card.icon}</Box><Box className={styles.summaryContent}><Typography className={styles.summaryTitle}>{card.title}</Typography><Typography className={styles.summaryCount}>{count}</Typography><Typography className={styles.summaryLabel}>Records found</Typography></Box><Button size="small" variant="outlined" startIcon={<Download/>} disabled={!count} onClick={()=>exportData(card.type,card.type)} className={styles.cardDownload}>Download</Button></Paper></Grid>
      })}
     </Grid>
     <Box className={styles.sections}>
      <DisplayTab category="Technical suspense" type="TSD" level={1} data={dataRows.TSD||[]} clickHandler={fetchDetailedData} downloadHandler={exportData} loading={loading==="Y"||loading==="TSD"} requestData={fetchIndividualDifference}/>
      <DisplayTab category="CGL suspense" type="CSD" level={1} data={dataRows.CSD||[]} clickHandler={fetchDetailedData} downloadHandler={exportData} loading={loading==="Y"||loading==="CSD"} requestData={fetchIndividualDifference}/>
      <DisplayTab category="Balance compare" type="BCD" level={1} data={dataRows.BCD||[]} clickHandler={fetchDetailedData} downloadHandler={exportData} loading={loading==="Y"||loading==="BCD"} requestData={fetchIndividualDifference}/>
     </Box>
     <Paper className={styles.infoBanner}><Typography>Download will include all Difference data for branch {branchCode} on {userDate?dayjs(userDate).format("DD-MM-YYYY"):""} with the applied filters.</Typography></Paper>
    </>}

    {mode==="GE"&&<Box className={styles.glifScreen}>
     <Typography className={styles.glifTitle}>GLIF data</Typography>
     <Typography className={styles.glifSubtitle}>Apply filters to download branch GLIF data.</Typography>
     <Paper className={`${styles.filterSection} ${styles.glifSection}`}>
      <Box className={styles.filterHeader}><Box><Typography className={styles.filterTitle}>Add filters</Typography><Typography className={styles.filterHint}>Select the required field and value, then add it to the applied filters.</Typography></Box></Box>
      <Box className={styles.filterControls}><Filter handleFilter={handleFilter} getValues={getFilterData}/></Box>
     </Paper>
     <Paper className={`${styles.filterSection} ${styles.glifSection} ${styles.appliedSection}`}>
      <Box className={styles.appliedHeader}><Box><Typography className={styles.filterTitle}>Applied filters</Typography><Typography className={styles.filterHint}>{Object.keys(glifDataFilter).length?`${Object.keys(glifDataFilter).length} filter${Object.keys(glifDataFilter).length>1?"s":""} applied`:"No filters applied"}</Typography></Box>{Object.keys(glifDataFilter).length>0&&<Button size="small" onClick={clearAllFilters} className={styles.clearAll}>Clear all</Button>}</Box>
      {Object.keys(glifDataFilter).length===0?<Typography className={styles.emptyFilter}>No filters applied</Typography>:<Stack spacing={0.8}>{Object.entries(glifDataFilter).map(([key,val])=><Box className={styles.appliedFilter} key={key}><Typography className={styles.appliedLabel}>{key.replaceAll("_"," ")}</Typography><Box className={styles.appliedValues}>{(Array.isArray(val.value)?val.value:[val.value]).map(item=><Chip key={`${key}-${item}`} size="small" label={item} onDelete={()=>deleteFilterValue(key,item)}/>)}</Box><Button size="small" onClick={()=>deleteFilter(key)}>Clear</Button></Box>)}</Stack>}
     </Paper>
     <Box className={styles.glifDownload}><Button variant="contained" startIcon={<Download/>} onClick={exportGlifData}>Download GLIF Data</Button></Box>
    </Box>}
   </Paper>
  </Box>

  <Dialog open={isDialogOpen} onClose={()=>{setBreakupDataRows({});setIsDialogOpen(false)}} fullWidth maxWidth="xl"><DialogTitle className={styles.dialogTitle}><Typography>Difference Break-up</Typography><Box><Button size="small" variant="contained" startIcon={<Download/>} onClick={exportDetailedData} sx={{mr:1}}>Download</Button><Button size="small" onClick={()=>{setBreakupDataRows({});setIsDialogOpen(false)}}>Close</Button></Box></DialogTitle><DialogContent><DisplayTab data={breakupDataRows} category="Difference Breakup" type={breakupDataRows?.type} level={2}/></DialogContent></Dialog>
 </Box>
}

   <Box className={styles.dateCard}>
            <Box sx={{ display: 'flex', alignItems: 'center', gap: '8px', marginBottom: '2px' }}>
              <CalendarMonthOutlined sx={{ fontSize: 15, color: '#6C5CE7' }} />
              <Typography className={styles.infoCardLabel} sx={{ margin: 0 }}>Report Date</Typography>
            </Box>
            <LocalizationProvider dateAdapter={AdapterDayjs}>
              <DesktopDatePicker
                value={userDate ? dayjs(userDate.substring(0, 11), 'YYYY-MM-DD') : dayjs()}
                onChange={(newVal) => { newVal ? setUserDate(newVal.format('YYYY-MM-DD')) : setUserDate(dayjs().format('YYYY-MM-DD')) }}
                minDate={MIN_ALLOWED_DATE}
                maxDate={dayjs()}
                views={["year", "month", "day"]}
                format='DD-MM-YYYY'
                closeOnSelect={true}
                slotProps={{ textField: { size: 'small', fullWidth: true } }}
                slots={{ actionBar: () => null }}
              />
            </LocalizationProvider>
          </Box>
